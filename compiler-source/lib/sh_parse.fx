fn using_core_parse_tests_for(prof: FixtureProfile, src: string) -> Result<i32, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_parse());
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let empty1: Vec<Expr> = vec_new(0);
    let empty_stmts1: Vec<Stmt> = vec_new(0);
    let step1_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty1, empty_stmts1)?;
    if (sh_lexer.slice_eq(src, step1_fn.name_off, step1_fn.name_len, "step1") != 1) {
        return Ok(873);
    }
    if (step1_fn.ret_is_result != 1) {
        return Ok(874);
    }
    if (return_is_call1_num(step1_fn.stmts, step1_fn.body_start, step1_fn.nodes, src, "Ok", 10) != 1) {
        return Ok(875);
    }
    let empty2: Vec<Expr> = vec_new(0);
    let empty_stmts2: Vec<Stmt> = vec_new(0);
    let step2_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty2, empty_stmts2)?;
    if (sh_lexer.slice_eq(src, step2_fn.name_off, step2_fn.name_len, "step2") != 1) {
        return Ok(876);
    }
    if (return_is_ok_add_ident_num(step2_fn.stmts, step2_fn.body_start, step2_fn.nodes, src, "n", 32) != 1) {
        return Ok(877);
    }
    let empty3: Vec<Expr> = vec_new(0);
    let empty_stmts3: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty3, empty_stmts3)?;
    if (pos != buf.kinds.len) {
        return Ok(878);
    }
    if (stmt_is_let_try_call0(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "a", "step1") != 1) {
        return Ok(879);
    }
    if (stmt_is_let_try_call1_ident(main_fn.stmts, main_fn.body_start + 1, main_fn.nodes, src, "b", "step2", "a") != 1) {
        return Ok(880);
    }
    if (return_is_ok_ident(main_fn.stmts, main_fn.body_start + 2, main_fn.nodes, src, "b") != 1) {
        return Ok(881);
    }
    if (string.len(mod_inc) < 0) {
        return Ok(1);
    }
    let c_src: string = using_core_emit_inner_for(prof, src)?;
    if (string.len(c_src) < 1) {
        return Ok(882);
    }
    return Ok(42);
}

