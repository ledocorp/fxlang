    return match s {
        Assign(off, ln, _) => sh_lexer.slice_eq(src, off, ln, name),
        AssignPtr(off, ln, _) => sh_lexer.slice_eq(src, off, ln, name),
        Let(_, _, _, _, _) => 0,
        Return(_) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
