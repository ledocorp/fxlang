}

// SH-C-28 - parse+emit lex-family smoke (slice_eq + lex + main → exit 42).
fn parse_and_emit_bootstrap_lexer_smoke() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_bootstrap_lexer_smoke()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let slice_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src, slice_fn.name_off, slice_fn.name_len, "slice_eq") != 1) {
        return Err(1);
    }
    if (slice_fn.body_len != 1) {
        return Err(1);
    }
    if (return_is_add_idents(slice_fn.stmts, slice_fn.body_start, slice_fn.nodes, src, "a", "b") != 1) {
        return Err(1);
    }
    let tc_slice: i32 = check_fn_returns(slice_fn, src)?;
    if (tc_slice != 0) {
        return Err(1);
    }
    let slice_ret_idx: i32 = stmt_return_expr_idx(slice_fn.stmts, slice_fn.body_start);
    let slice_ret_line: string = emit_return_add_idents_line(src, slice_fn.nodes, slice_ret_idx)?;
    let lex_empty: Vec<Expr> = vec_new(0);
    let lex_empty_stmts: Vec<Stmt> = vec_new(0);
    let lex_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, lex_empty, lex_empty_stmts)?;
    if (sh_lexer.slice_eq(src, lex_fn.name_off, lex_fn.name_len, "lex") != 1) {
        return Err(1);
    }
    if (lex_fn.body_len != 1) {
        return Err(1);
    }
    if (return_is_add_idents(lex_fn.stmts, lex_fn.body_start, lex_fn.nodes, src, "a", "b") != 1) {
        return Err(1);
    }
    let tc_lex: i32 = check_fn_returns(lex_fn, src)?;
    if (tc_lex != 0) {
        return Err(1);
    }
    let lex_ret_idx: i32 = stmt_return_expr_idx(lex_fn.stmts, lex_fn.body_start);
    let lex_ret_line: string = emit_return_add_idents_line(src, lex_fn.nodes, lex_ret_idx)?;
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, main_fn.name_off, main_fn.name_len, "main") != 1) {
        return Err(1);
    }
    if (main_fn.body_len != 2) {
        return Err(1);
    }
    if (stmt_is_let_call2(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "x", "lex", 40, 2) != 1) {
        return Err(1);
    }
    if (stmt_return_is_ident(main_fn.stmts, main_fn.body_start + 1, main_fn.nodes, src, "x") != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(main_fn, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    let call_idx: i32 = stmt_let_expr_idx(main_fn.stmts, main_fn.body_start);
    let call_arg0: i32 = call2_num_at(main_fn.nodes, call_idx, 0);
    let call_arg1: i32 = call2_num_at(main_fn.nodes, call_idx, 1);
    let callee_pfx: string = profile_callee_prefix(prof)?;
    let callee: string = emit_mangled_callee(callee_pfx, src, main_fn.nodes, call_idx)?;
    let call_line: string = emit_let_call2_line(src, main_fn.stmts, main_fn.body_start, callee, call_arg0, call_arg1)?;
    let ret_idx: i32 = stmt_return_expr_idx(main_fn.stmts, main_fn.body_start + 1);
    let ret_line: string = emit_return_ident_line(src, main_fn.nodes, ret_idx)?;
    let slice_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, slice_fn)?;
    let lex_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, lex_fn)?;
    let main_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, main_fn)?;
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let b0: StrBuilder = strbuf_new();
    let meta_slice: string = emit_meta_line("bootstrap_lexer_smoke_slice_eq", slice_fn.body_len)?;
    let b1: StrBuilder = strbuf_push(b0, meta_slice);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, slice_sig);
    let b4: StrBuilder = strbuf_push(b3, slice_ret_line);
    let b5: StrBuilder = strbuf_push(b4, "}\n\n");
    let meta_lex: string = emit_meta_line("bootstrap_lexer_smoke_lex", lex_fn.body_len)?;
    let b6: StrBuilder = strbuf_push(b5, meta_lex);
    let b7: StrBuilder = strbuf_push(b6, lex_sig);
    let b8: StrBuilder = strbuf_push(b7, lex_ret_line);
    let b9: StrBuilder = strbuf_push(b8, "}\n\n");
    let meta_main: string = emit_meta_line(prof.main_meta, main_fn.body_len)?;
    let b10: StrBuilder = strbuf_push(b9, meta_main);
    let b11: StrBuilder = strbuf_push(b10, main_sig);
    let b12: StrBuilder = strbuf_push(b11, call_line);
    let b13: StrBuilder = strbuf_push(b12, ret_line);
    let b14: StrBuilder = strbuf_push(b13, "}\n");
    // SH-C-28 provenance marker in emitted C.
    let b15: StrBuilder = strbuf_push(b14, "/* SH-C-28 - bootstrap lex-family smoke */\n");
    return Ok(strbuf_finish(b15));
}

fn emit_real_lexer_radius_vec_i32_push_helper() -> Result<string, core_Err> effects { alloc, mut } {
    // L1 stub path: len-only bump (matches std/vec outside a heap region).
    return Ok("static fx_Vec_i32 fx_vec_i32_push(fx_Vec_i32 v, int32_t x) {\n    (void)x;\n    return (fx_Vec_i32){ .data = v.data, .len = v.len + 1, .cap = v.cap };\n}\n\n");
}

fn emit_real_lexer_radius_push_tok_body() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    buf.kinds = fx_vec_i32_push(buf.kinds, kind);\n    buf.vals = fx_vec_i32_push(buf.vals, val);\n    buf.lens = fx_vec_i32_push(buf.lens, len);\n    return buf;\n");
}

fn emit_real_lexer_radius_is_space_body() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    if ((b == 32)) {\n        return 1;\n    }\n    if ((b == 9)) {\n        return 1;\n    }\n    if ((b == 10)) {\n        return 1;\n    }\n    if ((b == 13)) {\n        return 1;\n    }\n    return 0;\n");
}

fn emit_real_lexer_radius_main_body() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    int32_t s = fx_bootstrap_real_lexer_radius_is_space(32);\n    return (41 + s);\n");
}

fn stmt_is_let_call1_num(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, var: string, callee: string, lit: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(off, ln, e, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, var) != 1) {
                return 0;
            }
            return expr_is_call1_num(nodes, e, src, callee, lit);
        },
        Return(_) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

// SH-C-42 - parse+emit real-lexer radius (TokBuf + push_tok + is_space + main → exit 42).
fn parse_and_emit_bootstrap_real_lexer_radius() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_bootstrap_real_lexer_radius()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    // Consume module + import without requiring std/vec .h (radius emits local helpers).
    let _skip: i32 = skip_module_preamble(buf.kinds, buf.vals, buf.lens, &mut pos)?;
    let st_out: StructOut = parse_struct_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, st_out.name_off, st_out.name_len, "TokBuf") != 1) {
        return Err(1);
    }
    if (st_out.field_count != 3) {
        return Err(1);
    }
    let f0: string = variants_env_nth(st_out.fields_env, 0)?;
    let f1: string = variants_env_nth(st_out.fields_env, 1)?;
    let f2: string = variants_env_nth(st_out.fields_env, 2)?;
    if (sh_lexer.slice_eq(f0, 0, string.len(f0), "kinds") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(f1, 0, string.len(f1), "vals") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(f2, 0, string.len(f2), "lens") != 1) {
        return Err(1);
    }
    let ty0: string = struct_field_c_type(f0)?;
    let ty1: string = struct_field_c_type(f1)?;
    let ty2: string = struct_field_c_type(f2)?;
    if (sh_lexer.slice_eq(ty0, 0, string.len(ty0), "fx_Vec_i32") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(ty1, 0, string.len(ty1), "fx_Vec_i32") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(ty2, 0, string.len(ty2), "fx_Vec_i32") != 1) {
        return Err(1);
    }
    let push_empty: Vec<Expr> = vec_new(0);
    let push_empty_stmts: Vec<Stmt> = vec_new(0);
    let push_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, push_empty, push_empty_stmts)?;
    if (sh_lexer.slice_eq(src, push_fn.name_off, push_fn.name_len, "push_tok") != 1) {
        return Err(1);
    }
    if (push_fn.body_len != 4) {
        return Err(1);
    }
    if (stmt_is_assign(push_fn.stmts, push_fn.body_start, src, "buf.kinds") != 1) {
        return Err(1);
    }
    if (stmt_is_assign(push_fn.stmts, push_fn.body_start + 1, src, "buf.vals") != 1) {
        return Err(1);
    }
    if (stmt_is_assign(push_fn.stmts, push_fn.body_start + 2, src, "buf.lens") != 1) {
        return Err(1);
    }
    let e0: i32 = stmt_assign_expr_idx(push_fn.stmts, push_fn.body_start);
    let e1: i32 = stmt_assign_expr_idx(push_fn.stmts, push_fn.body_start + 1);
    let e2: i32 = stmt_assign_expr_idx(push_fn.stmts, push_fn.body_start + 2);
    if (expr_call_callee_is(push_fn.nodes, e0, src, "vec.push") != 1) {
        return Err(1);
    }
    if (expr_call_callee_is(push_fn.nodes, e1, src, "vec.push") != 1) {
        return Err(1);
    }
    if (expr_call_callee_is(push_fn.nodes, e2, src, "vec.push") != 1) {
        return Err(1);
    }
    if (stmt_return_is_ident(push_fn.stmts, push_fn.body_start + 3, push_fn.nodes, src, "buf") != 1) {
        return Err(1);
    }
