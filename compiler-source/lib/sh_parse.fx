    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f17)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f18)?);
