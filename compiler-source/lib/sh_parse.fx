// fx parser (inspectable compiler source).
// Recursive-descent parser and related helpers.
// Read-only snapshot for humans. Run the binary in bin/, do not rebuild from here.

module sh_parse;

using core;

import std/fx_defaults;
import std/string;
import sh_lexer;
import sh_diag;
import sh_ast;

struct ModOut {
    name_off: i32,
    name_len: i32,
}

struct ImpOut {
    path_off: i32,
    path_len: i32,
}

struct StmtStep {
    nodes: Vec<Expr>,
    stmts: Vec<Stmt>,
}

struct BlockParseOut {
    count: i32,
    nodes: Vec<Expr>,
    stmts: Vec<Stmt>,
}

struct ArgCountOut {
    argc: i32,
    first_arg: i32,
    second_arg: i32,
    third_arg: i32,
    fourth_arg: i32,
    fifth_arg: i32,
    nodes: Vec<Expr>,
}

struct ParseOut {
    idx: i32,
    nodes: Vec<Expr>,
}

struct StructLitAcc {
    count: i32,
    f0: i32,
    f1: i32,
    f2: i32,
    f3: i32,
    f4: i32,
    f5: i32,
    f6: i32,
    f7: i32,
    f8: i32,
    f9: i32,
    f10: i32,
    f11: i32,
    f12: i32,
    f13: i32,
    f14: i32,
    f15: i32,
    f16: i32,
    nodes: Vec<Expr>,
}

struct LetOut {
    name_off: i32,
    name_len: i32,
    root: i32,
    nodes: Vec<Expr>,
}

struct FnOut {
    name_off: i32,
    name_len: i32,
    ret_off: i32,
    ret_len: i32,
    ret_is_result: i32,
    ret_ok_off: i32,
    ret_ok_len: i32,
    ret_err_off: i32,
    ret_err_len: i32,
    effect_count: i32,
    param_sig: string,
    param_env: string,
    param_tok_pos: i32,
    body_start: i32,
    body_len: i32,
    nodes: Vec<Expr>,
    stmts: Vec<Stmt>,
}

struct EnumOut {
    name_off: i32,
    name_len: i32,
    variant_count: i32,
    variants_env: string,
    payloads_env: string,
}

struct StructOut {
    name_off: i32,
    name_len: i32,
    field_count: i32,
    fields_env: string,
}

struct MatchOut {
    scrutinee: i32,
    arm_count: i32,
    nodes: Vec<Expr>,
}

struct RetTypeOut {
    ret_off: i32,
    ret_len: i32,
    ret_is_result: i32,
    ret_ok_off: i32,
    ret_ok_len: i32,
    ret_err_off: i32,
    ret_err_len: i32,
}

fn parse_path_span(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32) -> Result<ImpOut, core_Err> {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    let start: i32 = vec_get(vals, *pos);
    *pos = *pos + 1;
    while (*pos < n) {
        if (vec_get(kinds, *pos) != 5) {
            break;
        }
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 30) {
            return Err(1);
        }
        *pos = *pos + 1;
    }
    let last: i32 = *pos - 1;
    let end: i32 = vec_get(vals, last) + vec_get(lens, last);
    let plen: i32 = end - start;
    return Ok(ImpOut { path_off: start, path_len: plen });
}

fn parse_module_decl(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32) -> Result<ModOut, core_Err> {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 29) {
        return Err(1);
    }
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    let name_off: i32 = vec_get(vals, *pos);
    let name_len: i32 = vec_get(lens, *pos);
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 13) {
        return Err(1);
    }
    *pos = *pos + 1;
    return Ok(ModOut { name_off: name_off, name_len: name_len });
}

fn parse_import_decl(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32) -> Result<ImpOut, core_Err> {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 32) {
        return Err(1);
    }
    *pos = *pos + 1;
    let path: ImpOut = parse_path_span(kinds, vals, lens, pos)?;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 13) {
        return Err(1);
    }
    *pos = *pos + 1;
    return Ok(path);
}

fn parse_type_ident(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32) -> Result<ImpOut, core_Err> {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    let off: i32 = vec_get(vals, *pos);
    let ln: i32 = vec_get(lens, *pos);
    *pos = *pos + 1;
    return Ok(ImpOut { path_off: off, path_len: ln });
}

fn parse_type_span_inner(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32) -> Result<ImpOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    // FX-SH-NAT-7 - `[T; N]` array type or `[T]` slice type span.
    if (vec_get(kinds, *pos) == 44) {
        let start_off: i32 = vec_get(vals, *pos);
        *pos = *pos + 1;
        let elem: ImpOut = parse_type_ident(kinds, vals, lens, pos)?;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) == 12) {
            *pos = *pos + 1;
            if (*pos >= n) {
                return Err(1);
            }
            if (vec_get(kinds, *pos) != 1) {
                return Err(1);
            }
            let len_off: i32 = vec_get(vals, *pos);
            let len_ln: i32 = vec_get(lens, *pos);
            *pos = *pos + 1;
            if (*pos >= n) {
                return Err(1);
            }
            if (vec_get(kinds, *pos) != 45) {
                return Err(1);
            }
            *pos = *pos + 1;
            let end_off: i32 = len_off + len_ln;
            let span_ln: i32 = end_off - start_off;
            return Ok(ImpOut { path_off: start_off, path_len: span_ln });
        }
        if (vec_get(kinds, *pos) != 45) {
            return Err(1);
        }
        *pos = *pos + 1;
        let end_off: i32 = elem.path_off + elem.path_len + 1;
        let span_ln: i32 = end_off - start_off;
        return Ok(ImpOut { path_off: start_off, path_len: span_ln });
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    let start_off: i32 = vec_get(vals, *pos);
    let start_ln: i32 = vec_get(lens, *pos);
    *pos = *pos + 1;
    // SH-C-72 - two-parameter `Map<K, V>` span (LV5 env maps); `Vec<T>` stays single-parameter.
    if (sh_lexer.slice_eq(src, start_off, start_ln, "Map") == 1) {
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 15) {
            return Ok(ImpOut { path_off: start_off, path_len: start_ln });
        }
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 30) {
            return Err(1);
        }
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 12) {
            return Err(1);
        }
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 30) {
            return Err(1);
        }
        let val_off: i32 = vec_get(vals, *pos);
        let val_ln: i32 = vec_get(lens, *pos);
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 16) {
            return Err(1);
        }
        *pos = *pos + 1;
        let map_span_ln: i32 = (val_off + val_ln) - start_off + 1;
        return Ok(ImpOut { path_off: start_off, path_len: map_span_ln });
    }
    if (sh_lexer.slice_eq(src, start_off, start_ln, "Vec") != 1) {
        return Ok(ImpOut { path_off: start_off, path_len: start_ln });
    }
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 15) {
        return Ok(ImpOut { path_off: start_off, path_len: start_ln });
    }
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    let inner_off: i32 = vec_get(vals, *pos);
    let inner_ln: i32 = vec_get(lens, *pos);
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 16) {
        return Err(1);
    }
    *pos = *pos + 1;
    let span_ln: i32 = (inner_off + inner_ln) - start_off + 1;
    return Ok(ImpOut { path_off: start_off, path_len: span_ln });
}

fn parse_type_span(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32) -> Result<ImpOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 14) {
        return parse_type_span_inner(kinds, vals, lens, src, pos);
    }
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, vec_get(vals, *pos), vec_get(lens, *pos), "mut") != 1) {
        return Err(1);
    }
    *pos = *pos + 1;
    let inner: ImpOut = parse_type_span_inner(kinds, vals, lens, src, pos)?;
    let span_off: i32 = inner.path_off - 5;
    let span_ln: i32 = inner.path_len + 5;
    return Ok(ImpOut { path_off: span_off, path_len: span_ln });
}

fn parse_ret_type(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32) -> Result<RetTypeOut, core_Err> {
    let n: i32 = kinds.len;
    let ret_off: i32 = 0;
    let ret_len: i32 = 0;
    let ret_is_result: i32 = 0;
    let ret_ok_off: i32 = 0;
    let ret_ok_len: i32 = 0;
    let ret_err_off: i32 = 0;
    let ret_err_len: i32 = 0;
    if (*pos + 1 < n) {
        if (vec_get(kinds, *pos) == 3) {
            if (vec_get(kinds, *pos + 1) == 16) {
                *pos = *pos + 2;
                if (*pos >= n) {
                    return Err(1);
                }
                if (vec_get(kinds, *pos) != 30) {
                    return Err(1);
                }
                let ty_off: i32 = vec_get(vals, *pos);
                let ty_len: i32 = vec_get(lens, *pos);
                if (sh_lexer.slice_eq(src, ty_off, ty_len, "Result") == 1) {
                    *pos = *pos + 1;
                    if (*pos >= n) {
                        return Err(1);
                    }
                    if (vec_get(kinds, *pos) != 15) {
                        return Err(1);
                    }
                    *pos = *pos + 1;
                    let ok_ty: ImpOut = parse_type_ident(kinds, vals, lens, pos)?;
                    if (*pos >= n) {
                        return Err(1);
                    }
                    if (vec_get(kinds, *pos) != 12) {
                        return Err(1);
                    }
                    *pos = *pos + 1;
                    let err_ty: ImpOut = parse_type_ident(kinds, vals, lens, pos)?;
                    if (*pos >= n) {
                        return Err(1);
                    }
                    if (vec_get(kinds, *pos) != 16) {
                        return Err(1);
                    }
                    *pos = *pos + 1;
                    ret_is_result = 1;
                    ret_ok_off = ok_ty.path_off;
                    ret_ok_len = ok_ty.path_len;
                    ret_err_off = err_ty.path_off;
                    ret_err_len = err_ty.path_len;
                } else {
                    ret_off = ty_off;
                    ret_len = ty_len;
                    *pos = *pos + 1;
                }
            }
        }
    }
    return Ok(RetTypeOut {
        ret_off: ret_off,
        ret_len: ret_len,
        ret_is_result: ret_is_result,
        ret_ok_off: ret_ok_off,
        ret_ok_len: ret_ok_len,
        ret_err_off: ret_err_off,
        ret_err_len: ret_err_len,
    });
}

fn parse_effects_clause(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32) -> Result<i32, core_Err> {
    let _n: i32 = vals.len;
    let _m: i32 = lens.len;
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Ok(0);
    }
    if (vec_get(kinds, *pos) != 28) {
        return Ok(0);
    }
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 8) {
        return Err(1);
    }
    *pos = *pos + 1;
    let count: i32 = 0;
    while (*pos < n) {
        if (vec_get(kinds, *pos) == 9) {
            *pos = *pos + 1;
            return Ok(count);
        }
        if (vec_get(kinds, *pos) != 30) {
            return Err(1);
        }
        *pos = *pos + 1;
        count = count + 1;
        if (*pos < n) {
            if (vec_get(kinds, *pos) == 12) {
                *pos = *pos + 1;
            }
        }
    }
    return Err(1);
}

// CONV-2-g.5 / MAP/G9 - closed C keyword set via Map<string, i32> (LV5), not linear slice_eq chain.
fn c_keyword_map() -> Map<string, i32> effects { alloc, mut } {
    let m: Map<string, i32> = map_new();
    m = map_insert(m, "auto", 1);
    m = map_insert(m, "break", 1);
    m = map_insert(m, "case", 1);
    m = map_insert(m, "char", 1);
    m = map_insert(m, "const", 1);
    m = map_insert(m, "continue", 1);
    m = map_insert(m, "default", 1);
    m = map_insert(m, "do", 1);
    m = map_insert(m, "double", 1);
    m = map_insert(m, "else", 1);
    m = map_insert(m, "enum", 1);
    m = map_insert(m, "extern", 1);
    m = map_insert(m, "float", 1);
    m = map_insert(m, "for", 1);
    m = map_insert(m, "goto", 1);
    m = map_insert(m, "if", 1);
    m = map_insert(m, "inline", 1);
    m = map_insert(m, "int", 1);
    m = map_insert(m, "long", 1);
    m = map_insert(m, "register", 1);
    m = map_insert(m, "return", 1);
    m = map_insert(m, "short", 1);
    m = map_insert(m, "signed", 1);
    m = map_insert(m, "sizeof", 1);
    m = map_insert(m, "static", 1);
    m = map_insert(m, "struct", 1);
    m = map_insert(m, "switch", 1);
    m = map_insert(m, "typedef", 1);
    m = map_insert(m, "union", 1);
    m = map_insert(m, "unsigned", 1);
    m = map_insert(m, "void", 1);
    m = map_insert(m, "volatile", 1);
    m = map_insert(m, "while", 1);
    return m;
}

fn is_c_keyword_word(word: string) -> i32 effects { alloc, mut } {
    let n: i32 = string.len(word);
    if (n < 1) {
        return 0;
    }
    let m: Map<string, i32> = c_keyword_map();
    if (map_contains(m, word)) {
        return 1;
    }
    return 0;
}

fn variant_union_field_name(vname: string) -> Result<string, core_Err> effects { alloc, mut } {
    if (sh_lexer.slice_eq(vname, 0, 3, "Num") == 1) {
        return Ok("num");
    }
    let n: i32 = string.len(vname);
    if (n < 1) {
        return Err(1);
    }
    if (n == 1) {
        let one: string = sh_lexer.slice_str(vname, 0, 1)?;
        if (is_c_keyword_word(one) == 1) {
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, one);
            let b2: StrBuilder = strbuf_push(b1, "_");
            return Ok(strbuf_finish(b2));
        }
        return Ok(one);
    }
    let b0: i32 = string.byte_at(vname, 0);
    let lb: i32 = sh_lexer.lower_byte(b0);
    let head: string = sh_lexer.ident_char_str(lb);
    let tail: string = sh_lexer.slice_str(vname, 1, n - 1)?;
    let f0: StrBuilder = strbuf_new();
    let f1: StrBuilder = strbuf_push(f0, head);
    let field: string = strbuf_finish(strbuf_push(f1, tail));
    if (is_c_keyword_word(field) == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, field);
        let b2: StrBuilder = strbuf_push(b1, "_");
        return Ok(strbuf_finish(b2));
    }
    return Ok(field);
}

fn enum_payload_field_name(vname: string) -> Result<string, core_Err> effects { alloc, mut } {
    return variant_union_field_name(vname);
}

fn parse_enum_variant_payload_spec(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32, vname: string) -> Result<string, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 6) {
        return Ok("");
    }
    *pos = *pos + 1;
    let ty0: ImpOut = parse_type_ident(kinds, vals, lens, pos)?;
    let ty0_c: string = map_type_span_to_c(src, ty0.path_off, ty0.path_len)?;
    let union_name: string = variant_union_field_name(vname)?;
    let ty_count: i32 = 1;
    let ty_buf: StrBuilder = strbuf_new();
    let ty_acc: StrBuilder = strbuf_push(ty_buf, ty0_c);
    while (*pos < n) {
        if (vec_get(kinds, *pos) == 12) {
            *pos = *pos + 1;
            if (*pos >= n) {
                return Err(1);
            }
            let ty_n: ImpOut = parse_type_ident(kinds, vals, lens, pos)?;
            let ty_n_c: string = map_type_span_to_c(src, ty_n.path_off, ty_n.path_len)?;
            ty_acc = strbuf_push(ty_acc, ",");
            ty_acc = strbuf_push(ty_acc, ty_n_c);
            ty_count = ty_count + 1;
            continue;
        }
        if (vec_get(kinds, *pos) == 7) {
            break;
        }
        return Err(1);
    }
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 7) {
        return Err(1);
    }
    *pos = *pos + 1;
    let ty_str: string = strbuf_finish(ty_acc);
    if (ty_count == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, ty_str);
        let b2: StrBuilder = strbuf_push(b1, ":");
        let b3: StrBuilder = strbuf_push(b2, union_name);
        return Ok(strbuf_finish(b3));
    }
    let cnt: string = str_from_i32(ty_count)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "M");
    let b2: StrBuilder = strbuf_push(b1, cnt);
    let b3: StrBuilder = strbuf_push(b2, ":");
    let b4: StrBuilder = strbuf_push(b3, ty_str);
    let b5: StrBuilder = strbuf_push(b4, ":");
    let b6: StrBuilder = strbuf_push(b5, union_name);
    return Ok(strbuf_finish(b6));
}

fn parse_enum_variants_rest(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32, name: ImpOut, var_buf: StrBuilder, payload_buf: StrBuilder, variant_count: i32) -> Result<EnumOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) == 9) {
        *pos = *pos + 1;
        let variants_acc: string = strbuf_finish(var_buf);
        let payloads_acc: string = strbuf_finish(payload_buf);
        return Ok(EnumOut {
            name_off: name.path_off,
            name_len: name.path_len,
            variant_count: variant_count,
            variants_env: variants_acc,
            payloads_env: payloads_acc,
        });
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    let v_off: i32 = vec_get(vals, *pos);
    let v_len: i32 = vec_get(lens, *pos);
    *pos = *pos + 1;
    let vname: string = sh_lexer.slice_str(src, v_off, v_len)?;
    let pushed: StrBuilder = strbuf_push(var_buf, vname);
    let pushed2: StrBuilder = strbuf_push(pushed, "|");
    let pspec: string = parse_enum_variant_payload_spec(kinds, vals, lens, src, pos, vname)?;
    let payload_next: StrBuilder = payload_buf;
    if (string.len(pspec) != 0) {
        payload_next = strbuf_push(payload_buf, pspec);
    }
    let payload_sep: StrBuilder = strbuf_push(payload_next, "|");
    if (*pos < n) {
        if (vec_get(kinds, *pos) == 12) {
            *pos = *pos + 1;
        }
    }
    return parse_enum_variants_rest(kinds, vals, lens, src, pos, name, pushed2, payload_sep, variant_count + 1);
}

fn parse_enum_def(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32) -> Result<EnumOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 33) {
        return Err(1);
    }
    *pos = *pos + 1;
    let name: ImpOut = parse_type_ident(kinds, vals, lens, pos)?;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 8) {
        return Err(1);
    }
    *pos = *pos + 1;
    let empty_buf: StrBuilder = strbuf_new();
    let empty_payload: StrBuilder = strbuf_new();
    return parse_enum_variants_rest(kinds, vals, lens, src, pos, name, empty_buf, empty_payload, 0);
}

fn parse_struct_fields_rest(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32, buf: StrBuilder, field_count: i32) -> Result<StructOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) == 9) {
        *pos = *pos + 1;
        return Ok(StructOut {
            name_off: 0,
            name_len: 0,
            field_count: field_count,
            fields_env: strbuf_finish(buf),
        });
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    let fld_off: i32 = vec_get(vals, *pos);
    let fld_ln: i32 = vec_get(lens, *pos);
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 11) {
        return Err(1);
    }
    *pos = *pos + 1;
    let _ty: ImpOut = parse_type_span(kinds, vals, lens, src, pos)?;
    let fname: string = sh_lexer.slice_str(src, fld_off, fld_ln)?;
    let pushed: StrBuilder = strbuf_push(buf, fname);
    let pushed2: StrBuilder = strbuf_push(pushed, "|");
    if (*pos < n) {
        if (vec_get(kinds, *pos) == 12) {
            *pos = *pos + 1;
        }
    }
    return parse_struct_fields_rest(kinds, vals, lens, src, pos, pushed2, field_count + 1);
}

fn parse_struct_def(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32) -> Result<StructOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 34) {
        return Err(1);
    }
    *pos = *pos + 1;
    let name: ImpOut = parse_type_ident(kinds, vals, lens, pos)?;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 8) {
        return Err(1);
    }
    *pos = *pos + 1;
    let empty_buf: StrBuilder = strbuf_new();
    let rest: StructOut = parse_struct_fields_rest(kinds, vals, lens, src, pos, empty_buf, 0)?;
    return Ok(StructOut {
        name_off: name.path_off,
        name_len: name.path_len,
        field_count: rest.field_count,
        fields_env: rest.fields_env,
    });
}

fn parse_match_arm_body(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, nodes: Vec<Expr>) -> Result<ParseOut, core_Err> effects { alloc, mut } {
    if (lens.len < 0) {
        return Err(1);
    }
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    *pos = *pos + 1;
    if (*pos < n) {
        if (vec_get(kinds, *pos) == 6) {
            *pos = *pos + 1;
            while (*pos < n) {
                if (vec_get(kinds, *pos) == 7) {
                    break;
                }
                if (vec_get(kinds, *pos) != 30) {
                    return Err(1);
                }
                *pos = *pos + 1;
                if (*pos < n) {
                    if (vec_get(kinds, *pos) == 12) {
                        *pos = *pos + 1;
                    }
                }
            }
            if (*pos >= n) {
                return Err(1);
            }
            if (vec_get(kinds, *pos) != 7) {
                return Err(1);
            }
            *pos = *pos + 1;
        }
    }
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 36) {
        return Err(1);
    }
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 1) {
        return parse_expr(kinds, vals, lens, pos, nodes);
    }
    let v: i32 = vec_get(vals, *pos);
    *pos = *pos + 1;
    let idx: i32 = nodes.len;
    let nodes2: Vec<Expr> = vec_push(nodes, Num(v));
    return Ok(ParseOut { idx: idx, nodes: nodes2 });
}

// SH-C-13 / CONV-2-g.16 - match arm bodies as Num(body_idx) slots (not base-100 pack;
// pack overflowed at ≥7 arms / body_idx≥100).
fn unpack_match_body(nodes: Vec<Expr>, bodies_start: i32, arm_i: i32, arm_count: i32) -> i32 {
    if (arm_i < 0) {
        return -1;
    }
    if (arm_i >= arm_count) {
        return -1;
    }
    let slot: Expr = vec_get(nodes, bodies_start + arm_i);
    return match slot {
        Num(b) => b,
        StrLit(_, _) => -1,
        Ident(_, _) => -1,
        Add(_, _) => -1,
        Sub(_, _) => -1,
        Mul(_, _) => -1,
        Div(_, _) => -1,
        CmpLt(_, _) => -1,
        CmpNe(_, _) => -1,
        CmpEq(_, _) => -1,
        CmpGe(_, _) => -1,
        Deref(_) => -1,
        Match(_, _, _) => -1,
        CallExpr(_, _, _, _, _, _, _) => -1,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => -1,
        TryExpr(_) => -1,
        Index(_, _) => -1,
        SliceRange(_, _, _) => -1,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn parse_match_arms_rest(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, scr_idx: i32, nodes: Vec<Expr>, bodies: Vec<i32>, arm_count: i32) -> Result<ParseOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) == 9) {
        *pos = *pos + 1;
        let bodies_start: i32 = nodes.len;
        let nodes2: Vec<Expr> = nodes;
        let i: i32 = 0;
        while (i < arm_count) {
            let bidx: i32 = vec_get(bodies, i);
            nodes2 = vec_push(nodes2, Num(bidx));
            i = i + 1;
        }
        let idx: i32 = nodes2.len;
        let nodes3: Vec<Expr> = vec_push(nodes2, Match(scr_idx, arm_count, bodies_start));
        return Ok(ParseOut { idx: idx, nodes: nodes3 });
    }
    let body: ParseOut = parse_match_arm_body(kinds, vals, lens, pos, nodes)?;
    let bodies2: Vec<i32> = vec_push(bodies, body.idx);
    if (*pos < n) {
        if (vec_get(kinds, *pos) == 12) {
            *pos = *pos + 1;
        }
    }
    return parse_match_arms_rest(kinds, vals, lens, pos, scr_idx, body.nodes, bodies2, arm_count + 1);
}

fn parse_match_expr(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, nodes: Vec<Expr>) -> Result<ParseOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 35) {
        return Err(1);
    }
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    let off: i32 = vec_get(vals, *pos);
    let ln: i32 = vec_get(lens, *pos);
    *pos = *pos + 1;
    let scr_idx: i32 = nodes.len;
    let scr_nodes: Vec<Expr> = vec_push(nodes, Ident(off, ln));
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 8) {
        return Err(1);
    }
    *pos = *pos + 1;
    let bodies0: Vec<i32> = vec_new(0);
    return parse_match_arms_rest(kinds, vals, lens, pos, scr_idx, scr_nodes, bodies0, 0);
}

fn parse_struct_lit_field(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, nodes: Vec<Expr>) -> Result<ParseOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos < n) {
        if (vec_get(kinds, *pos) == 12) {
            *pos = *pos + 1;
        }
    }
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 11) {
        return Err(1);
    }
    *pos = *pos + 1;
    return parse_expr(kinds, vals, lens, pos, nodes);
}

fn struct_lit_acc_init_first(idx: i32, nodes: Vec<Expr>) -> StructLitAcc {
    return StructLitAcc { count: 1, f0: idx, f1: -1, f2: -1, f3: -1, f4: -1, f5: -1, f6: -1, f7: -1, f8: -1, f9: -1, f10: -1, f11: -1, f12: -1, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes };
}

fn struct_lit_acc_push(acc: StructLitAcc, idx: i32, nodes: Vec<Expr>) -> Result<StructLitAcc, core_Err> {
    let c: i32 = acc.count + 1;
    if (c == 2) {
        return Ok(StructLitAcc { count: 2, f0: acc.f0, f1: idx, f2: -1, f3: -1, f4: -1, f5: -1, f6: -1, f7: -1, f8: -1, f9: -1, f10: -1, f11: -1, f12: -1, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 3) {
        return Ok(StructLitAcc { count: 3, f0: acc.f0, f1: acc.f1, f2: idx, f3: -1, f4: -1, f5: -1, f6: -1, f7: -1, f8: -1, f9: -1, f10: -1, f11: -1, f12: -1, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 4) {
        return Ok(StructLitAcc { count: 4, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: idx, f4: -1, f5: -1, f6: -1, f7: -1, f8: -1, f9: -1, f10: -1, f11: -1, f12: -1, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 5) {
        return Ok(StructLitAcc { count: 5, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: idx, f5: -1, f6: -1, f7: -1, f8: -1, f9: -1, f10: -1, f11: -1, f12: -1, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 6) {
        return Ok(StructLitAcc { count: 6, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: idx, f6: -1, f7: -1, f8: -1, f9: -1, f10: -1, f11: -1, f12: -1, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 7) {
        return Ok(StructLitAcc { count: 7, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: idx, f7: -1, f8: -1, f9: -1, f10: -1, f11: -1, f12: -1, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 8) {
        return Ok(StructLitAcc { count: 8, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: acc.f6, f7: idx, f8: -1, f9: -1, f10: -1, f11: -1, f12: -1, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 9) {
        return Ok(StructLitAcc { count: 9, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: acc.f6, f7: acc.f7, f8: idx, f9: -1, f10: -1, f11: -1, f12: -1, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 10) {
        return Ok(StructLitAcc { count: 10, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: acc.f6, f7: acc.f7, f8: acc.f8, f9: idx, f10: -1, f11: -1, f12: -1, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 11) {
        return Ok(StructLitAcc { count: 11, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: acc.f6, f7: acc.f7, f8: acc.f8, f9: acc.f9, f10: idx, f11: -1, f12: -1, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 12) {
        return Ok(StructLitAcc { count: 12, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: acc.f6, f7: acc.f7, f8: acc.f8, f9: acc.f9, f10: acc.f10, f11: idx, f12: -1, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 13) {
        return Ok(StructLitAcc { count: 13, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: acc.f6, f7: acc.f7, f8: acc.f8, f9: acc.f9, f10: acc.f10, f11: acc.f11, f12: idx, f13: -1, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 14) {
        return Ok(StructLitAcc { count: 14, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: acc.f6, f7: acc.f7, f8: acc.f8, f9: acc.f9, f10: acc.f10, f11: acc.f11, f12: acc.f12, f13: idx, f14: -1, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 15) {
        return Ok(StructLitAcc { count: 15, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: acc.f6, f7: acc.f7, f8: acc.f8, f9: acc.f9, f10: acc.f10, f11: acc.f11, f12: acc.f12, f13: acc.f13, f14: idx, f15: -1, f16: -1, nodes: nodes });
    }
    if (c == 16) {
        return Ok(StructLitAcc { count: 16, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: acc.f6, f7: acc.f7, f8: acc.f8, f9: acc.f9, f10: acc.f10, f11: acc.f11, f12: acc.f12, f13: acc.f13, f14: acc.f14, f15: idx, f16: -1, nodes: nodes });
    }
    if (c == 17) {
        return Ok(StructLitAcc { count: 17, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: acc.f6, f7: acc.f7, f8: acc.f8, f9: acc.f9, f10: acc.f10, f11: acc.f11, f12: acc.f12, f13: acc.f13, f14: acc.f14, f15: acc.f15, f16: idx, nodes: nodes });
    }
    return Err(1);
}

fn parse_struct_lit_fields_rest(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, acc: StructLitAcc) -> Result<StructLitAcc, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos < n) {
        if (vec_get(kinds, *pos) == 12) {
            *pos = *pos + 1;
            if (*pos < n) {
                if (vec_get(kinds, *pos) == 9) {
                    return Ok(acc);
                }
            }
            if (acc.count >= 17) {
                return Err(1);
            }
            let fi: ParseOut = parse_struct_lit_field(kinds, vals, lens, pos, acc.nodes)?;
            let acc2: StructLitAcc = struct_lit_acc_push(acc, fi.idx, fi.nodes)?;
            return parse_struct_lit_fields_rest(kinds, vals, lens, pos, acc2);
        }
    }
    return Ok(acc);
}

// FX-SH-NAT-7 - array literal `[e0, e1, …]` accumulator (max 8 elems).
struct ArrayLitAcc {
    count: i32,
    f0: i32,
    f1: i32,
    f2: i32,
    f3: i32,
    f4: i32,
    f5: i32,
    f6: i32,
    f7: i32,
    nodes: Vec<Expr>,
}

fn array_lit_acc_init_first(idx: i32, nodes: Vec<Expr>) -> ArrayLitAcc {
    return ArrayLitAcc { count: 1, f0: idx, f1: -1, f2: -1, f3: -1, f4: -1, f5: -1, f6: -1, f7: -1, nodes: nodes };
}

fn array_lit_acc_push(acc: ArrayLitAcc, idx: i32, nodes: Vec<Expr>) -> Result<ArrayLitAcc, core_Err> {
    let c: i32 = acc.count + 1;
    if (c == 2) {
        return Ok(ArrayLitAcc { count: 2, f0: acc.f0, f1: idx, f2: -1, f3: -1, f4: -1, f5: -1, f6: -1, f7: -1, nodes: nodes });
    }
    if (c == 3) {
        return Ok(ArrayLitAcc { count: 3, f0: acc.f0, f1: acc.f1, f2: idx, f3: -1, f4: -1, f5: -1, f6: -1, f7: -1, nodes: nodes });
    }
    if (c == 4) {
        return Ok(ArrayLitAcc { count: 4, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: idx, f4: -1, f5: -1, f6: -1, f7: -1, nodes: nodes });
    }
    if (c == 5) {
        return Ok(ArrayLitAcc { count: 5, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: idx, f5: -1, f6: -1, f7: -1, nodes: nodes });
    }
    if (c == 6) {
        return Ok(ArrayLitAcc { count: 6, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: idx, f6: -1, f7: -1, nodes: nodes });
    }
    if (c == 7) {
        return Ok(ArrayLitAcc { count: 7, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: idx, f7: -1, nodes: nodes });
    }
    if (c == 8) {
        return Ok(ArrayLitAcc { count: 8, f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: acc.f6, f7: idx, nodes: nodes });
    }
    return Err(1);
}

fn parse_array_lit_elems_rest(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, acc: ArrayLitAcc) -> Result<ArrayLitAcc, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) == 12) {
        *pos = *pos + 1;
        let fi: ParseOut = parse_expr(kinds, vals, lens, pos, acc.nodes)?;
        let acc2: ArrayLitAcc = array_lit_acc_push(acc, fi.idx, fi.nodes)?;
        return parse_array_lit_elems_rest(kinds, vals, lens, pos, acc2);
    }
    return Ok(acc);
}

fn parse_factor(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, nodes: Vec<Expr>) -> Result<ParseOut, core_Err> effects { alloc, mut } {
    let primary: ParseOut = parse_factor_atom(kinds, vals, lens, pos, nodes)?;
    return apply_index_postfix(kinds, vals, lens, pos, primary);
}

// FX-SH-NAT-3/4 - postfix `base[index]` or `base[lo..hi]` (DotDot kind 46).
fn apply_index_postfix(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, primary: ParseOut) -> Result<ParseOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    let cur_idx: i32 = primary.idx;
    let cur_nodes: Vec<Expr> = primary.nodes;
    if (*pos >= n) {
        return Ok(ParseOut { idx: cur_idx, nodes: cur_nodes });
    }
    if (vec_get(kinds, *pos) != 44) {
        return Ok(ParseOut { idx: cur_idx, nodes: cur_nodes });
    }
    *pos = *pos + 1;
    let first: ParseOut = parse_expr(kinds, vals, lens, pos, cur_nodes)?;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) == 46) {
        *pos = *pos + 1;
        let hi: ParseOut = parse_expr(kinds, vals, lens, pos, first.nodes)?;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 45) {
            return Err(1);
        }
        *pos = *pos + 1;
        let new_idx: i32 = hi.nodes.len;
        let nodes2: Vec<Expr> = vec_push(hi.nodes, SliceRange(cur_idx, first.idx, hi.idx));
        return apply_index_postfix(kinds, vals, lens, pos, ParseOut { idx: new_idx, nodes: nodes2 });
    }
    if (vec_get(kinds, *pos) != 45) {
        return Err(1);
    }
    *pos = *pos + 1;
    let new_idx: i32 = first.nodes.len;
    let nodes2: Vec<Expr> = vec_push(first.nodes, Index(cur_idx, first.idx));
    return apply_index_postfix(kinds, vals, lens, pos, ParseOut { idx: new_idx, nodes: nodes2 });
}

fn parse_factor_atom(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, nodes: Vec<Expr>) -> Result<ParseOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    let k: i32 = vec_get(kinds, *pos);
    if (k == 35) {
        return parse_match_expr(kinds, vals, lens, pos, nodes);
    }
    if (k == 4) {
        *pos = *pos + 1;
        let inner: ParseOut = parse_factor(kinds, vals, lens, pos, nodes)?;
        let idx: i32 = inner.nodes.len;
        let nodes3: Vec<Expr> = vec_push(inner.nodes, Deref(inner.idx));
        return Ok(ParseOut { idx: idx, nodes: nodes3 });
    }
    if (k == 14) {
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 30) {
            return Err(1);
        }
        let mut_off: i32 = vec_get(vals, *pos);
        let mut_ln: i32 = vec_get(lens, *pos);
        if (mut_ln != 3) {
            return Err(1);
        }
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 30) {
            return Err(1);
        }
        let name_off: i32 = vec_get(vals, *pos);
        let name_ln: i32 = vec_get(lens, *pos);
        *pos = *pos + 1;
        let start: i32 = mut_off - 1;
        let span_ln: i32 = (name_off + name_ln) - start;
        let idx: i32 = nodes.len;
        let nodes2: Vec<Expr> = vec_push(nodes, Ident(start, span_ln));
        return Ok(ParseOut { idx: idx, nodes: nodes2 });
    }
    if (k == 6) {
        *pos = *pos + 1;
        let inner: ParseOut = parse_expr(kinds, vals, lens, pos, nodes)?;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 7) {
            return Err(1);
        }
        *pos = *pos + 1;
        return Ok(ParseOut { idx: inner.idx, nodes: inner.nodes });
    }
    if (k == 37) {
        let off: i32 = vec_get(vals, *pos);
        let ln: i32 = vec_get(lens, *pos);
        *pos = *pos + 1;
        let idx: i32 = nodes.len;
        let nodes2: Vec<Expr> = vec_push(nodes, StrLit(off, ln));
        return Ok(ParseOut { idx: idx, nodes: nodes2 });
    }
    // CONV-3-r.23 - char lit (kind 41) lowers to Num(byte).
    if (k == 41) {
        let v: i32 = vec_get(vals, *pos);
        *pos = *pos + 1;
        let idx: i32 = nodes.len;
        let nodes2: Vec<Expr> = vec_push(nodes, Num(v));
        return Ok(ParseOut { idx: idx, nodes: nodes2 });
    }
    // FX-SH-NAT-7 - array literal `[e0, e1, …]`.
    if (k == 44) {
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) == 45) {
            *pos = *pos + 1;
            let idx: i32 = nodes.len;
            let nodes2: Vec<Expr> = vec_push(nodes, ArrayLit(0, -1, -1, -1, -1, -1, -1, -1, -1));
            return Ok(ParseOut { idx: idx, nodes: nodes2 });
        }
        let first: ParseOut = parse_expr(kinds, vals, lens, pos, nodes)?;
        let acc0: ArrayLitAcc = array_lit_acc_init_first(first.idx, first.nodes);
        let acc: ArrayLitAcc = parse_array_lit_elems_rest(kinds, vals, lens, pos, acc0)?;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 45) {
            return Err(1);
        }
        *pos = *pos + 1;
        let idx: i32 = acc.nodes.len;
        let nodes3: Vec<Expr> = vec_push(acc.nodes, ArrayLit(acc.count, acc.f0, acc.f1, acc.f2, acc.f3, acc.f4, acc.f5, acc.f6, acc.f7));
        return Ok(ParseOut { idx: idx, nodes: nodes3 });
    }
    if (k == 1) {
        let v: i32 = vec_get(vals, *pos);
        *pos = *pos + 1;
        let idx: i32 = nodes.len;
        let nodes2: Vec<Expr> = vec_push(nodes, Num(v));
        return Ok(ParseOut { idx: idx, nodes: nodes2 });
    }
    if (k == 30) {
        let off: i32 = vec_get(vals, *pos);
        let ln: i32 = vec_get(lens, *pos);
        *pos = *pos + 1;
        if (*pos < n) {
            if (vec_get(kinds, *pos) == 8) {
                *pos = *pos + 1;
                let f0: ParseOut = parse_struct_lit_field(kinds, vals, lens, pos, nodes)?;
                let acc0: StructLitAcc = struct_lit_acc_init_first(f0.idx, f0.nodes);
                let acc: StructLitAcc = parse_struct_lit_fields_rest(kinds, vals, lens, pos, acc0)?;
                if (*pos >= n) {
                    return Err(1);
                }
                if (vec_get(kinds, *pos) != 9) {
                    return Err(1);
                }
                *pos = *pos + 1;
                let idx: i32 = acc.nodes.len;
                let nodes3: Vec<Expr> = vec_push(acc.nodes, StructLit(off, ln, acc.count, acc.f0, acc.f1, acc.f2, acc.f3, acc.f4, acc.f5, acc.f6, acc.f7, acc.f8, acc.f9, acc.f10, acc.f11, acc.f12, acc.f13, acc.f14, acc.f15, acc.f16));
                return Ok(ParseOut { idx: idx, nodes: nodes3 });
            }
            if (vec_get(kinds, *pos) == 6) {
                *pos = *pos + 1;
                let args: ArgCountOut = parse_arg_count(kinds, vals, lens, pos, nodes)?;
                let call_idx: i32 = args.nodes.len;
                let nodes3: Vec<Expr> = vec_push(args.nodes, CallExpr(off, ln, args.first_arg, args.second_arg, args.third_arg, args.fourth_arg, args.fifth_arg));
                if (*pos < n) {
                    if (vec_get(kinds, *pos) == 17) {
                        *pos = *pos + 1;
                        let try_idx: i32 = nodes3.len;
                        let nodes4: Vec<Expr> = vec_push(nodes3, TryExpr(call_idx));
                        return Ok(ParseOut { idx: try_idx, nodes: nodes4 });
                    }
                }
                return Ok(ParseOut { idx: call_idx, nodes: nodes3 });
            }
        }
        let idx: i32 = nodes.len;
        let nodes2: Vec<Expr> = vec_push(nodes, Ident(off, ln));
        return Ok(ParseOut { idx: idx, nodes: nodes2 });
    }
    return Err(1);
}

fn parse_term_tail(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, acc_idx: i32, acc_nodes: Vec<Expr>) -> Result<ParseOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Ok(ParseOut { idx: acc_idx, nodes: acc_nodes });
    }
    let k: i32 = vec_get(kinds, *pos);
    if (k != 4) {
        if (k != 5) {
            return Ok(ParseOut { idx: acc_idx, nodes: acc_nodes });
        }
    }
    *pos = *pos + 1;
    let rhs: ParseOut = parse_factor(kinds, vals, lens, pos, acc_nodes)?;
    let nodes2: Vec<Expr> = rhs.nodes;
    let new_idx: i32 = nodes2.len;
    if (k == 4) {
        let nodes3: Vec<Expr> = vec_push(nodes2, Mul(acc_idx, rhs.idx));
        return parse_term_tail(kinds, vals, lens, pos, new_idx, nodes3);
    }
    let nodes3: Vec<Expr> = vec_push(nodes2, Div(acc_idx, rhs.idx));
    return parse_term_tail(kinds, vals, lens, pos, new_idx, nodes3);
}

fn parse_term(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, nodes: Vec<Expr>) -> Result<ParseOut, core_Err> effects { alloc, mut } {
    let left: ParseOut = parse_factor(kinds, vals, lens, pos, nodes)?;
    return parse_term_tail(kinds, vals, lens, pos, left.idx, left.nodes);
}

fn parse_expr_tail(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, acc_idx: i32, acc_nodes: Vec<Expr>) -> Result<ParseOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Ok(ParseOut { idx: acc_idx, nodes: acc_nodes });
    }
    let k: i32 = vec_get(kinds, *pos);
    if (k != 2) {
        if (k != 3) {
            return Ok(ParseOut { idx: acc_idx, nodes: acc_nodes });
        }
    }
    *pos = *pos + 1;
    let rhs: ParseOut = parse_term(kinds, vals, lens, pos, acc_nodes)?;
    let nodes2: Vec<Expr> = rhs.nodes;
    let new_idx: i32 = nodes2.len;
    if (k == 2) {
        let nodes3: Vec<Expr> = vec_push(nodes2, Add(acc_idx, rhs.idx));
        return parse_expr_tail(kinds, vals, lens, pos, new_idx, nodes3);
    }
    let nodes3: Vec<Expr> = vec_push(nodes2, Sub(acc_idx, rhs.idx));
    return parse_expr_tail(kinds, vals, lens, pos, new_idx, nodes3);
}

fn parse_expr(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, nodes: Vec<Expr>) -> Result<ParseOut, core_Err> effects { alloc, mut } {
    let left: ParseOut = parse_term(kinds, vals, lens, pos, nodes)?;
    return parse_expr_tail(kinds, vals, lens, pos, left.idx, left.nodes);
}

fn parse_cond(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, nodes: Vec<Expr>) -> Result<ParseOut, core_Err> effects { alloc, mut } {
    let left: ParseOut = parse_expr(kinds, vals, lens, pos, nodes)?;
    let n: i32 = kinds.len;
    if (*pos < n) {
        let k: i32 = vec_get(kinds, *pos);
        if (k == 15) {
            *pos = *pos + 1;
            let right: ParseOut = parse_expr(kinds, vals, lens, pos, left.nodes)?;
            let idx: i32 = right.nodes.len;
            let nodes2: Vec<Expr> = vec_push(right.nodes, CmpLt(left.idx, right.idx));
            return Ok(ParseOut { idx: idx, nodes: nodes2 });
        }
        if (k == 38) {
            *pos = *pos + 1;
            let right: ParseOut = parse_expr(kinds, vals, lens, pos, left.nodes)?;
            let idx: i32 = right.nodes.len;
            let nodes2: Vec<Expr> = vec_push(right.nodes, CmpNe(left.idx, right.idx));
            return Ok(ParseOut { idx: idx, nodes: nodes2 });
        }
        if (k == 40) {
            *pos = *pos + 1;
            let right: ParseOut = parse_expr(kinds, vals, lens, pos, left.nodes)?;
            let idx: i32 = right.nodes.len;
            let nodes2: Vec<Expr> = vec_push(right.nodes, CmpEq(left.idx, right.idx));
            return Ok(ParseOut { idx: idx, nodes: nodes2 });
        }
        if (k == 39) {
            *pos = *pos + 1;
            let right: ParseOut = parse_expr(kinds, vals, lens, pos, left.nodes)?;
            let idx: i32 = right.nodes.len;
            let nodes2: Vec<Expr> = vec_push(right.nodes, CmpGe(left.idx, right.idx));
            return Ok(ParseOut { idx: idx, nodes: nodes2 });
        }
        // SH-C-43 - `a > b` lowers to `b < a` (kind 16 bare `>`).
        if (k == 16) {
            *pos = *pos + 1;
            let right: ParseOut = parse_expr(kinds, vals, lens, pos, left.nodes)?;
            let idx: i32 = right.nodes.len;
            let nodes2: Vec<Expr> = vec_push(right.nodes, CmpLt(right.idx, left.idx));
            return Ok(ParseOut { idx: idx, nodes: nodes2 });
        }
        // CONV-3-r.25 - `a <= b` lowers to `b >= a` for bootstrap CmpGe emit (kind 43).
        if (k == 43) {
            *pos = *pos + 1;
            let right: ParseOut = parse_expr(kinds, vals, lens, pos, left.nodes)?;
            let idx: i32 = right.nodes.len;
            let nodes2: Vec<Expr> = vec_push(right.nodes, CmpGe(right.idx, left.idx));
            return Ok(ParseOut { idx: idx, nodes: nodes2 });
        }
    }
    return Ok(ParseOut { idx: left.idx, nodes: left.nodes });
}

fn parse_arg_count(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32, nodes: Vec<Expr>) -> Result<ArgCountOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) == 7) {
        *pos = *pos + 1;
        return Ok(ArgCountOut { argc: 0, first_arg: -1, second_arg: -1, third_arg: -1, fourth_arg: -1, fifth_arg: -1, nodes: nodes });
    }
    let mut_pos: i32 = *pos;
    let parsed: ParseOut = parse_expr(kinds, vals, lens, &mut mut_pos, nodes)?;
    let argc: i32 = 1;
    let first_arg: i32 = parsed.idx;
    let second_arg: i32 = -1;
    let third_arg: i32 = -1;
    let fourth_arg: i32 = -1;
    let fifth_arg: i32 = -1;
    *pos = mut_pos;
    let cur_nodes: Vec<Expr> = parsed.nodes;
    while (*pos < n) {
        if (vec_get(kinds, *pos) != 12) {
            break;
        }
        *pos = *pos + 1;
        let mut_pos2: i32 = *pos;
        let next: ParseOut = parse_expr(kinds, vals, lens, &mut mut_pos2, cur_nodes)?;
        *pos = mut_pos2;
        cur_nodes = next.nodes;
        argc = argc + 1;
        if (argc == 2) {
            second_arg = next.idx;
        }
        if (argc >= 3) {
            if (third_arg < 0) {
                third_arg = next.idx;
            } else {
                if (fourth_arg < 0) {
                    fourth_arg = next.idx;
                } else {
                    fifth_arg = next.idx;
                }
            }
        }
    }
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 7) {
        return Err(1);
    }
    *pos = *pos + 1;
    return Ok(ArgCountOut { argc: argc, first_arg: first_arg, second_arg: second_arg, third_arg: third_arg, fourth_arg: fourth_arg, fifth_arg: fifth_arg, nodes: cur_nodes });
}

fn parse_block_rest(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32, nodes: Vec<Expr>, stmts: Vec<Stmt>, start: i32) -> Result<BlockParseOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) == 9) {
        *pos = *pos + 1;
        let count: i32 = stmts.len - start;
        return Ok(BlockParseOut { count: count, nodes: nodes, stmts: stmts });
    }
    let step: StmtStep = parse_stmt(kinds, vals, lens, src, pos, nodes, stmts)?;
    return parse_block_rest(kinds, vals, lens, src, pos, step.nodes, step.stmts, start);
}

fn parse_block(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32, nodes: Vec<Expr>, stmts: Vec<Stmt>) -> Result<BlockParseOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 8) {
        return Err(1);
    }
    *pos = *pos + 1;
    let start: i32 = stmts.len;
    return parse_block_rest(kinds, vals, lens, src, pos, nodes, stmts, start);
}

fn parse_region_arena_size(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32) -> Result<i32, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) == 1) {
        let sz: i32 = vec_get(vals, *pos);
        *pos = *pos + 1;
        return Ok(sz);
    }
    if (vec_get(kinds, *pos) == 30) {
        let off: i32 = vec_get(vals, *pos);
        let ln: i32 = vec_get(lens, *pos);
        *pos = *pos + 1;
        if (*pos < n) {
            if (vec_get(kinds, *pos) == 6) {
                *pos = *pos + 1;
                if (*pos >= n) {
                    return Err(1);
                }
                if (vec_get(kinds, *pos) != 7) {
                    return Err(1);
                }
                *pos = *pos + 1;
            }
        }
        if (sh_lexer.slice_eq(src, off, ln, "fx_defaults.arena_boot") == 1) {
            return Ok(4096);
        }
        if (sh_lexer.slice_eq(src, off, ln, "fx_defaults.arena_parse") == 1) {
            return Ok(16384);
        }
        if (sh_lexer.slice_eq(src, off, ln, "fx_defaults.arena_emit") == 1) {
            return Ok(8192);
        }
    }
    return Err(1);
}

fn parse_stmt(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32, nodes: Vec<Expr>, stmts: Vec<Stmt>) -> Result<StmtStep, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    let k: i32 = vec_get(kinds, *pos);
    if (k == 26) {
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 30) {
            return Err(1);
        }
        let name_off: i32 = vec_get(vals, *pos);
        let name_len: i32 = vec_get(lens, *pos);
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 10) {
            return Err(1);
        }
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 27) {
            return Err(1);
        }
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 6) {
            return Err(1);
        }
        *pos = *pos + 1;
        let arena_size: i32 = parse_region_arena_size(kinds, vals, lens, src, pos)?;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 7) {
            return Err(1);
        }
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 13) {
            return Err(1);
        }
        *pos = *pos + 1;
        let stmts2: Vec<Stmt> = vec_push(stmts, Region(name_off, name_len, arena_size));
        return Ok(StmtStep { nodes: nodes, stmts: stmts2 });
    }
    if (k == 20) {
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 30) {
            return Err(1);
        }
        let name_off: i32 = vec_get(vals, *pos);
        let name_len: i32 = vec_get(lens, *pos);
        *pos = *pos + 1;
        let ty_off: i32 = 0;
        let ty_len: i32 = 0;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) == 11) {
            *pos = *pos + 1;
            let ty: ImpOut = parse_type_span(kinds, vals, lens, src, pos)?;
            ty_off = ty.path_off;
            ty_len = ty.path_len;
        }
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 10) {
            return Err(1);
        }
        *pos = *pos + 1;
        let mut_pos: i32 = *pos;
        let parsed: ParseOut = parse_expr(kinds, vals, lens, &mut mut_pos, nodes)?;
        if (mut_pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, mut_pos) != 13) {
            return Err(1);
        }
        *pos = mut_pos + 1;
        let stmts2: Vec<Stmt> = vec_push(stmts, Let(name_off, name_len, parsed.idx, ty_off, ty_len));
        return Ok(StmtStep { nodes: parsed.nodes, stmts: stmts2 });
    }
    if (k == 22) {
        *pos = *pos + 1;
        let mut_pos: i32 = *pos;
        // CONV-3-r.19 - return expr accepts comparisons (`a < b`) via parse_cond.
        let parsed: ParseOut = parse_cond(kinds, vals, lens, &mut mut_pos, nodes)?;
        if (mut_pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, mut_pos) != 13) {
            return Err(1);
        }
        *pos = mut_pos + 1;
        let stmts2: Vec<Stmt> = vec_push(stmts, Return(parsed.idx));
        return Ok(StmtStep { nodes: parsed.nodes, stmts: stmts2 });
    }
    if (k == 23) {
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        let mut_pos: i32 = *pos;
        let had_paren: i32 = 0;
        if (vec_get(kinds, mut_pos) == 6) {
            mut_pos = mut_pos + 1;
            had_paren = 1;
        }
        let cond: ParseOut = parse_cond(kinds, vals, lens, &mut mut_pos, nodes)?;
        if (had_paren == 1) {
            if (mut_pos >= n) {
                return Err(1);
            }
            if (vec_get(kinds, mut_pos) != 7) {
                return Err(1);
            }
            mut_pos = mut_pos + 1;
        }
        *pos = mut_pos;
        let then_blk: BlockParseOut = parse_block(kinds, vals, lens, src, pos, cond.nodes, stmts)?;
        let then_start: i32 = then_blk.stmts.len - then_blk.count;
        let else_start: i32 = 0;
        let else_len: i32 = 0;
        let cur_nodes: Vec<Expr> = then_blk.nodes;
        let cur_stmts: Vec<Stmt> = then_blk.stmts;
        if (*pos < n) {
            if (vec_get(kinds, *pos) == 24) {
                *pos = *pos + 1;
                let else_blk: BlockParseOut = parse_block(kinds, vals, lens, src, pos, cur_nodes, cur_stmts)?;
                else_start = else_blk.stmts.len - else_blk.count;
                else_len = else_blk.count;
                let stmts2: Vec<Stmt> = vec_push(else_blk.stmts, If(cond.idx, then_start, then_blk.count, else_start, else_len));
                return Ok(StmtStep { nodes: else_blk.nodes, stmts: stmts2 });
            }
        }
        let stmts2: Vec<Stmt> = vec_push(cur_stmts, If(cond.idx, then_start, then_blk.count, else_start, else_len));
        return Ok(StmtStep { nodes: cur_nodes, stmts: stmts2 });
    }
    if (k == 25) {
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        let mut_pos: i32 = *pos;
        let had_paren: i32 = 0;
        if (vec_get(kinds, mut_pos) == 6) {
            mut_pos = mut_pos + 1;
            had_paren = 1;
        }
        let cond: ParseOut = parse_cond(kinds, vals, lens, &mut mut_pos, nodes)?;
        if (had_paren == 1) {
            if (mut_pos >= n) {
                return Err(1);
            }
            if (vec_get(kinds, mut_pos) != 7) {
                return Err(1);
            }
            mut_pos = mut_pos + 1;
        }
        *pos = mut_pos;
        let body_blk: BlockParseOut = parse_block(kinds, vals, lens, src, pos, cond.nodes, stmts)?;
        let body_start: i32 = body_blk.stmts.len - body_blk.count;
        let stmts2: Vec<Stmt> = vec_push(body_blk.stmts, While(cond.idx, body_start, body_blk.count));
        return Ok(StmtStep { nodes: body_blk.nodes, stmts: stmts2 });
    }
    // CONV-3-r.17 - C-style `for (let i=0; cond; step) { body }` desugars to let+while.
    if (k == 41) {
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 6) {
            return Err(1);
        }
        *pos = *pos + 1;
        let init_step: StmtStep = parse_stmt(kinds, vals, lens, src, pos, nodes, stmts)?;
        let cond: ParseOut = parse_cond(kinds, vals, lens, pos, init_step.nodes)?;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 13) {
            return Err(1);
        }
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 30) {
            return Err(1);
        }
        let step_off: i32 = vec_get(vals, *pos);
        let step_ln: i32 = vec_get(lens, *pos);
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 10) {
            return Err(1);
        }
        *pos = *pos + 1;
        let step_expr: ParseOut = parse_expr(kinds, vals, lens, pos, cond.nodes)?;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 7) {
            return Err(1);
        }
        *pos = *pos + 1;
        let body_blk: BlockParseOut = parse_block(kinds, vals, lens, src, pos, step_expr.nodes, init_step.stmts)?;
        let body_start: i32 = body_blk.stmts.len - body_blk.count;
        let with_step: Vec<Stmt> = vec_push(body_blk.stmts, Assign(step_off, step_ln, step_expr.idx));
        let while_len: i32 = body_blk.count + 1;
        let stmts2: Vec<Stmt> = vec_push(with_step, While(cond.idx, body_start, while_len));
        return Ok(StmtStep { nodes: body_blk.nodes, stmts: stmts2 });
    }
    if (k == 31) {
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 13) {
            return Err(1);
        }
        *pos = *pos + 1;
        let stmts2: Vec<Stmt> = vec_push(stmts, Break);
        return Ok(StmtStep { nodes: nodes, stmts: stmts2 });
    }
    if (k == 42) {
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 13) {
            return Err(1);
        }
        *pos = *pos + 1;
        let stmts2: Vec<Stmt> = vec_push(stmts, Continue);
        return Ok(StmtStep { nodes: nodes, stmts: stmts2 });
    }
    if (k == 4) {
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 30) {
            return Err(1);
        }
        let name_off: i32 = vec_get(vals, *pos);
        let name_len: i32 = vec_get(lens, *pos);
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, *pos) != 10) {
            return Err(1);
        }
        *pos = *pos + 1;
        let mut_pos: i32 = *pos;
        let parsed: ParseOut = parse_expr(kinds, vals, lens, &mut mut_pos, nodes)?;
        if (mut_pos >= n) {
            return Err(1);
        }
        if (vec_get(kinds, mut_pos) != 13) {
            return Err(1);
        }
        *pos = mut_pos + 1;
        let stmts2: Vec<Stmt> = vec_push(stmts, AssignPtr(name_off, name_len, parsed.idx));
        return Ok(StmtStep { nodes: parsed.nodes, stmts: stmts2 });
    }
    if (k == 30) {
        let name_off: i32 = vec_get(vals, *pos);
        let name_len: i32 = vec_get(lens, *pos);
        *pos = *pos + 1;
        if (*pos >= n) {
            return Err(1);
        }
        let k2: i32 = vec_get(kinds, *pos);
        if (k2 == 6) {
            *pos = *pos + 1;
            let args: ArgCountOut = parse_arg_count(kinds, vals, lens, pos, nodes)?;
            if (*pos >= n) {
                return Err(1);
            }
            if (vec_get(kinds, *pos) != 13) {
                return Err(1);
            }
            *pos = *pos + 1;
            let stmts2: Vec<Stmt> = vec_push(stmts, Call(name_off, name_len, args.argc, args.first_arg));
            return Ok(StmtStep { nodes: args.nodes, stmts: stmts2 });
        }
        if (k2 == 10) {
            *pos = *pos + 1;
            let mut_pos: i32 = *pos;
            let parsed: ParseOut = parse_expr(kinds, vals, lens, &mut mut_pos, nodes)?;
            if (mut_pos >= n) {
                return Err(1);
            }
            if (vec_get(kinds, mut_pos) != 13) {
                return Err(1);
            }
            *pos = mut_pos + 1;
            let stmts2: Vec<Stmt> = vec_push(stmts, Assign(name_off, name_len, parsed.idx));
            return Ok(StmtStep { nodes: parsed.nodes, stmts: stmts2 });
        }
        // FX-SH-NAT-7 - `ident[index] = expr` index assignment.
        if (k2 == 44) {
            *pos = *pos + 1;
            let base_idx: i32 = nodes.len;
            let nodes1: Vec<Expr> = vec_push(nodes, Ident(name_off, name_len));
            let ix: ParseOut = parse_expr(kinds, vals, lens, pos, nodes1)?;
            if (*pos >= n) {
                return Err(1);
            }
            if (vec_get(kinds, *pos) != 45) {
                return Err(1);
            }
            *pos = *pos + 1;
            if (*pos >= n) {
                return Err(1);
            }
            if (vec_get(kinds, *pos) != 10) {
                return Err(1);
            }
            *pos = *pos + 1;
            let val: ParseOut = parse_expr(kinds, vals, lens, pos, ix.nodes)?;
            if (*pos >= n) {
                return Err(1);
            }
            if (vec_get(kinds, *pos) != 13) {
                return Err(1);
            }
            *pos = *pos + 1;
            let stmts2: Vec<Stmt> = vec_push(stmts, IndexAssign(base_idx, ix.idx, val.idx));
            return Ok(StmtStep { nodes: val.nodes, stmts: stmts2 });
        }
    }
    return Err(1);
}

fn type_span_is_vec(src: string, off: i32, ln: i32) -> i32 {
    if (ln < 5) {
        return 0;
    }
    if (sh_lexer.slice_eq(src, off, 3, "Vec") != 1) {
        return 0;
    }
    if (string.byte_at(src, off + 3) != 60) {
        return 0;
    }
    if (string.byte_at(src, off + ln - 1) != 62) {
        return 0;
    }
    return 1;
}

fn map_vec_type_c(src: string, off: i32, ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let elem_off: i32 = off + 4;
    let elem_ln: i32 = ln - 5;
    let ename: string = sh_lexer.slice_str(src, elem_off, elem_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_Vec_");
    let b2: StrBuilder = strbuf_push(b1, ename);
    return Ok(strbuf_finish(b2));
}

fn type_span_is_mut_ref(src: string, off: i32, ln: i32) -> i32 {
    if (ln < 6) {
        return 0;
    }
    if (sh_lexer.slice_eq(src, off, 1, "&") != 1) {
        return 0;
    }
    if (sh_lexer.slice_eq(src, off + 1, 3, "mut") != 1) {
        return 0;
    }
    return 1;
}

// FX-SH-NAT-7 - `&mut [T]` mut slice type span.
fn type_span_is_mut_slice(src: string, off: i32, ln: i32) -> i32 {
    if (type_span_is_mut_ref(src, off, ln) != 1) {
        return 0;
    }
    let inner_off: i32 = off + 5;
    let inner_ln: i32 = ln - 5;
    if (inner_ln < 3) {
        return 0;
    }
    if (string.byte_at(src, inner_off) != 91) {
        return 0;
    }
    if (string.byte_at(src, inner_off + inner_ln - 1) != 93) {
        return 0;
    }
    return 1;
}

// FX-SH-NAT-7 - `[T; N]` fixed array type span.
fn type_span_is_array(src: string, off: i32, ln: i32) -> i32 {
    if (ln < 5) {
        return 0;
    }
    if (string.byte_at(src, off) != 91) {
        return 0;
    }
    if (string.byte_at(src, off + ln - 1) != 93) {
        return 0;
    }
    let i: i32 = off + 1;
    let end: i32 = off + ln - 1;
    while (i < end) {
        if (string.byte_at(src, i) == 59) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn array_type_elem_off(src: string, off: i32, ln: i32) -> i32 {
    return off + 1;
}

fn array_type_elem_ln(src: string, off: i32, ln: i32) -> i32 {
    let i: i32 = off + 1;
    let end: i32 = off + ln - 1;
    while (i < end) {
        if (string.byte_at(src, i) == 59) {
            return i - (off + 1);
        }
        i = i + 1;
    }
    return 0;
}

fn array_type_len_off(src: string, off: i32, ln: i32) -> i32 {
    let i: i32 = off + 1;
    let end: i32 = off + ln - 1;
    while (i < end) {
        if (string.byte_at(src, i) == 59) {
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn array_type_len_ln(src: string, off: i32, ln: i32) -> i32 {
    let lo: i32 = array_type_len_off(src, off, ln);
    if (lo == 0) {
        return 0;
    }
    return (off + ln - 1) - lo;
}

fn map_array_type_c(mod_slug: string, src: string, off: i32, ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let elem_off: i32 = array_type_elem_off(src, off, ln);
    let elem_ln: i32 = array_type_elem_ln(src, off, ln);
    let len_off: i32 = array_type_len_off(src, off, ln);
    let len_ln: i32 = array_type_len_ln(src, off, ln);
    let ename: string = sh_lexer.slice_str(src, elem_off, elem_ln)?;
    let nstr: string = sh_lexer.slice_str(src, len_off, len_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_Array_");
    let b4: StrBuilder = strbuf_push(b3, ename);
    let b5: StrBuilder = strbuf_push(b4, "_");
    let b6: StrBuilder = strbuf_push(b5, nstr);
    return Ok(strbuf_finish(b6));
}

fn slice_type_elem_off(src: string, off: i32, ln: i32) -> i32 {
    return off + 1;
}

fn slice_type_elem_ln(src: string, off: i32, ln: i32) -> i32 {
    return ln - 2;
}

fn map_mut_slice_type_c(src: string, off: i32, ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let elem_off: i32 = slice_type_elem_off(src, off, ln);
    let elem_ln: i32 = slice_type_elem_ln(src, off, ln);
    let ename: string = sh_lexer.slice_str(src, elem_off, elem_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_MutSlice_");
    let b2: StrBuilder = strbuf_push(b1, ename);
    return Ok(strbuf_finish(b2));
}

fn map_slice_type_c(src: string, off: i32, ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let elem_off: i32 = slice_type_elem_off(src, off, ln);
    let elem_ln: i32 = slice_type_elem_ln(src, off, ln);
    let ename: string = sh_lexer.slice_str(src, elem_off, elem_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_Slice_");
    let b2: StrBuilder = strbuf_push(b1, ename);
    return Ok(strbuf_finish(b2));
}

fn map_mut_ref_type_c(mod_slug: string, src: string, off: i32, ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let inner_off: i32 = off + 5;
    let inner_ln: i32 = ln - 5;
    if (type_span_is_mut_slice(src, off, ln) == 1) {
        return map_mut_slice_type_c(src, inner_off, inner_ln);
    }
    let inner: string = map_type_span_to_c_mod(mod_slug, src, inner_off, inner_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, inner);
    let b2: StrBuilder = strbuf_push(b1, "*");
    return Ok(strbuf_finish(b2));
}

fn map_type_span_to_c_mod(mod_slug: string, src: string, off: i32, ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (type_span_is_mut_ref(src, off, ln) == 1) {
        return map_mut_ref_type_c(mod_slug, src, off, ln);
    }
    if (type_span_is_array(src, off, ln) == 1) {
        return map_array_type_c(mod_slug, src, off, ln);
    }
    if (ln >= 3) {
        if (string.byte_at(src, off) == 91) {
            if (string.byte_at(src, off + ln - 1) == 93) {
                return map_slice_type_c(src, off, ln);
            }
        }
    }
    if (type_span_is_vec(src, off, ln) == 1) {
        return map_vec_type_c(src, off, ln);
    }
    // SH-C-72 - Map spans lower to the LV5 std map ABI, not to a module-prefixed struct name.
    if (type_span_is_map(src, off, ln) == 1) {
        return map_map_type_c(src, off, ln);
    }
    if (sh_lexer.slice_eq(src, off, ln, "i32") == 1) {
        return Ok("int32_t");
    }
    if (sh_lexer.slice_eq(src, off, ln, "bool") == 1) {
        return Ok("int32_t");
    }
    if (sh_lexer.slice_eq(src, off, ln, "string") == 1) {
        return Ok("const char*");
    }
    if (sh_lexer.slice_eq(src, off, ln, "StrBuilder") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_StrBuilder");
        return Ok(strbuf_finish(b3));
    }
    // FX-SH-NAT-5 - Buf / Bytes are monomorphic global C types (foundry parity).
    if (sh_lexer.slice_eq(src, off, ln, "Buf") == 1) {
        return Ok("fx_Buf");
    }
    if (sh_lexer.slice_eq(src, off, ln, "Bytes") == 1) {
        return Ok("fx_Bytes");
    }
    if (string.len(mod_slug) == 0) {
        return Err(1);
    }
    let tname: string = sh_lexer.slice_str(src, off, ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_");
    let b4: StrBuilder = strbuf_push(b3, tname);
    return Ok(strbuf_finish(b4));
}

fn map_type_span_to_c(src: string, off: i32, ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    return map_type_span_to_c_mod("", src, off, ln);
}

fn concat_param_acc(prefix: string, part2: string, first: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (first == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, prefix);
        let b2: StrBuilder = strbuf_push(b1, part2);
        return Ok(strbuf_finish(b2));
    }
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, prefix);
    let b2: StrBuilder = strbuf_push(b1, ", ");
    let b3: StrBuilder = strbuf_push(b2, part2);
    return Ok(strbuf_finish(b3));
}

struct ParamParseOut {
    sig: string,
    env: string,
}

fn append_env_name(env: string, name: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, env);
    let b2: StrBuilder = strbuf_push(b1, name);
    let b3: StrBuilder = strbuf_push(b2, "|");
    return Ok(strbuf_finish(b3));
}

fn append_struct_env_name(env: string, name: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, env);
    let b2: StrBuilder = strbuf_push(b1, "|@");
    let b3: StrBuilder = strbuf_push(b2, name);
    let b4: StrBuilder = strbuf_push(b3, "|");
    return Ok(strbuf_finish(b4));
}

fn env_map_has_i32(m: Map<string, i32>, name: string) -> i32 {
    if (map_contains(m, name)) {
        return 1;
    }
    return 0;
}

fn append_env_name_map_i32(m: &mut Map<string, i32>, env: string, name: string) -> Result<string, core_Err> effects { alloc, mut } {
    *m = map_insert(*m, name, 1);
    return append_env_name(env, name);
}

fn append_struct_env_name_map(m: &mut Map<string, i32>, env: string, name: string) -> Result<string, core_Err> effects { alloc, mut } {
    *m = map_insert(*m, name, 1);
    return append_struct_env_name(env, name);
}

// SH-C-19 - string-annotated lets share let_struct_m with value tag 2 (struct = 1).
fn append_str_env_name_map(m: &mut Map<string, i32>, env: string, name: string) -> Result<string, core_Err> effects { alloc, mut } {
    *m = map_insert(*m, name, 2);
    return append_struct_env_name(env, name);
}

fn env_map_get_i32(m: Map<string, i32>, name: string) -> Result<i32, core_Err> {
    return map_get(m, name);
}

// CONV-2-g.5 / MAP/G9 slice 7 - map-only env lookups (incremental insert keys; no pipe-fill fallback).
fn env_lookup_i32(param_m: Map<string, i32>, let_i32_m: Map<string, i32>, name: string) -> i32 {
    if (env_map_has_i32(param_m, name) == 1) {
        return 1;
    }
    if (env_map_has_i32(let_i32_m, name) == 1) {
        return 1;
    }
    return 0;
}

fn env_lookup_struct(let_struct_m: Map<string, i32>, name: string) -> i32 {
    return env_map_has_i32(let_struct_m, name);
}

fn param_sig_is_parser_toks(sig: string) -> i32 {
    let want: string = "(fx_Vec_i32 kinds, fx_Vec_i32 vals, fx_Vec_i32 lens, int32_t* pos)";
    let n: i32 = string.len(want);
    if (string.len(sig) != n) {
        return 0;
    }
    return sh_lexer.slice_eq(sig, 0, n, want);
}

fn param_sig_is_parser_toks_src(sig: string) -> i32 {
    let want: string = "(fx_Vec_i32 kinds, fx_Vec_i32 vals, fx_Vec_i32 lens, const char* src, int32_t* pos)";
    let n: i32 = string.len(want);
    if (string.len(sig) != n) {
        return 0;
    }
    return sh_lexer.slice_eq(sig, 0, n, want);
}

fn param_sig_is_parser_toks_src_mod(sig: string) -> i32 {
    let want: string = "(fx_Vec_i32 kinds, fx_Vec_i32 vals, fx_Vec_i32 lens, const char* src, const char* mod_slug, int32_t* pos)";
    let n: i32 = string.len(want);
    if (string.len(sig) != n) {
        return 0;
    }
    return sh_lexer.slice_eq(sig, 0, n, want);
}

fn param_sig_has_kinds(sig: string) -> i32 {
    if (string.len(sig) < 17) {
        return 0;
    }
    return sh_lexer.slice_eq(sig, 0, 17, "(fx_Vec_i32 kinds");
}

fn param_sig_has_src(sig: string) -> i32 {
    let needle: string = "const char* src";
    let nlen: i32 = string.len(needle);
    let slen: i32 = string.len(sig);
    if (slen < nlen) {
        return 0;
    }
    let i: i32 = 0;
    while (i <= slen - nlen) {
        if (sh_lexer.slice_eq(sig, i, nlen, needle) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn param_sig_has_parser_nodes_stmts(sig: string) -> i32 {
    let nodes_needle: string = "fx_Vec_Expr nodes";
    let stmts_needle: string = "fx_Vec_Stmt stmts";
    let nlen: i32 = string.len(nodes_needle);
    let slen: i32 = string.len(sig);
    if (slen < nlen) {
        return 0;
    }
    let i: i32 = 0;
    let found_nodes: i32 = 0;
    while (i <= slen - nlen) {
        if (sh_lexer.slice_eq(sig, i, nlen, nodes_needle) == 1) {
            found_nodes = 1;
            break;
        }
        i = i + 1;
    }
    if (found_nodes != 1) {
        return 0;
    }
    let mlen: i32 = string.len(stmts_needle);
    if (slen < mlen) {
        return 0;
    }
    let j: i32 = 0;
    while (j <= slen - mlen) {
        if (sh_lexer.slice_eq(sig, j, mlen, stmts_needle) == 1) {
            return 1;
        }
        j = j + 1;
    }
    return 0;
}

fn emit_parser_param_nodes_stmts_void_casts() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    (void)nodes;\n    (void)stmts;\n");
}

fn parse_fn_params_c_nonempty(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, mod_slug: string, pos: &mut i32, prefix: string, env: string, first: i32, param_m: &mut Map<string, i32>) -> Result<ParamParseOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    let name_off: i32 = vec_get(vals, *pos);
    let name_len: i32 = vec_get(lens, *pos);
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 11) {
        return Err(1);
    }
    *pos = *pos + 1;
    let ty: ImpOut = parse_type_span(kinds, vals, lens, src, pos)?;
    let ty_c: string = map_type_span_to_c_mod(mod_slug, src, ty.path_off, ty.path_len)?;
    let pname: string = sh_lexer.slice_str(src, name_off, name_len)?;
    let p0: StrBuilder = strbuf_new();
    let p1: StrBuilder = strbuf_push(p0, ty_c);
    let p2: StrBuilder = strbuf_push(p1, " ");
    let p3: StrBuilder = strbuf_push(p2, pname);
    let part2: string = strbuf_finish(p3);
    let acc: string = concat_param_acc(prefix, part2, first)?;
    let env2: string = append_env_name_map_i32(param_m, env, pname)?;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) == 7) {
        *pos = *pos + 1;
        let s0: StrBuilder = strbuf_new();
        let s1: StrBuilder = strbuf_push(s0, acc);
        let sig: string = strbuf_finish(strbuf_push(s1, ")"));
        return Ok(ParamParseOut { sig: sig, env: env2 });
    }
    if (vec_get(kinds, *pos) != 12) {
        return Err(1);
    }
    *pos = *pos + 1;
    return parse_fn_params_c_nonempty(kinds, vals, lens, src, mod_slug, pos, acc, env2, 0, param_m);
}

fn parse_fn_params_c(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, mod_slug: string, pos: &mut i32, param_m: &mut Map<string, i32>) -> Result<ParamParseOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) == 7) {
        *pos = *pos + 1;
        return Ok(ParamParseOut { sig: "(void)", env: "|" });
    }
    return parse_fn_params_c_nonempty(kinds, vals, lens, src, mod_slug, pos, "(", "|", 1, param_m);
}

fn fill_param_m_tok_rec(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32, param_m: &mut Map<string, i32>) -> Result<i32, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) == 7) {
        *pos = *pos + 1;
        return Ok(0);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    let name_off: i32 = vec_get(vals, *pos);
    let name_len: i32 = vec_get(lens, *pos);
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 11) {
        return Err(1);
    }
    *pos = *pos + 1;
    let _ty: ImpOut = parse_type_span(kinds, vals, lens, src, pos)?;
    let pname: string = sh_lexer.slice_str(src, name_off, name_len)?;
    *param_m = map_insert(*param_m, pname, 1);
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) == 7) {
        *pos = *pos + 1;
        return Ok(0);
    }
    if (vec_get(kinds, *pos) != 12) {
        return Err(1);
    }
    *pos = *pos + 1;
    return fill_param_m_tok_rec(kinds, vals, lens, src, pos, param_m);
}

// CONV-2-g.5 / MAP/G9 slice 6 - rebuild param Map from source tokens (slice_str keys at parse sites).
fn fill_param_m_from_fn_out(fn_out: FnOut, src: string, param_m: &mut Map<string, i32>) -> Result<i32, core_Err> effects { alloc, mut } {
    let buf = sh_lexer.lex(src);
    let pos: i32 = fn_out.param_tok_pos;
    return fill_param_m_tok_rec(buf.kinds, buf.vals, buf.lens, src, &mut pos, param_m);
}

fn parse_fn_def(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, mod_slug: string, pos: &mut i32, nodes: Vec<Expr>, stmts: Vec<Stmt>) -> Result<FnOut, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 21) {
        return Err(1);
    }
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    let name_off: i32 = vec_get(vals, *pos);
    let name_len: i32 = vec_get(lens, *pos);
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 6) {
        return Err(1);
    }
    *pos = *pos + 1;
    let param_tok_pos: i32 = *pos;
    let discard_param_m: Map<string, i32> = map_new();
    let params: ParamParseOut = parse_fn_params_c(kinds, vals, lens, src, mod_slug, pos, &mut discard_param_m)?;
    let sig: RetTypeOut = parse_ret_type(kinds, vals, lens, src, pos)?;
    let effect_count: i32 = parse_effects_clause(kinds, vals, lens, pos)?;
    let body_blk: BlockParseOut = parse_block(kinds, vals, lens, src, pos, nodes, stmts)?;
    let body_start: i32 = body_blk.stmts.len - body_blk.count;
    return Ok(FnOut {
        name_off: name_off,
        name_len: name_len,
        ret_off: sig.ret_off,
        ret_len: sig.ret_len,
        ret_is_result: sig.ret_is_result,
        ret_ok_off: sig.ret_ok_off,
        ret_ok_len: sig.ret_ok_len,
        ret_err_off: sig.ret_err_off,
        ret_err_len: sig.ret_err_len,
        effect_count: effect_count,
        param_sig: params.sig,
        param_env: params.env,
        param_tok_pos: param_tok_pos,
        body_start: body_start,
        body_len: body_blk.count,
        nodes: body_blk.nodes,
        stmts: body_blk.stmts,
    });
}

fn parse_let_stmt(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>) -> Result<LetOut, core_Err> effects { alloc, mut } {
    let pos: i32 = 0;
    let n: i32 = kinds.len;
    if (n < 4) {
        return Err(1);
    }
    if (vec_get(kinds, pos) != 20) {
        return Err(1);
    }
    pos = pos + 1;
    if (vec_get(kinds, pos) != 30) {
        return Err(1);
    }
    let name_off: i32 = vec_get(vals, pos);
    let name_len: i32 = vec_get(lens, pos);
    pos = pos + 1;
    if (vec_get(kinds, pos) != 10) {
        return Err(1);
    }
    pos = pos + 1;
    let mut_pos: i32 = pos;
    let empty: Vec<Expr> = vec_new(0);
    let parsed: ParseOut = parse_expr(kinds, vals, lens, &mut mut_pos, empty)?;
    if (mut_pos != n) {
        return Err(1);
    }
    return Ok(LetOut {
        name_off: name_off,
        name_len: name_len,
        root: parsed.idx,
        nodes: parsed.nodes,
    });
}

fn eval_expr(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Num(n) => n,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(l, r) => eval_expr(nodes, l) + eval_expr(nodes, r),
        Sub(l, r) => eval_expr(nodes, l) - eval_expr(nodes, r),
        Mul(l, r) => eval_expr(nodes, l) * eval_expr(nodes, r),
        Div(l, r) => eval_expr(nodes, l) / eval_expr(nodes, r),
        CmpLt(l, r) => {
            if (eval_expr(nodes, l) < eval_expr(nodes, r)) {
                return 1;
            }
            return 0;
        },
        CmpNe(l, r) => {
            if (eval_expr(nodes, l) != eval_expr(nodes, r)) {
                return 1;
            }
            return 0;
        },
        CmpEq(l, r) => {
            if (eval_expr(nodes, l) == eval_expr(nodes, r)) {
                return 1;
            }
            return 0;
        },
        CmpGe(l, r) => {
            if (eval_expr(nodes, l) >= eval_expr(nodes, r)) {
                return 1;
            }
            return 0;
        },
        Deref(inner) => eval_expr(nodes, inner),
        Match(scr, _, _) => eval_expr(nodes, scr),
        CallExpr(_, _, a0, a1, _, _, _) => {
            if (a1 >= 0) {
                return eval_expr(nodes, a0) + eval_expr(nodes, a1);
            }
            return eval_expr(nodes, a0);
        },
        StructLit(_, _, count, f0, f1, f2, f3, f4, f5, f6, f7, f8, _, _, _, _, _, _, _, _) => eval_struct_lit_sum(nodes, count, f0, f1, f2, f3, f4, f5, f6, f7, f8),
        TryExpr(inner) => eval_expr(nodes, inner),
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

