fn expr_is_call2_nums(nodes: Vec<Expr>, idx: i32, src: string, callee: string, n0: i32, n1: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        CallExpr(off, ln, a0, a1, _, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, callee) != 1) {
                return 0;
            }
            if (is_num(nodes, a0, n0) != 1) {
                return 0;
            }
            return is_num(nodes, a1, n1);
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn return_is_call2_nums(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, callee: string, n0: i32, n1: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => expr_is_call2_nums(nodes, e, src, callee, n0, n1),
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn slice_dot_pos(src: string, off: i32, ln: i32) -> i32 {
    let i: i32 = 0;
    while (i < ln) {
        if (string.byte_at(src, off + i) == 46) {
            return off + i;
        }
        i = i + 1;
    }
    return -1;
}

fn emit_mangled_import_callee(src: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let coff: i32 = expr_call2_callee_off(nodes, call_idx);
    let cln: i32 = expr_call2_callee_ln(nodes, call_idx);
    let dot: i32 = slice_dot_pos(src, coff, cln);
    if (dot < 0) {
        return Err(1);
    }
    let mod_ln: i32 = dot - coff;
    let fn_off: i32 = dot + 1;
    let fn_ln: i32 = (coff + cln) - fn_off;
    let mod_name: string = sh_lexer.slice_str(src, coff, mod_ln)?;
    let fn_name: string = sh_lexer.slice_str(src, fn_off, fn_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_name);
    let b3: StrBuilder = strbuf_push(b2, "_");
    let b4: StrBuilder = strbuf_push(b3, fn_name);
    return Ok(strbuf_finish(b4));
}

fn emit_return_call2_import_line(src: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let callee: string = emit_mangled_import_callee(src, nodes, call_idx)?;
    let n0: i32 = call2_num_at(nodes, call_idx, 0);
    let n1: i32 = call2_num_at(nodes, call_idx, 1);
    let s0: string = str_from_i32(n0)?;
    let s1: string = str_from_i32(n1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return ");
    let b2: StrBuilder = strbuf_push(b1, callee);
    let b3: StrBuilder = strbuf_push(b2, "(");
    let b4: StrBuilder = strbuf_push(b3, s0);
    let b5: StrBuilder = strbuf_push(b4, ", ");
    let b6: StrBuilder = strbuf_push(b5, s1);
    let b7: StrBuilder = strbuf_push(b6, ");\n");
    return Ok(strbuf_finish(b7));
}

fn ident_is_field_access(nodes: Vec<Expr>, idx: i32, src: string, base: string, field: string) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Ident(off, ln) => {
            let dot: i32 = slice_dot_pos(src, off, ln);
            if (dot < 0) {
                return 0;
            }
            let base_ln: i32 = dot - off;
            let fld_off: i32 = dot + 1;
            let fld_ln: i32 = (off + ln) - fld_off;
            if (sh_lexer.slice_eq(src, off, base_ln, base) != 1) {
                return 0;
            }
            return sh_lexer.slice_eq(src, fld_off, fld_ln, field);
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        CallExpr(_, _, _, _, _, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn is_add_field_accesses(nodes: Vec<Expr>, idx: i32, src: string, base: string, f1: string, f2: string) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Add(l, r) => {
            if (ident_is_field_access(nodes, l, src, base, f1) != 1) {
                return 0;
            }
            return ident_is_field_access(nodes, r, src, base, f2);
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        CallExpr(_, _, _, _, _, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn is_add_cross_field_accesses(nodes: Vec<Expr>, idx: i32, src: string, lbase: string, lf: string, rbase: string, rf: string) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Add(li, ri) => {
            if (ident_is_field_access(nodes, li, src, lbase, lf) != 1) {
                return 0;
            }
            return ident_is_field_access(nodes, ri, src, rbase, rf);
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        CallExpr(_, _, _, _, _, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn return_is_add_cross_field_accesses(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, lbase: string, lf: string, rbase: string, rf: string) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => is_add_cross_field_accesses(nodes, e, src, lbase, lf, rbase, rf),
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn return_is_add_field_accesses(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, base: string, f1: string, f2: string) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => is_add_field_accesses(nodes, e, src, base, f1, f2),
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn emit_field_access_c(src: string, nodes: Vec<Expr>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let off: i32 = expr_ident_off(nodes, idx);
    let ln: i32 = expr_ident_ln(nodes, idx);
    return sh_lexer.slice_str(src, off, ln);
}

fn emit_return_add_field_accesses_line(src: string, nodes: Vec<Expr>, add_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let l: i32 = expr_binop_l(nodes, add_idx);
    let r: i32 = expr_binop_r(nodes, add_idx);
    let left: string = emit_field_access_c(src, nodes, l)?;
    let right: string = emit_field_access_c(src, nodes, r)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return (");
    let b2: StrBuilder = strbuf_push(b1, left);
    let b3: StrBuilder = strbuf_push(b2, " + ");
    let b4: StrBuilder = strbuf_push(b3, right);
    let b5: StrBuilder = strbuf_push(b4, ");\n");
    return Ok(strbuf_finish(b5));
}

fn emit_struct_type_c_name(prof: FixtureProfile, src: string, st_off: i32, st_ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let sname: string = sh_lexer.slice_str(src, st_off, st_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, prof.mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_");
    let b4: StrBuilder = strbuf_push(b3, sname);
    return Ok(strbuf_finish(b4));
}

fn struct_field_c_type(fname: string) -> Result<string, core_Err> effects { alloc, mut } {
    if (sh_lexer.slice_eq(fname, 0, string.len(fname), "variants_env") == 1) {
        return Ok("const char*");
    }
    if (sh_lexer.slice_eq(fname, 0, string.len(fname), "payloads_env") == 1) {
        return Ok("const char*");
    }
    if (sh_lexer.slice_eq(fname, 0, string.len(fname), "fields_env") == 1) {
        return Ok("const char*");
    }
    if (sh_lexer.slice_eq(fname, 0, string.len(fname), "param_sig") == 1) {
        return Ok("const char*");
    }
    if (sh_lexer.slice_eq(fname, 0, string.len(fname), "param_env") == 1) {
        return Ok("const char*");
    }
    // ParamParseOut / similar string carriers (CONV-2-g.8 field list).
    if (sh_lexer.slice_eq(fname, 0, string.len(fname), "sig") == 1) {
        return Ok("const char*");
    }
    if (sh_lexer.slice_eq(fname, 0, string.len(fname), "env") == 1) {
        return Ok("const char*");
    }
    if (sh_lexer.slice_eq(fname, 0, string.len(fname), "nodes") == 1) {
        return Ok("fx_Vec_Expr");
    }
    if (sh_lexer.slice_eq(fname, 0, string.len(fname), "stmts") == 1) {
        return Ok("fx_Vec_Stmt");
    }
    // SH-C-42 - real lexer TokBuf fields (kinds/vals/lens).
    if (sh_lexer.slice_eq(fname, 0, string.len(fname), "kinds") == 1) {
        return Ok("fx_Vec_i32");
    }
    if (sh_lexer.slice_eq(fname, 0, string.len(fname), "vals") == 1) {
        return Ok("fx_Vec_i32");
    }
    if (sh_lexer.slice_eq(fname, 0, string.len(fname), "lens") == 1) {
        return Ok("fx_Vec_i32");
    }
    return Ok("int32_t");
}

fn emit_struct_field_line(st_out: StructOut, field_i: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let fname: string = variants_env_nth(st_out.fields_env, field_i)?;
    let ty_c: string = struct_field_c_type(fname)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, ty_c);
    let b3: StrBuilder = strbuf_push(b2, " ");
    let b4: StrBuilder = strbuf_push(b3, fname);
    let b5: StrBuilder = strbuf_push(b4, ";\n");
    return Ok(strbuf_finish(b5));
}

fn emit_struct_fields_rest(st_out: StructOut, i: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (i >= st_out.field_count) {
        return Ok("");
    }
    let line: string = emit_struct_field_line(st_out, i)?;
    let rest: string = emit_struct_fields_rest(st_out, i + 1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, line);
    let b2: StrBuilder = strbuf_push(b1, rest);
    return Ok(strbuf_finish(b2));
}

fn emit_struct_typedef_block(prof: FixtureProfile, src: string, st_out: StructOut) -> Result<string, core_Err> effects { alloc, mut } {
    let ty_name: string = emit_struct_type_c_name(prof, src, st_out.name_off, st_out.name_len)?;
    let fields: string = emit_struct_fields_rest(st_out, 0)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "typedef struct {\n");
    let b2: StrBuilder = strbuf_push(b1, fields);
    let b3: StrBuilder = strbuf_push(b2, "} ");
    let b4: StrBuilder = strbuf_push(b3, ty_name);
    let b5: StrBuilder = strbuf_push(b4, ";\n\n");
    return Ok(strbuf_finish(b5));
}

fn emit_struct_lit_field_assign(st_out: StructOut, field_i: i32, val: i32, first: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let fname: string = variants_env_nth(st_out.fields_env, field_i)?;
    let sval: string = str_from_i32(val)?;
    let b0: StrBuilder = strbuf_new();
    if (first == 1) {
        let b1: StrBuilder = strbuf_push(b0, "{ .");
        let b2: StrBuilder = strbuf_push(b1, fname);
        let b3: StrBuilder = strbuf_push(b2, " = ");
        let b4: StrBuilder = strbuf_push(b3, sval);
        return Ok(strbuf_finish(b4));
    }
    let b1: StrBuilder = strbuf_push(b0, ", .");
    let b2: StrBuilder = strbuf_push(b1, fname);
    let b3: StrBuilder = strbuf_push(b2, " = ");
    let b4: StrBuilder = strbuf_push(b3, sval);
    return Ok(strbuf_finish(b4));
}

fn eval_struct_lit_sum(nodes: Vec<Expr>, count: i32, f0: i32, f1: i32, f2: i32, f3: i32, f4: i32, f5: i32, f6: i32, f7: i32, f8: i32) -> i32 {
    let s: i32 = 0;
    if (count >= 1) {
        s = s + eval_expr(nodes, f0);
    }
    if (count >= 2) {
        s = s + eval_expr(nodes, f1);
    }
    if (count >= 3) {
        s = s + eval_expr(nodes, f2);
    }
    if (count >= 4) {
        s = s + eval_expr(nodes, f3);
    }
    if (count >= 5) {
        s = s + eval_expr(nodes, f4);
    }
    if (count >= 6) {
        s = s + eval_expr(nodes, f5);
    }
    if (count >= 7) {
        s = s + eval_expr(nodes, f6);
    }
    if (count >= 8) {
        s = s + eval_expr(nodes, f7);
    }
    if (count >= 9) {
        s = s + eval_expr(nodes, f8);
    }
    return s;
}

fn struct_lit_count(nodes: Vec<Expr>, lit_idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, lit_idx);
    return match node {
        StructLit(_, _, count, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => count,
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        CallExpr(_, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn struct_lit_field_idx(nodes: Vec<Expr>, lit_idx: i32, field_i: i32) -> i32 {
    let node: Expr = vec_get(nodes, lit_idx);
    return match node {
        StructLit(_, _, _, f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16) => {
            if (field_i == 0) {
                return f0;
            }
            if (field_i == 1) {
                return f1;
            }
            if (field_i == 2) {
                return f2;
            }
            if (field_i == 3) {
                return f3;
            }
            if (field_i == 4) {
                return f4;
            }
            if (field_i == 5) {
                return f5;
            }
            if (field_i == 6) {
                return f6;
            }
            if (field_i == 7) {
                return f7;
            }
            if (field_i == 8) {
                return f8;
            }
            if (field_i == 9) {
                return f9;
            }
            if (field_i == 10) {
                return f10;
            }
            if (field_i == 11) {
                return f11;
            }
            if (field_i == 12) {
                return f12;
            }
            if (field_i == 13) {
                return f13;
            }
            if (field_i == 14) {
                return f14;
            }
            if (field_i == 15) {
                return f15;
            }
            if (field_i == 16) {
                return f16;
            }
            return -1;
        },
        Num(_) => -1,
        StrLit(_, _) => -1,
        Ident(_, _) => -1,
        Add(_, _) => -1,
        Sub(_, _) => -1,
        Mul(_, _) => -1,
        Div(_, _) => -1,
        CmpLt(_, _) => -1,
        CmpNe(_, _) => -1,
        CmpEq(_, _) => -1,
        CmpGe(_, _) => -1,
        Deref(_) => -1,
        Match(_, _, _) => -1,
        CallExpr(_, _, _, _, _, _, _) => -1,
        TryExpr(_) => -1,
        Index(_, _) => -1,
        SliceRange(_, _, _) => -1,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn struct_lit_val0(nodes: Vec<Expr>, idx: i32) -> i32 {
    return struct_lit_field_idx(nodes, idx, 0);
}

fn struct_lit_val1(nodes: Vec<Expr>, idx: i32) -> i32 {
    return struct_lit_field_idx(nodes, idx, 1);
}

fn emit_struct_lit_fields_assign_nums(st_out: StructOut, nodes: Vec<Expr>, lit_idx: i32, field_i: i32, count: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (field_i >= count) {
        return Ok("");
    }
    let v: i32 = struct_lit_field_idx(nodes, lit_idx, field_i);
    let n: i32 = eval_expr(nodes, v);
    let first: i32 = 0;
    if (field_i == 0) {
        first = 1;
    }
    let part: string = emit_struct_lit_field_assign(st_out, field_i, n, first)?;
    if (field_i + 1 >= count) {
        return Ok(part);
    }
    let rest: string = emit_struct_lit_fields_assign_nums(st_out, nodes, lit_idx, field_i + 1, count)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, part);
    let b2: StrBuilder = strbuf_push(b1, rest);
    return Ok(strbuf_finish(b2));
}

fn emit_struct_lit_c_expr(prof: FixtureProfile, src: string, st_out: StructOut, nodes: Vec<Expr>, lit_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (expr_ty_tag(nodes, lit_idx) != 11) {
        return Err(1);
    }
    let count: i32 = struct_lit_count(nodes, lit_idx);
    let ty_name: string = emit_struct_type_c_name(prof, src, st_out.name_off, st_out.name_len)?;
    let fields: string = emit_struct_lit_fields_assign_nums(st_out, nodes, lit_idx, 0, count)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "(");
    let b2: StrBuilder = strbuf_push(b1, ty_name);
    let b3: StrBuilder = strbuf_push(b2, ")");
    let b4: StrBuilder = strbuf_push(b3, fields);
    let b5: StrBuilder = strbuf_push(b4, " }");
    return Ok(strbuf_finish(b5));
}

fn expr_is_call1_struct_lit(nodes: Vec<Expr>, idx: i32, src: string, callee: string) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        CallExpr(off, ln, a0, a1, _, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, callee) != 1) {
                return 0;
            }
            if (a1 >= 0) {
                return 0;
            }
            let arg: Expr = vec_get(nodes, a0);
            return match arg {
                StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 1,
                Num(_) => 0,
                StrLit(_, _) => 0,
                Ident(_, _) => 0,
                Add(_, _) => 0,
                Sub(_, _) => 0,
                Mul(_, _) => 0,
                Div(_, _) => 0,
                CmpLt(_, _) => 0,
                CmpNe(_, _) => 0,
                CmpEq(_, _) => 0,
                CmpGe(_, _) => 0,
                Deref(_) => 0,
                Match(_, _, _) => 0,
                CallExpr(_, _, _, _, _, _, _) => 0,
                TryExpr(_) => 0,
                Index(_, _) => 0,
                SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
            };
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn return_is_call1_struct_lit(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, callee: string) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => expr_is_call1_struct_lit(nodes, e, src, callee),
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn emit_return_call1_struct_lit_line(prof: FixtureProfile, src: string, st_out: StructOut, callee_pfx: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let callee: string = emit_mangled_callee(callee_pfx, src, nodes, call_idx)?;
    let arg_idx: i32 = expr_call1_arg_idx(nodes, call_idx);
    if (arg_idx < 0) {
        return Err(1);
    }
    let lit: string = emit_struct_lit_c_expr(prof, src, st_out, nodes, arg_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return ");
    let b2: StrBuilder = strbuf_push(b1, callee);
    let b3: StrBuilder = strbuf_push(b2, "(");
    let b4: StrBuilder = strbuf_push(b3, lit);
    let b5: StrBuilder = strbuf_push(b4, ");\n");
    return Ok(strbuf_finish(b5));
}

fn return_is_add_idents(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, n1: string, n2: string) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => is_add_idents(nodes, e, src, n1, n2),
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
