    let b6: StrBuilder = strbuf_push(b5, "        case FX_{{MODULE_UPPER}}_EVENT_TAG_POINT:\n            {\n                int32_t x = _scrutinee.u.point.f0;\n                int32_t y = _scrutinee.u.point.f1;\n                _match_result = (x + y);\n                break;\n            }\n");
    let b7: StrBuilder = strbuf_push(b6, "        case FX_{{MODULE_UPPER}}_EVENT_TAG_STOP:\n            {\n                _match_result = 0;\n                break;\n            }\n    }\n    return _match_result;\n}\n\n");
    let b8: StrBuilder = strbuf_push(b7, "/* fx bootstrap emit: {{MODULE}}_main body_len=1 */\nint32_t fx_{{MODULE}}_main(void) {\n    return fx_{{MODULE}}_score((fx_{{MODULE}}_Event){ .tag = FX_{{MODULE_UPPER}}_EVENT_TAG_POINT, .u = { .point = { .f0 = {{X}}, .f1 = {{Y}} } } });\n}\n");
    return Ok(strbuf_finish(b8));
}

// CONV-3-BRIDGE-VEC-1/2 -- fx-owned Vec<enum> template.
fn emit_vec_enum_main_template() -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "/* fx bootstrap emit: {{MODULE}}_first body_len=2 */\n#include <stdint.h>\n#include <stddef.h>\n#include \"zspec/core.h\"\n\n");
    let b2: StrBuilder = strbuf_push(b1, "typedef enum {\n    FX_{{MODULE_UPPER}}_TOK_TAG_NUM,\n    FX_{{MODULE_UPPER}}_TOK_TAG_END,\n} fx_{{MODULE}}_TokTag;\n\n");
    let b3: StrBuilder = strbuf_push(b2, "typedef struct {\n    fx_{{MODULE}}_TokTag tag;\n    union {\n        int32_t num;\n    } u;\n} fx_{{MODULE}}_Tok;\n\n");
    let b4: StrBuilder = strbuf_push(b3, "typedef struct {\n    fx_{{MODULE}}_Tok* data;\n    size_t len;\n    size_t cap;\n} fx_Vec_Tok;\n\n");
    let b5: StrBuilder = strbuf_push(b4, "static __attribute__((unused)) fx_Vec_Tok fx_{{MODULE}}_vec_Tok_arena_new(core_Allocator* region, int32_t len) {\n    size_t n = (size_t)len;\n    fx_{{MODULE}}_Tok* p = (fx_{{MODULE}}_Tok*)core_mem_alloc(region, n * sizeof(fx_{{MODULE}}_Tok));\n    for (size_t i = 0; i < n; i++) {\n        fx_{{MODULE}}_Tok zero = {0};\n        p[i] = zero;\n    }\n    return (fx_Vec_Tok){ .data = p, .len = n, .cap = n };\n}\n\n");
    let b6: StrBuilder = strbuf_push(b5, "static __attribute__((unused)) fx_Vec_Tok fx_{{MODULE}}_vec_Tok_push_val(core_Allocator* region, fx_Vec_Tok v, fx_{{MODULE}}_Tok val) {\n    if (region == NULL) {\n        return (fx_Vec_Tok){ .data = v.data, .len = v.len + 1, .cap = v.cap };\n    }\n    size_t len = v.len;\n    size_t cap = v.cap;\n    fx_{{MODULE}}_Tok* data = v.data;\n    if (len >= cap) {\n        size_t new_cap = (cap == 0) ? 4 : (cap * 2);\n        fx_{{MODULE}}_Tok* nd = (fx_{{MODULE}}_Tok*)core_mem_alloc(region, new_cap * sizeof(fx_{{MODULE}}_Tok));\n        for (size_t i = 0; i < len; i++) {\n            nd[i] = data[i];\n        }\n        data = nd;\n        cap = new_cap;\n    }\n    data[len] = val;\n    return (fx_Vec_Tok){ .data = data, .len = len + 1, .cap = cap };\n}\n\n");
    let b7: StrBuilder = strbuf_push(b6, "int32_t fx_{{MODULE}}_first(fx_Vec_Tok v) {\n    fx_{{MODULE}}_Tok t = (v.data[0]);\n    fx_{{MODULE}}_Tok _scrutinee = t;\n    int32_t _match_result = 0;\n    switch (_scrutinee.tag) {\n        case FX_{{MODULE_UPPER}}_TOK_TAG_NUM:\n            {\n                int32_t n = _scrutinee.u.num;\n                _match_result = n;\n                break;\n            }\n        case FX_{{MODULE_UPPER}}_TOK_TAG_END:\n            {\n                _match_result = 0;\n                break;\n            }\n    }\n    return _match_result;\n}\n\n");
    let b8: StrBuilder = strbuf_push(b7, "/* fx bootstrap emit: {{MODULE}}_build body_len=5 */\nint32_t fx_{{MODULE}}_build(void) {\n    core_Allocator* r = core_arena_new(core_default_allocator(), (size_t)({{ARENA_SIZE}}));\n    fx_Vec_Tok v = fx_{{MODULE}}_vec_Tok_arena_new(r, 0);\n    v = fx_{{MODULE}}_vec_Tok_push_val(r, v, ((fx_{{MODULE}}_Tok){ .tag = FX_{{MODULE_UPPER}}_TOK_TAG_NUM, .u = { .num = {{PAYLOAD}} } }));\n    v = fx_{{MODULE}}_vec_Tok_push_val(r, v, ((fx_{{MODULE}}_Tok){ .tag = FX_{{MODULE_UPPER}}_TOK_TAG_END }));\n    core_mem_reset(r);\n    return fx_{{MODULE}}_first(v);\n}\n\n");
    let b9: StrBuilder = strbuf_push(b8, "/* fx bootstrap emit: {{MODULE}}_main body_len=1 */\nint32_t fx_{{MODULE}}_main(void) {\n    return fx_{{MODULE}}_build();\n}\n");
    return Ok(strbuf_finish(b9));
}

