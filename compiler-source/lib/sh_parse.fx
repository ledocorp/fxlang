// CONV-3-BRIDGE-RESULT-1/2 -- fx-owned Result guard+try template.
fn emit_result_guard_main_template() -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "#include <stdint.h>\n#include <stddef.h>\n#include \"zspec/core.h\"\n#define FX_CORE_ERR_DEFINED\n\n");
    let b2: StrBuilder = strbuf_push(b1, "#define FX_RESULT_TAG_OK 0\n#define FX_RESULT_TAG_ERR 1\n\n");
    let b3: StrBuilder = strbuf_push(b2, "typedef struct {\n    int32_t tag;\n    int32_t ok_val;\n    core_Err err_val;\n} fx_{{MODULE}}_Result_i32;\n\n");
    let b4: StrBuilder = strbuf_push(b3, "/* fx bootstrap emit: {{MODULE}}_parse_positive body_len=2 */\nfx_{{MODULE}}_Result_i32 fx_{{MODULE}}_parse_positive(int32_t n) {\n    if ((n <= 0)) {\n        return (fx_{{MODULE}}_Result_i32){ .tag = FX_RESULT_TAG_ERR, .ok_val = 0, .err_val = (core_Err)1 };\n    }\n    return (fx_{{MODULE}}_Result_i32){ .tag = FX_RESULT_TAG_OK, .ok_val = n, .err_val = CORE_OK };\n}\n\n");
    let b5: StrBuilder = strbuf_push(b4, "/* fx bootstrap emit: {{MODULE}}_main body_len=2 */\nfx_{{MODULE}}_Result_i32 fx_{{MODULE}}_main(void) {\n    fx_{{MODULE}}_Result_i32 __try_0 = fx_{{MODULE}}_parse_positive({{ARG}});\n    if (__try_0.tag != FX_RESULT_TAG_OK) {\n        return __try_0;\n    }\n    int32_t v = __try_0.ok_val;\n    return (fx_{{MODULE}}_Result_i32){ .tag = FX_RESULT_TAG_OK, .ok_val = v, .err_val = CORE_OK };\n}\n");
    return Ok(strbuf_finish(b5));
}

// CONV-3-BRIDGE-USINGCORE-1/2 -- fx-owned using-core two-step Result try template.
fn emit_using_core_main_template() -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "#include <stdint.h>\n#include <stddef.h>\n#include \"zspec/core.h\"\n#define FX_CORE_ERR_DEFINED\n\n");
    let b2: StrBuilder = strbuf_push(b1, "#define FX_RESULT_TAG_OK 0\n#define FX_RESULT_TAG_ERR 1\n\n");
    let b3: StrBuilder = strbuf_push(b2, "typedef struct {\n    int32_t tag;\n    int32_t ok_val;\n    core_Err err_val;\n} fx_{{MODULE}}_Result_i32;\n\n");
    let b4: StrBuilder = strbuf_push(b3, "/* fx bootstrap emit: {{MODULE}}_step1 body_len=1 */\nfx_{{MODULE}}_Result_i32 fx_{{MODULE}}_step1(void) {\n    return (fx_{{MODULE}}_Result_i32){ .tag = FX_RESULT_TAG_OK, .ok_val = {{STEP1}}, .err_val = CORE_OK };\n}\n\n");
    let b5: StrBuilder = strbuf_push(b4, "/* fx bootstrap emit: {{MODULE}}_step2 body_len=1 */\nfx_{{MODULE}}_Result_i32 fx_{{MODULE}}_step2(int32_t n) {\n    return (fx_{{MODULE}}_Result_i32){ .tag = FX_RESULT_TAG_OK, .ok_val = (n + {{ADD}}), .err_val = CORE_OK };\n}\n\n");
    let b6: StrBuilder = strbuf_push(b5, "/* fx bootstrap emit: {{MODULE}}_main body_len=3 */\nfx_{{MODULE}}_Result_i32 fx_{{MODULE}}_main(void) {\n    fx_{{MODULE}}_Result_i32 __try_0 = fx_{{MODULE}}_step1();\n    if (__try_0.tag != FX_RESULT_TAG_OK) {\n        return __try_0;\n    }\n    int32_t a = __try_0.ok_val;\n    fx_{{MODULE}}_Result_i32 __try_1 = fx_{{MODULE}}_step2(a);\n    if (__try_1.tag != FX_RESULT_TAG_OK) {\n        return __try_1;\n    }\n    int32_t b = __try_1.ok_val;\n    return (fx_{{MODULE}}_Result_i32){ .tag = FX_RESULT_TAG_OK, .ok_val = b, .err_val = CORE_OK };\n}\n");
    return Ok(strbuf_finish(b6));
}

// CONV-3-BRIDGE-IGNORE-1/2 -- fx-owned Pair Two(x,_) => x template.
fn emit_enum_payload_ignore_main_template() -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "/* fx bootstrap emit: {{MODULE}}_first body_len=1 */\n#include <stdint.h>\n\n");
    let b2: StrBuilder = strbuf_push(b1, "typedef enum {\n    FX_{{MODULE_UPPER}}_PAIR_TAG_TWO,\n} fx_{{MODULE}}_PairTag;\n\n");
    let b3: StrBuilder = strbuf_push(b2, "typedef struct {\n    fx_{{MODULE}}_PairTag tag;\n    union {\n        struct {\n            int32_t f0;\n            int32_t f1;\n        } two;\n    } u;\n} fx_{{MODULE}}_Pair;\n\n");
    let b4: StrBuilder = strbuf_push(b3, "int32_t fx_{{MODULE}}_first(fx_{{MODULE}}_Pair p) {\n    fx_{{MODULE}}_Pair _scrutinee = p;\n    int32_t _match_result = 0;\n    switch (_scrutinee.tag) {\n        case FX_{{MODULE_UPPER}}_PAIR_TAG_TWO:\n            {\n                int32_t x = _scrutinee.u.two.f0;\n                _match_result = x;\n                break;\n            }\n    }\n    return _match_result;\n}\n\n");
    let b5: StrBuilder = strbuf_push(b4, "/* fx bootstrap emit: {{MODULE}}_main body_len=1 */\nint32_t fx_{{MODULE}}_main(void) {\n    return fx_{{MODULE}}_first((fx_{{MODULE}}_Pair){ .tag = FX_{{MODULE_UPPER}}_PAIR_TAG_TWO, .u = { .two = { .f0 = {{F0}}, .f1 = {{F1}} } } });\n}\n");
    return Ok(strbuf_finish(b5));
