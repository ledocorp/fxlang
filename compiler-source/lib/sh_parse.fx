// SH-C-44 - fixed C substrate only. Every sh_lexer function body is emitted
// separately from its parsed FnOut below.
fn emit_sh_lexer_runtime_preamble() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("/* SH-C-44 - bootstrap real-lexer full (genuine emit) */\n#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n\ntypedef int core_Err;\n#define CORE_OK ((core_Err)0)\n#define CORE_ERR_OVERFLOW ((core_Err)1)\n#define CORE_ERR_OUT_OF_MEMORY ((core_Err)2)\n#define FX_RESULT_TAG_OK 0\n#define FX_RESULT_TAG_ERR 1\n\ntypedef struct {\n    int32_t* data;\n    size_t len;\n    size_t cap;\n} fx_Vec_i32;\n\ntypedef struct {\n    int32_t tag;\n    const char* ok_val;\n    core_Err err_val;\n} fx_sh_lexer_Result_string;\n\nstatic uint8_t fx_sh_bump_mem[1 << 20];\nstatic size_t fx_sh_bump_off;\n\nstatic void fx_sh_bump_reset(void) {\n    fx_sh_bump_off = 0;\n}\n\nstatic void* fx_sh_bump_alloc(size_t n) {\n    size_t align = (n + 7u) & ~7u;\n    if (fx_sh_bump_off + align > sizeof(fx_sh_bump_mem)) {\n        return NULL;\n    }\n    void* p = &fx_sh_bump_mem[fx_sh_bump_off];\n    fx_sh_bump_off += align;\n    return p;\n}\n\nstatic fx_Vec_i32 fx_vec_i32_new(void) {\n    return (fx_Vec_i32){ .data = NULL, .len = 0, .cap = 0 };\n}\n\nstatic fx_Vec_i32 fx_vec_i32_push(fx_Vec_i32 v, int32_t x) {\n    size_t len = v.len;\n    size_t cap = v.cap;\n    int32_t* data = v.data;\n    if (len >= cap) {\n        size_t new_cap = (cap == 0) ? 8 : (cap * 2);\n        int32_t* nd = (int32_t*)fx_sh_bump_alloc(new_cap * sizeof(int32_t));\n        if (nd == NULL) {\n            return v;\n        }\n        for (size_t i = 0; i < len; i++) {\n            nd[i] = data[i];\n        }\n        data = nd;\n        cap = new_cap;\n    }\n    data[len] = x;\n    return (fx_Vec_i32){ .data = data, .len = len + 1, .cap = cap };\n}\n\nstatic int32_t fx_vec_i32_get(fx_Vec_i32 v, int32_t idx) {\n    return v.data[idx];\n}\n\nstatic fx_sh_lexer_Result_string fx_sh_lexer_str_concat(const char* left, const char* right) {\n    size_t la = strlen(left);\n    size_t lb = strlen(right);\n    size_t total = la + lb + 1;\n    if (total < la || total < lb) {\n        return (fx_sh_lexer_Result_string){ .tag = FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = CORE_ERR_OVERFLOW };\n    }\n    char* out = (char*)fx_sh_bump_alloc(total);\n    if (out == NULL) {\n        return (fx_sh_lexer_Result_string){ .tag = FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = CORE_ERR_OUT_OF_MEMORY };\n    }\n    if (la > 0) {\n        memcpy(out, left, la);\n    }\n    if (lb > 0) {\n        memcpy(out + la, right, lb);\n    }\n    out[la + lb] = '\\0';\n    return (fx_sh_lexer_Result_string){ .tag = FX_RESULT_TAG_OK, .ok_val = out, .err_val = CORE_OK };\n}\n\n");
}

fn emit_sh_lexer_binop_c(callee_pfx: string, src: string, nodes: Vec<Expr>, idx: i32, op: string) -> Result<string, core_Err> effects { alloc, mut } {
    let left: string = emit_sh_lexer_expr_c(callee_pfx, src, nodes, expr_binop_l(nodes, idx))?;
    let right: string = emit_sh_lexer_expr_c(callee_pfx, src, nodes, expr_binop_r(nodes, idx))?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "(");
    let b2: StrBuilder = strbuf_push(b1, left);
    let b3: StrBuilder = strbuf_push(b2, op);
    let b4: StrBuilder = strbuf_push(b3, right);
    let b5: StrBuilder = strbuf_push(b4, ")");
    return Ok(strbuf_finish(b5));
}

fn emit_sh_lexer_call_args_c(callee_pfx: string, src: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let a0: i32 = expr_call_arg0_idx(nodes, call_idx);
    if (a0 < 0) {
        return Ok("");
    }
    let e0: string = emit_sh_lexer_expr_c(callee_pfx, src, nodes, a0)?;
    let b0: StrBuilder = strbuf_new();
    let cur: StrBuilder = strbuf_push(b0, e0);
    let a1: i32 = expr_call_arg1_idx(nodes, call_idx);
    if (a1 >= 0) {
        let e1: string = emit_sh_lexer_expr_c(callee_pfx, src, nodes, a1)?;
        cur = strbuf_push(cur, ", ");
        cur = strbuf_push(cur, e1);
    }
    let a2: i32 = expr_call_arg2_idx(nodes, call_idx);
    if (a2 >= 0) {
        let e2: string = emit_sh_lexer_expr_c(callee_pfx, src, nodes, a2)?;
        cur = strbuf_push(cur, ", ");
        cur = strbuf_push(cur, e2);
    }
    let a3: i32 = expr_call_arg3_idx(nodes, call_idx);
    if (a3 >= 0) {
        let e3: string = emit_sh_lexer_expr_c(callee_pfx, src, nodes, a3)?;
        cur = strbuf_push(cur, ", ");
        cur = strbuf_push(cur, e3);
    }
    let a4: i32 = expr_call_arg4_idx(nodes, call_idx);
    if (a4 >= 0) {
        let e4: string = emit_sh_lexer_expr_c(callee_pfx, src, nodes, a4)?;
        cur = strbuf_push(cur, ", ");
        cur = strbuf_push(cur, e4);
    }
    return Ok(strbuf_finish(cur));
}

fn emit_sh_lexer_call_c(callee_pfx: string, src: string, nodes: Vec<Expr>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let coff: i32 = expr_call2_callee_off(nodes, idx);
    let cln: i32 = expr_call2_callee_ln(nodes, idx);
    let a0: i32 = expr_call_arg0_idx(nodes, idx);
    let a1: i32 = expr_call_arg1_idx(nodes, idx);
    if (sh_lexer.slice_eq(src, coff, cln, "str_len") == 1) {
        let s: string = emit_sh_lexer_expr_c(callee_pfx, src, nodes, a0)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "((int32_t)strlen(");
        let b2: StrBuilder = strbuf_push(b1, s);
        let b3: StrBuilder = strbuf_push(b2, "))");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "str_byte_at") == 1) {
        let s: string = emit_sh_lexer_expr_c(callee_pfx, src, nodes, a0)?;
        let i: string = emit_sh_lexer_expr_c(callee_pfx, src, nodes, a1)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "((int32_t)(unsigned char)(");
        let b2: StrBuilder = strbuf_push(b1, s);
        let b3: StrBuilder = strbuf_push(b2, ")[");
        let b4: StrBuilder = strbuf_push(b3, i);
        let b5: StrBuilder = strbuf_push(b4, "])");
        return Ok(strbuf_finish(b5));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "vec.new") == 1) {
        return Ok("fx_vec_i32_new()");
    }
    let callee: string = "";
    if (sh_lexer.slice_eq(src, coff, cln, "vec.push") == 1) {
        callee = "fx_vec_i32_push";
    } else {
        if (sh_lexer.slice_eq(src, coff, cln, "vec.get") == 1) {
            callee = "fx_vec_i32_get";
        } else {
            if (sh_lexer.slice_eq(src, coff, cln, "vec_get") == 1) {
                callee = "fx_vec_i32_get";
            } else {
                if (sh_lexer.slice_eq(src, coff, cln, "str_concat") == 1) {
                    callee = "fx_sh_lexer_str_concat";
                } else {
                    callee = emit_mangled_callee(callee_pfx, src, nodes, idx)?;
                }
            }
        }
    }
    let args: string = emit_sh_lexer_call_args_c(callee_pfx, src, nodes, idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, callee);
    let b2: StrBuilder = strbuf_push(b1, "(");
    let b3: StrBuilder = strbuf_push(b2, args);
    let b4: StrBuilder = strbuf_push(b3, ")");
    return Ok(strbuf_finish(b4));
}

fn emit_sh_lexer_expr_c(callee_pfx: string, src: string, nodes: Vec<Expr>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let tag: i32 = expr_ty_tag(nodes, idx);
    if (tag == 1) {
        return str_from_i32(eval_expr(nodes, idx));
    }
    if (tag == 2) {
        // Bridge SH-C-44: raw memcpy slice (bootstrap slice_str/ident_char_str cannot copy '=' '+' in lit text).
        let lit: string = sh_lexer.slice_str(src, expr_strlit_off(nodes, idx), expr_strlit_ln(nodes, idx))?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "\"");
        let b2: StrBuilder = strbuf_push(b1, lit);
        let b3: StrBuilder = strbuf_push(b2, "\"");
        return Ok(strbuf_finish(b3));
    }
    if (tag == 3) {
        return emit_field_access_c(src, nodes, idx);
    }
    if (tag == 4) {
        return emit_sh_lexer_binop_c(callee_pfx, src, nodes, idx, " + ");
    }
    if (tag == 5) {
        return emit_sh_lexer_binop_c(callee_pfx, src, nodes, idx, " - ");
    }
    if (tag == 6) {
        return emit_sh_lexer_binop_c(callee_pfx, src, nodes, idx, " * ");
    }
    if (tag == 7) {
        return emit_sh_lexer_binop_c(callee_pfx, src, nodes, idx, " / ");
    }
    if (tag == 8) {
        return emit_sh_lexer_binop_c(callee_pfx, src, nodes, idx, " < ");
    }
    if (tag == 13) {
        return emit_sh_lexer_binop_c(callee_pfx, src, nodes, idx, " != ");
    }
    if (tag == 16) {
        return emit_sh_lexer_binop_c(callee_pfx, src, nodes, idx, " == ");
    }
    if (tag == 14) {
        return emit_sh_lexer_binop_c(callee_pfx, src, nodes, idx, " >= ");
    }
    if (tag == 10) {
        return emit_sh_lexer_call_c(callee_pfx, src, nodes, idx);
    }
    if (tag == 12) {
        return emit_sh_lexer_expr_c(callee_pfx, src, nodes, expr_try_inner_idx(nodes, idx));
    }
    return Err(1);
}

fn emit_sh_lexer_result_ctor_c(callee_pfx: string, src: string, fn_out: FnOut, expr_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let arg: i32 = expr_call_arg0_idx(fn_out.nodes, expr_idx);
    let payload: string = emit_sh_lexer_expr_c(callee_pfx, src, fn_out.nodes, arg)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "(fx_sh_lexer_Result_string){ .tag = ");
    if (expr_call_callee_is(fn_out.nodes, expr_idx, src, "Ok") == 1) {
        let b2: StrBuilder = strbuf_push(b1, "FX_RESULT_TAG_OK, .ok_val = ");
        let b3: StrBuilder = strbuf_push(b2, payload);
        let b4: StrBuilder = strbuf_push(b3, ", .err_val = CORE_OK }");
        return Ok(strbuf_finish(b4));
    }
    let b2: StrBuilder = strbuf_push(b1, "FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = (core_Err)");
    let b3: StrBuilder = strbuf_push(b2, payload);
    let b4: StrBuilder = strbuf_push(b3, " }");
    return Ok(strbuf_finish(b4));
}

fn emit_sh_lexer_struct_lit_c(prof: FixtureProfile, callee_pfx: string, src: string, st_out: StructOut, nodes: Vec<Expr>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let count: i32 = struct_lit_count(nodes, idx);
    let ty_name: string = emit_struct_type_c_name(prof, src, st_out.name_off, st_out.name_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "(");
    let b2: StrBuilder = strbuf_push(b1, ty_name);
    let cur: StrBuilder = strbuf_push(b2, "){ ");
    let i: i32 = 0;
    while (i < count) {
        if (i > 0) {
            cur = strbuf_push(cur, ", ");
        }
        let fname: string = variants_env_nth(st_out.fields_env, i)?;
        let val_idx: i32 = struct_lit_field_idx(nodes, idx, i);
        let val: string = emit_sh_lexer_expr_c(callee_pfx, src, nodes, val_idx)?;
        cur = strbuf_push(cur, ".");
        cur = strbuf_push(cur, fname);
        cur = strbuf_push(cur, " = ");
        cur = strbuf_push(cur, val);
        i = i + 1;
    }
    cur = strbuf_push(cur, " }");
    return Ok(strbuf_finish(cur));
}

fn emit_sh_lexer_value_expr_c(prof: FixtureProfile, callee_pfx: string, src: string, st_out: StructOut, nodes: Vec<Expr>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (expr_ty_tag(nodes, idx) == 11) {
        return emit_sh_lexer_struct_lit_c(prof, callee_pfx, src, st_out, nodes, idx);
    }
    return emit_sh_lexer_expr_c(callee_pfx, src, nodes, idx);
}

fn emit_sh_lexer_range_c(prof: FixtureProfile, callee_pfx: string, src: string, st_out: StructOut, fn_out: FnOut, start: i32, count: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (count <= 0) {
        return Ok("");
    }
    if (stmt_idx_is_nested(fn_out.stmts, start, start + count, start) == 1) {
        return emit_sh_lexer_range_c(prof, callee_pfx, src, st_out, fn_out, start + 1, count - 1);
    }
    let line: string = emit_sh_lexer_stmt_c(prof, callee_pfx, src, st_out, fn_out, start)?;
    let rest: string = emit_sh_lexer_range_c(prof, callee_pfx, src, st_out, fn_out, start + 1, count - 1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, line);
    let b2: StrBuilder = strbuf_push(b1, rest);
    return Ok(strbuf_finish(b2));
}

fn emit_sh_lexer_try_let_c(callee_pfx: string, src: string, fn_out: FnOut, stmt_idx: i32, expr_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let n: i32 = emit_parser_try_n_before(fn_out, stmt_idx);
    let ns: string = str_from_i32(n)?;
    let inner: i32 = expr_try_inner_idx(fn_out.nodes, expr_idx);
    let call: string = emit_sh_lexer_expr_c(callee_pfx, src, fn_out.nodes, inner)?;
    let var: string = sh_lexer.slice_str(src, stmt_let_var_off(fn_out.stmts, stmt_idx), stmt_let_var_ln(fn_out.stmts, stmt_idx))?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    fx_sh_lexer_Result_string __try_");
    let b2: StrBuilder = strbuf_push(b1, ns);
    let b3: StrBuilder = strbuf_push(b2, " = ");
    let b4: StrBuilder = strbuf_push(b3, call);
    let b5: StrBuilder = strbuf_push(b4, ";\n    if (__try_");
    let b6: StrBuilder = strbuf_push(b5, ns);
    let b7: StrBuilder = strbuf_push(b6, ".tag != FX_RESULT_TAG_OK) {\n        return __try_");
    let b8: StrBuilder = strbuf_push(b7, ns);
    let b9: StrBuilder = strbuf_push(b8, ";\n    }\n    const char* ");
    let b10: StrBuilder = strbuf_push(b9, var);
    let b11: StrBuilder = strbuf_push(b10, " = __try_");
    let b12: StrBuilder = strbuf_push(b11, ns);
    let b13: StrBuilder = strbuf_push(b12, ".ok_val;\n");
    return Ok(strbuf_finish(b13));
}

fn emit_sh_lexer_stmt_c(prof: FixtureProfile, callee_pfx: string, src: string, st_out: StructOut, fn_out: FnOut, stmt_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let tag: i32 = stmt_ty_tag(fn_out.stmts, stmt_idx);
    if (tag == 1) {
        let e: i32 = stmt_let_expr_idx(fn_out.stmts, stmt_idx);
        if (expr_ty_tag(fn_out.nodes, e) == 12) {
            return emit_sh_lexer_try_let_c(callee_pfx, src, fn_out, stmt_idx, e);
        }
        let var: string = sh_lexer.slice_str(src, stmt_let_var_off(fn_out.stmts, stmt_idx), stmt_let_var_ln(fn_out.stmts, stmt_idx))?;
        let ty: string = emit_let_bind_type_c_name(prof.mod_slug, src, fn_out, stmt_let_ty_off(fn_out.stmts, stmt_idx), stmt_let_ty_ln(fn_out.stmts, stmt_idx))?;
        let rhs: string = emit_sh_lexer_value_expr_c(prof, callee_pfx, src, st_out, fn_out.nodes, e)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "    ");
        let b2: StrBuilder = strbuf_push(b1, ty);
        let b3: StrBuilder = strbuf_push(b2, " ");
        let b4: StrBuilder = strbuf_push(b3, var);
        let b5: StrBuilder = strbuf_push(b4, " = ");
        let b6: StrBuilder = strbuf_push(b5, rhs);
        let b7: StrBuilder = strbuf_push(b6, ";\n");
        return Ok(strbuf_finish(b7));
    }
    if (tag == 2) {
        let e: i32 = stmt_return_expr_idx(fn_out.stmts, stmt_idx);
        let rhs: string = "";
        if (expr_call_callee_is(fn_out.nodes, e, src, "Ok") == 1) {
            rhs = emit_sh_lexer_result_ctor_c(callee_pfx, src, fn_out, e)?;
        } else {
            if (expr_call_callee_is(fn_out.nodes, e, src, "Err") == 1) {
                rhs = emit_sh_lexer_result_ctor_c(callee_pfx, src, fn_out, e)?;
            } else {
                rhs = emit_sh_lexer_value_expr_c(prof, callee_pfx, src, st_out, fn_out.nodes, e)?;
            }
        }
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "    return ");
        let b2: StrBuilder = strbuf_push(b1, rhs);
        let b3: StrBuilder = strbuf_push(b2, ";\n");
        return Ok(strbuf_finish(b3));
    }
    if (tag == 3) {
        let lhs: string = sh_lexer.slice_str(src, stmt_assign_var_off(fn_out.stmts, stmt_idx), stmt_assign_var_ln(fn_out.stmts, stmt_idx))?;
        let rhs: string = emit_sh_lexer_value_expr_c(prof, callee_pfx, src, st_out, fn_out.nodes, stmt_assign_expr_idx(fn_out.stmts, stmt_idx))?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "    ");
        let b2: StrBuilder = strbuf_push(b1, lhs);
        let b3: StrBuilder = strbuf_push(b2, " = ");
        let b4: StrBuilder = strbuf_push(b3, rhs);
        let b5: StrBuilder = strbuf_push(b4, ";\n");
        return Ok(strbuf_finish(b5));
    }
    if (tag == 4) {
        let cond: string = emit_sh_lexer_expr_c(callee_pfx, src, fn_out.nodes, stmt_if_cond(fn_out.stmts, stmt_idx))?;
        let then_body: string = emit_sh_lexer_range_c(prof, callee_pfx, src, st_out, fn_out, stmt_if_then_start(fn_out.stmts, stmt_idx), stmt_if_then_len(fn_out.stmts, stmt_idx))?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "    if (");
        let b2: StrBuilder = strbuf_push(b1, cond);
        let b3: StrBuilder = strbuf_push(b2, ") {\n");
        let b4: StrBuilder = strbuf_push(b3, then_body);
        let el: i32 = stmt_if_else_len(fn_out.stmts, stmt_idx);
        if (el > 0) {
            let else_body: string = emit_sh_lexer_range_c(prof, callee_pfx, src, st_out, fn_out, stmt_if_else_start(fn_out.stmts, stmt_idx), el)?;
            let b5: StrBuilder = strbuf_push(b4, "    } else {\n");
            let b6: StrBuilder = strbuf_push(b5, else_body);
            let b7: StrBuilder = strbuf_push(b6, "    }\n");
            return Ok(strbuf_finish(b7));
        }
        let b5: StrBuilder = strbuf_push(b4, "    }\n");
        return Ok(strbuf_finish(b5));
    }
    if (tag == 5) {
        let cond: string = emit_sh_lexer_expr_c(callee_pfx, src, fn_out.nodes, stmt_while_cond(fn_out.stmts, stmt_idx))?;
        let body: string = emit_sh_lexer_range_c(prof, callee_pfx, src, st_out, fn_out, stmt_while_body_start(fn_out.stmts, stmt_idx), stmt_while_body_len(fn_out.stmts, stmt_idx))?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "    while (");
        let b2: StrBuilder = strbuf_push(b1, cond);
        let b3: StrBuilder = strbuf_push(b2, ") {\n");
        let b4: StrBuilder = strbuf_push(b3, body);
        let b5: StrBuilder = strbuf_push(b4, "    }\n");
        return Ok(strbuf_finish(b5));
    }
    if (tag == 6) {
        let coff: i32 = stmt_call_callee_off(fn_out.stmts, stmt_idx);
        let cln: i32 = stmt_call_callee_ln(fn_out.stmts, stmt_idx);
        let callee: string = sh_lexer.slice_str(src, coff, cln)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "    fx_sh_lexer_");
        let b2: StrBuilder = strbuf_push(b1, callee);
        let b3: StrBuilder = strbuf_push(b2, "();\n");
        return Ok(strbuf_finish(b3));
    }
    if (tag == 7) {
        return Ok("    break;\n");
    }
    if (tag == 9) {
        return Ok("    fx_sh_bump_reset();\n");
    }
    if (tag == 10) {
        return Ok("    continue;\n");
    }
    return Err(1);
}

fn emit_sh_lexer_fn_c(prof: FixtureProfile, callee_pfx: string, src: string, st_out: StructOut, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let sig: string = emit_fn_sig_open_line(prof.mod_slug, src, fn_out)?;
    let body: string = emit_sh_lexer_range_c(prof, callee_pfx, src, st_out, fn_out, fn_out.body_start, fn_out.body_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, sig);
    let b2: StrBuilder = strbuf_push(b1, body);
    let b3: StrBuilder = strbuf_push(b2, "}\n\n");
    return Ok(strbuf_finish(b3));
}

fn emit_real_lexer_full_module_bundle(prof: FixtureProfile, src: string, st_out: StructOut, f0: FnOut, f1: FnOut, f2: FnOut, f3: FnOut, f4: FnOut, f5: FnOut, f6: FnOut, f7: FnOut, f8: FnOut, f9: FnOut, f10: FnOut, f11: FnOut, f12: FnOut, f13: FnOut, f14: FnOut, f15: FnOut, f16: FnOut, f17: FnOut, f18: FnOut, f19: FnOut, f20: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let pre: string = emit_sh_lexer_runtime_preamble()?;
    let st: string = emit_struct_typedef_block(prof, src, st_out)?;
    let pfx: string = "fx_sh_lexer_";
    let b0: StrBuilder = strbuf_new();
    let cur: StrBuilder = strbuf_push(b0, pre);
    cur = strbuf_push(cur, st);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f0)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f1)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f2)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f3)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f4)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f5)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f6)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f7)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f8)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f9)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f10)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f11)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f12)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f13)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f14)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f15)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f16)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f17)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f18)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f19)?);
    cur = strbuf_push(cur, emit_sh_lexer_fn_c(prof, pfx, src, st_out, f20)?);
    return Ok(strbuf_finish(cur));
}

fn fn_name_is(src: string, fn_out: FnOut, want: string) -> i32 {
    return sh_lexer.slice_eq(src, fn_out.name_off, fn_out.name_len, want);
}

// SH-C-44 - parse the full real lexer and genuinely emit all 21 FnOut bodies.
fn parse_and_emit_bootstrap_real_lexer_full() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(1 << 22);
    let prof: FixtureProfile = fixture_profile_bootstrap_real_lexer_full()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let _skip: i32 = skip_module_preamble(buf.kinds, buf.vals, buf.lens, &mut pos)?;
    let st_out: StructOut = parse_struct_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, st_out.name_off, st_out.name_len, "TokBuf") != 1) {
        return Err(1);
    }
    if (st_out.field_count != 3) {
        return Err(1);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let push_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, push_fn, "push_tok") != 1) {
        return Err(1);
    }
    let f1: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f1, "is_space") != 1) {
        return Err(1);
    }
    let f2: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f2, "is_digit") != 1) {
        return Err(1);
    }
    let f3: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f3, "is_ident_start") != 1) {
        return Err(1);
    }
    let f4: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f4, "is_ident_part") != 1) {
        return Err(1);
    }
    let f5: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f5, "slice_eq") != 1) {
        return Err(1);
    }
    let f6: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f6, "ident_char_str") != 1) {
        return Err(1);
    }
    let f7: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f7, "slice_str") != 1) {
        return Err(1);
    }
    let f8: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f8, "upper_byte") != 1) {
        return Err(1);
    }
    let f9: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f9, "lower_byte") != 1) {
        return Err(1);
    }
    let f10: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f10, "mangle_upper_slice") != 1) {
        return Err(1);
    }
    let f11: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f11, "keyword_at") != 1) {
        return Err(1);
    }
    let lex_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, lex_fn, "lex") != 1) {
        return Err(1);
    }
    let f13: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f13, "expect_kind") != 1) {
        return Err(1);
    }
    let f14: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f14, "expect_num") != 1) {
        return Err(1);
    }
    let f15: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f15, "expect_ident") != 1) {
        return Err(1);
    }
    let f16: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f16, "expect_kw") != 1) {
        return Err(1);
    }
    let f17: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f17, "check_let_add") != 1) {
        return Err(1);
    }
    let f18: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f18, "check_fn_return") != 1) {
        return Err(1);
    }
    let f19: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f19, "check_while_loop") != 1) {
        return Err(1);
    }
    let smoke_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, smoke_fn, "smoke_tests") != 1) {
        return Err(1);
    }
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    let bundle: string = emit_real_lexer_full_module_bundle(prof, src, st_out, push_fn, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, lex_fn, f13, f14, f15, f16, f17, f18, f19, smoke_fn)?;
    let meta_st: string = emit_meta_line("sh_lexer_TokBuf", st_out.field_count)?;
    let meta_lex: string = emit_meta_line("sh_lexer_lex", lex_fn.body_len)?;
    let meta_push: string = emit_meta_line("sh_lexer_push_tok", push_fn.body_len)?;
    let meta_smoke: string = emit_meta_line("sh_lexer_smoke_tests", smoke_fn.body_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, meta_st);
    let b2: StrBuilder = strbuf_push(b1, meta_lex);
    let b3: StrBuilder = strbuf_push(b2, meta_push);
    let b4: StrBuilder = strbuf_push(b3, meta_smoke);
    let b5: StrBuilder = strbuf_push(b4, bundle);
    return Ok(strbuf_finish(b5));
}

// SH-C-45 - REAL-PARSE-RADIUS profile.
fn fixture_profile_bootstrap_real_parse_radius() -> Result<FixtureProfile, core_Err> effects { alloc, mut } {
    let inc: string = includes_stdint_stddef()?;
    return Ok(FixtureProfile {
        mod_slug: "sh_parse",
        main_meta: "sh_parse_skip_module_preamble",
        includes: inc,
        golden_path: "bootstrap_real_parse_radius.fx",
    });
}

// SH-C-45 - real StrBuilder + lexer/string substrate (NOT stub emit_strbuf_typedef_and_helpers).
fn emit_sh_parse_runtime_preamble() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("/* SH-C-45 - bootstrap real-parse radius (genuine emit) */\n#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n\ntypedef struct {\n    int32_t* data;\n    size_t len;\n    size_t cap;\n} fx_Vec_i32;\n\ntypedef struct {\n    char* data;\n    size_t len;\n    size_t cap;\n} fx_sh_parse_StrBuilder;\n\ntypedef struct {\n    int32_t tag;\n    const char* ok_val;\n    int err_val;\n} fx_lib_sh_lexer_Result_string;\n\nstatic uint8_t fx_sh_parse_bump_mem[1 << 20];\nstatic size_t fx_sh_parse_bump_off;\n\nstatic void fx_sh_parse_bump_reset(void) {\n    fx_sh_parse_bump_off = 0;\n}\n\nstatic void* fx_sh_parse_bump_alloc(size_t n) {\n    size_t align = (n + 7u) & ~7u;\n    if (fx_sh_parse_bump_off + align > sizeof(fx_sh_parse_bump_mem)) {\n        return NULL;\n    }\n    void* p = &fx_sh_parse_bump_mem[fx_sh_parse_bump_off];\n    fx_sh_parse_bump_off += align;\n    return p;\n}\n\nstatic fx_sh_parse_StrBuilder fx_sh_parse_strbuf_new(void) {\n    return (fx_sh_parse_StrBuilder){ .data = NULL, .len = 0, .cap = 0 };\n}\n\nstatic fx_sh_parse_StrBuilder fx_sh_parse_strbuf_push(fx_sh_parse_StrBuilder b, const char* s) {\n    size_t add = strlen(s);\n    size_t need = b.len + add + 1;\n    if (need > b.cap) {\n        size_t new_cap = (b.cap == 0) ? 64 : (b.cap * 2);\n        while (new_cap < need) {\n            new_cap = new_cap * 2;\n        }\n        char* nd = (char*)fx_sh_parse_bump_alloc(new_cap);\n        if (nd == NULL) {\n            return b;\n        }\n        if (b.len > 0 && b.data != NULL) {\n            memcpy(nd, b.data, b.len);\n        }\n        b.data = nd;\n        b.cap = new_cap;\n    }\n    if (add > 0) {\n        memcpy(b.data + b.len, s, add);\n    }\n    b.len = b.len + add;\n    b.data[b.len] = '\\0';\n    return b;\n}\n\nstatic const char* fx_sh_parse_strbuf_finish(fx_sh_parse_StrBuilder b) {\n    if (b.data == NULL) {\n        char* z = (char*)fx_sh_parse_bump_alloc(1);\n        if (z == NULL) {\n            return \"\";\n        }\n        z[0] = '\\0';\n        return z;\n    }\n    return b.data;\n}\n\nstatic int32_t fx_std_string_len(const char* s) {\n    return (int32_t)strlen(s);\n}\n\nstatic int32_t fx_std_string_byte_at(const char* s, int32_t i) {\n    return (int32_t)(unsigned char)s[i];\n}\n\nstatic int32_t fx_lib_sh_lexer_slice_eq(const char* src, int32_t start, int32_t len, const char* lit) {\n    if (((int32_t)strlen(lit)) != len) {\n        return 0;\n    }\n    int32_t i = 0;\n    while (i < len) {\n        if (((int32_t)(unsigned char)src[start + i]) != ((int32_t)(unsigned char)lit[i])) {\n            return 0;\n        }\n        i = i + 1;\n    }\n    return 1;\n}\n\nstatic fx_lib_sh_lexer_Result_string fx_lib_sh_lexer_slice_str(const char* src, int32_t start, int32_t len) {\n    if (len < 0) {\n        return (fx_lib_sh_lexer_Result_string){ .tag = 1, .ok_val = 0, .err_val = 1 };\n    }\n    char* out = (char*)fx_sh_parse_bump_alloc((size_t)len + 1);\n    if (out == NULL) {\n        return (fx_lib_sh_lexer_Result_string){ .tag = 1, .ok_val = 0, .err_val = 2 };\n    }\n    if (len > 0) {\n        memcpy(out, src + start, (size_t)len);\n    }\n    out[len] = '\\0';\n    return (fx_lib_sh_lexer_Result_string){ .tag = 0, .ok_val = out, .err_val = 0 };\n}\n\n");
}

fn emit_sh_parse_pick_st(src: string, fn_out: FnOut, mod_st: StructOut, imp_st: StructOut, param_st: StructOut) -> StructOut {
    if (fn_out.ret_is_result == 1) {
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "ImpOut") == 1) {
            return imp_st;
        }
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "ModOut") == 1) {
            return mod_st;
        }
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "ParamParseOut") == 1) {
            return param_st;
        }
    }
    return mod_st;
}

fn emit_real_parse_radius_fn(prof: FixtureProfile, src: string, mod_st: StructOut, imp_st: StructOut, param_st: StructOut, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let st: StructOut = emit_sh_parse_pick_st(src, fn_out, mod_st, imp_st, param_st);
    return emit_fn_parser_helper_block(prof, prof.mod_slug, src, st, fn_out);
}

fn emit_real_parse_radius_module_bundle(prof: FixtureProfile, src: string, mod_st: StructOut, imp_st: StructOut, param_st: StructOut, f0: FnOut, f1: FnOut, f2: FnOut, f3: FnOut, f4: FnOut, f5: FnOut, f6: FnOut, f7: FnOut, f8: FnOut, f9: FnOut, f10: FnOut, f11: FnOut, f12: FnOut, f13: FnOut, f14: FnOut, f15: FnOut, f16: FnOut, f17: FnOut, f18: FnOut, f19: FnOut, f20: FnOut, f21: FnOut, f22: FnOut, f23: FnOut, f24: FnOut, f25: FnOut, f26: FnOut, f27: FnOut, f28: FnOut, f29: FnOut, f30: FnOut, f31: FnOut, f32: FnOut, f33: FnOut, f34: FnOut, f35: FnOut, f36: FnOut, f37: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let pre: string = emit_sh_parse_runtime_preamble()?;
    let td_mod: string = emit_struct_typedef_block(prof, src, mod_st)?;
    let td_imp: string = emit_struct_typedef_block(prof, src, imp_st)?;
    let td_param: string = emit_struct_typedef_block(prof, src, param_st)?;
    let res_base: string = emit_result_base_typedefs(prof.mod_slug)?;
    let res_mod: string = emit_result_struct_typedef(prof.mod_slug, "ModOut")?;
    let res_imp: string = emit_result_struct_typedef(prof.mod_slug, "ImpOut")?;
    let res_param: string = emit_result_struct_typedef(prof.mod_slug, "ParamParseOut")?;
    // Forward decl - map_mut_ref_type_c calls map_type_span_to_c_mod before its definition.
    let fwd: string = "fx_sh_parse_Result_string fx_sh_parse_map_type_span_to_c_mod(const char* mod_slug, const char* src, int32_t off, int32_t ln);\n";
    let smoke: string = "\nint32_t fx_sh_parse_radius_smoke_tests(void) {\n    fx_sh_parse_bump_reset();\n    if (fx_sh_parse_type_span_is_vec(\"Vec<i32>\", 0, 8) != 1) {\n        return 1;\n    }\n    fx_sh_parse_Result_string mapped = fx_sh_parse_map_type_span_to_c_mod(\"sh_parse\", \"&mut i32\", 0, 8);\n    if (mapped.tag != FX_RESULT_TAG_OK) {\n        return 2;\n    }\n    if (fx_lib_sh_lexer_slice_eq(mapped.ok_val, 0, fx_std_string_len(mapped.ok_val), \"int32_t*\") != 1) {\n        return 3;\n    }\n    fx_sh_parse_Result_string rel = fx_sh_parse_include_relative_h(\"lib/sh_parse.fx\", \"sh_lexer\");\n    if (rel.tag != FX_RESULT_TAG_OK) {\n        return 4;\n    }\n    if (fx_sh_parse_find_last_slash(\"a/b/c\") != 3) {\n        return 5;\n    }\n    return 42;\n}\n";
    let b0: StrBuilder = strbuf_new();
    let cur: StrBuilder = strbuf_push(b0, pre);
    cur = strbuf_push(cur, td_mod);
    cur = strbuf_push(cur, td_imp);
    cur = strbuf_push(cur, td_param);
    cur = strbuf_push(cur, res_base);
    cur = strbuf_push(cur, res_mod);
    cur = strbuf_push(cur, res_imp);
    cur = strbuf_push(cur, res_param);
    cur = strbuf_push(cur, fwd);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f0)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f1)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f2)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f3)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f4)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f5)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f6)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f7)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f8)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f9)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f10)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f11)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f12)?);
    cur = strbuf_push(cur, emit_real_parse_radius_fn(prof, src, mod_st, imp_st, param_st, f13)?);
