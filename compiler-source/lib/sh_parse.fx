fn emit_importstdiofile_main_template() -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "#include <stdint.h>\n#include <stddef.h>\n#include \"zspec/core.h\"\n#include \"std/io.h\"\n#include \"std/string.h\"\n#define FX_CORE_ERR_DEFINED\n\n");
