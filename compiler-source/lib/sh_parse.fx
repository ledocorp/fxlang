    };
}

fn stmt_is_let_call2(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, var: string, callee: string, n0: i32, n1: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(off, ln, e, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, var) != 1) {
                return 0;
