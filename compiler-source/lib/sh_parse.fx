    if (fn_name_is(src, f1, "parse_module_decl") != 1) {
        return Err(1);
    }
    let f2: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f2, "parse_import_decl") != 1) {
