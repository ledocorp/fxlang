    let empty_stmts: Vec<Stmt> = vec_new(0);
    let bump_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    let main_empty: Vec<Expr> = vec_new(0);
