fn stmt_let_name_off(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(off, _, _, _, _) => off,
        Return(r) => r,
        Assign(a, _, _) => a,
        AssignPtr(a, _, _) => a,
        If(a, _, _, _, _) => a,
        While(a, _, _) => a,
        Call(a, _, _, _) => a,
        Break => 0,
        Continue => 0,
        Region(a, _, _) => a,
        IndexAssign(a, _, _) => a,
    };
}

fn stmt_let_name_ln(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(_, ln, _, _, _) => ln,
        Return(r) => r,
        Assign(_, b, _) => b,
        AssignPtr(_, b, _) => b,
        If(_, b, _, _, _) => b,
        While(_, b, _) => b,
        Call(_, b, _, _) => b,
        Break => 0,
        Continue => 0,
        Region(_, b, _) => b,
        IndexAssign(_, b, _) => b,
    };
}

fn stmt_let_expr(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(_, _, e, _, _) => e,
        Return(r) => r,
        Assign(_, _, c) => c,
        AssignPtr(_, _, c) => c,
        If(_, _, c, d, e) => c + d + e,
        While(_, _, c) => c,
        Call(_, _, _, a) => a,
        Break => 0,
        Continue => 0,
        Region(_, _, a) => a,
        IndexAssign(_, _, a) => a,
    };
}

fn stmt_return_expr(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => e,
        Let(_, _, e, _, _) => e,
        Assign(_, _, e) => e,
        AssignPtr(_, _, e) => e,
        If(a, b, c, d, e) => a + b + c + d + e,
        While(a, b, c) => a + b + c,
        Call(a, b, c, d) => a + b + c + d,
        Break => 0,
        Continue => 0,
        Region(a, b, c) => a + b + c,
        IndexAssign(a, b, c) => a + b + c,
    };
}

fn build_let_env_rec(stmts: Vec<Stmt>, idx: i32, stop: i32, nodes: Vec<Expr>, src: string, param_env: string, param_m: Map<string, i32>, env: string, struct_ret_env: string, ret_m: Map<string, i32>, let_i32_m: &mut Map<string, i32>, let_struct_m: &mut Map<string, i32>) -> Result<string, core_Err> effects { alloc, mut } {
    if (idx >= stop) {
        return Ok(env);
    }
    let tag: i32 = stmt_ty_tag(stmts, idx);
    if (tag == 1) {
        let off: i32 = stmt_let_name_off(stmts, idx);
        let ln: i32 = stmt_let_name_ln(stmts, idx);
        let e: i32 = stmt_let_expr(stmts, idx);
        return build_let_env_on_let(stmts, idx, stop, nodes, src, param_env, param_m, env, off, ln, e, struct_ret_env, ret_m, let_i32_m, let_struct_m);
    }
    return build_let_env_rec(stmts, idx + 1, stop, nodes, src, param_env, param_m, env, struct_ret_env, ret_m, let_i32_m, let_struct_m);
}

fn expr_diag_span_off(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        StrLit(off, ln) => {
            if (off + ln >= 0) {
                return off;
            }
            return 0;
        },
        Ident(off, ln) => {
            if (off + ln >= 0) {
                return off;
            }
            return 0;
        },
        Num(_) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        CallExpr(_, _, _, _, _, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn expr_diag_span_len(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        StrLit(off, ln) => {
            if (off + ln >= 0) {
                return ln;
            }
            return 0;
        },
        Ident(off, ln) => {
            if (off + ln >= 0) {
                return ln;
            }
            return 0;
        },
        Num(_) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        CallExpr(_, _, _, _, _, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

struct TypeDiag {
    code: i32,
    span_off: i32,
    span_len: i32,
}

fn type_diag_empty() -> TypeDiag {
    return TypeDiag { code: 0, span_off: 0, span_len: 0 };
}

fn check_return_ty_core(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, param_env: string, param_m: Map<string, i32>, ret_kind: i32, let_env: string, let_i32_m: Map<string, i32>, let_struct_m: Map<string, i32>, struct_ret_env: string, ret_m: Map<string, i32>, diag: &mut TypeDiag) -> Result<i32, core_Err> effects { alloc, mut } {
    let tag: i32 = stmt_ty_tag(stmts, idx);
    if (tag == 2) {
        let e: i32 = stmt_return_expr(stmts, idx);
        return check_return_expr_ty(nodes, e, src, param_env, let_env, struct_ret_env, param_m, let_i32_m, let_struct_m, ret_m, ret_kind, diag);
    }
    return Err(1);
}

fn check_return_expr_ty(nodes: Vec<Expr>, e: i32, src: string, param_env: string, let_env: string, struct_ret_env: string, param_m: Map<string, i32>, let_i32_m: Map<string, i32>, let_struct_m: Map<string, i32>, ret_m: Map<string, i32>, ret_kind: i32, diag: &mut TypeDiag) -> Result<i32, core_Err> effects { alloc, mut } {
    // SH-C-18 - Result Err is valid for any Result<T, core_Err> return.
    if (expr_call_callee_is(nodes, e, src, "Err") == 1) {
        return Ok(0);
    }
    // SH-C-18 - Result Ok(payload): check payload against unwrapped T kind.
    let check_idx: i32 = e;
    if (expr_call_callee_is(nodes, e, src, "Ok") == 1) {
        check_idx = expr_call_arg0_idx(nodes, e);
    }
    let et: i32 = infer_expr_ty_kind(nodes, check_idx, src, param_env, let_env, struct_ret_env, param_m, let_i32_m, let_struct_m, ret_m)?;
    if (ret_kind == ty_kind_i32()) {
        if (et != ty_kind_i32()) {
            diag.code = sh_diag.sh_code_return_mismatch();
            diag.span_off = expr_diag_span_off(nodes, e);
            diag.span_len = expr_diag_span_len(nodes, e);
            return Err(1);
        }
    }
    if (ret_kind == ty_kind_str()) {
        if (et != ty_kind_str()) {
            diag.code = sh_diag.sh_code_return_mismatch();
            diag.span_off = expr_diag_span_off(nodes, e);
            diag.span_len = expr_diag_span_len(nodes, e);
            return Err(1);
        }
    }
    if (ret_kind == ty_kind_struct()) {
        if (et != ty_kind_struct()) {
            diag.code = sh_diag.sh_code_return_mismatch();
            diag.span_off = expr_diag_span_off(nodes, e);
            diag.span_len = expr_diag_span_len(nodes, e);
            return Err(1);
        }
    }
    return Ok(0);
}

fn check_return_ty(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, param_env: string, param_m: Map<string, i32>, body_start: i32, ret_kind: i32, struct_ret_env: string, ret_m: Map<string, i32>, diag: &mut TypeDiag) -> Result<i32, core_Err> effects { alloc, mut } {
    let let_i32_m: Map<string, i32> = map_new();
    let let_struct_m: Map<string, i32> = map_new();
    let let_env: string = build_let_env_rec(stmts, body_start, idx, nodes, src, param_env, param_m, "|", struct_ret_env, ret_m, &mut let_i32_m, &mut let_struct_m)?;
    return check_return_ty_core(stmts, idx, nodes, src, param_env, param_m, ret_kind, let_env, let_i32_m, let_struct_m, struct_ret_env, ret_m, diag);
}

fn check_fn_body_returns_rec(stmts: Vec<Stmt>, body_start: i32, off: i32, count: i32, nodes: Vec<Expr>, src: string, param_env: string, param_m: Map<string, i32>, ret_kind: i32, struct_ret_env: string, ret_m: Map<string, i32>, diag: &mut TypeDiag) -> Result<i32, core_Err> effects { alloc, mut } {
    if (off >= count) {
        return Ok(0);
    }
    let idx: i32 = body_start + off;
    let tag: i32 = stmt_ty_tag(stmts, idx);
    if (tag == 2) {
        // SH-C-18 - check every return (Err early + Ok success paths).
        let _ok: i32 = check_return_ty(stmts, idx, nodes, src, param_env, param_m, body_start, ret_kind, struct_ret_env, ret_m, diag)?;
        return check_fn_body_returns_rec(stmts, body_start, off + 1, count, nodes, src, param_env, param_m, ret_kind, struct_ret_env, ret_m, diag);
    }
    return check_fn_body_returns_rec(stmts, body_start, off + 1, count, nodes, src, param_env, param_m, ret_kind, struct_ret_env, ret_m, diag);
}

fn check_fn_returns_diag(fn_out: FnOut, src: string, struct_ret_env: string, ret_m: Map<string, i32>, diag: &mut TypeDiag) -> Result<i32, core_Err> effects { alloc, mut } {
    let ret_kind: i32 = ret_ty_kind(src, fn_out);
    if (ret_kind == ty_kind_bad()) {
        return Err(1);
    }
    let param_m: Map<string, i32> = map_new();
    let _pf: i32 = fill_param_m_from_fn_out(fn_out, src, &mut param_m)?;
    return check_fn_body_returns_rec(fn_out.stmts, fn_out.body_start, 0, fn_out.body_len, fn_out.nodes, src, fn_out.param_env, param_m, ret_kind, struct_ret_env, ret_m, diag);
}

fn check_fn_returns(fn_out: FnOut, src: string) -> Result<i32, core_Err> effects { alloc, mut } {
    let discard: TypeDiag = type_diag_empty();
    let ret_m: Map<string, i32> = map_new();
    return check_fn_returns_diag(fn_out, src, "|", ret_m, &mut discard);
}

fn check_fn_returns_with_struct_ret(fn_out: FnOut, src: string, struct_ret_env: string, ret_m: Map<string, i32>) -> Result<i32, core_Err> effects { alloc, mut } {
    let discard: TypeDiag = type_diag_empty();
    return check_fn_returns_diag(fn_out, src, struct_ret_env, ret_m, &mut discard);
}

fn typecheck_rejects_str_return() -> Result<i32, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_parse());
