fn emit_let_add_idents_line(src: string, stmts: Vec<Stmt>, let_idx: i32, nodes: Vec<Expr>) -> Result<string, core_Err> effects { alloc, mut } {
    let var_off: i32 = stmt_let_var_off(stmts, let_idx);
    let var_ln: i32 = stmt_let_var_ln(stmts, let_idx);
    let var: string = sh_lexer.slice_str(src, var_off, var_ln)?;
    let e: i32 = stmt_let_expr_idx(stmts, let_idx);
    let left_idx: i32 = expr_add_operand_idx(nodes, e, 0);
    let right_idx: i32 = expr_add_operand_idx(nodes, e, 1);
    let off0: i32 = expr_ident_off(nodes, left_idx);
    let ln0: i32 = expr_ident_ln(nodes, left_idx);
    let off1: i32 = expr_ident_off(nodes, right_idx);
    let ln1: i32 = expr_ident_ln(nodes, right_idx);
    let n0: string = sh_lexer.slice_str(src, off0, ln0)?;
    let n1: string = sh_lexer.slice_str(src, off1, ln1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    int32_t ");
    let b2: StrBuilder = strbuf_push(b1, var);
    let b3: StrBuilder = strbuf_push(b2, " = (");
    let b4: StrBuilder = strbuf_push(b3, n0);
    let b5: StrBuilder = strbuf_push(b4, " + ");
    let b6: StrBuilder = strbuf_push(b5, n1);
    let b7: StrBuilder = strbuf_push(b6, ");\n");
    return Ok(strbuf_finish(b7));
}

fn emit_let_ident_rhs_line(src: string, stmts: Vec<Stmt>, let_idx: i32, nodes: Vec<Expr>) -> Result<string, core_Err> effects { alloc, mut } {
    let var_off: i32 = stmt_let_var_off(stmts, let_idx);
    let var_ln: i32 = stmt_let_var_ln(stmts, let_idx);
    let var: string = sh_lexer.slice_str(src, var_off, var_ln)?;
    let e: i32 = stmt_let_expr_idx(stmts, let_idx);
    let rhs_off: i32 = expr_ident_off(nodes, e);
    let rhs_ln: i32 = expr_ident_ln(nodes, e);
    let rhs: string = sh_lexer.slice_str(src, rhs_off, rhs_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    int32_t ");
    let b2: StrBuilder = strbuf_push(b1, var);
    let b3: StrBuilder = strbuf_push(b2, " = ");
    let b4: StrBuilder = strbuf_push(b3, rhs);
    let b5: StrBuilder = strbuf_push(b4, ";\n");
    return Ok(strbuf_finish(b5));
}

fn emit_fn_return_add_idents_block(mod_slug: string, src: string, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let sig_line: string = emit_fn_sig_open_line(mod_slug, src, fn_out)?;
    let ret_idx: i32 = stmt_return_expr_idx(fn_out.stmts, fn_out.body_start);
    let ret_line: string = emit_return_add_idents_line(src, fn_out.nodes, ret_idx)?;
