fn result_guard_src() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("using core;\n\nfn parse_positive(n: i32) -> Result<i32, core_Err> {\n    if (n <= 0) {\n        return Err(1);\n    }\n    return Ok(n);\n}\n\nfn main() -> Result<i32, core_Err> {\n    let v = parse_positive(10)?;\n    return Ok(v);\n}\n");
}

fn emit_parsed_ok_result_guard_module(prof: FixtureProfile, mod_inc: string, src: string, parse_fn: FnOut, main_fn: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let tags: string = emit_result_tag_defines()?;
    let result_td: string = emit_result_i32_typedef(prof.mod_slug)?;
    let empty_st: StructOut = StructOut {
        name_off: 0,
        name_len: 0,
        field_count: 0,
        fields_env: "",
    };
    let parse_blk: string = emit_fn_parser_helper_block(prof, prof.mod_slug, src, empty_st, parse_fn)?;
    let main_blk: string = emit_fn_parser_helper_block(prof, prof.mod_slug, src, empty_st, main_fn)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, pre);
    let b2: StrBuilder = strbuf_push(b1, tags);
    let b3: StrBuilder = strbuf_push(b2, result_td);
    let meta_parse: string = emit_meta_line("ok_result_guard_parse_positive", parse_fn.body_len)?;
    let b4: StrBuilder = strbuf_push(b3, meta_parse);
    let b5: StrBuilder = strbuf_push(b4, parse_blk);
    let meta_main: string = emit_meta_line(prof.main_meta, main_fn.body_len)?;
    let b6: StrBuilder = strbuf_push(b5, meta_main);
    let b7: StrBuilder = strbuf_push(b6, main_blk);
    return Ok(strbuf_finish(b7));
}

fn result_guard_emit_inner() -> Result<string, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_result_guard()?;
    let src: string = result_guard_src()?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let parse_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    return emit_parsed_ok_result_guard_module(prof, mod_inc, src, parse_fn, main_fn);
}

fn result_guard_parse_tests() -> Result<i32, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_ok_result_guard()?;
    let src: string = result_guard_src()?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let parse_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src, parse_fn.name_off, parse_fn.name_len, "parse_positive") != 1) {
        return Ok(861);
    }
    if (parse_fn.ret_is_result != 1) {
        return Ok(862);
    }
    if (sh_lexer.slice_eq(src, parse_fn.ret_ok_off, parse_fn.ret_ok_len, "i32") != 1) {
        return Ok(863);
    }
    if (sh_lexer.slice_eq(src, parse_fn.ret_err_off, parse_fn.ret_err_len, "core_Err") != 1) {
        return Ok(864);
    }
    if (fn_body_has_guard_err_ok(parse_fn, src, 1, "n") != 1) {
        return Ok(866);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Ok(868);
    }
    if (main_fn.ret_is_result != 1) {
        return Ok(869);
    }
    if (fn_body_has_try_return_ok(main_fn, src, "v", "parse_positive", 10, "v") != 1) {
        return Ok(870);
    }
    if (string.len(mod_inc) < 0) {
        return Ok(1);
    }
    let c_src: string = result_guard_emit_inner()?;
    if (string.len(c_src) < 1) {
        return Ok(872);
    }
    return Ok(42);
}

fn parse_and_emit_ok_result_guard() -> Result<string, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_ok_result_guard()?;
    let src: string = result_guard_src()?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let parse_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src, parse_fn.name_off, parse_fn.name_len, "parse_positive") != 1) {
        return Err(1);
    }
    if (parse_fn.ret_is_result != 1) {
        return Err(1);
    }
    if (fn_body_has_guard_err_ok(parse_fn, src, 1, "n") != 1) {
        return Err(1);
    }
    let tc_parse: i32 = check_fn_returns(parse_fn, src)?;
    if (tc_parse != 0) {
        return Err(1);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (fn_body_has_try_return_ok(main_fn, src, "v", "parse_positive", 10, "v") != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(main_fn, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    if (string.len(mod_inc) < 0) {
        return Err(1);
    }
    return result_guard_emit_inner();
}

