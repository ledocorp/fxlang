fn emit_enum_payload_value_expr(src: string, enum_ty: string, tag_name: string, union_field: string, spec: string, nodes: Vec<Expr>, a0: i32, a1: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let h0: StrBuilder = strbuf_new();
    let h1: StrBuilder = strbuf_push(h0, "((");
    let h2: StrBuilder = strbuf_push(h1, enum_ty);
    let h3: StrBuilder = strbuf_push(h2, "){ .tag = ");
    let head: string = strbuf_finish(strbuf_push(h3, tag_name));
    if (payload_spec_is_multi(spec) == 1) {
        if (a1 < 0) {
            return Err(1);
        }
        let v0: i32 = eval_expr(nodes, a0);
        let v1: i32 = eval_expr(nodes, a1);
        let s0: string = str_from_i32(v0)?;
        let s1: string = str_from_i32(v1)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, head);
        let b2: StrBuilder = strbuf_push(b1, ", .u = { .");
        let b3: StrBuilder = strbuf_push(b2, union_field);
        let b4: StrBuilder = strbuf_push(b3, " = { .f0 = ");
        let b5: StrBuilder = strbuf_push(b4, s0);
        let b6: StrBuilder = strbuf_push(b5, ", .f1 = ");
        let b7: StrBuilder = strbuf_push(b6, s1);
        let b8: StrBuilder = strbuf_push(b7, " } } })");
        return Ok(strbuf_finish(b8));
    }
    if (string.len(spec) < 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, head);
        let b2: StrBuilder = strbuf_push(b1, " })");
        return Ok(strbuf_finish(b2));
    }
    let u0: StrBuilder = strbuf_new();
    let u1: StrBuilder = strbuf_push(u0, head);
    let u2: StrBuilder = strbuf_push(u1, ", .u = { .");
    let uhead: string = strbuf_finish(strbuf_push(u2, union_field));
    if (expr_ty_tag(nodes, a0) == 2) {
        let lit_off: i32 = expr_strlit_off(nodes, a0);
        let lit_ln: i32 = expr_strlit_ln(nodes, a0);
        let lit_val: string = sh_lexer.slice_str(src, lit_off, lit_ln)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, uhead);
        let b2: StrBuilder = strbuf_push(b1, " = \"");
        let b3: StrBuilder = strbuf_push(b2, lit_val);
        let b4: StrBuilder = strbuf_push(b3, "\" } })");
        return Ok(strbuf_finish(b4));
    }
    let lit_val: i32 = eval_expr(nodes, a0);
    let lit_str: string = str_from_i32(lit_val)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, uhead);
    let b2: StrBuilder = strbuf_push(b1, " = ");
    let b3: StrBuilder = strbuf_push(b2, lit_str);
    let b4: StrBuilder = strbuf_push(b3, " } })");
    return Ok(strbuf_finish(b4));
}

fn emit_enum_variant_value_from_expr(prof: FixtureProfile, src: string, en_out: EnumOut, nodes: Vec<Expr>, expr_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let enum_ty: string = emit_enum_type_c_name(prof, src, en_out.name_off, en_out.name_len)?;
    if (expr_ty_tag(nodes, expr_idx) == 3) {
        let voff: i32 = expr_ident_off(nodes, expr_idx);
        let vln: i32 = expr_ident_ln(nodes, expr_idx);
        let vname: string = sh_lexer.slice_str(src, voff, vln)?;
        let tag_name: string = emit_enum_variant_tag_const(prof, src, en_out, vname)?;
        return emit_enum_payload_value_expr(src, enum_ty, tag_name, "", "", nodes, -1, -1);
    }
    if (expr_ty_tag(nodes, expr_idx) == 10) {
        let voff: i32 = expr_call2_callee_off(nodes, expr_idx);
        let vln: i32 = expr_call2_callee_ln(nodes, expr_idx);
        let vname: string = sh_lexer.slice_str(src, voff, vln)?;
        let tag_name: string = emit_enum_variant_tag_const(prof, src, en_out, vname)?;
        let spec: string = enum_variant_payload_spec(en_out, vname)?;
        if (string.len(spec) < 1) {
            return emit_enum_payload_value_expr(src, enum_ty, tag_name, "", "", nodes, -1, -1);
        }
        let union_field: string = payload_spec_union_field(spec)?;
        let a0: i32 = expr_call_arg0_idx(nodes, expr_idx);
        let a1: i32 = expr_call_arg1_idx(nodes, expr_idx);
        return emit_enum_payload_value_expr(src, enum_ty, tag_name, union_field, spec, nodes, a0, a1);
    }
    return Err(1);
}

fn emit_region_stmt_line(src: string, stmts: Vec<Stmt>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let off: i32 = stmt_region_var_off(stmts, idx);
    let ln: i32 = stmt_region_var_ln(stmts, idx);
    let sz: i32 = stmt_region_arena_size(stmts, idx);
    let rname: string = sh_lexer.slice_str(src, off, ln)?;
    let sz_str: string = str_from_i32(sz)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    core_Allocator* ");
    let b2: StrBuilder = strbuf_push(b1, rname);
    let b3: StrBuilder = strbuf_push(b2, " = core_arena_new(core_default_allocator(), (size_t)(");
    let b4: StrBuilder = strbuf_push(b3, sz_str);
    let b5: StrBuilder = strbuf_push(b4, "));\n");
    return Ok(strbuf_finish(b5));
}

fn emit_let_vec_new_stmt_line(prof: FixtureProfile, src: string, region_name: string, var_off: i32, var_ln: i32, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let var: string = sh_lexer.slice_str(src, var_off, var_ln)?;
    let cap_arg: i32 = expr_call_arg0_idx(nodes, call_idx);
    let cap_str: string = str_from_i32(eval_expr(nodes, cap_arg))?;
    let pfx: string = profile_callee_prefix(prof)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    fx_Vec_Tok ");
    let b2: StrBuilder = strbuf_push(b1, var);
    let b3: StrBuilder = strbuf_push(b2, " = ");
    let b4: StrBuilder = strbuf_push(b3, pfx);
    let b5: StrBuilder = strbuf_push(b4, "vec_Tok_arena_new(");
    let b6: StrBuilder = strbuf_push(b5, region_name);
    let b7: StrBuilder = strbuf_push(b6, ", ");
    let b8: StrBuilder = strbuf_push(b7, cap_str);
    let b9: StrBuilder = strbuf_push(b8, ");\n");
    return Ok(strbuf_finish(b9));
}

fn emit_assign_vec_push_stmt_line(prof: FixtureProfile, src: string, en_out: EnumOut, region_name: string, lhs_off: i32, lhs_ln: i32, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let lhs: string = sh_lexer.slice_str(src, lhs_off, lhs_ln)?;
    let vec_arg: i32 = expr_call_arg0_idx(nodes, call_idx);
    let elem_arg: i32 = expr_call_arg1_idx(nodes, call_idx);
    let vec_name: string = emit_field_access_c(src, nodes, vec_arg)?;
    let elem_val: string = emit_enum_variant_value_from_expr(prof, src, en_out, nodes, elem_arg)?;
    let pfx: string = profile_callee_prefix(prof)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, lhs);
    let b3: StrBuilder = strbuf_push(b2, " = ");
    let b4: StrBuilder = strbuf_push(b3, pfx);
    let b5: StrBuilder = strbuf_push(b4, "vec_Tok_push_val(");
    let b6: StrBuilder = strbuf_push(b5, region_name);
    let b7: StrBuilder = strbuf_push(b6, ", ");
    let b8: StrBuilder = strbuf_push(b7, vec_name);
    let b9: StrBuilder = strbuf_push(b8, ", ");
    let b10: StrBuilder = strbuf_push(b9, elem_val);
    let b11: StrBuilder = strbuf_push(b10, ");\n");
    return Ok(strbuf_finish(b11));
}

fn emit_region_reset_line(region_name: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    core_mem_reset(");
    let b2: StrBuilder = strbuf_push(b1, region_name);
    let b3: StrBuilder = strbuf_push(b2, ");\n");
    return Ok(strbuf_finish(b3));
}

fn emit_return_call1_with_region_reset_line(region_name: string, callee_pfx: string, src: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let reset: string = emit_region_reset_line(region_name)?;
    let ret: string = emit_return_call1_expr_line(callee_pfx, src, nodes, call_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, reset);
    let b2: StrBuilder = strbuf_push(b1, ret);
    return Ok(strbuf_finish(b2));
}

fn emit_build_vec_body_stmt_line(prof: FixtureProfile, src: string, en_out: EnumOut, callee_pfx: string, region_name: string, fn_out: FnOut, stmt_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let tag: i32 = stmt_ty_tag(fn_out.stmts, stmt_idx);
    if (tag == 9) {
        return emit_region_stmt_line(src, fn_out.stmts, stmt_idx);
    }
    if (tag == 1) {
        let off: i32 = stmt_let_var_off(fn_out.stmts, stmt_idx);
        let ln: i32 = stmt_let_var_ln(fn_out.stmts, stmt_idx);
        let e: i32 = stmt_let_expr_idx(fn_out.stmts, stmt_idx);
        if (expr_call_callee_is(fn_out.nodes, e, src, "vec_new") != 1) {
            return Err(1);
        }
        return emit_let_vec_new_stmt_line(prof, src, region_name, off, ln, fn_out.nodes, e);
    }
    if (tag == 3) {
        let off: i32 = stmt_assign_var_off(fn_out.stmts, stmt_idx);
        let ln: i32 = stmt_assign_var_ln(fn_out.stmts, stmt_idx);
        let e: i32 = stmt_assign_expr_idx(fn_out.stmts, stmt_idx);
        if (expr_call_callee_is(fn_out.nodes, e, src, "vec_push") != 1) {
            return Err(1);
        }
        return emit_assign_vec_push_stmt_line(prof, src, en_out, region_name, off, ln, fn_out.nodes, e);
    }
    if (tag == 2) {
        let e: i32 = stmt_return_expr_idx(fn_out.stmts, stmt_idx);
        return emit_return_call1_with_region_reset_line(region_name, callee_pfx, src, fn_out.nodes, e);
    }
    return Err(1);
}

fn emit_build_vec_body_stmts_rest(prof: FixtureProfile, src: string, en_out: EnumOut, callee_pfx: string, region_name: string, fn_out: FnOut, off: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (off >= fn_out.body_len) {
        return Ok("");
    }
    let stmt_idx: i32 = fn_out.body_start + off;
    let line: string = emit_build_vec_body_stmt_line(prof, src, en_out, callee_pfx, region_name, fn_out, stmt_idx)?;
    let rest: string = emit_build_vec_body_stmts_rest(prof, src, en_out, callee_pfx, region_name, fn_out, off + 1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, line);
    let b2: StrBuilder = strbuf_push(b1, rest);
    return Ok(strbuf_finish(b2));
}

fn emit_fn_build_vec_enum_block(src: string, prof: FixtureProfile, en_out: EnumOut, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let reg_idx: i32 = fn_out.body_start;
    let reg_off: i32 = stmt_region_var_off(fn_out.stmts, reg_idx);
    let reg_ln: i32 = stmt_region_var_ln(fn_out.stmts, reg_idx);
    let region_name: string = sh_lexer.slice_str(src, reg_off, reg_ln)?;
    let callee_pfx: string = profile_callee_prefix(prof)?;
    return emit_build_vec_body_stmts_rest(prof, src, en_out, callee_pfx, region_name, fn_out, 0);
}

fn emit_return_call0_expr_line(callee_pfx: string, src: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let callee: string = emit_mangled_callee(callee_pfx, src, nodes, call_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return ");
    let b2: StrBuilder = strbuf_push(b1, callee);
    let b3: StrBuilder = strbuf_push(b2, "();\n");
    return Ok(strbuf_finish(b3));
}

fn expr_is_call0(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        CallExpr(_, _, a0, a1, _, _, _) => {
            if (a0 >= 0) {
                return 0;
            }
            if (a1 >= 0) {
                return 0;
            }
            return 1;
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn emit_fn_return_call0_block(mod_slug: string, src: string, callee_pfx: string, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let sig: string = emit_fn_sig_open_line(mod_slug, src, fn_out)?;
    let ret_idx: i32 = stmt_return_expr_idx(fn_out.stmts, fn_out.body_start);
    if (expr_is_call0(fn_out.nodes, ret_idx) != 1) {
        return Err(1);
    }
    let ret_line: string = emit_return_call0_expr_line(callee_pfx, src, fn_out.nodes, ret_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, sig);
    let b2: StrBuilder = strbuf_push(b1, ret_line);
    let b3: StrBuilder = strbuf_push(b2, "}\n\n");
    return Ok(strbuf_finish(b3));
}

fn emit_fn_call0_return_block(mod_slug: string, src: string, callee_pfx: string, fn_out: FnOut, callee: string) -> Result<string, core_Err> effects { alloc, mut } {
    let ret_idx: i32 = stmt_return_expr_idx(fn_out.stmts, fn_out.body_start);
    if (expr_call_callee_is(fn_out.nodes, ret_idx, src, callee) != 1) {
        return Err(1);
    }
    return emit_fn_return_call0_block(mod_slug, src, callee_pfx, fn_out);
}

fn emit_parsed_ok_vec_enum_module(prof: FixtureProfile, mod_inc: string, src: string, en_out: EnumOut, first_fn: FnOut, build_fn: FnOut, main_fn: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let enum_blk: string = emit_enum_typedef_block(prof, src, en_out)?;
    let vec_struct: string = emit_vec_tok_struct_typedef()?;
    let helpers: string = emit_vec_enum_helpers(prof, src, en_out)?;
    let first_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, first_fn)?;
    let first_body: string = emit_fn_first_vec_get_match_block(src, prof, en_out, first_fn)?;
    let build_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, build_fn)?;
    let build_body: string = emit_fn_build_vec_enum_block(src, prof, en_out, build_fn)?;
    let pfx: string = profile_callee_prefix(prof)?;
    let main_blk: string = emit_fn_return_call0_block(prof.mod_slug, src, pfx, main_fn)?;
    let b0: StrBuilder = strbuf_new();
    let meta_first: string = emit_meta_line("ok_vec_enum_first", first_fn.body_len)?;
    let b1: StrBuilder = strbuf_push(b0, meta_first);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, enum_blk);
    let b4: StrBuilder = strbuf_push(b3, vec_struct);
    let b5: StrBuilder = strbuf_push(b4, helpers);
    let b6: StrBuilder = strbuf_push(b5, first_sig);
    let b7: StrBuilder = strbuf_push(b6, first_body);
    let b8: StrBuilder = strbuf_push(b7, "}\n\n");
    let meta_build: string = emit_meta_line("ok_vec_enum_build", build_fn.body_len)?;
    let b9: StrBuilder = strbuf_push(b8, meta_build);
    let b10: StrBuilder = strbuf_push(b9, build_sig);
    let b11: StrBuilder = strbuf_push(b10, build_body);
    let b12: StrBuilder = strbuf_push(b11, "}\n\n");
    let meta_main: string = emit_meta_line(prof.main_meta, main_fn.body_len)?;
    let b13: StrBuilder = strbuf_push(b12, meta_main);
    let b14: StrBuilder = strbuf_push(b13, main_blk);
    return Ok(strbuf_finish(b14));
}

fn vec_enum_emit_inner() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_vec_enum()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let first_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    let build_empty: Vec<Expr> = vec_new(0);
    let build_empty_stmts: Vec<Stmt> = vec_new(0);
    let build_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, build_empty, build_empty_stmts)?;
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    return emit_parsed_ok_vec_enum_module(prof, mod_inc, src, en_out, first_fn, build_fn, main_fn);
}

fn vec_enum_parse_tests() -> Result<i32, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_ok_vec_enum()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, en_out.name_off, en_out.name_len, "Tok") != 1) {
        return Ok(901);
    }
    if (en_out.variant_count != 2) {
        return Ok(902);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let first_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (first_fn.body_len != 2) {
        return Ok(903);
    }
    if (return_is_match_on_ident(first_fn.stmts, first_fn.body_start + 1, first_fn.nodes, src, "t", 2) != 1) {
        return Ok(904);
    }
    let build_empty: Vec<Expr> = vec_new(0);
    let build_empty_stmts: Vec<Stmt> = vec_new(0);
    let build_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, build_empty, build_empty_stmts)?;
    if (build_fn.body_len != 5) {
        return Ok(905);
    }
    if (stmt_ty_tag(build_fn.stmts, build_fn.body_start) != 9) {
        return Ok(906);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Ok(907);
    }
    if (expr_call_callee_is(main_fn.nodes, stmt_return_expr_idx(main_fn.stmts, main_fn.body_start), src, "build") != 1) {
        return Ok(908);
    }
    if (string.len(mod_inc) < 0) {
        return Ok(1);
    }
    let c_src: string = vec_enum_emit_inner()?;
    if (string.len(c_src) < 1) {
        return Ok(909);
    }
    return Ok(42);
}

fn parse_and_emit_ok_vec_enum() -> Result<string, core_Err> effects { alloc, io, mut } {
    return vec_enum_emit_inner();
}

