    }
    let f24: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f24, "path_segment_count") != 1) {
        return Err(1);
    }
    let f25: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f25, "path_seg_start") != 1) {
        return Err(1);
    }
    let f26: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f26, "path_seg_len") != 1) {
        return Err(1);
    }
    let f27: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f27, "path_seg_eq") != 1) {
        return Err(1);
    }
    let f28: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f28, "path_join_suffix") != 1) {
        return Err(1);
    }
    let f29: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f29, "repeat_parent_dotdot") != 1) {
        return Err(1);
    }
    let f30: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f30, "relative_include_path") != 1) {
        return Err(1);
    }
    let f31: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f31, "include_relative_h") != 1) {
        return Err(1);
    }
    let f32: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f32, "mod_inc_has_line") != 1) {
        return Err(1);
    }
    let f33: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f33, "include_line_for_spec") != 1) {
        return Err(1);
    }
    let f34: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f34, "parse_using_decl") != 1) {
        return Err(1);
    }
    let f35: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f35, "parse_preamble_imports_rest") != 1) {
        return Err(1);
    }
    let f36: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f36, "parse_preamble_includes") != 1) {
        return Err(1);
    }
    let f37: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f37, "skip_module_preamble") != 1) {
        return Err(1);
    }
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    let bundle: string = emit_real_parse_radius_module_bundle(prof, src, mod_st, imp_st, param_st, f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18, f19, f20, f21, f22, f23, f24, f25, f26, f27, f28, f29, f30, f31, f32, f33, f34, f35, f36, f37)?;
    let meta_skip: string = emit_meta_line("sh_parse_skip_module_preamble", f37.body_len)?;
    let meta_inc: string = emit_meta_line("sh_parse_include_line_for_spec", f33.body_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, meta_skip);
    let b2: StrBuilder = strbuf_push(b1, meta_inc);
    let b3: StrBuilder = strbuf_push(b2, bundle);
    return Ok(strbuf_finish(b3));
}

// SH-C-51 - REAL-PARSE-RECURSIVE profile.
fn fixture_profile_bootstrap_real_parse_recursive() -> Result<FixtureProfile, core_Err> effects { alloc, mut } {
    let inc: string = includes_stdint_stddef()?;
    return Ok(FixtureProfile {
        mod_slug: "sh_parse",
        main_meta: "sh_parse_skip_module_preamble",
        includes: inc,
        golden_path: "bootstrap_real_parse_recursive.fx",
    });
}

fn emit_sh_parse_recursive_runtime_preamble() -> Result<string, core_Err> effects { alloc, mut } {
    let base: string = emit_sh_parse_runtime_preamble()?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "/* SH-C-51 - bootstrap real-parse recursive (genuine emit) */\n");
    let b2: StrBuilder = strbuf_push(b1, base);
    return Ok(strbuf_finish(b2));
}

fn emit_sh_parse_pick_st_recursive(src: string, fn_out: FnOut, mod_st: StructOut, imp_st: StructOut, param_st: StructOut, ret_st: StructOut, enum_st: StructOut, struct_st: StructOut) -> StructOut {
    let base: StructOut = emit_sh_parse_pick_st(src, fn_out, mod_st, imp_st, param_st);
    if (fn_out.ret_is_result == 1) {
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "RetTypeOut") == 1) { return ret_st; }
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "EnumOut") == 1) { return enum_st; }
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "StructOut") == 1) { return struct_st; }
    } else {
        if (sh_lexer.slice_eq(src, fn_out.ret_off, fn_out.ret_len, "RetTypeOut") == 1) { return ret_st; }
        if (sh_lexer.slice_eq(src, fn_out.ret_off, fn_out.ret_len, "EnumOut") == 1) { return enum_st; }
        if (sh_lexer.slice_eq(src, fn_out.ret_off, fn_out.ret_len, "StructOut") == 1) { return struct_st; }
        if (sh_lexer.slice_eq(src, fn_out.ret_off, fn_out.ret_len, "Map<string, i32>") == 1) { return mod_st; }
    }
    return base;
}

fn emit_real_parse_recursive_fn(prof: FixtureProfile, src: string, mod_st: StructOut, imp_st: StructOut, param_st: StructOut, ret_st: StructOut, enum_st: StructOut, struct_st: StructOut, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let st: StructOut = emit_sh_parse_pick_st_recursive(src, fn_out, mod_st, imp_st, param_st, ret_st, enum_st, struct_st);
    return emit_fn_parser_helper_block(prof, prof.mod_slug, src, st, fn_out);
}

fn emit_real_parse_recursive_module_bundle(prof: FixtureProfile, src: string, mod_st: StructOut, imp_st: StructOut, param_st: StructOut, ret_st: StructOut, enum_st: StructOut, struct_st: StructOut, f0: FnOut, f1: FnOut, f2: FnOut, f3: FnOut, f4: FnOut, f5: FnOut, f6: FnOut, f7: FnOut, f8: FnOut, f9: FnOut, f10: FnOut, f11: FnOut, f12: FnOut, f13: FnOut, f14: FnOut, f15: FnOut, f16: FnOut, f17: FnOut, f18: FnOut, f19: FnOut, f20: FnOut, f21: FnOut, f22: FnOut, f23: FnOut, f24: FnOut, f25: FnOut, f26: FnOut, f27: FnOut, f28: FnOut, f29: FnOut, f30: FnOut, f31: FnOut, f32: FnOut, f33: FnOut, f34: FnOut, f35: FnOut, f36: FnOut, f37: FnOut, f38: FnOut, f39: FnOut, f40: FnOut, f41: FnOut, f42: FnOut, f43: FnOut, f44: FnOut, f45: FnOut, f46: FnOut, f47: FnOut, f48: FnOut, f49: FnOut, f50: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let pre: string = emit_sh_parse_recursive_runtime_preamble()?;
