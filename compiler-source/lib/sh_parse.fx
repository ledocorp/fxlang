    let res_enum: string = emit_result_struct_typedef(prof.mod_slug, "EnumOut")?;
    let res_struct: string = emit_result_struct_typedef(prof.mod_slug, "StructOut")?;
    let str_from_i32_blk: string = emit_str_from_i32_helper_block(prof.mod_slug)?;
    let fwd: string = "fx_sh_parse_Result_string fx_sh_parse_map_type_span_to_c_mod(const char* mod_slug, const char* src, int32_t off, int32_t ln);\n";
    let smoke: string = "\nint32_t fx_sh_parse_recursive_smoke_tests(void) {\n    fx_sh_parse_bump_reset();\n    if (fx_sh_parse_type_span_is_vec(\"Vec<i32>\", 0, 8) != 1) {\n        return 1;\n    }\n    fx_sh_parse_Result_string mapped = fx_sh_parse_map_type_span_to_c_mod(\"sh_parse\", \"&mut i32\", 0, 8);\n    if (mapped.tag != FX_RESULT_TAG_OK) {\n        return 2;\n    }\n    if (fx_lib_sh_lexer_slice_eq(mapped.ok_val, 0, fx_std_string_len(mapped.ok_val), \"int32_t*\") != 1) {\n        return 3;\n    }\n    if (fx_sh_parse_is_c_keyword_word(\"return\") != 1) {\n        return 4;\n    }\n    if (fx_sh_parse_find_last_slash(\"a/b/c\") != 3) {\n        return 5;\n    }\n    return 42;\n}\n";
    let b0: StrBuilder = strbuf_new();
    let cur: StrBuilder = strbuf_push(b0, pre);
    cur = strbuf_push(cur, td_mod);
    cur = strbuf_push(cur, td_imp);
