    let b3: StrBuilder = strbuf_push(b2, "typedef struct {\n    int32_t tag;\n    int32_t ok_val;\n    core_Err err_val;\n} fx_{{MODULE}}_Result_i32;\n\n");
    let b4: StrBuilder = strbuf_push(b3, "/* fx bootstrap emit: {{MODULE}} body_len=7 */\nfx_{{MODULE}}_Result_i32 fx_{{MODULE}}_main(void) {\n");
    let b5: StrBuilder = strbuf_push(b4, "    core_Allocator* r = core_arena_new(core_default_allocator(), (size_t)({{ARENA}}));\n");
    let b6: StrBuilder = strbuf_push(b5, "    const char* path = \"{{PATH}}\";\n");
    let b7: StrBuilder = strbuf_push(b6, "    int32_t w = fx_std_io_write_file(path, \"{{CONTENT}}\");\n");
    let b8: StrBuilder = strbuf_push(b7, "    if ((w != 0)) {\n        core_mem_reset(r);\n        return (fx_{{MODULE}}_Result_i32){ .tag = FX_RESULT_TAG_OK, .ok_val = 1, .err_val = CORE_OK };\n    }\n");
    let b9: StrBuilder = strbuf_push(b8, "    fx_std_io_Result_string __try_0 = fx_std_io_read_file(path);\n");
    let b10: StrBuilder = strbuf_push(b9, "    if (__try_0.tag != FX_RESULT_TAG_OK) {\n        core_mem_reset(r);\n        return (fx_{{MODULE}}_Result_i32){ .tag = FX_RESULT_TAG_ERR, .ok_val = 0, .err_val = __try_0.err_val };\n    }\n");
    let b11: StrBuilder = strbuf_push(b10, "    const char* body = __try_0.ok_val;\n");
    let b12: StrBuilder = strbuf_push(b11, "    if (fx_std_string_compare(body, \"{{CONTENT}}\")) {\n        core_mem_reset(r);\n        return (fx_{{MODULE}}_Result_i32){ .tag = FX_RESULT_TAG_OK, .ok_val = 0, .err_val = CORE_OK };\n    }\n");
    let b13: StrBuilder = strbuf_push(b12, "    core_mem_reset(r);\n    return (fx_{{MODULE}}_Result_i32){ .tag = FX_RESULT_TAG_OK, .ok_val = 1, .err_val = CORE_OK };\n}\n");
    return Ok(strbuf_finish(b13));
}

