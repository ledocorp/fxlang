    let b16: StrBuilder = strbuf_push(b15, "    int32_t* p = (int32_t*)core_mem_alloc(region, n * sizeof(int32_t));\n");
    let b17: StrBuilder = strbuf_push(b16, "    for (size_t i = 0; i < n; i++) {\n");
    let b18: StrBuilder = strbuf_push(b17, "        p[i] = (int32_t)(i + 1);\n");
    let b19: StrBuilder = strbuf_push(b18, "    }\n");
    let b20: StrBuilder = strbuf_push(b19, "    return (fx_Vec_i32){ .data = p, .len = n, .cap = n };\n");
    let b21: StrBuilder = strbuf_push(b20, "}\n\n");
    let b22: StrBuilder = strbuf_push(b21, "fx_{{MODULE}}_Result_i32 fx_{{MODULE}}_fail(void) {\n");
    let b23: StrBuilder = strbuf_push(b22, "    return (fx_{{MODULE}}_Result_i32){ .tag = FX_RESULT_TAG_ERR, .ok_val = 0, .err_val = (core_Err){{ERR}} };\n");
