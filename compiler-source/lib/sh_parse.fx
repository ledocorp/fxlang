fn sh_ast_module_tests() -> Result<i32, core_Err> effects { alloc, mut } {
    // SH-ERG-4.1 - cross-module Expr constructor + tag from lib/sh_ast.
    let t: i32 = sh_ast.tag(Num(7));
    if (t != 1) {
        return Ok(345);
    }
    let t2: i32 = sh_ast.tag(TryExpr(0));
    if (t2 != 16) {
        return Ok(346);
    }
    let t3: i32 = sh_ast.tag(Index(0, 1));
    if (t3 != 17) {
        return Ok(347);
    }
    let t4: i32 = sh_ast.tag(SliceRange(0, 1, 2));
    let t5: i32 = sh_ast.tag(ArrayLit(0, 1, 2, 3, 4, 5, 6, 7, 8));
    if (t4 != 18) {
        return Ok(348);
    }
    return Ok(42);
}

fn typecheck_fixture_tests() -> Result<i32, core_Err> effects { alloc, io, mut } {
    let prof_ok: i32 = fixture_profile_tests()?;
    if (prof_ok != 42) {
        return Ok(prof_ok);
