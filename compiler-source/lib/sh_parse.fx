    }
    if (return_is_call2_nums(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "add", 3, 4) != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(main_fn, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    let add_ret_idx: i32 = stmt_return_expr_idx(add_fn.stmts, add_fn.body_start);
    let add_ret_line: string = emit_return_add_idents_line(src, add_fn.nodes, add_ret_idx)?;
    let ret_idx: i32 = stmt_return_expr_idx(main_fn.stmts, main_fn.body_start);
    let callee_pfx: string = profile_callee_prefix(prof)?;
    let main_ret: string = emit_return_call2_nums_line(callee_pfx, src, main_fn.nodes, ret_idx)?;
    let add_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, add_fn)?;
    let main_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, main_fn)?;
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let b0: StrBuilder = strbuf_new();
    let meta_add: string = emit_meta_line(prof.mod_slug, add_fn.body_len)?;
    let b1: StrBuilder = strbuf_push(b0, meta_add);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, add_sig);
    let b4: StrBuilder = strbuf_push(b3, add_ret_line);
    let b5: StrBuilder = strbuf_push(b4, "}\n\n");
    let meta_main: string = emit_meta_line(prof.main_meta, main_fn.body_len)?;
    let b6: StrBuilder = strbuf_push(b5, meta_main);
    let b7: StrBuilder = strbuf_push(b6, main_sig);
    let b8: StrBuilder = strbuf_push(b7, main_ret);
    let b9: StrBuilder = strbuf_push(b8, "}\n");
    return Ok(strbuf_finish(b9));
}

