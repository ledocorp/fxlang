fn mod_includes_parsed_tests() -> Result<i32, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_boot());
    let src3: string = "import math;\n";
    let buf3 = sh_lexer.lex(src3);
    let pos3: i32 = 0;
    let inc3: string = parse_preamble_includes(buf3.kinds, buf3.vals, buf3.lens, src3, "ok_import", &mut pos3)?;
    if (sh_lexer.slice_eq(inc3, 0, 19, "#include \"math.h\"\n\n") != 1) {
        return Ok(107);
    }
    let src4: string = "module boot; import sh_lexer; import sh_diag;";
    let buf4 = sh_lexer.lex(src4);
    let pos4: i32 = 0;
    let inc4: string = parse_preamble_includes(buf4.kinds, buf4.vals, buf4.lens, src4, "boot", &mut pos4)?;
    if (sh_lexer.slice_eq(inc4, 0, 23, "#include \"sh_lexer.h\"\n\n") != 1) {
        return Ok(108);
    }
    if (sh_lexer.slice_eq(inc4, 23, 22, "#include \"sh_diag.h\"\n\n") != 1) {
        return Ok(110);
    }
    let src5: string = "module boot; import std/fx_defaults;";
    let buf5 = sh_lexer.lex(src5);
    let pos5: i32 = 0;
    let inc5: string = parse_preamble_includes(buf5.kinds, buf5.vals, buf5.lens, src5, "lib/sh_lexer", &mut pos5)?;
    if (sh_lexer.slice_eq(inc5, 0, 33, "#include \"../std/fx_defaults.h\"\n\n") != 1) {
        return Ok(111);
    }
    let src0: string = "fn main() -> i32 {\n    return 0;\n}\n";
    let buf0 = sh_lexer.lex(src0);
    let pos0: i32 = 0;
    let inc0: string = parse_preamble_includes(buf0.kinds, buf0.vals, buf0.lens, src0, "ok_main", &mut pos0)?;
    if (string.len(inc0) != 0) {
        return Ok(115);
    }
    let src6: string = "module sh_parse; using core; import std/fx_defaults; import std/string; import sh_lexer; import sh_diag; import sh_ast;";
    let buf6 = sh_lexer.lex(src6);
    let pos6: i32 = 0;
    let inc6: string = parse_preamble_includes(buf6.kinds, buf6.vals, buf6.lens, src6, "lib/sh_parse", &mut pos6)?;
    if (mod_inc_has_line(inc6, "#include \"../std/fx_defaults.h\"") != 1) {
        return Ok(122);
    }
    if (mod_inc_has_line(inc6, "#include \"../std/string.h\"") != 1) {
        return Ok(123);
    }
    if (mod_inc_has_line(inc6, "#include \"sh_lexer.h\"") != 1) {
        return Ok(124);
    }
    if (mod_inc_has_line(inc6, "#include \"sh_diag.h\"") != 1) {
        return Ok(125);
    }
    if (mod_inc_has_line(inc6, "#include \"sh_ast.h\"") != 1) {
        return Ok(126);
    }
    return Ok(42);
}

