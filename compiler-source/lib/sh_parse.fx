// CONV-3-BRIDGE-DEFERARENAREAD-1/2 -- fx-owned arena + defer(read_first) + bare i32 return.
fn emit_deferarenaread_main_template() -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "/* fx bootstrap emit: {{MODULE}} body_len=2 */\n");
    let b2: StrBuilder = strbuf_push(b1, "#include <stdint.h>\n");
