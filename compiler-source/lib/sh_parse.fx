    let ty: string = strbuf_finish(strbuf_push(t2, "_Expr"));
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "static __attribute__((unused)) fx_Vec_Expr ");
    let b2: StrBuilder = strbuf_push(b1, pfx);
    let b3: StrBuilder = strbuf_push(b2, "vec_Expr_push_val(core_Allocator* region, fx_Vec_Expr v, ");
    let b4: StrBuilder = strbuf_push(b3, ty);
    let b5: StrBuilder = strbuf_push(b4, " val) {\n    if (region == NULL) {\n        return (fx_Vec_Expr){ .data = v.data, .len = v.len + 1, .cap = v.cap };\n    }\n    size_t len = v.len;\n    size_t cap = v.cap;\n    ");
    let b6: StrBuilder = strbuf_push(b5, ty);
    let b7: StrBuilder = strbuf_push(b6, "* data = (");
    let b8: StrBuilder = strbuf_push(b7, ty);
    let b9: StrBuilder = strbuf_push(b8, "*)v.data;\n    if (len >= cap) {\n        size_t new_cap = (cap == 0) ? 4 : (cap * 2);\n        ");
    let b10: StrBuilder = strbuf_push(b9, ty);
    let b11: StrBuilder = strbuf_push(b10, "* nd = (");
    let b12: StrBuilder = strbuf_push(b11, ty);
    let b13: StrBuilder = strbuf_push(b12, "*)core_mem_alloc(region, new_cap * sizeof(");
    let b14: StrBuilder = strbuf_push(b13, ty);
    let b15: StrBuilder = strbuf_push(b14, "));\n        for (size_t i = 0; i < len; i++) {\n            nd[i] = data[i];\n        }\n        data = nd;\n        cap = new_cap;\n    }\n    data[len] = val;\n    return (fx_Vec_Expr){ .data = data, .len = len + 1, .cap = cap };\n}\n\n");
    return Ok(strbuf_finish(b15));
}

fn emit_strbuf_typedef_and_helpers(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let pfx: string = strbuf_finish(b2);
    let t0: StrBuilder = strbuf_new();
    let t1: StrBuilder = strbuf_push(t0, pfx);
    let ty: string = strbuf_finish(strbuf_push(t1, "_StrBuilder"));
    let o0: StrBuilder = strbuf_new();
    let o1: StrBuilder = strbuf_push(o0, "typedef struct {\n    char* data;\n    size_t len;\n    size_t cap;\n} ");
    let o2: StrBuilder = strbuf_push(o1, ty);
    let o3: StrBuilder = strbuf_push(o2, ";\n\nstatic ");
    let o4: StrBuilder = strbuf_push(o3, ty);
    let o5: StrBuilder = strbuf_push(o4, " ");
    let o6: StrBuilder = strbuf_push(o5, pfx);
    let o7: StrBuilder = strbuf_push(o6, "_strbuf_new(void) {\n    return (");
    let o8: StrBuilder = strbuf_push(o7, ty);
    let o9: StrBuilder = strbuf_push(o8, "){ .data = NULL, .len = 0, .cap = 0 };\n}\n\nstatic __attribute__((unused)) ");
    let o10: StrBuilder = strbuf_push(o9, ty);
    let o11: StrBuilder = strbuf_push(o10, " ");
    let o12: StrBuilder = strbuf_push(o11, pfx);
    let o13: StrBuilder = strbuf_push(o12, "_strbuf_push(");
    let o14: StrBuilder = strbuf_push(o13, ty);
    let o15: StrBuilder = strbuf_push(o14, " b, const char* s) {\n    (void)b;\n    (void)s;\n    return b;\n}\n\nstatic const char* ");
    let o16: StrBuilder = strbuf_push(o15, pfx);
    let o17: StrBuilder = strbuf_push(o16, "_strbuf_finish(");
    let o18: StrBuilder = strbuf_push(o17, ty);
    let o19: StrBuilder = strbuf_push(o18, " b) {\n    (void)b;\n    return \"\";\n}\n\n");
    return Ok(strbuf_finish(o19));
}

fn mod_includes_empty() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("");
}

fn find_last_slash(s: string) -> i32 {
    let len: i32 = string.len(s);
    let i: i32 = len - 1;
    while (i >= 0) {
        if (sh_lexer.slice_eq(s, i, 1, "/") == 1) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

fn parent_base_path(base: string) -> Result<string, core_Err> effects { alloc, mut } {
    let slash: i32 = find_last_slash(base);
    if (slash < 0) {
        return Ok("");
    }
    return sh_lexer.slice_str(base, 0, slash);
}

fn import_base_for_spec(importer: string, import_spec: string) -> Result<string, core_Err> effects { alloc, mut } {
    if (find_last_slash(import_spec) >= 0) {
        return Ok(import_spec);
    }
    let slash: i32 = find_last_slash(importer);
    if (slash < 0) {
        return Ok(import_spec);
    }
    let parent: string = sh_lexer.slice_str(importer, 0, slash)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, parent);
    let b2: StrBuilder = strbuf_push(b1, "/");
    let b3: StrBuilder = strbuf_push(b2, import_spec);
    return Ok(strbuf_finish(b3));
}

fn slash_count(s: string) -> i32 {
    let len: i32 = string.len(s);
    let i: i32 = 0;
    let c: i32 = 0;
    while (i < len) {
        if (sh_lexer.slice_eq(s, i, 1, "/") == 1) {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

fn path_segment_count(s: string) -> i32 {
    if (string.len(s) == 0) {
        return 0;
    }
    return slash_count(s) + 1;
}

fn path_seg_start(s: string, seg_idx: i32) -> i32 {
    let len: i32 = string.len(s);
    if (len == 0) {
        return -1;
    }
    if (seg_idx == 0) {
        return 0;
    }
    let i: i32 = 0;
    let cur: i32 = 0;
    while (i < len) {
        if (sh_lexer.slice_eq(s, i, 1, "/") == 1) {
            cur = cur + 1;
            if (cur == seg_idx) {
                if (i + 1 >= len) {
                    return -1;
                }
                return i + 1;
            }
        }
        i = i + 1;
    }
    return -1;
}

fn path_seg_len(s: string, start: i32) -> i32 {
    let n: i32 = string.len(s);
    let i: i32 = start;
    while (i < n) {
        if (sh_lexer.slice_eq(s, i, 1, "/") == 1) {
            return i - start;
        }
        i = i + 1;
    }
    return n - start;
}

fn path_seg_eq(a: string, a_seg: i32, b: string, b_seg: i32) -> Result<i32, core_Err> effects { alloc, mut } {
    let a0: i32 = path_seg_start(a, a_seg);
    let b0: i32 = path_seg_start(b, b_seg);
    if (a0 < 0 || b0 < 0) {
        return Ok(0);
    }
    let al: i32 = path_seg_len(a, a0);
    let bl: i32 = path_seg_len(b, b0);
    if (al != bl) {
        return Ok(0);
    }
    let bs: string = sh_lexer.slice_str(b, b0, bl)?;
    return Ok(sh_lexer.slice_eq(a, a0, al, bs));
}

fn path_join_suffix(s: string, start_seg: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let nsegs: i32 = path_segment_count(s);
    if (start_seg >= nsegs) {
        return Ok("");
    }
    let s0: i32 = path_seg_start(s, start_seg);
    let sl0: i32 = path_seg_len(s, s0);
    let acc: string = sh_lexer.slice_str(s, s0, sl0)?;
    let seg: i32 = start_seg + 1;
    let cur: StrBuilder = strbuf_new();
    cur = strbuf_push(cur, acc);
    while (seg < nsegs) {
        let s1: i32 = path_seg_start(s, seg);
        let sl1: i32 = path_seg_len(s, s1);
        let piece: string = sh_lexer.slice_str(s, s1, sl1)?;
        cur = strbuf_push(cur, "/");
        cur = strbuf_push(cur, piece);
        seg = seg + 1;
    }
    return Ok(strbuf_finish(cur));
}

fn repeat_parent_dotdot(n: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (n <= 0) {
        return Ok("");
    }
    let b0: StrBuilder = strbuf_new();
    let i: i32 = 0;
    while (i < n) {
        b0 = strbuf_push(b0, "../");
        i = i + 1;
    }
    return Ok(strbuf_finish(b0));
}

fn relative_include_path(from_base: string, to_base: string) -> Result<string, core_Err> effects { alloc, mut } {
    let from_parent: string = parent_base_path(from_base)?;
    let from_depth: i32 = path_segment_count(from_parent);
    let to_depth: i32 = path_segment_count(to_base);
    let common: i32 = 0;
    while (common < from_depth && common < to_depth) {
        let eq: i32 = path_seg_eq(from_parent, common, to_base, common)?;
        if (eq != 1) {
            break;
        }
        common = common + 1;
    }
    let ups: i32 = from_depth - common;
    let prefix: string = repeat_parent_dotdot(ups)?;
    let suffix: string = path_join_suffix(to_base, common)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, prefix);
    let b2: StrBuilder = strbuf_push(b1, suffix);
    let b3: StrBuilder = strbuf_push(b2, ".h");
    return Ok(strbuf_finish(b3));
}

fn include_relative_h(importer: string, import_spec: string) -> Result<string, core_Err> effects { alloc, mut } {
    let to_base: string = import_base_for_spec(importer, import_spec)?;
    return relative_include_path(importer, to_base);
}

fn mod_inc_has_line(mod_inc: string, line: string) -> i32 {
    let hay_len: i32 = string.len(mod_inc);
    let needle_len: i32 = string.len(line);
    if (needle_len <= 0) {
        return 0;
    }
    let i: i32 = 0;
    while (i + needle_len <= hay_len) {
        if (sh_lexer.slice_eq(mod_inc, i, needle_len, line) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn include_line_for_spec(importer: string, spec: string) -> Result<string, core_Err> effects { alloc, mut } {
    let rel: string = include_relative_h(importer, spec)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "#include \"");
    let b2: StrBuilder = strbuf_push(b1, rel);
    let b3: StrBuilder = strbuf_push(b2, "\"\n");
    return Ok(strbuf_finish(b3));
}

fn parse_preamble_imports_rest(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, importer: string, pos: &mut i32, acc: string) -> Result<string, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Ok(acc);
    }
    let using_skipped: i32 = parse_using_decl(kinds, vals, lens, src, pos)?;
    if (using_skipped == 1) {
        return parse_preamble_imports_rest(kinds, vals, lens, src, importer, pos, acc);
    }
    let k: i32 = vec_get(kinds, *pos);
    if (k != 32) {
        return Ok(acc);
    }
    let imp: ImpOut = parse_import_decl(kinds, vals, lens, pos)?;
    let spec: string = sh_lexer.slice_str(src, imp.path_off, imp.path_len)?;
    let line: string = include_line_for_spec(importer, spec)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, acc);
    let b2: StrBuilder = strbuf_push(b1, line);
    let b3: StrBuilder = strbuf_push(b2, "\n");
    let acc3: string = strbuf_finish(b3);
    return parse_preamble_imports_rest(kinds, vals, lens, src, importer, pos, acc3);
}

fn parse_using_decl(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, pos: &mut i32) -> Result<i32, core_Err> {
    let n: i32 = kinds.len;
    if (*pos >= n) {
        return Ok(0);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Ok(0);
    }
    if (sh_lexer.slice_eq(src, vec_get(vals, *pos), vec_get(lens, *pos), "using") != 1) {
        return Ok(0);
    }
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 30) {
        return Err(1);
    }
    *pos = *pos + 1;
    if (*pos >= n) {
        return Err(1);
    }
    if (vec_get(kinds, *pos) != 13) {
        return Err(1);
    }
    *pos = *pos + 1;
    return Ok(1);
}

fn parse_preamble_includes(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, src: string, importer: string, pos: &mut i32) -> Result<string, core_Err> effects { alloc, mut } {
    let n: i32 = kinds.len;
    let acc: string = mod_includes_empty()?;
    if (*pos >= n) {
        return Ok(acc);
    }
    let k0: i32 = vec_get(kinds, *pos);
    if (k0 == 29) {
        let mod_out: ModOut = parse_module_decl(kinds, vals, lens, pos)?;
        if (mod_out.name_len < 0) {
            return Err(1);
        }
    }
    return parse_preamble_imports_rest(kinds, vals, lens, src, importer, pos, acc);
}

fn emit_file_preamble(prof: FixtureProfile, mod_inc: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, prof.includes);
    if (string.len(mod_inc) == 0) {
        return Ok(strbuf_finish(b1));
    }
    let b2: StrBuilder = strbuf_push(b1, mod_inc);
    return Ok(strbuf_finish(b2));
}

fn skip_module_preamble(kinds: Vec<i32>, vals: Vec<i32>, lens: Vec<i32>, pos: &mut i32) -> Result<i32, core_Err> {
    let n: i32 = kinds.len;
    while (*pos < n) {
        let k: i32 = vec_get(kinds, *pos);
        if (k == 32) {
            let imp: ImpOut = parse_import_decl(kinds, vals, lens, pos)?;
            if (imp.path_len < 0) {
                return Err(1);
            }
        } else {
            if (k == 29) {
                let mod_out: ModOut = parse_module_decl(kinds, vals, lens, pos)?;
                if (mod_out.name_len < 0) {
                    return Err(1);
                }
            } else {
                break;
            }
        }
    }
    return Ok(0);
}

fn expr_is_call1_strlit(nodes: Vec<Expr>, idx: i32, src: string, callee: string, lit: string) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        CallExpr(off, ln, a0, a1, _, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, callee) != 1) {
                return 0;
            }
            if (a1 >= 0) {
                return 0;
            }
            return is_strlit(nodes, a0, src, lit);
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn return_is_ok_strlit(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, lit: string) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => expr_is_call1_strlit(nodes, e, src, "Ok", lit),
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

