fn emit_parsed_enum_payload_match_module(prof: FixtureProfile, mod_inc: string, src: string, en_out: EnumOut, code_fn: FnOut, main_fn: FnOut, code_meta: string) -> Result<string, core_Err> effects { alloc, mut } {
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let enum_blk: string = emit_enum_typedef_block(prof, src, en_out)?;
    let code_blk: string = emit_fn_match_return_block(prof.mod_slug, src, prof, en_out, code_fn)?;
    let main_blk: string = emit_fn_call1_payload_return_block(prof.mod_slug, src, prof, en_out, main_fn)?;
    let b0: StrBuilder = strbuf_new();
    let meta_code: string = emit_meta_line(code_meta, code_fn.body_len)?;
    let b1: StrBuilder = strbuf_push(b0, meta_code);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, enum_blk);
    let b4: StrBuilder = strbuf_push(b3, code_blk);
    let meta_main: string = emit_meta_line(prof.main_meta, main_fn.body_len)?;
    let b5: StrBuilder = strbuf_push(b4, meta_main);
    let b6: StrBuilder = strbuf_push(b5, main_blk);
    return Ok(strbuf_finish(b6));
}

fn fixture_profile_ok_enum_payload() -> Result<FixtureProfile, core_Err> effects { alloc, mut } {
    let inc: string = includes_stdint_only()?;
    return Ok(FixtureProfile {
        mod_slug: "ok_enum_payload",
        main_meta: "ok_enum_payload_main",
        includes: inc,
        golden_path: "ok_enum_payload.fx",
    });
}

fn expr_call_callee_is(nodes: Vec<Expr>, idx: i32, src: string, callee: string) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        CallExpr(coff, cln, _, _, _, _, _) => sh_lexer.slice_eq(src, coff, cln, callee),
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn expr_is_call1_num(nodes: Vec<Expr>, idx: i32, src: string, callee: string, lit: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        CallExpr(coff, cln, a0, a1, _, _, _) => {
            if (a1 >= 0) {
                return 0;
            }
            if (sh_lexer.slice_eq(src, coff, cln, callee) != 1) {
                return 0;
            }
            return is_num(nodes, a0, lit);
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn expr_is_payload_ctor2_num(nodes: Vec<Expr>, idx: i32, src: string, variant: string, lit0: i32, lit1: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        CallExpr(coff, cln, a0, a1, _, _, _) => {
            if (a1 < 0) {
                return 0;
            }
            if (sh_lexer.slice_eq(src, coff, cln, variant) != 1) {
                return 0;
            }
            if (is_num(nodes, a0, lit0) != 1) {
                return 0;
            }
            return is_num(nodes, a1, lit1);
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn return_is_call1_payload2_num(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, callee: string, variant: string, lit0: i32, lit1: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => {
            if (expr_call_callee_is(nodes, e, src, callee) != 1) {
                return 0;
            }
            let arg_idx: i32 = expr_call1_arg_idx(nodes, e);
            if (arg_idx < 0) {
                return 0;
            }
            return expr_is_payload_ctor2_num(nodes, arg_idx, src, variant, lit0, lit1);
        },
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

