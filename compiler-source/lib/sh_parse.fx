        Ident(_, _) => -1,
        Add(_, _) => -1,
        Sub(_, _) => -1,
        Mul(_, _) => -1,
        Div(_, _) => -1,
        CmpLt(_, _) => -1,
        CmpNe(_, _) => -1,
        CmpEq(_, _) => -1,
