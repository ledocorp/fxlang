    if (fn_name_is(src, f63, "parse_expr") != 1) {
        return Err(1);
    }
    let f64: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f64, "parse_cond") != 1) {
        return Err(1);
    }
    let f65: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f65, "parse_arg_count") != 1) {
        return Err(1);
    }
    let f66: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f66, "parse_block_rest") != 1) {
        return Err(1);
    }
    let f67: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f67, "parse_block") != 1) {
        return Err(1);
    }
    let f68: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f68, "parse_region_arena_size") != 1) {
        return Err(1);
    }
    let f69: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f69, "parse_stmt") != 1) {
        return Err(1);
    }
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    let bundle: string = emit_real_parse_expr_stmt_module_bundle(prof, src, mod_st, imp_st, param_st, ret_st, enum_st, struct_st, parse_out_st, stmt_step_st, block_parse_out_st, arg_count_out_st, struct_lit_acc_st, f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18, f19, f20, f21, f22, f23, f24, f25, f26, f27, f28, f29, f30, f31, f32, f33, f34, f35, f36, f37, f38, f39, f40, f41, f42, f43, f44, f45, f46, f47, f48, f49, f50, f51, f52, f53, f54, f55, f56, f57, f58, f59, f60, f61, f62, f63, f64, f65, f66, f67, f68, f69)?;
    let meta_skip: string = emit_meta_line("sh_parse_skip_module_preamble", f37.body_len)?;
    let meta_factor: string = emit_meta_line("sh_parse_parse_factor", f59.body_len)?;
    let meta_stmt: string = emit_meta_line("sh_parse_parse_stmt", f69.body_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, meta_skip);
    let b2: StrBuilder = strbuf_push(b1, meta_factor);
    let b3: StrBuilder = strbuf_push(b2, meta_stmt);
    let b4: StrBuilder = strbuf_push(b3, bundle);
    return Ok(strbuf_finish(b4));
}

// SH-C-72 - Map type-span lowering helpers (type-span family; appended here so the
// live golden fn ordering of SH-C-55…71 stays stable).
fn type_span_is_map(src: string, off: i32, ln: i32) -> i32 {
    if (ln < 5) {
        return 0;
    }
    if (sh_lexer.slice_eq(src, off, 3, "Map") != 1) {
        return 0;
    }
    if (string.byte_at(src, off + 3) != 60) {
        return 0;
    }
    if (string.byte_at(src, off + ln - 1) != 62) {
        return 0;
    }
    return 1;
}

// FX-SH-NAT-6 - LV5 map ABI: `Map<string, i32>` and `Map<string, string>` (space-normalized for ss).
fn type_span_is_map_string_string(src: string, off: i32, ln: i32) -> i32 {
    let want: string = "Map<string,string>";
    let wi: i32 = 0;
    let si: i32 = 0;
    let wlen: i32 = string.len(want);
    while (si < ln) {
        let b: i32 = string.byte_at(src, off + si);
        if (b == 32) {
            si = si + 1;
            continue;
        }
        if (wi >= wlen) {
            return 0;
        }
        if (string.byte_at(want, wi) != b) {
            return 0;
        }
        wi = wi + 1;
        si = si + 1;
    }
    if (wi != wlen) {
        return 0;
    }
    return 1;
}

fn map_map_type_c(src: string, off: i32, ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (sh_lexer.slice_eq(src, off, ln, "Map<string, i32>") == 1) {
        return Ok("fx_Map_string_i32");
    }
    if (type_span_is_map_string_string(src, off, ln) == 1) {
        return Ok("fx_Map_string_string");
    }
    return Err(1);
}

// SH-C-72 - REAL-PARSE-MAP-EXPORTS profile (extends SH-C-71).
fn fixture_profile_bootstrap_real_parse_fn_def() -> Result<FixtureProfile, core_Err> effects { alloc, mut } {
    let inc: string = includes_stdint_stddef()?;
    return Ok(FixtureProfile {
        mod_slug: "sh_parse",
        main_meta: "sh_parse_skip_module_preamble",
        includes: inc,
        golden_path: "bootstrap_real_parse_fn_def.fx",
    });
}

