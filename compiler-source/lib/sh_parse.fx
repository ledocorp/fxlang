    }
    let ok_let_str: i32 = typecheck_accepts_typed_let_str_try()?;
    if (ok_let_str != 42) {
        return Ok(ok_let_str);
    }
    let bad_let_str: i32 = typecheck_rejects_typed_let_str_on_result_i32()?;
    if (bad_let_str != 42) {
        return Ok(bad_let_str);
    }
    let ok_fwd: i32 = typecheck_accepts_result_forward_struct()?;
    if (ok_fwd != 42) {
        return Ok(ok_fwd);
    }
    let bad_fwd: i32 = typecheck_rejects_result_forward_unknown()?;
