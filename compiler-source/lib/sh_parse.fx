fn stmt_is_call(stmts: Vec<Stmt>, idx: i32, src: string, name: string, argc: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Call(off, ln, argc_want, _) => {
            if (argc_want != argc) {
                return 0;
            }
            return sh_lexer.slice_eq(src, off, ln, name);
        },
        Let(_, _, _, _, _) => 0,
        Return(_) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
