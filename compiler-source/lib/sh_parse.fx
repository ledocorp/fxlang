fn includes_zspec_core() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("#include <stdint.h>\n#include <stddef.h>\n#include \"zspec/core.h\"\n#define FX_CORE_ERR_DEFINED\n\n");
}

fn fixture_profile_ok_vec_enum() -> Result<FixtureProfile, core_Err> effects { alloc, mut } {
    let inc: string = includes_zspec_core()?;
    return Ok(FixtureProfile {
        mod_slug: "ok_vec_enum",
        main_meta: "ok_vec_enum_main",
        includes: inc,
        golden_path: "ok_vec_enum.fx",
    });
}

fn emit_vec_enum_helpers(prof: FixtureProfile, src: string, en_out: EnumOut) -> Result<string, core_Err> effects { alloc, mut } {
    let ty_name: string = emit_enum_type_c_name(prof, src, en_out.name_off, en_out.name_len)?;
    let vec_name: string = "fx_Vec_Tok";
    let pfx: string = profile_callee_prefix(prof)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "static __attribute__((unused)) ");
    let b2: StrBuilder = strbuf_push(b1, vec_name);
    let b3: StrBuilder = strbuf_push(b2, " ");
    let b4: StrBuilder = strbuf_push(b3, pfx);
    let b5: StrBuilder = strbuf_push(b4, "vec_Tok_arena_new(core_Allocator* region, int32_t len) {\n    size_t n = (size_t)len;\n    ");
    let b6: StrBuilder = strbuf_push(b5, ty_name);
    let b7: StrBuilder = strbuf_push(b6, "* p = (");
    let b8: StrBuilder = strbuf_push(b7, ty_name);
    let b9: StrBuilder = strbuf_push(b8, "*)core_mem_alloc(region, n * sizeof(");
    let b10: StrBuilder = strbuf_push(b9, ty_name);
    let b11: StrBuilder = strbuf_push(b10, "));\n    for (size_t i = 0; i < n; i++) {\n        ");
    let b12: StrBuilder = strbuf_push(b11, ty_name);
    let b13: StrBuilder = strbuf_push(b12, " zero = {0};\n        p[i] = zero;\n    }\n    return (");
    let b14: StrBuilder = strbuf_push(b13, vec_name);
    let b15: StrBuilder = strbuf_push(b14, "){ .data = p, .len = n, .cap = n };\n}\n\nstatic __attribute__((unused)) ");
    let b16: StrBuilder = strbuf_push(b15, vec_name);
    let b17: StrBuilder = strbuf_push(b16, " ");
    let b18: StrBuilder = strbuf_push(b17, pfx);
    let b19: StrBuilder = strbuf_push(b18, "vec_Tok_push_val(core_Allocator* region, ");
    let b20: StrBuilder = strbuf_push(b19, vec_name);
    let b21: StrBuilder = strbuf_push(b20, " v, ");
    let b22: StrBuilder = strbuf_push(b21, ty_name);
    let b23: StrBuilder = strbuf_push(b22, " val) {\n    if (region == NULL) {\n        return (");
    let b24: StrBuilder = strbuf_push(b23, vec_name);
    let b25: StrBuilder = strbuf_push(b24, "){ .data = v.data, .len = v.len + 1, .cap = v.cap };\n    }\n    size_t len = v.len;\n    size_t cap = v.cap;\n    ");
    let b26: StrBuilder = strbuf_push(b25, ty_name);
    let b27: StrBuilder = strbuf_push(b26, "* data = v.data;\n    if (len >= cap) {\n        size_t new_cap = (cap == 0) ? 4 : (cap * 2);\n        ");
