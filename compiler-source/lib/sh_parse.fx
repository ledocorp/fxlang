fn parse_and_emit_ok_main() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_main()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let fn_out: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, "", &mut pos, empty, empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, fn_out.name_off, fn_out.name_len, "main") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_off, fn_out.ret_len, "i32") != 1) {
        return Err(1);
    }
    if (stmt_is_return(fn_out.stmts, fn_out.body_start, fn_out.nodes, 0) != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(fn_out, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    let ret_idx: i32 = stmt_return_expr_idx(fn_out.stmts, fn_out.body_start);
    let ret_val: i32 = eval_expr(fn_out.nodes, ret_idx);
    let ret_line: string = emit_return_num_line(ret_val)?;
    let sig_line: string = emit_fn_sig_open_line(prof.mod_slug, src, fn_out)?;
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let b0: StrBuilder = strbuf_new();
    let meta: string = emit_meta_line(prof.mod_slug, fn_out.body_len)?;
    let b1: StrBuilder = strbuf_push(b0, meta);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, sig_line);
    let b4: StrBuilder = strbuf_push(b3, ret_line);
    let b5: StrBuilder = strbuf_push(b4, "}\n");
    return Ok(strbuf_finish(b5));
}

// CONV-3-BRIDGE-2 -- fx-owned production template for the simple-main capability.
// Rust supplies only checked module/literal values; the emitted C shape remains here.
fn emit_simple_main_template() -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "/* fx bootstrap emit: {{MODULE}} body_len=1 */\n");
    let b2: StrBuilder = strbuf_push(b1, "#include <stdint.h>\n\n");
    let b3: StrBuilder = strbuf_push(b2, "int32_t fx_{{MODULE}}_main(void) {\n");
    let b4: StrBuilder = strbuf_push(b3, "    return {{RETURN_I32}};\n");
    let b5: StrBuilder = strbuf_push(b4, "}\n");
    return Ok(strbuf_finish(b5));
}

