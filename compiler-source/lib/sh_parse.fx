fn emit_parsed_enum_match_module(prof: FixtureProfile, mod_inc: string, src: string, en_out: EnumOut, tag_fn: FnOut, main_fn: FnOut, tag_meta: string) -> Result<string, core_Err> effects { alloc, mut } {
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let enum_blk: string = emit_enum_typedef_block(prof, src, en_out)?;
    let tag_blk: string = emit_fn_match_return_block(prof.mod_slug, src, prof, en_out, tag_fn)?;
    let main_blk: string = emit_fn_call1_enum_return_block(prof.mod_slug, src, prof, en_out, main_fn)?;
    let b0: StrBuilder = strbuf_new();
    let meta_tag: string = emit_meta_line(tag_meta, tag_fn.body_len)?;
    let b1: StrBuilder = strbuf_push(b0, meta_tag);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, enum_blk);
    let b4: StrBuilder = strbuf_push(b3, tag_blk);
    let meta_main: string = emit_meta_line(prof.main_meta, main_fn.body_len)?;
    let b5: StrBuilder = strbuf_push(b4, meta_main);
    let b6: StrBuilder = strbuf_push(b5, main_blk);
    return Ok(strbuf_finish(b6));
}

fn load_golden_src(path: string) -> Result<string, core_Err> effects { alloc, io, mut } {
    return fs_read_text(path);
}

fn golden_path_runtime() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("bootstrap_self_subset.fx");
}

fn load_src_runtime() -> Result<string, core_Err> effects { alloc, io, mut } {
    let path: string = golden_path_runtime()?;
    return load_golden_src(path);
}

fn emit_parse_loader_meta_line() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("/* fx bootstrap emit: bootstrap_self_subset_parse_loader=load_src */\n");
}

fn profile_callee_prefix(prof: FixtureProfile) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, prof.mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_");
    return Ok(strbuf_finish(b3));
}

fn emit_meta_line(tag: string, body_len: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let n: string = str_from_i32(body_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "/* fx bootstrap emit: ");
    let b2: StrBuilder = strbuf_push(b1, tag);
    let b3: StrBuilder = strbuf_push(b2, " body_len=");
    let b4: StrBuilder = strbuf_push(b3, n);
    let b5: StrBuilder = strbuf_push(b4, " */\n");
    return Ok(strbuf_finish(b5));
}

fn emit_result_type_c_name(mod_slug: string, src: string, ok_off: i32, ok_ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let ok_name: string = sh_lexer.slice_str(src, ok_off, ok_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_Result_");
    let b4: StrBuilder = strbuf_push(b3, ok_name);
    return Ok(strbuf_finish(b4));
}

fn emit_result_string_typedef(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "#define FX_RESULT_TAG_OK 0\n#define FX_RESULT_TAG_ERR 1\n\n#ifndef FX_CORE_ERR_DEFINED\n#define FX_CORE_ERR_DEFINED\ntypedef enum core_Err {\n    CORE_OK = 0,\n    CORE_ERR_OUT_OF_MEMORY,\n    CORE_ERR_INVALID_ARG,\n    CORE_ERR_OVERFLOW,\n    CORE_ERR_UNSUPPORTED,\n} core_Err;\n#endif\n\ntypedef struct {\n    int32_t tag;\n    const char* ok_val;\n    core_Err err_val;\n} fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_Result_string;\n\n");
    return Ok(strbuf_finish(b3));
}

fn emit_result_i32_typedef(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "typedef struct {\n    int32_t tag;\n    int32_t ok_val;\n    core_Err err_val;\n} fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_Result_i32;\n\n");
    return Ok(strbuf_finish(b3));
}

fn emit_result_struct_typedef(mod_slug: string, struct_name: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_");
    let st_ty: string = strbuf_finish(strbuf_push(b3, struct_name));
    let b4: StrBuilder = strbuf_new();
    let b5: StrBuilder = strbuf_push(b4, "fx_");
    let b6: StrBuilder = strbuf_push(b5, mod_slug);
    let b7: StrBuilder = strbuf_push(b6, "_Result_");
    let res_ty: string = strbuf_finish(strbuf_push(b7, struct_name));
    let b8: StrBuilder = strbuf_new();
    let b9: StrBuilder = strbuf_push(b8, "typedef struct {\n    int32_t tag;\n    ");
    let b10: StrBuilder = strbuf_push(b9, st_ty);
    let b11: StrBuilder = strbuf_push(b10, " ok_val;\n    core_Err err_val;\n} ");
    let b12: StrBuilder = strbuf_push(b11, res_ty);
    let b13: StrBuilder = strbuf_push(b12, ";\n\n");
    return Ok(strbuf_finish(b13));
}

fn emit_result_base_typedefs(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let s: string = emit_result_string_typedef(mod_slug)?;
    let i: string = emit_result_i32_typedef(mod_slug)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, s);
    let b2: StrBuilder = strbuf_push(b1, i);
    return Ok(strbuf_finish(b2));
}

fn emit_result_struct_typedefs(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let m: string = emit_result_struct_typedef(mod_slug, "ModOut")?;
    let p: string = emit_result_struct_typedef(mod_slug, "ImpOut")?;
    let r: string = emit_result_struct_typedef(mod_slug, "RetTypeOut")?;
    let e: string = emit_result_struct_typedef(mod_slug, "EnumOut")?;
    let s: string = emit_result_struct_typedef(mod_slug, "StructOut")?;
    let f: string = emit_result_struct_typedef(mod_slug, "FnSigOut")?;
    let fo: string = emit_result_struct_typedef(mod_slug, "FnOut")?;
    let pp: string = emit_result_struct_typedef(mod_slug, "ParamParseOut")?;
    let po: string = emit_result_struct_typedef(mod_slug, "ParseOut")?;
    let ss: string = emit_result_struct_typedef(mod_slug, "StmtStep")?;
    let bp: string = emit_result_struct_typedef(mod_slug, "BlockParseOut")?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, m);
    let b2: StrBuilder = strbuf_push(b1, p);
    let b3: StrBuilder = strbuf_push(b2, r);
    let b4: StrBuilder = strbuf_push(b3, e);
    let b5: StrBuilder = strbuf_push(b4, s);
    let b6: StrBuilder = strbuf_push(b5, f);
    let b7: StrBuilder = strbuf_push(b6, fo);
    let b8: StrBuilder = strbuf_push(b7, pp);
    let b8p: StrBuilder = strbuf_push(b8, po);
    let b8s: StrBuilder = strbuf_push(b8p, ss);
    let b9: StrBuilder = strbuf_push(b8s, bp);
    return Ok(strbuf_finish(b9));
}

fn emit_result_typedefs(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let base: string = emit_result_base_typedefs(mod_slug)?;
    let structs: string = emit_result_struct_typedefs(mod_slug)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, base);
    let b2: StrBuilder = strbuf_push(b1, structs);
    return Ok(strbuf_finish(b2));
}

fn emit_return_ok_struct_lit_line(prof: FixtureProfile, mod_slug: string, src: string, st_out: StructOut, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let ret_ty: string = emit_result_type_c_name(mod_slug, src, fn_out.ret_ok_off, fn_out.ret_ok_len)?;
    let ret_idx: i32 = stmt_return_expr_idx(fn_out.stmts, fn_out.body_start);
    let lit_idx: i32 = expr_call_arg0_idx(fn_out.nodes, ret_idx);
    let lit: string = emit_struct_lit_c_expr(prof, src, st_out, fn_out.nodes, lit_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return (");
    let b2: StrBuilder = strbuf_push(b1, ret_ty);
    let b3: StrBuilder = strbuf_push(b2, "){ .tag = FX_RESULT_TAG_OK, .ok_val = ");
    let b4: StrBuilder = strbuf_push(b3, lit);
    let b5: StrBuilder = strbuf_push(b4, ", .err_val = CORE_OK };\n");
    return Ok(strbuf_finish(b5));
}

fn ident_field_is(nodes: Vec<Expr>, idx: i32, src: string, base: string, field: string) -> i32 {
    return ident_is_field_access(nodes, idx, src, base, field);
}

fn emit_parser_binop_expr_c(mod_slug: string, src: string, nodes: Vec<Expr>, idx: i32, op: string) -> Result<string, core_Err> effects { alloc, mut } {
    let l: i32 = expr_binop_l(nodes, idx);
    let r: i32 = expr_binop_r(nodes, idx);
    let ls: string = emit_parser_expr_c(mod_slug, src, nodes, l)?;
    let rs: string = emit_parser_expr_c(mod_slug, src, nodes, r)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "(");
    let b2: StrBuilder = strbuf_push(b1, ls);
    let b3: StrBuilder = strbuf_push(b2, op);
    let b4: StrBuilder = strbuf_push(b3, rs);
    let b5: StrBuilder = strbuf_push(b4, ")");
    return Ok(strbuf_finish(b5));
}

fn emit_parser_ident_c(src: string, nodes: Vec<Expr>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let off: i32 = expr_ident_off(nodes, idx);
    let ln: i32 = expr_ident_ln(nodes, idx);
    if (sh_lexer.slice_eq(src, off, ln, "true") == 1) {
        return Ok("1");
    }
    if (sh_lexer.slice_eq(src, off, ln, "false") == 1) {
        return Ok("0");
    }
    if (ln >= 5) {
        if (sh_lexer.slice_eq(src, off, 5, "&mut ") == 1) {
            let name: string = sh_lexer.slice_str(src, off + 5, ln - 5)?;
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, "(fx_MutSlice_i32){ .data = (");
            let b2: StrBuilder = strbuf_push(b1, name);
            let b3: StrBuilder = strbuf_push(b2, ").data, .len = (size_t)(sizeof((");
            let b4: StrBuilder = strbuf_push(b3, name);
            let b5: StrBuilder = strbuf_push(b4, ").data)/sizeof((");
            let b6: StrBuilder = strbuf_push(b5, name);
            let b7: StrBuilder = strbuf_push(b6, ").data[0])) }");
            return Ok(strbuf_finish(b7));
        }
    }
    let dot: i32 = slice_dot_pos(src, off, ln);
    if (dot >= 0) {
        let fld_off: i32 = dot + 1;
        let fld_ln: i32 = (off + ln) - fld_off;
        if (sh_lexer.slice_eq(src, fld_off, fld_ln, "len") == 1) {
            let base_ln: i32 = dot - off;
            let base: string = sh_lexer.slice_str(src, off, base_ln)?;
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, "(int32_t)");
            let b2: StrBuilder = strbuf_push(b1, base);
            let b3: StrBuilder = strbuf_push(b2, ".len");
            return Ok(strbuf_finish(b3));
        }
    }
    return sh_lexer.slice_str(src, off, ln);
}

fn emit_parser_callee_c(mod_slug: string, src: string, coff: i32, cln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    // SH-C-73 - boot smoke/self_subset call sh_lexer.lex (TokBuf entry).
    if (sh_lexer.slice_eq(src, coff, cln, "sh_lexer.lex") == 1) {
        return Ok("fx_lib_sh_lexer_lex");
    }
    if (sh_lexer.slice_eq(src, coff, cln, "sh_lexer.slice_eq") == 1) {
        return Ok("fx_lib_sh_lexer_slice_eq");
    }
    if (sh_lexer.slice_eq(src, coff, cln, "sh_lexer.slice_str") == 1) {
        return Ok("fx_lib_sh_lexer_slice_str");
    }
    if (sh_lexer.slice_eq(src, coff, cln, "string.len") == 1) {
        return Ok("fx_std_string_len");
    }
    // SH-C-77 - production emit-module bodies call sh_parse.* / fs_write_text.
    if (sh_lexer.slice_eq(src, coff, cln, "fs_write_text") == 1) {
        return Ok("core_fs_write_text");
    }
    if (cln > 9) {
        if (sh_lexer.slice_eq(src, coff, 9, "sh_parse.") == 1) {
            let rest: string = sh_lexer.slice_str(src, coff + 9, cln - 9)?;
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, "fx_lib_sh_parse_");
            let b2: StrBuilder = strbuf_push(b1, rest);
            return Ok(strbuf_finish(b2));
        }
    }
    if (sh_lexer.slice_eq(src, coff, cln, "string.byte_at") == 1) {
        return Ok("fx_std_string_byte_at");
    }
    if (sh_lexer.slice_eq(src, coff, cln, "sh_lexer.lower_byte") == 1) {
        return Ok("fx_lib_sh_lexer_lower_byte");
    }
    if (sh_lexer.slice_eq(src, coff, cln, "sh_lexer.ident_char_str") == 1) {
        return Ok("fx_lib_sh_lexer_ident_char_str");
    }
    if (sh_lexer.slice_eq(src, coff, cln, "str_from_i32") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_str_from_i32");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "strbuf_new") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_strbuf_new");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "strbuf_push") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_strbuf_push");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "strbuf_finish") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_strbuf_finish");
        return Ok(strbuf_finish(b3));
    }
    let name: string = sh_lexer.slice_str(src, coff, cln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_");
    let b4: StrBuilder = strbuf_push(b3, name);
    return Ok(strbuf_finish(b4));
}

fn emit_call_args_span_c(mod_slug: string, src: string, nodes: Vec<Expr>, from_idx: i32, to_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (from_idx < 0) {
        return Err(1);
    }
    if (to_idx < from_idx) {
        if (to_idx < 0) {
            return emit_parser_expr_c(mod_slug, src, nodes, from_idx);
        }
        return Err(1);
    }
    let s: string = emit_parser_expr_c(mod_slug, src, nodes, from_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b_cur: StrBuilder = strbuf_push(b0, s);
    let i: i32 = from_idx + 1;
    while (i <= to_idx) {
        if (node_is_comma_arg_root(nodes, i) == 1) {
            if (node_is_nested_expr_child(nodes, from_idx, to_idx, i) != 1) {
                let e: string = emit_parser_expr_c(mod_slug, src, nodes, i)?;
                b_cur = strbuf_push(b_cur, ", ");
                b_cur = strbuf_push(b_cur, e);
            }
        }
        i = i + 1;
    }
    return Ok(strbuf_finish(b_cur));
}

fn node_is_comma_arg_root(nodes: Vec<Expr>, idx: i32) -> i32 {
    let tag: i32 = expr_ty_tag(nodes, idx);
    if (tag == 1) {
        return 1;
    }
    if (tag == 2) {
        return 1;
    }
    if (tag == 3) {
        return 1;
    }
    if (tag == 4) {
        return 1;
    }
    if (tag == 5) {
        return 1;
    }
    if (tag == 6) {
        return 1;
    }
    if (tag == 7) {
        return 1;
    }
    if (tag == 8) {
        return 1;
    }
    if (tag == 13) {
        return 1;
    }
    if (tag == 14) {
        return 1;
    }
    if (tag == 16) {
        return 1;
    }
    if (tag == 10) {
        return 1;
    }
    if (tag == 11) {
        return 1;
    }
    if (tag == 15) {
        return 1;
    }
    return 0;
}

fn expr_refs_child(nodes: Vec<Expr>, parent_idx: i32, child_idx: i32) -> i32 {
    let tag: i32 = expr_ty_tag(nodes, parent_idx);
    if (tag == 4 || tag == 5 || tag == 6 || tag == 7 || tag == 8 || tag == 13 || tag == 14) {
        if (expr_binop_l(nodes, parent_idx) == child_idx) {
            return 1;
        }
        if (expr_binop_r(nodes, parent_idx) == child_idx) {
            return 1;
        }
    }
    if (tag == 15) {
        if (expr_deref_inner_idx(nodes, parent_idx) == child_idx) {
            return 1;
        }
    }
    if (tag == 10) {
        let a0: i32 = expr_call_arg0_idx(nodes, parent_idx);
        let a1: i32 = expr_call_arg1_idx(nodes, parent_idx);
        let a2: i32 = expr_call_arg2_idx(nodes, parent_idx);
        let a3: i32 = expr_call_arg3_idx(nodes, parent_idx);
        let a4: i32 = expr_call_arg4_idx(nodes, parent_idx);
        if (a0 == child_idx) {
            return 1;
        }
        if (a1 == child_idx) {
            return 1;
        }
        if (a2 == child_idx) {
            return 1;
        }
        if (a3 == child_idx) {
            return 1;
        }
        if (a4 == child_idx) {
            return 1;
        }
    }
    if (tag == 11) {
        let count: i32 = struct_lit_count(nodes, parent_idx);
        let fi: i32 = 0;
        while (fi < count) {
            if (struct_lit_field_idx(nodes, parent_idx, fi) == child_idx) {
                return 1;
            }
            fi = fi + 1;
        }
    }
    return 0;
}

fn node_is_nested_expr_child(nodes: Vec<Expr>, from_idx: i32, to_idx: i32, idx: i32) -> i32 {
    let i: i32 = from_idx;
    while (i <= to_idx) {
        if (i != idx) {
            if (expr_refs_child(nodes, i, idx) == 1) {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn emit_parser_mangled_call_c(mod_slug: string, src: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let coff: i32 = expr_call2_callee_off(nodes, call_idx);
    let cln: i32 = expr_call2_callee_ln(nodes, call_idx);
    if (sh_lexer.slice_eq(src, coff, cln, "str_concat") == 1) {
        let a0: i32 = expr_call_arg0_idx(nodes, call_idx);
        let a1: i32 = expr_call_arg1_idx(nodes, call_idx);
        if (a0 < 0) {
            return Err(1);
        }
        if (a1 < 0) {
            return Err(1);
        }
        let left: string = emit_parser_expr_c(mod_slug, src, nodes, a0)?;
        let right: string = emit_parser_expr_c(mod_slug, src, nodes, a1)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_str_concat(core_default_allocator(), ");
        let b4: StrBuilder = strbuf_push(b3, left);
        let b5: StrBuilder = strbuf_push(b4, ", ");
        let b6: StrBuilder = strbuf_push(b5, right);
        let b7: StrBuilder = strbuf_push(b6, ")");
        return Ok(strbuf_finish(b7));
    }
    let callee: string = emit_parser_callee_c(mod_slug, src, coff, cln)?;
    let a0: i32 = expr_call_arg0_idx(nodes, call_idx);
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, callee);
    let b2: StrBuilder = strbuf_push(b1, "(");
    if (a0 < 0) {
        let b3: StrBuilder = strbuf_push(b2, ")");
        return Ok(strbuf_finish(b3));
    }
    let a1: i32 = expr_call_arg1_idx(nodes, call_idx);
    let a2: i32 = expr_call_arg2_idx(nodes, call_idx);
    let a3: i32 = expr_call_arg3_idx(nodes, call_idx);
    let a4: i32 = expr_call_arg4_idx(nodes, call_idx);
    let span_end: i32 = a1;
    if (a2 >= 0) {
        span_end = a2;
    }
    if (a3 >= 0) {
        span_end = a3;
    }
    if (a4 >= 0) {
        span_end = a4;
    }
    let args: string = emit_call_args_span_c(mod_slug, src, nodes, a0, span_end)?;
    let b3: StrBuilder = strbuf_push(b2, args);
    let b4: StrBuilder = strbuf_push(b3, ")");
    return Ok(strbuf_finish(b4));
}

fn emit_ok_struct_type_c_name(mod_slug: string, src: string, ok_off: i32, ok_len: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let ok_name: string = sh_lexer.slice_str(src, ok_off, ok_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_");
    let b4: StrBuilder = strbuf_push(b3, ok_name);
    return Ok(strbuf_finish(b4));
}

fn emit_parser_try_n_before(fn_out: FnOut, stmt_idx: i32) -> i32 {
    let n: i32 = 0;
    let i: i32 = fn_out.body_start;
    while (i < stmt_idx) {
        let tag: i32 = stmt_ty_tag(fn_out.stmts, i);
        if (tag == 1) {
            let e: i32 = stmt_let_expr_idx(fn_out.stmts, i);
            if (expr_ty_tag(fn_out.nodes, e) == 12) {
                n = n + 1;
            }
        }
        if (tag == 3) {
            let e: i32 = stmt_assign_expr_idx(fn_out.stmts, i);
            if (expr_ty_tag(fn_out.nodes, e) == 12) {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

fn stmt_let_ty_off(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(_, _, _, off, _) => off,
        Return(_) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn stmt_let_ty_ln(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(_, _, _, _, ln) => ln,
        Return(_) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn emit_let_bind_type_c_name(mod_slug: string, src: string, fn_out: FnOut, ty_off: i32, ty_ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (ty_ln > 0) {
        if (sh_lexer.slice_eq(src, ty_off, ty_ln, "i32") == 1) {
            return Ok("int32_t");
        }
        if (sh_lexer.slice_eq(src, ty_off, ty_ln, "string") == 1) {
            return Ok("const char*");
        }
        // SH-C-73 - TokBuf is the lexer import type, not fx_sh_parse_TokBuf.
        if (sh_lexer.slice_eq(src, ty_off, ty_ln, "TokBuf") == 1) {
            return Ok("fx_lib_sh_lexer_TokBuf");
        }
        if (sh_lexer.slice_eq(src, ty_off, ty_ln, "StrBuilder") == 1) {
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, "fx_");
            let b2: StrBuilder = strbuf_push(b1, mod_slug);
            let b3: StrBuilder = strbuf_push(b2, "_StrBuilder");
            return Ok(strbuf_finish(b3));
        }
        if (type_span_is_vec(src, ty_off, ty_ln) == 1) {
            return map_vec_type_c(src, ty_off, ty_ln);
        }
        if (type_span_is_mut_slice(src, ty_off, ty_ln) == 1) {
            let inner_off: i32 = ty_off + 5;
            let inner_ln: i32 = ty_ln - 5;
            return map_mut_slice_type_c(src, inner_off, inner_ln);
        }
        if (type_span_is_array(src, ty_off, ty_ln) == 1) {
            return map_array_type_c(mod_slug, src, ty_off, ty_ln);
        }
        return emit_ok_struct_type_c_name(mod_slug, src, ty_off, ty_ln);
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "i32") == 1) {
        return Ok("int32_t");
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "string") == 1) {
        return Ok("const char*");
    }
    return emit_ok_struct_type_c_name(mod_slug, src, fn_out.ret_ok_off, fn_out.ret_ok_len);
}

fn emit_let_result_type_c_name(mod_slug: string, src: string, fn_out: FnOut, ty_off: i32, ty_ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (ty_ln > 0) {
        if (sh_lexer.slice_eq(src, ty_off, ty_ln, "i32") == 1) {
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, "fx_");
            let b2: StrBuilder = strbuf_push(b1, mod_slug);
            let b3: StrBuilder = strbuf_push(b2, "_Result_i32");
            return Ok(strbuf_finish(b3));
        }
        if (sh_lexer.slice_eq(src, ty_off, ty_ln, "string") == 1) {
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, "fx_");
            let b2: StrBuilder = strbuf_push(b1, mod_slug);
            let b3: StrBuilder = strbuf_push(b2, "_Result_string");
            return Ok(strbuf_finish(b3));
        }
        return emit_result_type_c_name(mod_slug, src, ty_off, ty_ln);
    }
    return emit_result_type_c_name(mod_slug, src, fn_out.ret_ok_off, fn_out.ret_ok_len);
}

fn emit_parser_try_call_result_type_c(mod_slug: string, src: string, fn_out: FnOut, nodes: Vec<Expr>, try_expr_idx: i32, ty_off: i32, ty_ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let inner: i32 = expr_try_inner_idx(nodes, try_expr_idx);
    let coff: i32 = expr_call2_callee_off(nodes, inner);
    let cln: i32 = expr_call2_callee_ln(nodes, inner);
    if (sh_lexer.slice_eq(src, coff, cln, "sh_lexer.slice_str") == 1) {
        return Ok("fx_lib_sh_lexer_Result_string");
    }
    if (sh_lexer.slice_eq(src, coff, cln, "str_from_i32") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_Result_string");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "str_concat") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_Result_string");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "map_type_span_to_c_mod") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_Result_string");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "parse_type_span") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_Result_ImpOut");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "void_param_sig") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_Result_string");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "close_param_sig") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_Result_string");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "concat_param_acc") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_Result_string");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "append_env_name") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_Result_string");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "parse_expr") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_Result_ParseOut");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "parse_stmt") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_Result_StmtStep");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "parse_block_rest") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_Result_BlockParseOut");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, coff, cln, "parse_block") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "fx_");
        let b2: StrBuilder = strbuf_push(b1, mod_slug);
        let b3: StrBuilder = strbuf_push(b2, "_Result_BlockParseOut");
        return Ok(strbuf_finish(b3));
    }
    return emit_let_result_type_c_name(mod_slug, src, fn_out, ty_off, ty_ln);
}

fn emit_parser_try_call_line(mod_slug: string, src: string, fn_out: FnOut, nodes: Vec<Expr>, try_expr_idx: i32, try_n: i32, ty_off: i32, ty_ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let inner: i32 = expr_try_inner_idx(nodes, try_expr_idx);
    let ret_ty: string = emit_parser_try_call_result_type_c(mod_slug, src, fn_out, nodes, try_expr_idx, ty_off, ty_ln)?;
    let call: string = emit_parser_mangled_call_c(mod_slug, src, nodes, inner)?;
    let n: string = str_from_i32(try_n)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, ret_ty);
    let b3: StrBuilder = strbuf_push(b2, " __try_");
    let b4: StrBuilder = strbuf_push(b3, n);
    let b5: StrBuilder = strbuf_push(b4, " = ");
    let b6: StrBuilder = strbuf_push(b5, call);
    let b7: StrBuilder = strbuf_push(b6, ";\n");
    return Ok(strbuf_finish(b7));
}

fn emit_parser_let_try_bind_line(mod_slug: string, src: string, fn_out: FnOut, var_off: i32, var_len: i32, try_n: i32, ty_off: i32, ty_ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let vname: string = sh_lexer.slice_str(src, var_off, var_len)?;
    let ok_ty: string = emit_let_bind_type_c_name(mod_slug, src, fn_out, ty_off, ty_ln)?;
    let n: string = str_from_i32(try_n)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, ok_ty);
    let b3: StrBuilder = strbuf_push(b2, " ");
    let b4: StrBuilder = strbuf_push(b3, vname);
    let b5: StrBuilder = strbuf_push(b4, " = __try_");
    let b6: StrBuilder = strbuf_push(b5, n);
    let b7: StrBuilder = strbuf_push(b6, ".ok_val;\n");
    let f: string = strbuf_finish(b7);
    if (var_len >= 1) {
        if (string.byte_at(src, var_off) == 95) {
            let v0: StrBuilder = strbuf_new();
            let v1: StrBuilder = strbuf_push(v0, "    (void)");
            let v2: StrBuilder = strbuf_push(v1, vname);
            let v3: StrBuilder = strbuf_push(v2, ";\n");
            let void_line: string = strbuf_finish(v3);
            let o0: StrBuilder = strbuf_new();
            let o1: StrBuilder = strbuf_push(o0, f);
            let o2: StrBuilder = strbuf_push(o1, void_line);
            return Ok(strbuf_finish(o2));
        }
    }
    return Ok(f);
}

fn emit_parser_let_try_line(mod_slug: string, src: string, fn_out: FnOut, var_off: i32, var_len: i32, nodes: Vec<Expr>, expr_idx: i32, try_n: i32, ty_off: i32, ty_ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let try_line: string = emit_parser_try_call_line(mod_slug, src, fn_out, nodes, expr_idx, try_n, ty_off, ty_ln)?;
    let prop_line: string = emit_parser_try_propagate_line(mod_slug, src, fn_out, try_n)?;
    let bind_line: string = emit_parser_let_try_bind_line(mod_slug, src, fn_out, var_off, var_len, try_n, ty_off, ty_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, try_line);
    let b2: StrBuilder = strbuf_push(b1, prop_line);
    let b3: StrBuilder = strbuf_push(b2, bind_line);
    return Ok(strbuf_finish(b3));
}

fn emit_parser_return_mangled_call_line(mod_slug: string, src: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let call: string = emit_parser_mangled_call_c(mod_slug, src, nodes, call_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return ");
    let b2: StrBuilder = strbuf_push(b1, call);
    let b3: StrBuilder = strbuf_push(b2, ";\n");
    return Ok(strbuf_finish(b3));
}

fn expr_ok_return_ident_name(nodes: Vec<Expr>, idx: i32, src: string) -> Result<string, core_Err> effects { alloc, mut } {
    let arg_idx: i32 = expr_call_arg0_idx(nodes, idx);
    if (expr_ty_tag(nodes, arg_idx) != 3) {
        return Err(1);
    }
    let off: i32 = expr_ident_off(nodes, arg_idx);
    let ln: i32 = expr_ident_ln(nodes, arg_idx);
    return sh_lexer.slice_str(src, off, ln);
}

// FX-SH-NAT-2 - call shape `fx_{mod}_map_nth_key/value(m, i)` (foundry parity).
fn emit_map_nth_call_c(mod_slug: string, suffix: string, map_c: string, idx_c: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_");
    let b4: StrBuilder = strbuf_push(b3, suffix);
    let b5: StrBuilder = strbuf_push(b4, "(");
    let b6: StrBuilder = strbuf_push(b5, map_c);
    let b7: StrBuilder = strbuf_push(b6, ", ");
    let b8: StrBuilder = strbuf_push(b7, idx_c);
    let b9: StrBuilder = strbuf_push(b8, ")");
    return Ok(strbuf_finish(b9));
}

// FX-SH-NAT-2 - dense nth walk helpers (foundry map_helpers.c.in shape; mod_slug = sh_parse for fn-def preamble).
fn emit_map_nth_helpers_c(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "\n/* FX-SH-NAT-2 - map_nth_* helpers */\nstatic inline const char* fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_map_nth_key(fx_Map_string_i32 map, int32_t n) {\n    if (n < 0 || map.keys == NULL || map.cap == 0) { return \"\"; }\n    int32_t seen = 0;\n    for (size_t i = 0; i < map.cap; i++) {\n        if (map.keys[i] != NULL) {\n            if (seen == n) { return map.keys[i]; }\n            seen = seen + 1;\n        }\n    }\n    return \"\";\n}\n\nstatic inline int32_t fx_");
    let b4: StrBuilder = strbuf_push(b3, mod_slug);
    let b5: StrBuilder = strbuf_push(b4, "_map_nth_value(fx_Map_string_i32 map, int32_t n) {\n    if (n < 0 || map.keys == NULL || map.cap == 0) { return 0; }\n    int32_t seen = 0;\n    for (size_t i = 0; i < map.cap; i++) {\n        if (map.keys[i] != NULL) {\n            if (seen == n) { return map.vals[i]; }\n            seen = seen + 1;\n        }\n    }\n    return 0;\n}\n");
    return Ok(strbuf_finish(b5));
}

// FX-SH-NAT-5 - Buf / Bytes typedefs (foundry emit_c uses_buf_bytes shape).
fn emit_buf_bytes_typedefs_c() -> Result<string, core_Err> effects { alloc, mut } {
