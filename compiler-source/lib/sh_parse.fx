    let b26: StrBuilder = strbuf_push(b25, mod_slug);
    let b27: StrBuilder = strbuf_push(b26, "_map_contains_ss(fx_Map_string_string map, const char* key) {\n    if (map.cap == 0 || map.keys == NULL) { return 0; }\n    size_t slot = fx_");
