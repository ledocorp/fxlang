}

fn emit_result_string_typedef_zspec(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "typedef struct {\n    int32_t tag;\n    const char* ok_val;\n    core_Err err_val;\n} fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_Result_string;\n\n");
    return Ok(strbuf_finish(b3));
}

fn emit_str_concat_result_helper_block(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let pfx: string = strbuf_finish(b2);
    let r0: StrBuilder = strbuf_new();
    let r1: StrBuilder = strbuf_push(r0, pfx);
    let ret_ty: string = strbuf_finish(strbuf_push(r1, "_Result_string"));
    let f0: StrBuilder = strbuf_new();
    let f1: StrBuilder = strbuf_push(f0, pfx);
    let fn_name: string = strbuf_finish(strbuf_push(f1, "_str_concat"));
    let o0: StrBuilder = strbuf_new();
    let o1: StrBuilder = strbuf_push(o0, "static ");
    let o2: StrBuilder = strbuf_push(o1, ret_ty);
    let o3: StrBuilder = strbuf_push(o2, " ");
    let o4: StrBuilder = strbuf_push(o3, fn_name);
    let o5: StrBuilder = strbuf_push(o4, "(core_Allocator* a, const char* left, const char* right) {\n    size_t la = strlen(left);\n    size_t lb = strlen(right);\n    size_t total = la + lb + 1;\n    if (total < la || total < lb) {\n        return (");
    let o6: StrBuilder = strbuf_push(o5, ret_ty);
    let o7: StrBuilder = strbuf_push(o6, "){ .tag = FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = CORE_ERR_OVERFLOW };\n    }\n    char* out = (char*)core_mem_alloc(a, total);\n    if (out == NULL) {\n        return (");
    let o8: StrBuilder = strbuf_push(o7, ret_ty);
    let o9: StrBuilder = strbuf_push(o8, "){ .tag = FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = CORE_ERR_OUT_OF_MEMORY };\n    }\n    if (la > 0) {\n        memcpy(out, left, la);\n    }\n    if (lb > 0) {\n        memcpy(out + la, right, lb);\n    }\n    out[la + lb] = '\\0';\n    return (");
    let o10: StrBuilder = strbuf_push(o9, ret_ty);
    let o11: StrBuilder = strbuf_push(o10, "){ .tag = FX_RESULT_TAG_OK, .ok_val = out, .err_val = CORE_OK };\n}\n\n");
    return Ok(strbuf_finish(o11));
}

