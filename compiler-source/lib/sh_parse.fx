fn expr_is_call2_ident_num(nodes: Vec<Expr>, idx: i32, src: string, callee: string, arg: string, n1: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        CallExpr(off, ln, a0, a1, _, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, callee) != 1) {
                return 0;
            }
            if (is_ident(nodes, a0, src, arg) != 1) {
                return 0;
            }
            return is_num(nodes, a1, n1);
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn expr_is_call2_call1_ident_num(nodes: Vec<Expr>, idx: i32, src: string, outer: string, inner: string, arg: string, n1: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        CallExpr(off, ln, a0, a1, _, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, outer) != 1) {
                return 0;
            }
            if (is_num(nodes, a1, n1) != 1) {
                return 0;
            }
            return expr_is_call1_ident(nodes, a0, src, inner, arg);
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn match_arm_body_is_call2_call1_ident_num(nodes: Vec<Expr>, match_idx: i32, arm_i: i32, src: string, outer: string, inner: string, arg: string, n1: i32) -> i32 {
    let body_idx: i32 = match_arm_body_idx(nodes, match_idx, arm_i);
    if (body_idx < 0) {
        return 0;
    }
    return expr_is_call2_call1_ident_num(nodes, body_idx, src, outer, inner, arg, n1);
}

fn match_arm_body_is_call2_ident_num(nodes: Vec<Expr>, match_idx: i32, arm_i: i32, src: string, callee: string, arg: string, n1: i32) -> i32 {
    let body_idx: i32 = match_arm_body_idx(nodes, match_idx, arm_i);
    if (body_idx < 0) {
        return 0;
    }
    return expr_is_call2_ident_num(nodes, body_idx, src, callee, arg, n1);
}

fn match_arm_body_is_call1_ident(nodes: Vec<Expr>, match_idx: i32, arm_i: i32, src: string, callee: string, arg: string) -> i32 {
    let body_idx: i32 = match_arm_body_idx(nodes, match_idx, arm_i);
    if (body_idx < 0) {
        return 0;
    }
    return expr_is_call1_ident(nodes, body_idx, src, callee, arg);
}

fn match_arm_body_is_call0(nodes: Vec<Expr>, match_idx: i32, arm_i: i32, src: string, callee: string) -> i32 {
    let body_idx: i32 = match_arm_body_idx(nodes, match_idx, arm_i);
    if (body_idx < 0) {
        return 0;
    }
    if (expr_is_call0(nodes, body_idx) != 1) {
        return 0;
    }
    return expr_call_callee_is(nodes, body_idx, src, callee);
}

fn return_is_match_on_ident(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, name: string, arms: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => {
            if (expr_match_scrutinee_is_ident(nodes, e, src, name) != 1) {
                return 0;
            }
            if (expr_match_arm_count(nodes, e) != arms) {
                return 0;
            }
            return 1;
        },
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

