fn parse_and_emit_ok_enum_payload_ignore() -> Result<string, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_ok_enum_payload_ignore()?;
    let src: string = enum_payload_ignore_src()?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, en_out.name_off, en_out.name_len, "Pair") != 1) {
        return Err(1);
    }
    if (en_out.variant_count != 1) {
        return Err(1);
    }
    if (enum_has_any_payload(en_out) != 1) {
        return Err(1);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let first_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (return_is_match_on_ident(first_fn.stmts, first_fn.body_start, first_fn.nodes, src, "p", 1) != 1) {
        return Err(1);
    }
    let tc_first: i32 = check_fn_returns(first_fn, src)?;
    if (tc_first != 0) {
        return Err(1);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (return_is_call1_payload2_num(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "first", "Two", 42, 99) != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(main_fn, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    if (string.len(mod_inc) < 0) {
        return Err(1);
    }
    return enum_payload_ignore_emit_inner();
}

