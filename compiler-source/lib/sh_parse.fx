    let diag_ok: i32 = sh_diag.sh_diag_tests()?;
    if (diag_ok != 42) {
        return Ok(diag_ok);
    }
    let ast_ok: i32 = sh_ast_module_tests()?;
    if (ast_ok != 42) {
        return Ok(ast_ok);
    }
    let bad: i32 = typecheck_rejects_str_return()?;
    if (bad != 42) {
        return Ok(bad);
