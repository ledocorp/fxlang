fn stmt_if_then_return_err_num(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, lit: i32) -> i32 {
    if (stmt_ty_tag(stmts, idx) != 4) {
        return 0;
    }
    let ts: i32 = stmt_if_then_start(stmts, idx);
    let tl: i32 = stmt_if_then_len(stmts, idx);
    if (tl != 1) {
        return 0;
    }
    if (stmt_if_else_len(stmts, idx) > 0) {
        return 0;
    }
    return return_is_err_num(stmts, ts, nodes, src, lit);
}

fn fn_body_has_guard_err_ok(fn_out: FnOut, src: string, err_n: i32, ok_ident: string) -> i32 {
    let i: i32 = fn_out.body_start;
    let end: i32 = fn_out.body_start + fn_out.body_len;
    let saw_if_err: i32 = 0;
    let saw_ok: i32 = 0;
    while (i < end) {
        if (stmt_if_then_return_err_num(fn_out.stmts, i, fn_out.nodes, src, err_n) == 1) {
            saw_if_err = 1;
        }
        if (return_is_ok_ident(fn_out.stmts, i, fn_out.nodes, src, ok_ident) == 1) {
            saw_ok = 1;
        }
        i = i + 1;
    }
    if (saw_if_err == 1 && saw_ok == 1) {
        return 1;
    }
    return 0;
}

fn fn_body_has_try_return_ok(fn_out: FnOut, src: string, var: string, callee: string, lit: i32, ok_ident: string) -> i32 {
    let i: i32 = fn_out.body_start;
    let end: i32 = fn_out.body_start + fn_out.body_len;
    let saw_try: i32 = 0;
    let saw_ok: i32 = 0;
    while (i < end) {
        if (stmt_is_let_try_call1_num(fn_out.stmts, i, fn_out.nodes, src, var, callee, lit) == 1) {
            saw_try = 1;
        }
        if (return_is_ok_ident(fn_out.stmts, i, fn_out.nodes, src, ok_ident) == 1) {
            saw_ok = 1;
        }
        i = i + 1;
    }
    if (saw_try == 1 && saw_ok == 1) {
        return 1;
    }
    return 0;
}

fn expr_is_call1_ident(nodes: Vec<Expr>, idx: i32, src: string, callee: string, arg: string) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        CallExpr(off, ln, a0, a1, _, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, callee) != 1) {
                return 0;
            }
            if (a1 >= 0) {
                return 0;
            }
            return is_ident(nodes, a0, src, arg);
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn return_is_call1_ident(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, callee: string, arg: string) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => expr_is_call1_ident(nodes, e, src, callee, arg),
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn return_is_call1_strlit(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, callee: string, lit: string) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => expr_is_call1_strlit(nodes, e, src, callee, lit),
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn expr_match_arm_count(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Match(_, ac, _) => ac,
        Num(_) => -1,
        StrLit(_, _) => -1,
        Ident(_, _) => -1,
        Add(_, _) => -1,
        Sub(_, _) => -1,
        Mul(_, _) => -1,
        Div(_, _) => -1,
        CmpLt(_, _) => -1,
        CmpNe(_, _) => -1,
        CmpEq(_, _) => -1,
        CmpGe(_, _) => -1,
        Deref(_) => -1,
        CallExpr(_, _, _, _, _, _, _) => -1,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => -1,
        TryExpr(_) => -1,
        Index(_, _) => -1,
        SliceRange(_, _, _) => -1,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn expr_match_scrutinee_is_ident(nodes: Vec<Expr>, idx: i32, src: string, name: string) -> i32 {
    let node: Expr = vec_get(nodes, idx);
