    let empty_st: StructOut = StructOut {
        name_off: 0,
        name_len: 0,
        field_count: 0,
        fields_env: "",
    };
    let step1_blk: string = emit_fn_parser_helper_block(prof, prof.mod_slug, src, empty_st, step1_fn)?;
    let step2_blk: string = emit_fn_parser_helper_block(prof, prof.mod_slug, src, empty_st, step2_fn)?;
    let main_blk: string = emit_fn_parser_helper_block(prof, prof.mod_slug, src, empty_st, main_fn)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, pre);
    let b2: StrBuilder = strbuf_push(b1, tags);
    let b3: StrBuilder = strbuf_push(b2, result_td);
    let step1_meta_name: string = using_core_helper_meta_name(prof.mod_slug, "step1")?;
    let meta1: string = emit_meta_line(step1_meta_name, step1_fn.body_len)?;
    let b4: StrBuilder = strbuf_push(b3, meta1);
    let b5: StrBuilder = strbuf_push(b4, step1_blk);
    let step2_meta_name: string = using_core_helper_meta_name(prof.mod_slug, "step2")?;
