    let b29: StrBuilder = strbuf_push(b28, "* nd = (");
    let b30: StrBuilder = strbuf_push(b29, ty_name);
    let b31: StrBuilder = strbuf_push(b30, "*)core_mem_alloc(region, new_cap * sizeof(");
    let b32: StrBuilder = strbuf_push(b31, ty_name);
    let b33: StrBuilder = strbuf_push(b32, "));\n        for (size_t i = 0; i < len; i++) {\n            nd[i] = data[i];\n        }\n        data = nd;\n        cap = new_cap;\n    }\n    data[len] = val;\n    return (");
    let b34: StrBuilder = strbuf_push(b33, vec_name);
    let b35: StrBuilder = strbuf_push(b34, "){ .data = data, .len = len + 1, .cap = cap };\n}\n\n");
    return Ok(strbuf_finish(b35));
}

fn emit_vec_tok_struct_typedef() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("typedef struct {\n    fx_ok_vec_enum_Tok* data;\n    size_t len;\n    size_t cap;\n} fx_Vec_Tok;\n\n");
}

fn stmt_region_arena_size(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Region(_, _, sz) => sz,
        Let(_, _, _, _, _) => -1,
        Return(_) => -1,
        Assign(_, _, _) => -1,
        AssignPtr(_, _, _) => -1,
        If(_, _, _, _, _) => -1,
        While(_, _, _) => -1,
        Call(_, _, _, _) => -1,
        Break => -1,
        Continue => -1,
        IndexAssign(_, _, _) => -1,
    };
}

fn emit_let_vec_get_stmt_line(prof: FixtureProfile, src: string, en_out: EnumOut, var_off: i32, var_ln: i32, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let var: string = sh_lexer.slice_str(src, var_off, var_ln)?;
    let vec_arg: i32 = expr_call_arg0_idx(nodes, call_idx);
    let idx_arg: i32 = expr_call_arg1_idx(nodes, call_idx);
    let vec_name: string = emit_field_access_c(src, nodes, vec_arg)?;
    let idx_str: string = str_from_i32(eval_expr(nodes, idx_arg))?;
    let enum_ty: string = emit_enum_type_c_name(prof, src, en_out.name_off, en_out.name_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, enum_ty);
    let b3: StrBuilder = strbuf_push(b2, " ");
    let b4: StrBuilder = strbuf_push(b3, var);
    let b5: StrBuilder = strbuf_push(b4, " = (");
    let b6: StrBuilder = strbuf_push(b5, vec_name);
    let b7: StrBuilder = strbuf_push(b6, ".data[");
    let b8: StrBuilder = strbuf_push(b7, idx_str);
    let b9: StrBuilder = strbuf_push(b8, "]);\n");
    return Ok(strbuf_finish(b9));
}

fn emit_return_match_stmt_line(src: string, prof: FixtureProfile, en_out: EnumOut, nodes: Vec<Expr>, match_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let scr_idx: i32 = expr_match_scrutinee_idx(nodes, match_idx);
    let arm_count: i32 = expr_match_arm_count(nodes, match_idx);
    if (scr_idx < 0) {
        return Err(1);
    }
    if (arm_count < 0) {
        return Err(1);
    }
    return emit_match_i32_switch_body(src, prof, en_out, nodes, match_idx, arm_count, scr_idx);
}

fn emit_first_vec_body_stmt_line(prof: FixtureProfile, src: string, en_out: EnumOut, fn_out: FnOut, stmt_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let tag: i32 = stmt_ty_tag(fn_out.stmts, stmt_idx);
    if (tag == 1) {
        let off: i32 = stmt_let_var_off(fn_out.stmts, stmt_idx);
        let ln: i32 = stmt_let_var_ln(fn_out.stmts, stmt_idx);
        let e: i32 = stmt_let_expr_idx(fn_out.stmts, stmt_idx);
        if (expr_call_callee_is(fn_out.nodes, e, src, "vec_get") != 1) {
            return Err(1);
        }
        return emit_let_vec_get_stmt_line(prof, src, en_out, off, ln, fn_out.nodes, e);
    }
    if (tag == 2) {
        let e: i32 = stmt_return_expr_idx(fn_out.stmts, stmt_idx);
        if (expr_ty_tag(fn_out.nodes, e) != 9) {
            return Err(1);
        }
        return emit_return_match_stmt_line(src, prof, en_out, fn_out.nodes, e);
    }
    return Err(1);
}

fn emit_first_vec_body_stmts_rest(prof: FixtureProfile, src: string, en_out: EnumOut, fn_out: FnOut, off: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (off >= fn_out.body_len) {
        return Ok("");
    }
    let stmt_idx: i32 = fn_out.body_start + off;
    let line: string = emit_first_vec_body_stmt_line(prof, src, en_out, fn_out, stmt_idx)?;
    let rest: string = emit_first_vec_body_stmts_rest(prof, src, en_out, fn_out, off + 1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, line);
    let b2: StrBuilder = strbuf_push(b1, rest);
    return Ok(strbuf_finish(b2));
}

fn emit_fn_first_vec_get_match_block(src: string, prof: FixtureProfile, en_out: EnumOut, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    return emit_first_vec_body_stmts_rest(prof, src, en_out, fn_out, 0);
}

