ore_Allocator* region, fx_Vec_Expr v, fx_sh_parse_Expr val) {\n    (void)region;\n    (void)val;\n    return v;\n}\n\nstatic fx_Vec_Expr fx_sh_parse_vec_new(int32_t cap) {\n    (void)cap;\n    return (fx_Vec_Expr){ .data = 0, .len = 0, .cap = 0 };\n}\n\nstatic fx_Vec_i32 fx_sh_parse_vec_i32_push(fx_Vec_i32 v, int32_t val) {\n    (void)val;\n    return v;\n}\n\n");
