        IndexAssign(_, _, _) => 0,
    };
}

fn stmt_is_while(stmts: Vec<Stmt>, idx: i32, body_len: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        While(_, _, bl) => {
            if (bl == body_len) {
                return 1;
            }
            return 0;
        },
        Let(_, _, _, _, _) => 0,
        Return(_) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn check_if_body(stmts: Vec<Stmt>, nodes: Vec<Expr>, c: i32, ts: i32, tl: i32, es: i32, el: i32) -> i32 {
    if (tl != 1) {
        return 16;
    }
    if (el != 1) {
        return 17;
    }
    if (stmt_is_return(stmts, ts, nodes, 1) != 1) {
        return 18;
    }
    if (stmt_is_return(stmts, es, nodes, 0) != 1) {
        return 19;
    }
    if (is_cmp_lt(nodes, c, 0, 1) != 1) {
        return 25;
    }
    return 0;
}

fn check_if_stmt(stmts: Vec<Stmt>, nodes: Vec<Expr>) -> i32 {
    let if5: Stmt = vec_get(stmts, 2);
    return match if5 {
        If(c, ts, tl, es, el) => check_if_body(stmts, nodes, c, ts, tl, es, el),
        Let(_, _, _, _, _) => 20,
        Return(_) => 21,
        Assign(_, _, _) => 22,
        AssignPtr(_, _, _) => 22,
        While(_, _, _) => 23,
        Call(_, _, _, _) => 24,
        Break => 24,
        Continue => 24,
        Region(_, _, _) => 25,
        IndexAssign(_, _, _) => 0,
    };
}

fn check_while_body(stmts: Vec<Stmt>, nodes: Vec<Expr>, src: string, c: i32, bs: i32, bl: i32) -> i32 {
    if (bl != 1) {
        return 28;
    }
    if (stmt_is_assign(stmts, bs, src, "i") != 1) {
        return 29;
    }
    if (is_ident(nodes, 0, src, "i") != 1) {
        return 35;
    }
    if (is_num(nodes, 1, 10) != 1) {
        return 36;
    }
    if (is_cmp_lt(nodes, c, 0, 1) != 1) {
        return 37;
    }
    return 0;
}

fn check_while_stmt(stmts: Vec<Stmt>, nodes: Vec<Expr>, src: string) -> i32 {
    let wh6: Stmt = vec_get(stmts, 1);
    return match wh6 {
        While(c, bs, bl) => check_while_body(stmts, nodes, src, c, bs, bl),
        Let(_, _, _, _, _) => 30,
        Return(_) => 31,
        Assign(_, _, _) => 32,
        AssignPtr(_, _, _) => 32,
        If(_, _, _, _, _) => 33,
        Call(_, _, _, _) => 34,
        Break => 34,
        Continue => 34,
        Region(_, _, _) => 35,
        IndexAssign(_, _, _) => 0,
    };
}

fn self_subset_tests() -> Result<i32, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_boot());
    let src: string = "module sh_parse; import sh_lexer; enum Expr { Num(i32), Stop, }";
    let toks: TokBuf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_out: ModOut = parse_module_decl(toks.kinds, toks.vals, toks.lens, &mut pos)?;
    if (sh_lexer.slice_eq(src, mod_out.name_off, mod_out.name_len, "sh_parse") != 1) {
        return Ok(64);
    }
    let imp_out: ImpOut = parse_import_decl(toks.kinds, toks.vals, toks.lens, &mut pos)?;
    if (sh_lexer.slice_eq(src, imp_out.path_off, imp_out.path_len, "sh_lexer") != 1) {
        return Ok(65);
    }
    let en_out: EnumOut = parse_enum_def(toks.kinds, toks.vals, toks.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, en_out.name_off, en_out.name_len, "Expr") != 1) {
        return Ok(66);
    }
    if (en_out.variant_count != 2) {
        return Ok(67);
    }
    if (pos != toks.kinds.len) {
        return Ok(68);
    }
    return Ok(42);
}

fn includes_zspec_stdio_stdlib() -> Result<string, core_Err> effects { alloc, mut } {
    // FX_CORE_ERR_DEFINED - skip duplicate core_Err typedefs in emit/helpers.
    return Ok("#include <stdint.h>\n#include <stddef.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include \"zspec/core.h\"\n#define FX_CORE_ERR_DEFINED\n\n");
}

fn fixture_profile_bootstrap_self_subset() -> Result<FixtureProfile, core_Err> effects { alloc, mut } {
    // Vec push helpers need core_Allocator (same as ok_vec_enum).
    let inc: string = includes_zspec_stdio_stdlib()?;
    return Ok(FixtureProfile {
        mod_slug: "bootstrap_self_subset",
        main_meta: "bootstrap_self_subset",
        includes: inc,
        golden_path: "bootstrap_self_subset.fx",
    });
}

fn match_parse_tests() -> Result<i32, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_emit());
    let src: string = "match m { Num(n) => n, Stop => 99, }";
    let toks: TokBuf = sh_lexer.lex(src);
    let empty: Vec<Expr> = vec_new(0);
    let pos: i32 = 0;
    let out: ParseOut = parse_match_expr(toks.kinds, toks.vals, toks.lens, &mut pos, empty)?;
    if (pos != toks.kinds.len) {
        return Ok(69);
    }
    if (is_match(out.nodes, out.idx, 0, 2) != 1) {
        return Ok(71);
    }
    return Ok(42);
}

fn enum_payload_emit_inner() -> Result<string, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_enum_payload()?;
    let src: string = "enum Msg {\n    Num(i32),\n    Stop,\n}\n\nfn code(m: Msg) -> i32 {\n    return match m {\n        Num(n) => n,\n        Stop => 99,\n    };\n}\n\nfn main() -> i32 {\n    return code(Num(42));\n}\n";
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let code_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    return emit_parsed_enum_payload_match_module(prof, mod_inc, src, en_out, code_fn, main_fn, "ok_enum_payload_code");
}

fn enum_payload_parse_tests() -> Result<i32, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_ok_enum_payload()?;
    let src: string = "enum Msg {\n    Num(i32),\n    Stop,\n}\n\nfn code(m: Msg) -> i32 {\n    return match m {\n        Num(n) => n,\n        Stop => 99,\n    };\n}\n\nfn main() -> i32 {\n    return code(Num(42));\n}\n";
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, en_out.name_off, en_out.name_len, "Msg") != 1) {
        return Ok(801);
    }
    if (en_out.variant_count != 2) {
        return Ok(802);
    }
    if (enum_has_any_payload(en_out) != 1) {
        return Ok(803);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let code_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (return_is_match_on_ident(code_fn.stmts, code_fn.body_start, code_fn.nodes, src, "m", 2) != 1) {
        return Ok(804);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Ok(807);
    }
    if (return_is_call1_payload_num(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "code", "Num", 42) != 1) {
        return Ok(805);
    }
    if (string.len(mod_inc) < 0) {
        return Ok(1);
    }
    let c_src: string = enum_payload_emit_inner()?;
    if (string.len(c_src) < 1) {
        return Ok(806);
    }
    return Ok(42);
}

