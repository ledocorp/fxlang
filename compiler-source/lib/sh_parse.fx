fn parse_and_emit_ok_hello() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_hello()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let fn_out: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, "", &mut pos, empty, empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, fn_out.name_off, fn_out.name_len, "main") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_off, fn_out.ret_len, "i32") != 1) {
        return Err(1);
    }
    if (fn_out.body_len != 2) {
        return Err(1);
    }
    if (stmt_is_call(fn_out.stmts, fn_out.body_start, src, "puts", 1) != 1) {
        return Err(1);
    }
    let arg_idx: i32 = stmt_call_first_arg(fn_out.stmts, fn_out.body_start);
    if (is_strlit(fn_out.nodes, arg_idx, src, "hello") != 1) {
        return Err(1);
    }
    if (stmt_is_return(fn_out.stmts, fn_out.body_start + 1, fn_out.nodes, 0) != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(fn_out, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    let call_line: string = emit_stmt_call1_strlit_line(src, fn_out.stmts, fn_out.body_start, fn_out.nodes)?;
    let ret_idx: i32 = stmt_return_expr_idx(fn_out.stmts, fn_out.body_start + 1);
    let ret_val: i32 = eval_expr(fn_out.nodes, ret_idx);
    let ret_line: string = emit_return_num_line(ret_val)?;
    let sig_line: string = emit_fn_sig_open_line(prof.mod_slug, src, fn_out)?;
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let b0: StrBuilder = strbuf_new();
    let meta: string = emit_meta_line(prof.mod_slug, fn_out.body_len)?;
    let b1: StrBuilder = strbuf_push(b0, meta);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, sig_line);
    let b4: StrBuilder = strbuf_push(b3, call_line);
    let b5: StrBuilder = strbuf_push(b4, ret_line);
    let b6: StrBuilder = strbuf_push(b5, "}\n");
    return Ok(strbuf_finish(b6));
}

fn parse_and_emit_ok_color_match() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_color_match()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, en_out.name_off, en_out.name_len, "Color") != 1) {
        return Err(1);
    }
    if (en_out.variant_count != 3) {
        return Err(1);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let tag_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src, tag_fn.name_off, tag_fn.name_len, "tag") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, tag_fn.ret_off, tag_fn.ret_len, "i32") != 1) {
        return Err(1);
    }
    if (tag_fn.body_len != 1) {
        return Err(1);
    }
    if (return_is_match_on_ident(tag_fn.stmts, tag_fn.body_start, tag_fn.nodes, src, "c", 3) != 1) {
        return Err(1);
    }
    let tc_tag: i32 = check_fn_returns(tag_fn, src)?;
    if (tc_tag != 0) {
        return Err(1);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, main_fn.name_off, main_fn.name_len, "main") != 1) {
        return Err(1);
    }
    if (main_fn.body_len != 1) {
        return Err(1);
    }
    if (return_is_call1_ident(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "tag", "Green") != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(main_fn, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    return emit_parsed_enum_match_module(prof, mod_inc, src, en_out, tag_fn, main_fn, "ok_color_match_tag");
}

