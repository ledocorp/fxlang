fn emit_sh_parse_pick_st_expr_stmt(src: string, fn_out: FnOut, mod_st: StructOut, imp_st: StructOut, param_st: StructOut, ret_st: StructOut, enum_st: StructOut, struct_st: StructOut, parse_out_st: StructOut, stmt_step_st: StructOut, block_parse_out_st: StructOut, arg_count_out_st: StructOut, struct_lit_acc_st: StructOut) -> StructOut {
    let base: StructOut = emit_sh_parse_pick_st_recursive(src, fn_out, mod_st, imp_st, param_st, ret_st, enum_st, struct_st);
    if (fn_out.ret_is_result == 1) {
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "ParseOut") == 1) { return parse_out_st; }
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "StmtStep") == 1) { return stmt_step_st; }
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "BlockParseOut") == 1) { return block_parse_out_st; }
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "ArgCountOut") == 1) { return arg_count_out_st; }
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "StructLitAcc") == 1) { return struct_lit_acc_st; }
    } else {
        if (sh_lexer.slice_eq(src, fn_out.ret_off, fn_out.ret_len, "StructLitAcc") == 1) { return struct_lit_acc_st; }
    }
    return base;
}

