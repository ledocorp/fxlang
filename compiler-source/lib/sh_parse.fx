    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_enum_payload_mixed()?;
    let src: string = enum_payload_mixed_src();
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let noop_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    let score_empty: Vec<Expr> = vec_new(0);
    let score_empty_stmts: Vec<Stmt> = vec_new(0);
    let score_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, score_empty, score_empty_stmts)?;
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    return emit_parsed_enum_payload_mixed_module(prof, mod_inc, src, en_out, noop_fn, score_fn, main_fn);
}

fn enum_payload_mixed_parse_tests() -> Result<i32, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_ok_enum_payload_mixed()?;
    let src: string = enum_payload_mixed_src();
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, en_out.name_off, en_out.name_len, "Event") != 1) {
        return Ok(851);
    }
    if (en_out.variant_count != 3) {
        return Ok(852);
    }
    if (enum_has_any_payload(en_out) != 1) {
        return Ok(853);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let noop_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src, noop_fn.name_off, noop_fn.name_len, "noop") != 1) {
        return Ok(854);
    }
    let score_empty: Vec<Expr> = vec_new(0);
    let score_empty_stmts: Vec<Stmt> = vec_new(0);
    let score_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, score_empty, score_empty_stmts)?;
    if (return_is_match_on_ident(score_fn.stmts, score_fn.body_start, score_fn.nodes, src, "e", 3) != 1) {
        return Ok(855);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Ok(858);
    }
    if (return_is_call1_payload2_num(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "score", "Point", 10, 32) != 1) {
        return Ok(856);
    }
    if (string.len(mod_inc) < 0) {
        return Ok(1);
    }
    let c_src: string = enum_payload_mixed_emit_inner()?;
    if (string.len(c_src) < 1) {
        return Ok(857);
    }
    return Ok(42);
}

fn smoke_tests() -> Result<i32, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_parse());
    let probe: Vec<i32> = vec_arena_new(0);
    let _probe: Vec<i32> = vec_push(probe, 0);
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);

    let toks1: TokBuf = sh_lexer.lex("1 + 2");
    let pos1: i32 = 0;
    let out1: ParseOut = parse_expr(toks1.kinds, toks1.vals, toks1.lens, &mut pos1, empty)?;
    if (out1.nodes.len != 3) {
        return Ok(1);
    }
    if (is_num(out1.nodes, 0, 1) != 1) {
        return Ok(2);
    }
    if (is_num(out1.nodes, 1, 2) != 1) {
        return Ok(3);
    }
    if (is_add(out1.nodes, out1.idx, 0, 1) != 1) {
        return Ok(4);
    }
    let v1: i32 = eval_expr(out1.nodes, out1.idx);
    if (v1 != 3) {
        return Ok(5);
    }

    let toks2: TokBuf = sh_lexer.lex("2 * (3 + 4)");
    let pos2: i32 = 0;
    let out2: ParseOut = parse_expr(toks2.kinds, toks2.vals, toks2.lens, &mut pos2, empty)?;
    if (out2.nodes.len != 5) {
        return Ok(6);
    }
    let v2: i32 = eval_expr(out2.nodes, out2.idx);
    if (v2 != 14) {
        return Ok(7);
    }

    let src3: string = "let x = 1 + 2";
    let toks3: TokBuf = sh_lexer.lex(src3);
    let let3: LetOut = parse_let_stmt(toks3.kinds, toks3.vals, toks3.lens)?;
    if (sh_lexer.slice_eq(src3, let3.name_off, let3.name_len, "x") != 1) {
        return Ok(8);
    }
    let v3: i32 = eval_expr(let3.nodes, let3.root);
    if (v3 != 3) {
        return Ok(9);
    }

    let src4: string = "fn f() -> i32 { return 1; }";
    let toks4: TokBuf = sh_lexer.lex(src4);
    let pos4: i32 = 0;
    let fn4: FnOut = parse_fn_def(toks4.kinds, toks4.vals, toks4.lens, src4, "", &mut pos4, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src4, fn4.name_off, fn4.name_len, "f") != 1) {
        return Ok(10);
    }
    if (sh_lexer.slice_eq(src4, fn4.ret_off, fn4.ret_len, "i32") != 1) {
        return Ok(11);
    }
    if (fn4.body_len != 1) {
        return Ok(12);
    }
    if (stmt_is_return(fn4.stmts, fn4.body_start, fn4.nodes, 1) != 1) {
        return Ok(13);
    }

    let src5: string = "if 0 < 1 { return 1; } else { return 0; }";
    let toks5: TokBuf = sh_lexer.lex(src5);
    let pos5: i32 = 0;
    let step5: StmtStep = parse_stmt(toks5.kinds, toks5.vals, toks5.lens, src5, &mut pos5, empty, empty_stmts)?;
    if (pos5 != toks5.kinds.len) {
        return Ok(14);
    }
    if (step5.stmts.len != 3) {
        return Ok(15);
    }
    let err5: i32 = check_if_stmt(step5.stmts, step5.nodes);
    if (err5 != 0) {
        return Ok(err5);
    }

    let src6: string = "while i < 10 { i = i + 1; }";
    let toks6: TokBuf = sh_lexer.lex(src6);
    let pos6: i32 = 0;
    let step6: StmtStep = parse_stmt(toks6.kinds, toks6.vals, toks6.lens, src6, &mut pos6, empty, empty_stmts)?;
    if (pos6 != toks6.kinds.len) {
        return Ok(26);
    }
    if (step6.stmts.len != 2) {
        return Ok(27);
    }
    let err6: i32 = check_while_stmt(step6.stmts, step6.nodes, src6);
    if (err6 != 0) {
        return Ok(err6);
    }

    let src7: string = "g();";
    let toks7: TokBuf = sh_lexer.lex(src7);
    let pos7: i32 = 0;
    let step7: StmtStep = parse_stmt(toks7.kinds, toks7.vals, toks7.lens, src7, &mut pos7, empty, empty_stmts)?;
    if (pos7 != toks7.kinds.len) {
        return Ok(38);
    }
    if (stmt_is_call(step7.stmts, 0, src7, "g", 0) != 1) {
        return Ok(39);
    }

    let src8: string = "module boot;";
    let toks8: TokBuf = sh_lexer.lex(src8);
    let pos8: i32 = 0;
    let mod8: ModOut = parse_module_decl(toks8.kinds, toks8.vals, toks8.lens, &mut pos8)?;
    if (pos8 != toks8.kinds.len) {
        return Ok(40);
    }
    if (sh_lexer.slice_eq(src8, mod8.name_off, mod8.name_len, "boot") != 1) {
        return Ok(41);
    }

    let src9: string = "import sh_lexer;";
    let toks9: TokBuf = sh_lexer.lex(src9);
    let pos9: i32 = 0;
    let imp9: ImpOut = parse_import_decl(toks9.kinds, toks9.vals, toks9.lens, &mut pos9)?;
    if (pos9 != toks9.kinds.len) {
        return Ok(42);
    }
    if (sh_lexer.slice_eq(src9, imp9.path_off, imp9.path_len, "sh_lexer") != 1) {
        return Ok(43);
    }

    let src10: string = "import lib/sh_parse;";
    let toks10: TokBuf = sh_lexer.lex(src10);
    let pos10: i32 = 0;
    let imp10: ImpOut = parse_import_decl(toks10.kinds, toks10.vals, toks10.lens, &mut pos10)?;
    if (pos10 != toks10.kinds.len) {
        return Ok(44);
    }
    if (sh_lexer.slice_eq(src10, imp10.path_off, imp10.path_len, "lib/sh_parse") != 1) {
        return Ok(45);
    }

    let src11: string = "module boot; import lib/sh_parse; import sh_lexer;";
    let toks11: TokBuf = sh_lexer.lex(src11);
    let pos11: i32 = 0;
    let mod11: ModOut = parse_module_decl(toks11.kinds, toks11.vals, toks11.lens, &mut pos11)?;
    if (sh_lexer.slice_eq(src11, mod11.name_off, mod11.name_len, "boot") != 1) {
        return Ok(46);
    }
    let imp11a: ImpOut = parse_import_decl(toks11.kinds, toks11.vals, toks11.lens, &mut pos11)?;
    if (sh_lexer.slice_eq(src11, imp11a.path_off, imp11a.path_len, "lib/sh_parse") != 1) {
        return Ok(47);
    }
    let imp11b: ImpOut = parse_import_decl(toks11.kinds, toks11.vals, toks11.lens, &mut pos11)?;
    if (sh_lexer.slice_eq(src11, imp11b.path_off, imp11b.path_len, "sh_lexer") != 1) {
        return Ok(48);
    }
    if (pos11 != toks11.kinds.len) {
        return Ok(49);
    }

    let src12: string = "enum Msg { Num(i32), Stop, }";
    let toks12: TokBuf = sh_lexer.lex(src12);
    let pos12: i32 = 0;
    let en12: EnumOut = parse_enum_def(toks12.kinds, toks12.vals, toks12.lens, src12, &mut pos12)?;
    if (pos12 != toks12.kinds.len) {
        return Ok(50);
    }
    if (sh_lexer.slice_eq(src12, en12.name_off, en12.name_len, "Msg") != 1) {
        return Ok(51);
    }
    if (en12.variant_count != 2) {
        return Ok(52);
    }

    let src13: string = "struct Point { x: i32, y: i32, }";
    let toks13: TokBuf = sh_lexer.lex(src13);
    let pos13: i32 = 0;
    let st13: StructOut = parse_struct_def(toks13.kinds, toks13.vals, toks13.lens, src13, &mut pos13)?;
    if (pos13 != toks13.kinds.len) {
        return Ok(53);
    }
    if (sh_lexer.slice_eq(src13, st13.name_off, st13.name_len, "Point") != 1) {
        return Ok(54);
    }
    if (st13.field_count != 2) {
        return Ok(55);
    }

    let src14: string = "fn main() -> Result<i32, core_Err> effects { alloc, mut } { return 1; }";
    let toks14: TokBuf = sh_lexer.lex(src14);
    let pos14: i32 = 0;
    let fn14: FnOut = parse_fn_def(toks14.kinds, toks14.vals, toks14.lens, src14, "", &mut pos14, empty, empty_stmts)?;
    if (pos14 != toks14.kinds.len) {
        return Ok(56);
    }
    if (fn14.ret_is_result != 1) {
        return Ok(57);
    }
    if (sh_lexer.slice_eq(src14, fn14.ret_ok_off, fn14.ret_ok_len, "i32") != 1) {
        return Ok(58);
    }
    if (sh_lexer.slice_eq(src14, fn14.ret_err_off, fn14.ret_err_len, "core_Err") != 1) {
        return Ok(59);
    }
    if (fn14.effect_count != 2) {
        return Ok(60);
    }

    let match_ok: i32 = match_parse_tests()?;
    if (match_ok != 42) {
        return Ok(match_ok);
    }

    let enum_ok: i32 = enum_payload_parse_tests()?;
    if (enum_ok != 42) {
        return Ok(enum_ok);
    }

    let enum_multi_ok: i32 = enum_payload_multi_parse_tests()?;
    if (enum_multi_ok != 42) {
        return Ok(enum_multi_ok);
    }

    let enum_str_ok: i32 = enum_payload_string_parse_tests()?;
    if (enum_str_ok != 42) {
        return Ok(enum_str_ok);
    }

    let enum_mix_ok: i32 = enum_payload_mixed_parse_tests()?;
    if (enum_mix_ok != 42) {
        return Ok(enum_mix_ok);
    }

    let src_mut: string = "fn f(p: &mut i32) -> i32 { return 0; }";
    let toks_mut: TokBuf = sh_lexer.lex(src_mut);
    let pos_mut: i32 = 0;
    let fn_mut: FnOut = parse_fn_def(toks_mut.kinds, toks_mut.vals, toks_mut.lens, src_mut, "test", &mut pos_mut, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src_mut, fn_mut.name_off, fn_mut.name_len, "f") != 1) {
        return Ok(901);
    }
    let want_sig: string = "(int32_t* p)";
    if (sh_lexer.slice_eq(fn_mut.param_sig, 0, string.len(want_sig), want_sig) != 1) {
        return Ok(902);
    }

    return Ok(42);
}

struct FixtureProfile {
    mod_slug: string,
    main_meta: string,
    includes: string,
    golden_path: string,
}

fn includes_stdint_only() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("#include <stdint.h>\n\n");
}

fn includes_stdint_stddef() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("#include <stdint.h>\n#include <stddef.h>\n\n");
}

fn includes_stdint_stdio() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("#include <stdint.h>\n#include <stdio.h>\n\n");
}

fn includes_stdint_stdio_stdlib() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("#include <stdint.h>\n#include <stddef.h>\n#include <stdio.h>\n#include <stdlib.h>\n\n");
}

fn emit_fx_vec_i32_typedef() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("typedef struct {\n    int32_t* data;\n    size_t len;\n    size_t cap;\n} fx_Vec_i32;\n\n");
}

fn emit_fx_vec_parser_opaque_typedefs() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("typedef struct {\n    void* data;\n    size_t len;\n    size_t cap;\n} fx_Vec_Expr;\n\ntypedef struct {\n    void* data;\n    size_t len;\n    size_t cap;\n} fx_Vec_Stmt;\n\n");
}

fn emit_vec_stmt_push_val_helper(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let p0: StrBuilder = strbuf_new();
    let p1: StrBuilder = strbuf_push(p0, "fx_");
    let p2: StrBuilder = strbuf_push(p1, mod_slug);
    let pfx: string = strbuf_finish(strbuf_push(p2, "_"));
    let t0: StrBuilder = strbuf_new();
    let t1: StrBuilder = strbuf_push(t0, "fx_");
    let t2: StrBuilder = strbuf_push(t1, mod_slug);
    let ty: string = strbuf_finish(strbuf_push(t2, "_Stmt"));
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "static __attribute__((unused)) fx_Vec_Stmt ");
    let b2: StrBuilder = strbuf_push(b1, pfx);
    let b3: StrBuilder = strbuf_push(b2, "vec_Stmt_push_val(core_Allocator* region, fx_Vec_Stmt v, ");
    let b4: StrBuilder = strbuf_push(b3, ty);
    let b5: StrBuilder = strbuf_push(b4, " val) {\n    if (region == NULL) {\n        return (fx_Vec_Stmt){ .data = v.data, .len = v.len + 1, .cap = v.cap };\n    }\n    size_t len = v.len;\n    size_t cap = v.cap;\n    ");
    let b6: StrBuilder = strbuf_push(b5, ty);
    let b7: StrBuilder = strbuf_push(b6, "* data = (");
    let b8: StrBuilder = strbuf_push(b7, ty);
    let b9: StrBuilder = strbuf_push(b8, "*)v.data;\n    if (len >= cap) {\n        size_t new_cap = (cap == 0) ? 4 : (cap * 2);\n        ");
    let b10: StrBuilder = strbuf_push(b9, ty);
    let b11: StrBuilder = strbuf_push(b10, "* nd = (");
    let b12: StrBuilder = strbuf_push(b11, ty);
    let b13: StrBuilder = strbuf_push(b12, "*)core_mem_alloc(region, new_cap * sizeof(");
    let b14: StrBuilder = strbuf_push(b13, ty);
    let b15: StrBuilder = strbuf_push(b14, "));\n        for (size_t i = 0; i < len; i++) {\n            nd[i] = data[i];\n        }\n        data = nd;\n        cap = new_cap;\n    }\n    data[len] = val;\n    return (fx_Vec_Stmt){ .data = data, .len = len + 1, .cap = cap };\n}\n\n");
    return Ok(strbuf_finish(b15));
}

fn emit_vec_expr_push_val_helper(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let p0: StrBuilder = strbuf_new();
    let p1: StrBuilder = strbuf_push(p0, "fx_");
    let p2: StrBuilder = strbuf_push(p1, mod_slug);
    let pfx: string = strbuf_finish(strbuf_push(p2, "_"));
    let t0: StrBuilder = strbuf_new();
    let t1: StrBuilder = strbuf_push(t0, "fx_");
