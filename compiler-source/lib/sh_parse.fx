fn expr_binop_l(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Add(l, _) => l,
        Sub(l, _) => l,
        Mul(l, _) => l,
        Div(l, _) => l,
        CmpLt(l, _) => l,
        CmpNe(l, _) => l,
        CmpEq(l, _) => l,
        CmpGe(l, _) => l,
        Deref(inner) => inner,
        Num(n) => n,
        StrLit(off, ln) => off + ln,
        Ident(off, ln) => off + ln,
        Match(scr, arms, _) => scr + arms,
        CallExpr(coff, cln, a0, a1, _, _, _) => coff + cln + a0 + a1,
        StructLit(o, l, c, f0, f1, f2, f3, f4, f5, f6, f7, f8, _, _, _, _, _, _, _, _) => o + l + c + f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

fn expr_binop_r(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Add(_, r) => r,
        Sub(_, r) => r,
        Mul(_, r) => r,
        Div(_, r) => r,
        CmpLt(_, r) => r,
        CmpNe(_, r) => r,
        CmpEq(_, r) => r,
        CmpGe(_, r) => r,
        Deref(inner) => inner,
        Num(n) => n,
        StrLit(off, ln) => off + ln,
        Ident(off, ln) => off + ln,
        Match(scr, arms, _) => scr + arms,
        CallExpr(coff, cln, a0, a1, _, _, _) => coff + cln + a0 + a1,
        StructLit(o, l, c, f0, f1, f2, f3, f4, f5, f6, f7, f8, _, _, _, _, _, _, _, _) => o + l + c + f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

fn infer_expr_ty_kind(nodes: Vec<Expr>, idx: i32, src: string, param_env: string, let_env: string, struct_ret_env: string, param_m: Map<string, i32>, let_i32_m: Map<string, i32>, let_struct_m: Map<string, i32>, ret_m: Map<string, i32>) -> Result<i32, core_Err> effects { alloc, mut } {
    let tag: i32 = expr_ty_tag(nodes, idx);
    if (tag == 1) {
        return Ok(ty_kind_i32());
    }
    if (tag == 2) {
        return Ok(ty_kind_str());
    }
    if (tag == 3) {
        let off: i32 = expr_ident_off(nodes, idx);
        let ln: i32 = expr_ident_ln(nodes, idx);
        return infer_ident_ty(src, off, ln, param_m, let_i32_m, let_struct_m);
    }
    if (tag == 10) {
        return infer_call_ty(nodes, idx, src, ret_m);
    }
    if (tag == 11) {
        return Ok(ty_kind_struct());
    }
    if (tag == 9) {
        return Ok(ty_kind_i32());
    }
    if (tag == 8) {
        return Ok(ty_kind_i32());
    }
    if (tag == 13) {
        return Ok(ty_kind_i32());
    }
    if (tag == 14) {
        return Ok(ty_kind_i32());
    }
    if (tag == 15) {
        let inner: i32 = expr_deref_inner_idx(nodes, idx);
        return infer_expr_ty_kind(nodes, inner, src, param_env, let_env, struct_ret_env, param_m, let_i32_m, let_struct_m, ret_m);
    }
    // SH-C-18 - TryExpr (`e?`) forwards the inner expression type.
    if (tag == 12) {
        let inner: i32 = expr_try_inner_idx(nodes, idx);
        return infer_expr_ty_kind(nodes, inner, src, param_env, let_env, struct_ret_env, param_m, let_i32_m, let_struct_m, ret_m);
    }
    // FX-SH-NAT-3 - Index sugar: element type treated as i32 in self-host subset (Vec i32 / arrays).
    if (tag == 17) {
        return Ok(ty_kind_i32());
    }
    // FX-SH-NAT-4 - SliceRange → slice view (struct-ish in self-host subset).
    if (tag == 18) {
        return Ok(ty_kind_struct());
    }
    // FX-SH-NAT-7 - ArrayLit → array struct binding.
    if (tag == 19) {
        return Ok(ty_kind_struct());
    }
    let l: i32 = expr_binop_l(nodes, idx);
    let r: i32 = expr_binop_r(nodes, idx);
    return infer_binop_ty(nodes, l, r, src, param_env, let_env, struct_ret_env, param_m, let_i32_m, let_struct_m, ret_m);
}

fn let_rhs_bind_kind(nodes: Vec<Expr>, idx: i32, src: string, param_env: string, let_env: string, struct_ret_env: string, param_m: Map<string, i32>, let_i32_m: Map<string, i32>, let_struct_m: Map<string, i32>, ret_m: Map<string, i32>) -> Result<i32, core_Err> effects { alloc, mut } {
    let ty: i32 = infer_expr_ty_kind(nodes, idx, src, param_env, let_env, struct_ret_env, param_m, let_i32_m, let_struct_m, ret_m)?;
    if (ty == ty_kind_i32()) {
        return Ok(1);
    }
    if (ty == ty_kind_struct()) {
        return Ok(2);
    }
    // SH-C-19 - string RHS binds into let_struct_m with tag 2.
    if (ty == ty_kind_str()) {
        return Ok(3);
    }
    return Ok(0);
}

fn let_rhs_is_i32(nodes: Vec<Expr>, idx: i32, src: string, param_env: string, let_env: string, struct_ret_env: string, param_m: Map<string, i32>, let_i32_m: Map<string, i32>, let_struct_m: Map<string, i32>, ret_m: Map<string, i32>) -> Result<i32, core_Err> effects { alloc, mut } {
    let kind: i32 = let_rhs_bind_kind(nodes, idx, src, param_env, let_env, struct_ret_env, param_m, let_i32_m, let_struct_m, ret_m)?;
    if (kind == 1) {
        return Ok(1);
    }
    return Ok(0);
}

fn build_let_env_on_let(stmts: Vec<Stmt>, idx: i32, stop: i32, nodes: Vec<Expr>, src: string, param_env: string, param_m: Map<string, i32>, env: string, off: i32, ln: i32, e: i32, struct_ret_env: string, ret_m: Map<string, i32>, let_i32_m: &mut Map<string, i32>, let_struct_m: &mut Map<string, i32>) -> Result<string, core_Err> effects { alloc, mut } {
    // SH-C-19 - typed let annotations win over RHS infer (CallExpr/`?` often defaults to i32).
    let ty_ln: i32 = stmt_let_ty_ln(stmts, idx);
    if (ty_ln > 0) {
        let ty_off: i32 = stmt_let_ty_off(stmts, idx);
        let name: string = sh_lexer.slice_str(src, off, ln)?;
        if (sh_lexer.slice_eq(src, ty_off, ty_ln, "i32") == 1) {
            let env2: string = append_env_name_map_i32(let_i32_m, env, name)?;
            return build_let_env_rec(stmts, idx + 1, stop, nodes, src, param_env, param_m, env2, struct_ret_env, ret_m, let_i32_m, let_struct_m);
        }
        if (sh_lexer.slice_eq(src, ty_off, ty_ln, "bool") == 1) {
            let env2: string = append_env_name_map_i32(let_i32_m, env, name)?;
            return build_let_env_rec(stmts, idx + 1, stop, nodes, src, param_env, param_m, env2, struct_ret_env, ret_m, let_i32_m, let_struct_m);
        }
        if (sh_lexer.slice_eq(src, ty_off, ty_ln, "string") == 1) {
            let env2: string = append_str_env_name_map(let_struct_m, env, name)?;
            return build_let_env_rec(stmts, idx + 1, stop, nodes, src, param_env, param_m, env2, struct_ret_env, ret_m, let_i32_m, let_struct_m);
        }
        if (type_span_is_array(src, ty_off, ty_ln) == 1) {
            let env2: string = append_struct_env_name_map(let_struct_m, env, name)?;
            return build_let_env_rec(stmts, idx + 1, stop, nodes, src, param_env, param_m, env2, struct_ret_env, ret_m, let_i32_m, let_struct_m);
        }
        if (type_span_is_mut_slice(src, ty_off, ty_ln) == 1) {
            let env2: string = append_struct_env_name_map(let_struct_m, env, name)?;
            return build_let_env_rec(stmts, idx + 1, stop, nodes, src, param_env, param_m, env2, struct_ret_env, ret_m, let_i32_m, let_struct_m);
        }
        let env2: string = append_struct_env_name_map(let_struct_m, env, name)?;
        return build_let_env_rec(stmts, idx + 1, stop, nodes, src, param_env, param_m, env2, struct_ret_env, ret_m, let_i32_m, let_struct_m);
    }
    let bind_ok: i32 = let_rhs_bind_kind(nodes, e, src, param_env, env, struct_ret_env, param_m, *let_i32_m, *let_struct_m, ret_m)?;
    if (bind_ok == 1) {
        let name: string = sh_lexer.slice_str(src, off, ln)?;
        let env2: string = append_env_name_map_i32(let_i32_m, env, name)?;
        return build_let_env_rec(stmts, idx + 1, stop, nodes, src, param_env, param_m, env2, struct_ret_env, ret_m, let_i32_m, let_struct_m);
    }
    if (bind_ok == 2) {
        let name: string = sh_lexer.slice_str(src, off, ln)?;
        let env2: string = append_struct_env_name_map(let_struct_m, env, name)?;
        return build_let_env_rec(stmts, idx + 1, stop, nodes, src, param_env, param_m, env2, struct_ret_env, ret_m, let_i32_m, let_struct_m);
    }
    if (bind_ok == 3) {
        let name: string = sh_lexer.slice_str(src, off, ln)?;
        let env2: string = append_str_env_name_map(let_struct_m, env, name)?;
        return build_let_env_rec(stmts, idx + 1, stop, nodes, src, param_env, param_m, env2, struct_ret_env, ret_m, let_i32_m, let_struct_m);
    }
    return build_let_env_rec(stmts, idx + 1, stop, nodes, src, param_env, param_m, env, struct_ret_env, ret_m, let_i32_m, let_struct_m);
}

fn stmt_ty_tag(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(_, _, _, _, _) => 1,
        Return(_) => 2,
        Assign(_, _, _) => 3,
        AssignPtr(_, _, _) => 8,
        If(_, _, _, _, _) => 4,
        While(_, _, _) => 5,
        Call(_, _, _, _) => 6,
        Break => 7,
        Continue => 10,
        Region(_, _, _) => 9,
        IndexAssign(_, _, _) => 11,
    };
}

fn stmt_if_cond(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        If(c, _, _, _, _) => c,
        Let(_, _, _, _, _) => 0,
        Return(_) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

