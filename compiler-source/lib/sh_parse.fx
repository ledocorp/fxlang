fn return_is_ok_add_ident_num(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, ident: string, n: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => {
            if (expr_call_callee_is(nodes, e, src, "Ok") != 1) {
                return 0;
            }
            let arg: i32 = expr_call_arg0_idx(nodes, e);
            if (expr_ty_tag(nodes, arg) != 4) {
                return 0;
            }
            let left: i32 = expr_binop_l(nodes, arg);
            let right: i32 = expr_binop_r(nodes, arg);
            if (is_ident(nodes, left, src, ident) != 1) {
                return 0;
            }
            return is_num(nodes, right, n);
        },
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn expr_is_try_call1_ident(nodes: Vec<Expr>, idx: i32, src: string, callee: string, arg: string) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        TryExpr(inner) => expr_is_call1_ident(nodes, inner, src, callee, arg),
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        CallExpr(_, _, _, _, _, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn stmt_is_let_try_call1_ident(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, var: string, callee: string, arg: string) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(off, ln, e, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, var) != 1) {
                return 0;
            }
            return expr_is_try_call1_ident(nodes, e, src, callee, arg);
        },
        Return(_) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

