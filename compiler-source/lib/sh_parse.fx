    let b6: StrBuilder = strbuf_push(b5, meta2);
    let b7: StrBuilder = strbuf_push(b6, step2_blk);
    let meta_main: string = emit_meta_line(prof.main_meta, main_fn.body_len)?;
    let b8: StrBuilder = strbuf_push(b7, meta_main);
    let b9: StrBuilder = strbuf_push(b8, main_blk);
    return Ok(strbuf_finish(b9));
}

