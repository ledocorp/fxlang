// CONV-3-r.14 -- parse+emit `ok_while_zero` (while false body never runs; exit 0).
fn parse_and_emit_ok_while_zero() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_while_zero()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let fn_out: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, "", &mut pos, empty, empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, fn_out.name_off, fn_out.name_len, "main") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_off, fn_out.ret_len, "i32") != 1) {
        return Err(1);
    }
    if (fn_out.body_len != 3) {
        return Err(1);
    }
    let wh_idx: i32 = fn_out.body_start + 1;
    if (stmt_is_while(fn_out.stmts, wh_idx, 1) != 1) {
        return Err(1);
    }
    if (stmt_is_return(fn_out.stmts, fn_out.body_start, fn_out.nodes, 42) != 1) {
        return Err(1);
    }
    if (stmt_is_return(fn_out.stmts, fn_out.body_start + 2, fn_out.nodes, 0) != 1) {
        return Err(1);
    }
    let cond: i32 = stmt_while_cond(fn_out.stmts, wh_idx);
    if (is_ident(fn_out.nodes, cond, src, "false") != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(fn_out, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    let while_blk: string = emit_while_false_return42_block()?;
    let ret_line: string = emit_return_num_line(0)?;
    let sig_line: string = emit_fn_sig_open_line(prof.mod_slug, src, fn_out)?;
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let b0: StrBuilder = strbuf_new();
    let meta: string = emit_meta_line(prof.mod_slug, fn_out.body_len)?;
    let b1: StrBuilder = strbuf_push(b0, meta);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, sig_line);
    let b4: StrBuilder = strbuf_push(b3, while_blk);
    let b5: StrBuilder = strbuf_push(b4, ret_line);
    let b6: StrBuilder = strbuf_push(b5, "}\n");
    return Ok(strbuf_finish(b6));
}

// CONV-3-r.15 - parse+emit `ok_if_else` (if/else on bool; main calls pick(true) → exit 1).
fn parse_and_emit_ok_if_else() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_if_else()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let pick_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src, pick_fn.name_off, pick_fn.name_len, "pick") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, pick_fn.ret_off, pick_fn.ret_len, "i32") != 1) {
        return Err(1);
    }
    if (pick_fn.body_len != 3) {
        return Err(1);
    }
    let if_idx: i32 = pick_fn.body_start + 2;
    if (stmt_ty_tag(pick_fn.stmts, if_idx) != 4) {
        return Err(1);
    }
    if (stmt_if_then_len(pick_fn.stmts, if_idx) != 1) {
        return Err(1);
    }
    if (stmt_if_else_len(pick_fn.stmts, if_idx) != 1) {
        return Err(1);
    }
    let then_s: i32 = stmt_if_then_start(pick_fn.stmts, if_idx);
    let else_s: i32 = stmt_if_else_start(pick_fn.stmts, if_idx);
    if (stmt_is_return(pick_fn.stmts, then_s, pick_fn.nodes, 1) != 1) {
        return Err(1);
    }
    if (stmt_is_return(pick_fn.stmts, else_s, pick_fn.nodes, 0) != 1) {
        return Err(1);
    }
    let cond: i32 = stmt_if_cond(pick_fn.stmts, if_idx);
    if (is_ident(pick_fn.nodes, cond, src, "b") != 1) {
        return Err(1);
    }
