fn parse_and_emit_ok_struct_field() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_struct_field()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let st_out: StructOut = parse_struct_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, st_out.name_off, st_out.name_len, "Point") != 1) {
        return Err(1);
    }
    if (st_out.field_count != 2) {
        return Err(1);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let sum_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src, sum_fn.name_off, sum_fn.name_len, "sum") != 1) {
        return Err(1);
    }
    if (sum_fn.body_len != 1) {
        return Err(1);
    }
    if (return_is_add_field_accesses(sum_fn.stmts, sum_fn.body_start, sum_fn.nodes, src, "p", "x", "y") != 1) {
        return Err(1);
    }
    let tc_sum: i32 = check_fn_returns(sum_fn, src)?;
    if (tc_sum != 0) {
        return Err(1);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (return_is_call1_struct_lit(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "sum") != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(main_fn, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let struct_blk: string = emit_struct_typedef_block(prof, src, st_out)?;
    let sum_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, sum_fn)?;
    let sum_ret_idx: i32 = stmt_return_expr_idx(sum_fn.stmts, sum_fn.body_start);
    let sum_ret: string = emit_return_add_field_accesses_line(src, sum_fn.nodes, sum_ret_idx)?;
    let main_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, main_fn)?;
    let main_ret_idx: i32 = stmt_return_expr_idx(main_fn.stmts, main_fn.body_start);
    let callee_pfx: string = profile_callee_prefix(prof)?;
    let main_ret: string = emit_return_call1_struct_lit_line(prof, src, st_out, callee_pfx, main_fn.nodes, main_ret_idx)?;
    let b0: StrBuilder = strbuf_new();
    let meta_st: string = emit_meta_line(prof.mod_slug, st_out.field_count)?;
    let b1: StrBuilder = strbuf_push(b0, meta_st);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, struct_blk);
    let meta_sum: string = emit_meta_line("ok_struct_field_sum", sum_fn.body_len)?;
    let b4: StrBuilder = strbuf_push(b3, meta_sum);
    let b5: StrBuilder = strbuf_push(b4, sum_sig);
    let b6: StrBuilder = strbuf_push(b5, sum_ret);
    let b7: StrBuilder = strbuf_push(b6, "}\n\n");
    let meta_main: string = emit_meta_line(prof.main_meta, main_fn.body_len)?;
    let b8: StrBuilder = strbuf_push(b7, meta_main);
    let b9: StrBuilder = strbuf_push(b8, main_sig);
    let b10: StrBuilder = strbuf_push(b9, main_ret);
    let b11: StrBuilder = strbuf_push(b10, "}\n");
    return Ok(strbuf_finish(b11));
}

fn emit_binop_expr_c(src: string, nodes: Vec<Expr>, idx: i32, op: string) -> Result<string, core_Err> effects { alloc, mut } {
    let l: i32 = expr_binop_l(nodes, idx);
    let r: i32 = expr_binop_r(nodes, idx);
    let ls: string = emit_expr_c(src, nodes, l)?;
    let rs: string = emit_expr_c(src, nodes, r)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "(");
    let b2: StrBuilder = strbuf_push(b1, ls);
    let b3: StrBuilder = strbuf_push(b2, op);
    let b4: StrBuilder = strbuf_push(b3, rs);
    let b5: StrBuilder = strbuf_push(b4, ")");
    return Ok(strbuf_finish(b5));
}

fn emit_expr_c(src: string, nodes: Vec<Expr>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let tag: i32 = expr_ty_tag(nodes, idx);
    if (tag == 1) {
        let n: i32 = eval_expr(nodes, idx);
        return str_from_i32(n);
    }
    if (tag == 3) {
        return emit_field_access_c(src, nodes, idx);
    }
    if (tag == 4) {
        return emit_binop_expr_c(src, nodes, idx, " + ");
    }
    if (tag == 5) {
        return emit_binop_expr_c(src, nodes, idx, " - ");
    }
    if (tag == 6) {
        return emit_binop_expr_c(src, nodes, idx, " * ");
    }
    if (tag == 7) {
        return emit_binop_expr_c(src, nodes, idx, " / ");
    }
    return Err(1);
}

fn emit_struct_lit_field_assign_expr(st_out: StructOut, field_i: i32, val_expr: string, first: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let fname: string = variants_env_nth(st_out.fields_env, field_i)?;
    let b0: StrBuilder = strbuf_new();
    if (first == 1) {
        let b1: StrBuilder = strbuf_push(b0, "{ .");
        let b2: StrBuilder = strbuf_push(b1, fname);
        let b3: StrBuilder = strbuf_push(b2, " = ");
        let b4: StrBuilder = strbuf_push(b3, val_expr);
        return Ok(strbuf_finish(b4));
    }
    let b1: StrBuilder = strbuf_push(b0, ", .");
    let b2: StrBuilder = strbuf_push(b1, fname);
    let b3: StrBuilder = strbuf_push(b2, " = ");
    let b4: StrBuilder = strbuf_push(b3, val_expr);
    return Ok(strbuf_finish(b4));
}

fn emit_parser_struct_lit_val_c(mod_slug: string, src: string, nodes: Vec<Expr>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let tag: i32 = expr_ty_tag(nodes, idx);
    if (tag == 2) {
        let ln: i32 = expr_strlit_ln(nodes, idx);
        if (ln == 0) {
            return Ok("0");
        }
    }
    return emit_parser_expr_c(mod_slug, src, nodes, idx);
}

fn emit_struct_lit_fields_assign_exprs(st_out: StructOut, mod_slug: string, src: string, nodes: Vec<Expr>, lit_idx: i32, field_i: i32, count: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (field_i >= count) {
        return Ok("");
    }
    let v: i32 = struct_lit_field_idx(nodes, lit_idx, field_i);
    let es: string = emit_parser_struct_lit_val_c(mod_slug, src, nodes, v)?;
    let first: i32 = 0;
    if (field_i == 0) {
        first = 1;
    }
    let part: string = emit_struct_lit_field_assign_expr(st_out, field_i, es, first)?;
    if (field_i + 1 >= count) {
        return Ok(part);
    }
    let rest: string = emit_struct_lit_fields_assign_exprs(st_out, mod_slug, src, nodes, lit_idx, field_i + 1, count)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, part);
    let b2: StrBuilder = strbuf_push(b1, rest);
    return Ok(strbuf_finish(b2));
}

fn emit_struct_lit_exprs_c_expr(prof: FixtureProfile, src: string, st_out: StructOut, nodes: Vec<Expr>, lit_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (expr_ty_tag(nodes, lit_idx) != 11) {
        return Err(1);
    }
    let count: i32 = struct_lit_count(nodes, lit_idx);
    let ty_name: string = emit_struct_type_c_name(prof, src, st_out.name_off, st_out.name_len)?;
    let fields: string = emit_struct_lit_fields_assign_exprs(st_out, prof.mod_slug, src, nodes, lit_idx, 0, count)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "(");
    let b2: StrBuilder = strbuf_push(b1, ty_name);
    let b3: StrBuilder = strbuf_push(b2, ")");
    let b4: StrBuilder = strbuf_push(b3, fields);
    let b5: StrBuilder = strbuf_push(b4, " }");
    return Ok(strbuf_finish(b5));
}

fn emit_return_struct_lit_exprs_line(prof: FixtureProfile, src: string, st_out: StructOut, nodes: Vec<Expr>, lit_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let lit: string = emit_struct_lit_exprs_c_expr(prof, src, st_out, nodes, lit_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return ");
    let b2: StrBuilder = strbuf_push(b1, lit);
    let b3: StrBuilder = strbuf_push(b2, ";\n");
    return Ok(strbuf_finish(b3));
}

fn emit_let_struct_call1_line(prof: FixtureProfile, src: string, st_out: StructOut, callee_pfx: string, var_off: i32, var_ln: i32, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let var: string = sh_lexer.slice_str(src, var_off, var_ln)?;
    let ty_name: string = emit_struct_type_c_name(prof, src, st_out.name_off, st_out.name_len)?;
    let callee: string = emit_mangled_callee(callee_pfx, src, nodes, call_idx)?;
    let arg_idx: i32 = expr_call1_arg_idx(nodes, call_idx);
    if (arg_idx < 0) {
        return Err(1);
    }
    let arg_expr: string = emit_expr_c(src, nodes, arg_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, ty_name);
    let b3: StrBuilder = strbuf_push(b2, " ");
    let b4: StrBuilder = strbuf_push(b3, var);
    let b5: StrBuilder = strbuf_push(b4, " = ");
    let b6: StrBuilder = strbuf_push(b5, callee);
    let b7: StrBuilder = strbuf_push(b6, "(");
    let b8: StrBuilder = strbuf_push(b7, arg_expr);
    let b9: StrBuilder = strbuf_push(b8, ");\n");
    return Ok(strbuf_finish(b9));
}

fn emit_return_call1_expr_line(callee_pfx: string, src: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let callee: string = emit_mangled_callee(callee_pfx, src, nodes, call_idx)?;
    let arg_idx: i32 = expr_call1_arg_idx(nodes, call_idx);
    if (arg_idx < 0) {
        return Err(1);
    }
    let arg_expr: string = emit_expr_c(src, nodes, arg_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return ");
    let b2: StrBuilder = strbuf_push(b1, callee);
    let b3: StrBuilder = strbuf_push(b2, "(");
    let b4: StrBuilder = strbuf_push(b3, arg_expr);
    let b5: StrBuilder = strbuf_push(b4, ");\n");
    return Ok(strbuf_finish(b5));
}

// CONV-3-r.21 - return mangled callee with strlit arg.
fn emit_return_call1_strlit_line(callee_pfx: string, src: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let callee: string = emit_mangled_callee(callee_pfx, src, nodes, call_idx)?;
    let arg_idx: i32 = expr_call1_arg_idx(nodes, call_idx);
    if (arg_idx < 0) {
        return Err(1);
    }
    let lit_off: i32 = expr_strlit_off(nodes, arg_idx);
    let lit_ln: i32 = expr_strlit_ln(nodes, arg_idx);
    let lit: string = sh_lexer.slice_str(src, lit_off, lit_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return ");
    let b2: StrBuilder = strbuf_push(b1, callee);
    let b3: StrBuilder = strbuf_push(b2, "(\"");
    let b4: StrBuilder = strbuf_push(b3, lit);
    let b5: StrBuilder = strbuf_push(b4, "\");\n");
    return Ok(strbuf_finish(b5));
}

// CONV-3-r.20 - `return add(3, 4);` with module-mangled callee.
fn emit_return_call2_nums_line(callee_pfx: string, src: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let callee: string = emit_mangled_callee(callee_pfx, src, nodes, call_idx)?;
    let a0: i32 = call2_num_at(nodes, call_idx, 0);
    let a1: i32 = call2_num_at(nodes, call_idx, 1);
    let s0: string = str_from_i32(a0)?;
    let s1: string = str_from_i32(a1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return ");
    let b2: StrBuilder = strbuf_push(b1, callee);
    let b3: StrBuilder = strbuf_push(b2, "(");
    let b4: StrBuilder = strbuf_push(b3, s0);
    let b5: StrBuilder = strbuf_push(b4, ", ");
    let b6: StrBuilder = strbuf_push(b5, s1);
    let b7: StrBuilder = strbuf_push(b6, ");\n");
    return Ok(strbuf_finish(b7));
}

// CONV-3-r.21 - return puts(msg); (extern callee, unmangled).
fn emit_return_puts_msg_line() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    return puts(msg);\n");
}

// CONV-3-r.21 - return fx_ok_effect_io_log_line with fx-io lit (oracle shape).
fn emit_return_log_line_fx_io_line() -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return fx_ok_effect_io_log_line(");
    let b2: StrBuilder = strbuf_push(b1, "\"");
    let b3: StrBuilder = strbuf_push(b2, "fx-io");
    let b4: StrBuilder = strbuf_push(b3, "\"");
    let b5: StrBuilder = strbuf_push(b4, ");\n");
    return Ok(strbuf_finish(b5));
}

// CONV-3-r.21 - parse+emit ok_effect_io (log_line puts + main log_line call).
fn parse_and_emit_ok_effect_io() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_effect_io()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let log_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src, log_fn.name_off, log_fn.name_len, "log_line") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, log_fn.ret_off, log_fn.ret_len, "i32") != 1) {
        return Err(1);
    }
    if (log_fn.effect_count != 1) {
        return Err(1);
    }
    if (log_fn.body_len != 1) {
        return Err(1);
    }
    if (return_is_call1_ident(log_fn.stmts, log_fn.body_start, log_fn.nodes, src, "puts", "msg") != 1) {
        return Err(1);
    }
    let tc_log: i32 = check_fn_returns(log_fn, src)?;
    if (tc_log != 0) {
        return Err(1);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, main_fn.name_off, main_fn.name_len, "main") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, main_fn.ret_off, main_fn.ret_len, "i32") != 1) {
        return Err(1);
    }
    if (main_fn.effect_count != 1) {
        return Err(1);
    }
    if (main_fn.body_len != 1) {
        return Err(1);
    }
    if (return_is_call1_strlit(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "log_line", "fx-io") != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(main_fn, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    let log_ret_line: string = emit_return_puts_msg_line()?;
    let main_ret: string = emit_return_log_line_fx_io_line()?;
    let log_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, log_fn)?;
    let main_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, main_fn)?;
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let b0: StrBuilder = strbuf_new();
    let meta_log: string = emit_meta_line(prof.mod_slug, log_fn.body_len)?;
    let b1: StrBuilder = strbuf_push(b0, meta_log);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, log_sig);
    let b4: StrBuilder = strbuf_push(b3, log_ret_line);
    let b5: StrBuilder = strbuf_push(b4, "}\n\n");
    let meta_main: string = emit_meta_line(prof.main_meta, main_fn.body_len)?;
    let b6: StrBuilder = strbuf_push(b5, meta_main);
    let b7: StrBuilder = strbuf_push(b6, main_sig);
    let b8: StrBuilder = strbuf_push(b7, main_ret);
    let b9: StrBuilder = strbuf_push(b8, "}\n");
    return Ok(strbuf_finish(b9));
}

// CONV-3-r.22 - return my_add(10, 32); (extern callee, unmangled).
fn emit_return_my_add_10_32_line() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    return my_add(10, 32);\n");
}

// CONV-3-r.22 - forward decl for extern my_add (bootstrap .c has no .h).
fn emit_extern_my_add_proto_line() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("int32_t my_add(int32_t a, int32_t b);\n\n");
}

// CONV-3-r.22 - parse+emit ok_extern_call (main return my_add(10, 32); exit 42).
fn parse_and_emit_ok_extern_call() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_extern_call()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let fn_out: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, "", &mut pos, empty, empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, fn_out.name_off, fn_out.name_len, "main") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_off, fn_out.ret_len, "i32") != 1) {
        return Err(1);
    }
    if (fn_out.body_len != 1) {
        return Err(1);
    }
    if (return_is_call2_nums(fn_out.stmts, fn_out.body_start, fn_out.nodes, src, "my_add", 10, 32) != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(fn_out, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    let proto: string = emit_extern_my_add_proto_line()?;
    let ret_line: string = emit_return_my_add_10_32_line()?;
    let sig_line: string = emit_fn_sig_open_line(prof.mod_slug, src, fn_out)?;
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let b0: StrBuilder = strbuf_new();
    let meta: string = emit_meta_line(prof.mod_slug, fn_out.body_len)?;
    let b1: StrBuilder = strbuf_push(b0, meta);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, proto);
    let b4: StrBuilder = strbuf_push(b3, sig_line);
    let b5: StrBuilder = strbuf_push(b4, ret_line);
    let b6: StrBuilder = strbuf_push(b5, "}\n");
    return Ok(strbuf_finish(b6));
}

// CONV-3-r.23 - let name = char-byte Num.
fn stmt_is_let_num(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, name: string, want: i32) -> i32 {
    if (stmt_ty_tag(stmts, idx) != 1) {
        return 0;
    }
    if (sh_lexer.slice_eq(src, stmt_let_var_off(stmts, idx), stmt_let_var_ln(stmts, idx), name) != 1) {
        return 0;
    }
    return is_num(nodes, stmt_let_expr_idx(stmts, idx), want);
}

// CONV-3-r.23 - parse+emit ok_char_lit (codes; char lits -> i32; exit 215).
fn parse_and_emit_ok_char_lit() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_char_lit()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let fn_out: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, fn_out.name_off, fn_out.name_len, "codes") != 1) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_off, fn_out.ret_len, "i32") != 1) {
        return Err(1);
    }
    if (fn_out.body_len != 7) {
        return Err(1);
    }
    if (stmt_is_let_num(fn_out.stmts, fn_out.body_start, fn_out.nodes, src, "a", 65) != 1) {
        return Err(1);
    }
    if (stmt_is_let_num(fn_out.stmts, fn_out.body_start + 1, fn_out.nodes, src, "nl", 10) != 1) {
        return Err(1);
    }
    if (stmt_is_let_num(fn_out.stmts, fn_out.body_start + 2, fn_out.nodes, src, "tab", 9) != 1) {
        return Err(1);
    }
    if (stmt_is_let_num(fn_out.stmts, fn_out.body_start + 3, fn_out.nodes, src, "zero", 0) != 1) {
        return Err(1);
    }
    if (stmt_is_let_num(fn_out.stmts, fn_out.body_start + 4, fn_out.nodes, src, "quote", 39) != 1) {
        return Err(1);
    }
    if (stmt_is_let_num(fn_out.stmts, fn_out.body_start + 5, fn_out.nodes, src, "back", 92) != 1) {
        return Err(1);
    }
    if (stmt_ty_tag(fn_out.stmts, fn_out.body_start + 6) != 2) {
        return Err(1);
    }
    if (expr_ty_tag(fn_out.nodes, stmt_return_expr_idx(fn_out.stmts, fn_out.body_start + 6)) != 4) {
        return Err(1);
    }
    let tc: i32 = check_fn_returns(fn_out, src)?;
    if (tc != 0) {
        return Err(1);
    }
    let empty_st: StructOut = StructOut {
        name_off: 0,
        name_len: 0,
        field_count: 0,
        fields_env: "",
    };
    let body: string = emit_parser_fn_body_block(prof.mod_slug, src, prof, empty_st, fn_out)?;
    let sig_line: string = emit_fn_sig_open_line(prof.mod_slug, src, fn_out)?;
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let b0: StrBuilder = strbuf_new();
    let meta: string = emit_meta_line(prof.mod_slug, fn_out.body_len)?;
    let b1: StrBuilder = strbuf_push(b0, meta);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, sig_line);
    let b4: StrBuilder = strbuf_push(b3, body);
    let b5: StrBuilder = strbuf_push(b4, "}\n");
    return Ok(strbuf_finish(b5));
}

fn emit_fn_body_stmt_line(prof: FixtureProfile, src: string, st_out: StructOut, callee_pfx: string, fn_out: FnOut, stmt_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let tag: i32 = stmt_ty_tag(fn_out.stmts, stmt_idx);
    if (tag == 1) {
        let off: i32 = stmt_let_var_off(fn_out.stmts, stmt_idx);
        let ln: i32 = stmt_let_var_ln(fn_out.stmts, stmt_idx);
        let e: i32 = stmt_let_expr_idx(fn_out.stmts, stmt_idx);
        return emit_let_struct_call1_line(prof, src, st_out, callee_pfx, off, ln, fn_out.nodes, e);
    }
    if (tag == 2) {
        let e: i32 = stmt_return_expr_idx(fn_out.stmts, stmt_idx);
        return emit_return_add_field_accesses_line(src, fn_out.nodes, e);
    }
    return Err(1);
}

fn emit_fn_body_stmts_rest(prof: FixtureProfile, src: string, st_out: StructOut, callee_pfx: string, fn_out: FnOut, off: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (off >= fn_out.body_len) {
        return Ok("");
    }
    let stmt_idx: i32 = fn_out.body_start + off;
    let line: string = emit_fn_body_stmt_line(prof, src, st_out, callee_pfx, fn_out, stmt_idx)?;
    let rest: string = emit_fn_body_stmts_rest(prof, src, st_out, callee_pfx, fn_out, off + 1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, line);
    let b2: StrBuilder = strbuf_push(b1, rest);
    return Ok(strbuf_finish(b2));
}

fn emit_fn_body_block(prof: FixtureProfile, src: string, st_out: StructOut, callee_pfx: string, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    return emit_fn_body_stmts_rest(prof, src, st_out, callee_pfx, fn_out, 0);
}

fn return_is_struct_lit(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => {
            if (expr_ty_tag(nodes, e) == 11) {
                return 1;
            }
            return 0;
        },
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn stmt_is_let_call1_ident(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, var: string, callee: string, arg: string) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(off, ln, e, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, var) != 1) {
                return 0;
            }
            return expr_is_call1_ident(nodes, e, src, callee, arg);
        },
        Return(_) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn expr_is_call1_field_access(nodes: Vec<Expr>, idx: i32, src: string, callee: string, base: string, field: string) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        CallExpr(off, ln, a0, a1, _, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, callee) != 1) {
                return 0;
            }
            if (a1 >= 0) {
                return 0;
            }
            return ident_is_field_access(nodes, a0, src, base, field);
        },
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn stmt_is_let_call1_field(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, var: string, callee: string, base: string, field: string) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(off, ln, e, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, var) != 1) {
                return 0;
            }
            return expr_is_call1_field_access(nodes, e, src, callee, base, field);
        },
        Return(_) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn return_is_call1_num(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, callee: string, n: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => expr_is_call1_num(nodes, e, src, callee, n),
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn parse_and_emit_ok_struct_return() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_emit());
    let prof: FixtureProfile = fixture_profile_ok_struct_return()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let st_out: StructOut = parse_struct_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, st_out.name_off, st_out.name_len, "Eval") != 1) {
        return Err(1);
    }
    if (st_out.field_count != 2) {
        return Err(1);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let step_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src, step_fn.name_off, step_fn.name_len, "step") != 1) {
        return Err(1);
    }
    if (step_fn.body_len != 1) {
        return Err(1);
    }
    if (return_is_struct_lit(step_fn.stmts, step_fn.body_start, step_fn.nodes) != 1) {
        return Err(1);
    }
    let tc_step: i32 = check_fn_returns(step_fn, src)?;
    if (tc_step != 0) {
        return Err(1);
    }
    let step_name: string = sh_lexer.slice_str(src, step_fn.name_off, step_fn.name_len)?;
    let ret_m: Map<string, i32> = map_new();
    let struct_ret_env: string = append_env_name_map_i32(&mut ret_m, "|", step_name)?;
    let twice_empty: Vec<Expr> = vec_new(0);
    let twice_empty_stmts: Vec<Stmt> = vec_new(0);
    let twice_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, twice_empty, twice_empty_stmts)?;
    if (sh_lexer.slice_eq(src, twice_fn.name_off, twice_fn.name_len, "twice") != 1) {
        return Err(1);
    }
    if (twice_fn.body_len != 3) {
        return Err(1);
    }
    if (stmt_is_let_call1_ident(twice_fn.stmts, twice_fn.body_start, twice_fn.nodes, src, "a", "step", "start") != 1) {
        return Err(1);
    }
    if (stmt_is_let_call1_field(twice_fn.stmts, twice_fn.body_start + 1, twice_fn.nodes, src, "b", "step", "a", "pos") != 1) {
        return Err(1);
    }
    if (return_is_add_cross_field_accesses(twice_fn.stmts, twice_fn.body_start + 2, twice_fn.nodes, src, "a", "value", "b", "value") != 1) {
        return Err(1);
    }
    let tc_twice: i32 = check_fn_returns_with_struct_ret(twice_fn, src, struct_ret_env, ret_m)?;
    if (tc_twice != 0) {
        return Err(1);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (return_is_call1_num(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "twice", 5) != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(main_fn, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    let pre: string = emit_file_preamble(prof, mod_inc)?;
    let struct_blk: string = emit_struct_typedef_block(prof, src, st_out)?;
    let callee_pfx: string = profile_callee_prefix(prof)?;
    let step_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, step_fn)?;
    let step_ret_idx: i32 = stmt_return_expr_idx(step_fn.stmts, step_fn.body_start);
    let step_ret: string = emit_return_struct_lit_exprs_line(prof, src, st_out, step_fn.nodes, step_ret_idx)?;
    let twice_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, twice_fn)?;
    let twice_body: string = emit_fn_body_block(prof, src, st_out, callee_pfx, twice_fn)?;
    let main_sig: string = emit_fn_sig_open_line(prof.mod_slug, src, main_fn)?;
    let main_ret_idx: i32 = stmt_return_expr_idx(main_fn.stmts, main_fn.body_start);
    let main_ret: string = emit_return_call1_expr_line(callee_pfx, src, main_fn.nodes, main_ret_idx)?;
    let b0: StrBuilder = strbuf_new();
    let meta_st: string = emit_meta_line(prof.mod_slug, st_out.field_count)?;
    let b1: StrBuilder = strbuf_push(b0, meta_st);
    let b2: StrBuilder = strbuf_push(b1, pre);
    let b3: StrBuilder = strbuf_push(b2, struct_blk);
    let meta_step: string = emit_meta_line("ok_struct_return_step", step_fn.body_len)?;
    let b4: StrBuilder = strbuf_push(b3, meta_step);
    let b5: StrBuilder = strbuf_push(b4, step_sig);
    let b6: StrBuilder = strbuf_push(b5, step_ret);
    let b7: StrBuilder = strbuf_push(b6, "}\n\n");
    let meta_twice: string = emit_meta_line("ok_struct_return_twice", twice_fn.body_len)?;
    let b8: StrBuilder = strbuf_push(b7, meta_twice);
    let b9: StrBuilder = strbuf_push(b8, twice_sig);
    let b10: StrBuilder = strbuf_push(b9, twice_body);
    let b11: StrBuilder = strbuf_push(b10, "}\n\n");
    let meta_main: string = emit_meta_line(prof.main_meta, main_fn.body_len)?;
    let b12: StrBuilder = strbuf_push(b11, meta_main);
    let b13: StrBuilder = strbuf_push(b12, main_sig);
    let b14: StrBuilder = strbuf_push(b13, main_ret);
    let b15: StrBuilder = strbuf_push(b14, "}\n");
    return Ok(strbuf_finish(b15));
}

fn return_is_eval_num(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, n: i32) -> i32 {
    let e: i32 = stmt_return_expr(stmts, idx);
    return is_num(nodes, e, n);
}

fn bootstrap_self_subset_pipeline(do_emit: i32) -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_bootstrap_self_subset()?;
    let importer: string = "lib/sh_parse";
    let path: string = golden_path_runtime()?;
    if (sh_lexer.slice_eq(path, 0, 24, prof.golden_path) != 1) {
        return Err(1);
    }
    let src: string = load_src_runtime()?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, importer, &mut pos)?;
    if (mod_inc_has_line(mod_inc, "#include \"../std/fx_defaults.h\"") != 1) {
        return Err(1);
    }
    if (mod_inc_has_line(mod_inc, "#include \"../std/string.h\"") != 1) {
        return Err(1);
    }
    if (mod_inc_has_line(mod_inc, "#include \"sh_lexer.h\"") != 1) {
        return Err(1);
    }
    if (mod_inc_has_line(mod_inc, "#include \"sh_diag.h\"") != 1) {
        return Err(1);
    }
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, en_out.name_off, en_out.name_len, "Expr") != 1) {
        return Err(1);
    }
    if (en_out.variant_count != 9) {
        return Err(1);
    }
    if (enum_has_any_payload(en_out) != 1) {
        return Err(1);
    }
    let stmt_en: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, stmt_en.name_off, stmt_en.name_len, "Stmt") != 1) {
        return Err(1);
