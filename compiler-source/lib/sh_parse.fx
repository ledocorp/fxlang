fn enum_payload_string_src() -> string {
    return "enum Msg {\n    Text(string),\n    Num(i32),\n}\n\nfn noop(_s: string) -> i32 {\n    return 42;\n}\n\nfn code(m: Msg) -> i32 {\n    return match m {\n        Text(s) => noop(s),\n        Num(n) => n,\n    };\n}\n\nfn main() -> i32 {\n    return code(Text(\"hello\"));\n}\n";
}

