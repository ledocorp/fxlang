fn stmt_is_assign_try_call2_ident_strlit(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, var: string, callee: string, arg0: string, lit: string) -> i32 {
    if (stmt_is_assign(stmts, idx, src, var) != 1) {
        return 0;
    }
    let e: i32 = stmt_assign_expr_idx(stmts, idx);
    if (expr_ty_tag(nodes, e) != 12) {
        return 0;
    }
    let inner: i32 = expr_try_inner_idx(nodes, e);
    if (expr_call_callee_is(nodes, inner, src, callee) != 1) {
        return 0;
    }
    let a0: i32 = expr_call_arg0_idx(nodes, inner);
    let a1: i32 = expr_call_arg1_idx(nodes, inner);
    if (a0 < 0) {
        return 0;
    }
    if (a1 < 0) {
        return 0;
    }
    if (expr_ty_tag(nodes, a0) != 3) {
        return 0;
    }
    let a0_off: i32 = expr_ident_off(nodes, a0);
    let a0_ln: i32 = expr_ident_ln(nodes, a0);
    if (sh_lexer.slice_eq(src, a0_off, a0_ln, arg0) != 1) {
        return 0;
    }
    if (expr_ty_tag(nodes, a1) != 2) {
        return 0;
    }
    let lit_off: i32 = expr_strlit_off(nodes, a1);
    let lit_ln: i32 = expr_strlit_ln(nodes, a1);
    return sh_lexer.slice_eq(src, lit_off, lit_ln, lit);
}

