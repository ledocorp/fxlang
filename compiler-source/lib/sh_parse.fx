fn enum_payload_mixed_src() -> string {
    return "enum Event {\n    Text(string),\n    Point(i32, i32),\n    Stop,\n}\n\nfn noop(_s: string) -> i32 {\n    return 1;\n}\n\nfn score(e: Event) -> i32 {\n    return match e {\n        Text(s) => noop(s),\n        Point(x, y) => x + y,\n        Stop => 0,\n    };\n}\n\nfn main() -> i32 {\n    return score(Point(10, 32));\n}\n";
}

