fn emit_mangled_callee(prefix: string, src: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let coff: i32 = expr_call2_callee_off(nodes, call_idx);
    let cln: i32 = expr_call2_callee_ln(nodes, call_idx);
    let name: string = sh_lexer.slice_str(src, coff, cln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, prefix);
    let b2: StrBuilder = strbuf_push(b1, name);
    return Ok(strbuf_finish(b2));
}

fn stmt_let_var_off(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(off, ln, e, _, _) => {
            if (e + off + ln < 0) {
                return 0;
            }
            return off;
        },
        Return(r) => r,
        Assign(a, b, c) => a + b + c,
        AssignPtr(a, b, c) => a + b + c,
        If(a, b, c, d, e) => a + b + c + d + e,
        While(a, b, c) => a + b + c,
        Call(a, b, c, d) => a + b + c + d,
        Break => 0,
        Continue => 0,
        Region(a, b, c) => a + b + c,
        IndexAssign(a, b, c) => a + b + c,
    };
}

fn stmt_let_var_ln(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(off, ln, e, _, _) => {
            if (e + off + ln < 0) {
                return 0;
            }
            return ln;
        },
        Return(r) => r,
        Assign(a, b, c) => a + b + c,
        AssignPtr(a, b, c) => a + b + c,
        If(a, b, c, d, e) => a + b + c + d + e,
        While(a, b, c) => a + b + c,
        Call(a, b, c, d) => a + b + c + d,
        Break => 0,
        Continue => 0,
        Region(a, b, c) => a + b + c,
        IndexAssign(a, b, c) => a + b + c,
    };
}

fn emit_let_call2_line(src: string, stmts: Vec<Stmt>, let_idx: i32, callee: string, n0: i32, n1: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let var_off: i32 = stmt_let_var_off(stmts, let_idx);
    let var_ln: i32 = stmt_let_var_ln(stmts, let_idx);
    let var: string = sh_lexer.slice_str(src, var_off, var_ln)?;
    let s0: string = str_from_i32(n0)?;
    let s1: string = str_from_i32(n1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    int32_t ");
    let b2: StrBuilder = strbuf_push(b1, var);
    let b3: StrBuilder = strbuf_push(b2, " = ");
    let b4: StrBuilder = strbuf_push(b3, callee);
    let b5: StrBuilder = strbuf_push(b4, "(");
    let b6: StrBuilder = strbuf_push(b5, s0);
    let b7: StrBuilder = strbuf_push(b6, ", ");
    let b8: StrBuilder = strbuf_push(b7, s1);
    let b9: StrBuilder = strbuf_push(b8, ");\n");
    return Ok(strbuf_finish(b9));
}

fn emit_call2_line(prefix: string, n0: i32, n1: i32, suffix: string) -> Result<string, core_Err> effects { alloc, mut } {
    let s0: string = str_from_i32(n0)?;
    let s1: string = str_from_i32(n1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, prefix);
    let b2: StrBuilder = strbuf_push(b1, s0);
    let b3: StrBuilder = strbuf_push(b2, ", ");
    let b4: StrBuilder = strbuf_push(b3, s1);
    let b5: StrBuilder = strbuf_push(b4, suffix);
    return Ok(strbuf_finish(b5));
}

fn stmt_call_callee_off(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Call(off, ln, argc, arg) => {
            if (argc + arg + off + ln < 0) {
                return 0;
            }
            return off;
        },
        Return(r) => r,
        Let(a, b, c, _, _) => a + b + c,
        Assign(a, b, c) => a + b + c,
        AssignPtr(a, b, c) => a + b + c,
        If(a, b, c, d, e) => a + b + c + d + e,
        While(a, b, c) => a + b + c,
        Break => 0,
        Continue => 0,
        Region(a, b, c) => a + b + c,
        IndexAssign(a, b, c) => a + b + c,
    };
}

fn stmt_call_callee_ln(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Call(off, ln, argc, arg) => {
            if (argc + arg + off + ln < 0) {
                return 0;
            }
            return ln;
        },
        Return(r) => r,
        Let(a, b, c, _, _) => a + b + c,
        Assign(a, b, c) => a + b + c,
        AssignPtr(a, b, c) => a + b + c,
        If(a, b, c, d, e) => a + b + c + d + e,
        While(a, b, c) => a + b + c,
        Break => 0,
        Continue => 0,
        Region(a, b, c) => a + b + c,
        IndexAssign(a, b, c) => a + b + c,
    };
}

fn stmt_call_first_arg(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Call(off, ln, argc, arg) => {
            if (argc + arg + off + ln < 0) {
                return -1;
            }
            return arg;
        },
        Return(r) => r,
        Let(a, b, c, _, _) => a + b + c,
        Assign(a, b, c) => a + b + c,
        AssignPtr(a, b, c) => a + b + c,
        If(a, b, c, d, e) => a + b + c + d + e,
        While(a, b, c) => a + b + c,
        Break => 0,
        Continue => 0,
        Region(a, b, c) => a + b + c,
        IndexAssign(a, b, c) => a + b + c,
    };
}

fn expr_strlit_off(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        StrLit(off, ln) => {
            if (off + ln >= 0) {
                return off;
            }
            return 0;
        },
        Num(n) => n,
        Ident(ioff, iln) => ioff + iln,
        Add(l, r) => l + r,
        Sub(l, r) => l - r,
        Mul(l, r) => l + r,
        Div(l, r) => l - r,
        CmpLt(l, r) => l + r,
        CmpNe(l, r) => l + r,
        CmpEq(l, r) => l + r,
        CmpGe(l, r) => l + r,
        Deref(inner) => inner,
        Match(scr, arms, _) => scr + arms,
        CallExpr(coff, cln, a0, a1, _, _, _) => coff + cln + a0 + a1,
        StructLit(o, l, c, f0, f1, f2, f3, f4, f5, f6, f7, f8, _, _, _, _, _, _, _, _) => o + l + c + f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

fn expr_strlit_ln(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        StrLit(off, ln) => {
            if (off + ln >= 0) {
                return ln;
            }
            return 0;
        },
        Num(n) => n,
        Ident(ioff, iln) => ioff + iln,
        Add(l, r) => l + r,
        Sub(l, r) => l - r,
        Mul(l, r) => l + r,
        Div(l, r) => l - r,
        CmpLt(l, r) => l + r,
        CmpNe(l, r) => l + r,
        CmpEq(l, r) => l + r,
        CmpGe(l, r) => l + r,
        Deref(inner) => inner,
        Match(scr, arms, _) => scr + arms,
        CallExpr(coff, cln, a0, a1, _, _, _) => coff + cln + a0 + a1,
        StructLit(o, l, c, f0, f1, f2, f3, f4, f5, f6, f7, f8, _, _, _, _, _, _, _, _) => o + l + c + f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

fn emit_call1_strlit_line(src: string, callee: string, lit_off: i32, lit_ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let lit: string = sh_lexer.slice_str(src, lit_off, lit_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, callee);
    let b3: StrBuilder = strbuf_push(b2, "(\"");
    let b4: StrBuilder = strbuf_push(b3, lit);
    let b5: StrBuilder = strbuf_push(b4, "\");\n");
    return Ok(strbuf_finish(b5));
}

fn emit_stmt_call1_strlit_line(src: string, stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>) -> Result<string, core_Err> effects { alloc, mut } {
    let coff: i32 = stmt_call_callee_off(stmts, idx);
    let cln: i32 = stmt_call_callee_ln(stmts, idx);
    let callee: string = sh_lexer.slice_str(src, coff, cln)?;
    let arg_idx: i32 = stmt_call_first_arg(stmts, idx);
    let lit_off: i32 = expr_strlit_off(nodes, arg_idx);
    let lit_ln: i32 = expr_strlit_ln(nodes, arg_idx);
    return emit_call1_strlit_line(src, callee, lit_off, lit_ln);
}

fn ty_kind_i32() -> i32 {
    return 1;
}

fn ty_kind_str() -> i32 {
    return 2;
}

fn ty_kind_bad() -> i32 {
    return 0;
}

fn ty_kind_struct() -> i32 {
    return 3;
}

fn ret_ty_kind(src: string, fn_out: FnOut) -> i32 {
    if (fn_out.ret_is_result == 1) {
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "i32") == 1) {
            return ty_kind_i32();
        }
        if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "string") == 1) {
            return ty_kind_str();
        }
        return ty_kind_struct();
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_off, fn_out.ret_len, "i32") == 1) {
        return ty_kind_i32();
    }
    // CONV-3-r.19 - bool lowers to int32_t; CmpLt/etc. already infer as i32.
    if (sh_lexer.slice_eq(src, fn_out.ret_off, fn_out.ret_len, "bool") == 1) {
        return ty_kind_i32();
    }
    return ty_kind_struct();
}

fn infer_call_ty(nodes: Vec<Expr>, idx: i32, src: string, ret_m: Map<string, i32>) -> Result<i32, core_Err> effects { alloc, mut } {
    let coff: i32 = expr_call2_callee_off(nodes, idx);
    let cln: i32 = expr_call2_callee_ln(nodes, idx);
    let name: string = sh_lexer.slice_str(src, coff, cln)?;
    if (env_map_has_i32(ret_m, name) == 1) {
        // SH-C-20 - ret_m value tags: 1=struct Result payload, 2=string, 3=i32.
        let k: i32 = env_map_get_i32(ret_m, name)?;
        if (k == 2) {
            return Ok(ty_kind_str());
        }
        if (k == 3) {
            return Ok(ty_kind_i32());
        }
        return Ok(ty_kind_struct());
    }
    return Ok(ty_kind_i32());
}

fn infer_ident_ty(src: string, off: i32, ln: i32, param_m: Map<string, i32>, let_i32_m: Map<string, i32>, let_struct_m: Map<string, i32>) -> Result<i32, core_Err> effects { alloc, mut } {
    let dot: i32 = slice_dot_pos(src, off, ln);
    if (dot >= 0) {
        let base_ln: i32 = dot - off;
        let base_name: string = sh_lexer.slice_str(src, off, base_ln)?;
        let in_param: i32 = env_lookup_i32(param_m, let_i32_m, base_name);
        if (in_param == 1) {
            return Ok(ty_kind_i32());
        }
        let in_struct_let: i32 = env_lookup_struct(let_struct_m, base_name);
        if (in_struct_let == 1) {
            // SH-C-19 - only struct-tagged lets (value 1) expose i32 fields.
            let k: i32 = env_map_get_i32(let_struct_m, base_name)?;
            if (k == 1) {
                return Ok(ty_kind_i32());
            }
            return Ok(ty_kind_bad());
        }
        return Ok(ty_kind_bad());
    }
    let name: string = sh_lexer.slice_str(src, off, ln)?;
    let in_struct_let: i32 = env_lookup_struct(let_struct_m, name);
    if (in_struct_let == 1) {
        // SH-C-19 - value 2 = string-annotated let; value 1 = struct.
        let k: i32 = env_map_get_i32(let_struct_m, name)?;
        if (k == 2) {
            return Ok(ty_kind_str());
        }
        return Ok(ty_kind_struct());
    }
    let in_param: i32 = env_lookup_i32(param_m, let_i32_m, name);
    if (in_param == 1) {
        return Ok(ty_kind_i32());
    }
    return Ok(ty_kind_bad());
}

fn combine_binop_ty(left: i32, right: i32) -> i32 {
    if (left == ty_kind_str()) {
        return ty_kind_str();
    }
    if (right == ty_kind_str()) {
        return ty_kind_str();
    }
    if (left == ty_kind_i32()) {
        if (right == ty_kind_i32()) {
            return ty_kind_i32();
        }
    }
    return ty_kind_bad();
}

fn infer_binop_ty(nodes: Vec<Expr>, l: i32, r: i32, src: string, param_env: string, let_env: string, struct_ret_env: string, param_m: Map<string, i32>, let_i32_m: Map<string, i32>, let_struct_m: Map<string, i32>, ret_m: Map<string, i32>) -> Result<i32, core_Err> effects { alloc, mut } {
    let tl: i32 = infer_expr_ty_kind(nodes, l, src, param_env, let_env, struct_ret_env, param_m, let_i32_m, let_struct_m, ret_m)?;
    let tr: i32 = infer_expr_ty_kind(nodes, r, src, param_env, let_env, struct_ret_env, param_m, let_i32_m, let_struct_m, ret_m)?;
    return Ok(combine_binop_ty(tl, tr));
}

fn expr_ty_tag(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Num(_) => 1,
        StrLit(_, _) => 2,
        Ident(_, _) => 3,
        Add(_, _) => 4,
        Sub(_, _) => 5,
        Mul(_, _) => 6,
        Div(_, _) => 7,
        CmpLt(_, _) => 8,
        CmpNe(_, _) => 13,
        CmpEq(_, _) => 16,
        CmpGe(_, _) => 14,
        Deref(_) => 15,
        Match(_, _, _) => 9,
        CallExpr(_, _, _, _, _, _, _) => 10,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 11,
        TryExpr(_) => 12,
        Index(_, _) => 17,
        SliceRange(_, _, _) => 18,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 19,
    };
}

fn expr_index_base_idx(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        Num(_) => -1,
        StrLit(_, _) => -1,
        Ident(_, _) => -1,
        Add(_, _) => -1,
        Sub(_, _) => -1,
        Mul(_, _) => -1,
        Div(_, _) => -1,
        CmpLt(_, _) => -1,
        CmpNe(_, _) => -1,
        CmpEq(_, _) => -1,
        CmpGe(_, _) => -1,
        Deref(_) => -1,
        Match(_, _, _) => -1,
        CallExpr(_, _, _, _, _, _, _) => -1,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => -1,
        TryExpr(_) => -1,
        ArrayLit(_, _, _, _, _, _, _, _, _) => -1,
    };
}

