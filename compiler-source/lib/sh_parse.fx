fn fixture_profile_tests() -> Result<i32, core_Err> effects { alloc, mut } {
    let p0: FixtureProfile = fixture_profile_ok_main()?;
    if (sh_lexer.slice_eq(p0.mod_slug, 0, 7, "ok_main") != 1) {
