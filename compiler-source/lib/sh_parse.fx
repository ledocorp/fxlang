        return Ok(ok_fs);
    }
    let bad_fs: i32 = typecheck_rejects_result_forward_fs_read_text_unknown()?;
    if (bad_fs != 42) {
        return Ok(bad_fs);
    }
    let ok_sfr: i32 = typecheck_accepts_result_forward_struct_fields_rest()?;
    if (ok_sfr != 42) {
        return Ok(ok_sfr);
    }
    let bad_sfr: i32 = typecheck_rejects_result_forward_struct_fields_rest_unknown()?;
    if (bad_sfr != 42) {
        return Ok(bad_sfr);
    }
    let ok_pne: i32 = typecheck_accepts_result_forward_fn_params_nonempty()?;
    if (ok_pne != 42) {
        return Ok(ok_pne);
    }
    let bad_pne: i32 = typecheck_rejects_result_forward_fn_params_nonempty_unknown()?;
    if (bad_pne != 42) {
        return Ok(bad_pne);
    }
    let ok_br: i32 = typecheck_accepts_result_forward_block_rest()?;
    if (ok_br != 42) {
        return Ok(ok_br);
    }
    let bad_br: i32 = typecheck_rejects_result_forward_block_rest_unknown()?;
    if (bad_br != 42) {
