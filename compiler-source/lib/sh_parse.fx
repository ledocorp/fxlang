        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn return_is_call1_payload_str(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, callee: string, variant: string, want: string) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => {
            if (expr_call_callee_is(nodes, e, src, callee) != 1) {
                return 0;
            }
            let arg_idx: i32 = expr_call1_arg_idx(nodes, e);
            if (arg_idx < 0) {
                return 0;
            }
            return expr_is_payload_ctor_strlit(nodes, arg_idx, src, variant, want);
        },
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn return_is_call1_payload_num(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, callee: string, variant: string, lit: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => expr_is_call1_payload_num(nodes, e, src, callee, variant, lit),
        Let(_, _, _, _, _) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn expr_is_call1_payload_num(nodes: Vec<Expr>, idx: i32, src: string, callee: string, variant: string, lit: i32) -> i32 {
    if (expr_call_callee_is(nodes, idx, src, callee) != 1) {
        return 0;
    }
    let arg_idx: i32 = expr_call1_arg_idx(nodes, idx);
    if (arg_idx < 0) {
        return 0;
    }
    return expr_is_call1_num(nodes, arg_idx, src, variant, lit);
}

fn stmt_is_let_call1_payload_num(stmts: Vec<Stmt>, idx: i32, nodes: Vec<Expr>, src: string, var: string, callee: string, variant: string, lit: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(off, ln, e, _, _) => {
            if (sh_lexer.slice_eq(src, off, ln, var) != 1) {
                return 0;
            }
            return expr_is_call1_payload_num(nodes, e, src, callee, variant, lit);
        },
        Return(_) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        Region(_, _, _) => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn stmt_is_region_var_arena(stmts: Vec<Stmt>, idx: i32, src: string, var: string, arena_sz: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Region(off, ln, sz) => {
            if (sh_lexer.slice_eq(src, off, ln, var) != 1) {
                return 0;
            }
            if (sz != arena_sz) {
                return 0;
            }
            return 1;
        },
        Let(_, _, _, _, _) => 0,
        Return(_) => 0,
        Assign(_, _, _) => 0,
        AssignPtr(_, _, _) => 0,
        If(_, _, _, _, _) => 0,
        While(_, _, _) => 0,
        Call(_, _, _, _) => 0,
        Break => 0,
        Continue => 0,
        IndexAssign(_, _, _) => 0,
    };
}

fn parse_and_emit_ok_enum_payload() -> Result<string, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_ok_enum_payload()?;
    let src: string = "enum Msg {\n    Num(i32),\n    Stop,\n}\n\nfn code(m: Msg) -> i32 {\n    return match m {\n        Num(n) => n,\n        Stop => 99,\n    };\n}\n\nfn main() -> i32 {\n    return code(Num(42));\n}\n";
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, en_out.name_off, en_out.name_len, "Msg") != 1) {
        return Err(1);
    }
    if (en_out.variant_count != 2) {
        return Err(1);
    }
    if (enum_has_any_payload(en_out) != 1) {
        return Err(1);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let code_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src, code_fn.name_off, code_fn.name_len, "code") != 1) {
        return Err(1);
    }
    if (code_fn.body_len != 1) {
        return Err(1);
    }
    if (return_is_match_on_ident(code_fn.stmts, code_fn.body_start, code_fn.nodes, src, "m", 2) != 1) {
        return Err(1);
    }
    let tc_code: i32 = check_fn_returns(code_fn, src)?;
    if (tc_code != 0) {
        return Err(1);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (sh_lexer.slice_eq(src, main_fn.name_off, main_fn.name_len, "main") != 1) {
        return Err(1);
    }
    if (main_fn.body_len != 1) {
        return Err(1);
    }
    if (return_is_call1_payload_num(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "code", "Num", 42) != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(main_fn, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    if (string.len(mod_inc) < 0) {
        return Err(1);
    }
    return enum_payload_emit_inner();
}

fn parse_and_emit_ok_enum_payload_multi() -> Result<string, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_ok_enum_payload_multi()?;
    let src: string = "enum Shape {\n    Point(i32, i32),\n    Unit,\n}\n\nfn sum_coords(s: Shape) -> i32 {\n    return match s {\n        Point(x, y) => x + y,\n        Unit => 0,\n    };\n}\n\nfn main() -> i32 {\n    return sum_coords(Point(10, 32));\n}\n";
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, en_out.name_off, en_out.name_len, "Shape") != 1) {
        return Err(1);
    }
    if (en_out.variant_count != 2) {
        return Err(1);
    }
    if (enum_has_any_payload(en_out) != 1) {
        return Err(1);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let code_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (return_is_match_on_ident(code_fn.stmts, code_fn.body_start, code_fn.nodes, src, "s", 2) != 1) {
        return Err(1);
    }
    let tc_code: i32 = check_fn_returns(code_fn, src)?;
    if (tc_code != 0) {
        return Err(1);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (return_is_call1_payload2_num(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "sum_coords", "Point", 10, 32) != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(main_fn, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    if (string.len(mod_inc) < 0) {
        return Err(1);
    }
    return enum_payload_multi_emit_inner();
}

fn parse_and_emit_ok_enum_payload_string() -> Result<string, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_ok_enum_payload_string()?;
    let src: string = enum_payload_string_src();
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, en_out.name_off, en_out.name_len, "Msg") != 1) {
        return Err(1);
    }
    if (en_out.variant_count != 2) {
        return Err(1);
    }
    if (enum_has_any_payload(en_out) != 1) {
        return Err(1);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let noop_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src, noop_fn.name_off, noop_fn.name_len, "noop") != 1) {
        return Err(1);
    }
    let code_empty: Vec<Expr> = vec_new(0);
    let code_empty_stmts: Vec<Stmt> = vec_new(0);
    let code_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, code_empty, code_empty_stmts)?;
    if (return_is_match_on_ident(code_fn.stmts, code_fn.body_start, code_fn.nodes, src, "m", 2) != 1) {
        return Err(1);
    }
    let tc_code: i32 = check_fn_returns(code_fn, src)?;
    if (tc_code != 0) {
        return Err(1);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (return_is_call1_payload_str(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "code", "Text", "hello") != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(main_fn, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    if (string.len(mod_inc) < 0) {
        return Err(1);
    }
    return enum_payload_string_emit_inner();
}

fn parse_and_emit_ok_enum_payload_mixed() -> Result<string, core_Err> effects { alloc, mut } {
    region r = arena(fx_defaults.arena_parse());
    let prof: FixtureProfile = fixture_profile_ok_enum_payload_mixed()?;
    let src: string = enum_payload_mixed_src();
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let mod_inc: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos)?;
    let en_out: EnumOut = parse_enum_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, en_out.name_off, en_out.name_len, "Event") != 1) {
        return Err(1);
    }
    if (en_out.variant_count != 3) {
        return Err(1);
    }
    if (enum_has_any_payload(en_out) != 1) {
        return Err(1);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let noop_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (sh_lexer.slice_eq(src, noop_fn.name_off, noop_fn.name_len, "noop") != 1) {
        return Err(1);
    }
    let score_empty: Vec<Expr> = vec_new(0);
    let score_empty_stmts: Vec<Stmt> = vec_new(0);
    let score_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, score_empty, score_empty_stmts)?;
    if (return_is_match_on_ident(score_fn.stmts, score_fn.body_start, score_fn.nodes, src, "e", 3) != 1) {
        return Err(1);
    }
    let tc_score: i32 = check_fn_returns(score_fn, src)?;
    if (tc_score != 0) {
        return Err(1);
    }
    let main_empty: Vec<Expr> = vec_new(0);
    let main_empty_stmts: Vec<Stmt> = vec_new(0);
    let main_fn: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, main_empty, main_empty_stmts)?;
    if (pos != buf.kinds.len) {
        return Err(1);
    }
    if (return_is_call1_payload2_num(main_fn.stmts, main_fn.body_start, main_fn.nodes, src, "score", "Point", 10, 32) != 1) {
        return Err(1);
    }
    let tc_main: i32 = check_fn_returns(main_fn, src)?;
    if (tc_main != 0) {
        return Err(1);
    }
    if (string.len(mod_inc) < 0) {
        return Err(1);
    }
    return enum_payload_mixed_emit_inner();
}

