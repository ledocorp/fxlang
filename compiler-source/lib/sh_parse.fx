fn parse_and_emit_bootstrap_real_parse_recursive() -> Result<string, core_Err> effects { alloc, io, mut } {
    region r = arena(1 << 24);
    let prof: FixtureProfile = fixture_profile_bootstrap_real_parse_recursive()?;
    let src: string = load_golden_src(prof.golden_path)?;
    let buf = sh_lexer.lex(src);
    let pos: i32 = 0;
    let _skip: i32 = skip_module_preamble(buf.kinds, buf.vals, buf.lens, &mut pos)?;
    let _using: i32 = parse_using_decl(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    let _incs: string = parse_preamble_includes(buf.kinds, buf.vals, buf.lens, src, "lib/sh_parse.fx", &mut pos)?;
    let mod_st: StructOut = parse_struct_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, mod_st.name_off, mod_st.name_len, "ModOut") != 1) {
        return Err(1);
    }
    let imp_st: StructOut = parse_struct_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, imp_st.name_off, imp_st.name_len, "ImpOut") != 1) {
        return Err(1);
    }
    let param_st: StructOut = parse_struct_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, param_st.name_off, param_st.name_len, "ParamParseOut") != 1) {
        return Err(1);
    }
    let ret_st: StructOut = parse_struct_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, ret_st.name_off, ret_st.name_len, "RetTypeOut") != 1) {
        return Err(1);
    }
    let enum_st: StructOut = parse_struct_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, enum_st.name_off, enum_st.name_len, "EnumOut") != 1) {
        return Err(1);
    }
    let struct_st: StructOut = parse_struct_def(buf.kinds, buf.vals, buf.lens, src, &mut pos)?;
    if (sh_lexer.slice_eq(src, struct_st.name_off, struct_st.name_len, "StructOut") != 1) {
        return Err(1);
    }
    let empty: Vec<Expr> = vec_new(0);
    let empty_stmts: Vec<Stmt> = vec_new(0);
    let f0: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f0, "parse_path_span") != 1) {
        return Err(1);
    }
    let f1: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f1, "parse_module_decl") != 1) {
        return Err(1);
    }
    let f2: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f2, "parse_import_decl") != 1) {
        return Err(1);
    }
    let f3: FnOut = parse_fn_def(buf.kinds, buf.vals, buf.lens, src, prof.mod_slug, &mut pos, empty, empty_stmts)?;
    if (fn_name_is(src, f3, "type_span_is_vec") != 1) {
