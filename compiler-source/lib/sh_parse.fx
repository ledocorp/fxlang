fn expr_call1_arg_idx(nodes: Vec<Expr>, call_idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, call_idx);
    return match node {
        CallExpr(_, _, a0, a1, _, _, _) => {
            if (a1 >= 0) {
                return -1;
            }
            return a0;
        },
        Num(n) => n,
        StrLit(off, ln) => off + ln,
        Ident(off, ln) => off + ln,
        Add(l, r) => l + r,
        Sub(l, r) => l - r,
        Mul(l, r) => l + r,
        Div(l, r) => l - r,
        CmpLt(l, r) => l + r,
        CmpNe(l, r) => l + r,
        CmpEq(l, r) => l + r,
        CmpGe(l, r) => l + r,
        Deref(inner) => inner,
        Match(scr, arms, _) => scr + arms,
        StructLit(_, _, c, f0, f1, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => c + f0 + f1,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

fn emit_return_call1_enum_variant_line(prof: FixtureProfile, src: string, en_out: EnumOut, callee_pfx: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let callee: string = emit_mangled_callee(callee_pfx, src, nodes, call_idx)?;
    let arg_idx: i32 = expr_call1_arg_idx(nodes, call_idx);
    if (arg_idx < 0) {
        return Err(1);
    }
    let arg_off: i32 = expr_ident_off(nodes, arg_idx);
    let arg_ln: i32 = expr_ident_ln(nodes, arg_idx);
    let variant_name: string = sh_lexer.slice_str(src, arg_off, arg_ln)?;
    let const_name: string = emit_enum_variant_const(prof, src, en_out, variant_name)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return ");
    let b2: StrBuilder = strbuf_push(b1, callee);
    let b3: StrBuilder = strbuf_push(b2, "(");
    let b4: StrBuilder = strbuf_push(b3, const_name);
    let b5: StrBuilder = strbuf_push(b4, ");\n");
    return Ok(strbuf_finish(b5));
}

fn emit_fn_call1_enum_return_block(mod_slug: string, src: string, prof: FixtureProfile, en_out: EnumOut, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let sig: string = emit_fn_sig_open_line(mod_slug, src, fn_out)?;
    let ret_idx: i32 = stmt_return_expr_idx(fn_out.stmts, fn_out.body_start);
    let callee_pfx: string = profile_callee_prefix(prof)?;
    let ret_line: string = emit_return_call1_enum_variant_line(prof, src, en_out, callee_pfx, fn_out.nodes, ret_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, sig);
    let b2: StrBuilder = strbuf_push(b1, ret_line);
    let b3: StrBuilder = strbuf_push(b2, "}\n");
    return Ok(strbuf_finish(b3));
}

fn enum_variant_payload_spec(en_out: EnumOut, variant_name: string) -> Result<string, core_Err> effects { alloc, mut } {
    let i: i32 = 0;
    while (i < en_out.variant_count) {
        let vname: string = variants_env_nth(en_out.variants_env, i)?;
        if (sh_lexer.slice_eq(vname, 0, string.len(vname), variant_name) == 1) {
            return payloads_env_nth(en_out.payloads_env, i);
        }
        i = i + 1;
    }
    return Err(1);
}

fn emit_return_call1_payload_ctor_call_expr(src: string, callee: string, enum_ty: string, tag_name: string, union_field: string, spec: string, nodes: Vec<Expr>, a0: i32, a1: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (payload_spec_is_multi(spec) == 1) {
        if (a1 < 0) {
            return Err(1);
        }
        let v0: i32 = eval_expr(nodes, a0);
        let v1: i32 = eval_expr(nodes, a1);
        let s0: string = str_from_i32(v0)?;
        let s1: string = str_from_i32(v1)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "    return ");
        let b2: StrBuilder = strbuf_push(b1, callee);
        let b3: StrBuilder = strbuf_push(b2, "((");
        let b4: StrBuilder = strbuf_push(b3, enum_ty);
        let b5: StrBuilder = strbuf_push(b4, "){ .tag = ");
        let b6: StrBuilder = strbuf_push(b5, tag_name);
        let b7: StrBuilder = strbuf_push(b6, ", .u = { .");
        let b8: StrBuilder = strbuf_push(b7, union_field);
        let b9: StrBuilder = strbuf_push(b8, " = { .f0 = ");
        let b10: StrBuilder = strbuf_push(b9, s0);
        let b11: StrBuilder = strbuf_push(b10, ", .f1 = ");
        let b12: StrBuilder = strbuf_push(b11, s1);
        let b13: StrBuilder = strbuf_push(b12, " } } });\n");
        return Ok(strbuf_finish(b13));
    }
    let lit_arg: i32 = a0;
    if (lit_arg < 0) {
        return Err(1);
    }
    let h0: StrBuilder = strbuf_new();
    let h1: StrBuilder = strbuf_push(h0, "    return ");
    let h2: StrBuilder = strbuf_push(h1, callee);
    let h3: StrBuilder = strbuf_push(h2, "((");
    let h4: StrBuilder = strbuf_push(h3, enum_ty);
    let h5: StrBuilder = strbuf_push(h4, "){ .tag = ");
    let h6: StrBuilder = strbuf_push(h5, tag_name);
    let h7: StrBuilder = strbuf_push(h6, ", .u = { .");
    let head: string = strbuf_finish(strbuf_push(h7, union_field));
    if (expr_ty_tag(nodes, lit_arg) == 2) {
        let lit_off: i32 = expr_strlit_off(nodes, lit_arg);
        let lit_ln: i32 = expr_strlit_ln(nodes, lit_arg);
        let lit_val: string = sh_lexer.slice_str(src, lit_off, lit_ln)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, head);
        let b2: StrBuilder = strbuf_push(b1, " = \"");
        let b3: StrBuilder = strbuf_push(b2, lit_val);
        let b4: StrBuilder = strbuf_push(b3, "\" } });\n");
        return Ok(strbuf_finish(b4));
    }
    let lit_val: i32 = eval_expr(nodes, lit_arg);
    let lit_str: string = str_from_i32(lit_val)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, head);
    let b2: StrBuilder = strbuf_push(b1, " = ");
    let b3: StrBuilder = strbuf_push(b2, lit_str);
    let b4: StrBuilder = strbuf_push(b3, " } });\n");
    return Ok(strbuf_finish(b4));
}

fn emit_call1_payload_ctor_rhs_expr(src: string, callee: string, enum_ty: string, tag_name: string, union_field: string, spec: string, nodes: Vec<Expr>, a0: i32, a1: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (payload_spec_is_multi(spec) == 1) {
        if (a1 < 0) {
            return Err(1);
        }
        let v0: i32 = eval_expr(nodes, a0);
        let v1: i32 = eval_expr(nodes, a1);
        let s0: string = str_from_i32(v0)?;
        let s1: string = str_from_i32(v1)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, callee);
        let b2: StrBuilder = strbuf_push(b1, "((");
        let b3: StrBuilder = strbuf_push(b2, enum_ty);
        let b4: StrBuilder = strbuf_push(b3, "){ .tag = ");
        let b5: StrBuilder = strbuf_push(b4, tag_name);
        let b6: StrBuilder = strbuf_push(b5, ", .u = { .");
        let b7: StrBuilder = strbuf_push(b6, union_field);
        let b8: StrBuilder = strbuf_push(b7, " = { .f0 = ");
        let b9: StrBuilder = strbuf_push(b8, s0);
        let b10: StrBuilder = strbuf_push(b9, ", .f1 = ");
        let b11: StrBuilder = strbuf_push(b10, s1);
        let b12: StrBuilder = strbuf_push(b11, " } } })");
        return Ok(strbuf_finish(b12));
    }
    let lit_arg: i32 = a0;
    if (lit_arg < 0) {
        return Err(1);
    }
    let h0: StrBuilder = strbuf_new();
    let h1: StrBuilder = strbuf_push(h0, callee);
    let h2: StrBuilder = strbuf_push(h1, "((");
    let h3: StrBuilder = strbuf_push(h2, enum_ty);
    let h4: StrBuilder = strbuf_push(h3, "){ .tag = ");
    let h5: StrBuilder = strbuf_push(h4, tag_name);
    let h6: StrBuilder = strbuf_push(h5, ", .u = { .");
    let head: string = strbuf_finish(strbuf_push(h6, union_field));
    if (expr_ty_tag(nodes, lit_arg) == 2) {
        let lit_off: i32 = expr_strlit_off(nodes, lit_arg);
        let lit_ln: i32 = expr_strlit_ln(nodes, lit_arg);
        let lit_val: string = sh_lexer.slice_str(src, lit_off, lit_ln)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, head);
        let b2: StrBuilder = strbuf_push(b1, " = \"");
        let b3: StrBuilder = strbuf_push(b2, lit_val);
        let b4: StrBuilder = strbuf_push(b3, "\" } })");
        return Ok(strbuf_finish(b4));
    }
    let lit_val: i32 = eval_expr(nodes, lit_arg);
    let lit_str: string = str_from_i32(lit_val)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, head);
    let b2: StrBuilder = strbuf_push(b1, " = ");
    let b3: StrBuilder = strbuf_push(b2, lit_str);
    let b4: StrBuilder = strbuf_push(b3, " } })");
    return Ok(strbuf_finish(b4));
}

fn emit_let_call1_payload_line(prof: FixtureProfile, src: string, en_out: EnumOut, callee_pfx: string, var_off: i32, var_len: i32, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let vname: string = sh_lexer.slice_str(src, var_off, var_len)?;
    let callee: string = emit_mangled_callee(callee_pfx, src, nodes, call_idx)?;
    let outer_arg: i32 = expr_call1_arg_idx(nodes, call_idx);
    if (outer_arg < 0) {
        return Err(1);
    }
    let variant_off: i32 = expr_call2_callee_off(nodes, outer_arg);
    let variant_ln: i32 = expr_call2_callee_ln(nodes, outer_arg);
    let variant_name: string = sh_lexer.slice_str(src, variant_off, variant_ln)?;
    let tag_name: string = emit_enum_variant_tag_const(prof, src, en_out, variant_name)?;
    let enum_ty: string = emit_enum_type_c_name(prof, src, en_out.name_off, en_out.name_len)?;
    let spec: string = enum_variant_payload_spec(en_out, variant_name)?;
    let union_field: string = payload_spec_union_field(spec)?;
    if (expr_ty_tag(nodes, outer_arg) != 10) {
        return Err(1);
    }
    let a0: i32 = expr_call_arg0_idx(nodes, outer_arg);
    let a1: i32 = expr_call_arg1_idx(nodes, outer_arg);
    let rhs: string = emit_call1_payload_ctor_rhs_expr(src, callee, enum_ty, tag_name, union_field, spec, nodes, a0, a1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    int32_t ");
    let b2: StrBuilder = strbuf_push(b1, vname);
    let b3: StrBuilder = strbuf_push(b2, " = ");
    let b4: StrBuilder = strbuf_push(b3, rhs);
    let b5: StrBuilder = strbuf_push(b4, ";\n");
    return Ok(strbuf_finish(b5));
}

fn emit_bootstrap_region_stmt_line(src: string, stmts: Vec<Stmt>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let off: i32 = stmt_region_var_off(stmts, idx);
    let ln: i32 = stmt_region_var_ln(stmts, idx);
    let sz: i32 = stmt_region_arena_size(stmts, idx);
    let rname: string = sh_lexer.slice_str(src, off, ln)?;
    let sz_str: string = str_from_i32(sz)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, rname);
    let scratch: string = strbuf_finish(strbuf_push(b1, "_scratch"));
    let b2: StrBuilder = strbuf_new();
    let b3: StrBuilder = strbuf_push(b2, "    uint8_t ");
    let b4: StrBuilder = strbuf_push(b3, scratch);
    let b5: StrBuilder = strbuf_push(b4, "[");
    let b6: StrBuilder = strbuf_push(b5, sz_str);
    let b7: StrBuilder = strbuf_push(b6, "]; /* region ");
    let b8: StrBuilder = strbuf_push(b7, rname);
    let b9: StrBuilder = strbuf_push(b8, " */\n    (void)");
    let b10: StrBuilder = strbuf_push(b9, scratch);
    let b11: StrBuilder = strbuf_push(b10, ";\n");
    return Ok(strbuf_finish(b11));
}

fn emit_fn_region_let_call1_payload_return_ok_ident_block(mod_slug: string, src: string, prof: FixtureProfile, en_out: EnumOut, fn_out: FnOut, ok_ident: string) -> Result<string, core_Err> effects { alloc, mut } {
    let sig_line: string = emit_fn_sig_open_line(mod_slug, src, fn_out)?;
    let region_line: string = emit_bootstrap_region_stmt_line(src, fn_out.stmts, fn_out.body_start)?;
    let let_stmt: i32 = fn_out.body_start + 1;
    let let_idx: i32 = stmt_let_expr_idx(fn_out.stmts, let_stmt);
    let var_off: i32 = stmt_let_name_off(fn_out.stmts, let_stmt);
    let var_len: i32 = stmt_let_name_ln(fn_out.stmts, let_stmt);
    let callee_pfx: string = profile_callee_prefix(prof)?;
    let let_line: string = emit_let_call1_payload_line(prof, src, en_out, callee_pfx, var_off, var_len, fn_out.nodes, let_idx)?;
    let ret_line: string = emit_return_ok_ident_line(mod_slug, src, fn_out, ok_ident)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, sig_line);
    let b2: StrBuilder = strbuf_push(b1, region_line);
    let b3: StrBuilder = strbuf_push(b2, let_line);
    let b4: StrBuilder = strbuf_push(b3, ret_line);
    let b5: StrBuilder = strbuf_push(b4, "}\n\n");
    return Ok(strbuf_finish(b5));
}

fn emit_fn_let_call1_payload_return_ok_ident_block(mod_slug: string, src: string, prof: FixtureProfile, en_out: EnumOut, fn_out: FnOut, ok_ident: string) -> Result<string, core_Err> effects { alloc, mut } {
    let sig_line: string = emit_fn_sig_open_line(mod_slug, src, fn_out)?;
    let let_idx: i32 = stmt_let_expr_idx(fn_out.stmts, fn_out.body_start);
    let var_off: i32 = stmt_let_name_off(fn_out.stmts, fn_out.body_start);
    let var_len: i32 = stmt_let_name_ln(fn_out.stmts, fn_out.body_start);
    let callee_pfx: string = profile_callee_prefix(prof)?;
    let let_line: string = emit_let_call1_payload_line(prof, src, en_out, callee_pfx, var_off, var_len, fn_out.nodes, let_idx)?;
    let ret_line: string = emit_return_ok_ident_line(mod_slug, src, fn_out, ok_ident)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, sig_line);
    let b2: StrBuilder = strbuf_push(b1, let_line);
    let b3: StrBuilder = strbuf_push(b2, ret_line);
    let b4: StrBuilder = strbuf_push(b3, "}\n\n");
    return Ok(strbuf_finish(b4));
}

fn emit_return_call1_payload_ctor_line(prof: FixtureProfile, src: string, en_out: EnumOut, callee_pfx: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let callee: string = emit_mangled_callee(callee_pfx, src, nodes, call_idx)?;
    let outer_arg: i32 = expr_call1_arg_idx(nodes, call_idx);
    if (outer_arg < 0) {
        return Err(1);
    }
    let variant_off: i32 = expr_call2_callee_off(nodes, outer_arg);
    let variant_ln: i32 = expr_call2_callee_ln(nodes, outer_arg);
    let variant_name: string = sh_lexer.slice_str(src, variant_off, variant_ln)?;
    let tag_name: string = emit_enum_variant_tag_const(prof, src, en_out, variant_name)?;
    let enum_ty: string = emit_enum_type_c_name(prof, src, en_out.name_off, en_out.name_len)?;
    let spec: string = enum_variant_payload_spec(en_out, variant_name)?;
    let union_field: string = payload_spec_union_field(spec)?;
    if (expr_ty_tag(nodes, outer_arg) != 10) {
        return Err(1);
    }
    let a0: i32 = expr_call_arg0_idx(nodes, outer_arg);
    let a1: i32 = expr_call_arg1_idx(nodes, outer_arg);
    return emit_return_call1_payload_ctor_call_expr(src, callee, enum_ty, tag_name, union_field, spec, nodes, a0, a1);
}

fn emit_fn_call1_payload_return_block(mod_slug: string, src: string, prof: FixtureProfile, en_out: EnumOut, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let sig: string = emit_fn_sig_open_line(mod_slug, src, fn_out)?;
    let ret_idx: i32 = stmt_return_expr_idx(fn_out.stmts, fn_out.body_start);
    let callee_pfx: string = profile_callee_prefix(prof)?;
    let ret_line: string = emit_return_call1_payload_ctor_line(prof, src, en_out, callee_pfx, fn_out.nodes, ret_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, sig);
    let b2: StrBuilder = strbuf_push(b1, ret_line);
    let b3: StrBuilder = strbuf_push(b2, "}\n");
    return Ok(strbuf_finish(b3));
}

