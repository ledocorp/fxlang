                    let b13: StrBuilder = strbuf_push(b12, ", .f2 = ");
                    let b14: StrBuilder = strbuf_push(b13, payload2);
                    let b15: StrBuilder = strbuf_push(b14, " } } })");
                    return Ok(strbuf_finish(b15));
                }
                if (sh_lexer.slice_eq(src, a1_coff, a1_cln, "While") == 1) {
                    let vec: string = emit_parser_expr_c(mod_slug, src, nodes, a0)?;
                    let arg0_idx: i32 = expr_call_arg0_idx(nodes, a1);
                    let arg1_idx: i32 = expr_call_arg1_idx(nodes, a1);
                    let arg2_idx: i32 = expr_call_arg2_idx(nodes, a1);
                    let payload0: string = emit_parser_expr_c(mod_slug, src, nodes, arg0_idx)?;
                    let payload1: string = emit_parser_expr_c(mod_slug, src, nodes, arg1_idx)?;
                    let payload2: string = emit_parser_expr_c(mod_slug, src, nodes, arg2_idx)?;
                    let mod_up: string = sh_lexer.mangle_upper_slice(mod_slug, 0, string.len(mod_slug))?;
                    let b0: StrBuilder = strbuf_new();
                    let b1: StrBuilder = strbuf_push(b0, "fx_");
                    let b2: StrBuilder = strbuf_push(b1, mod_slug);
                    let b3: StrBuilder = strbuf_push(b2, "_vec_Stmt_push_val(core_default_allocator(), ");
                    let b4: StrBuilder = strbuf_push(b3, vec);
                    let b5: StrBuilder = strbuf_push(b4, ", (fx_");
                    let b6: StrBuilder = strbuf_push(b5, mod_slug);
                    let b7: StrBuilder = strbuf_push(b6, "_Stmt){ .tag = FX_");
                    let b8: StrBuilder = strbuf_push(b7, mod_up);
                    let b9: StrBuilder = strbuf_push(b8, "_STMT_TAG_WHILE, .u = { .while_ = { .f0 = ");
                    let b10: StrBuilder = strbuf_push(b9, payload0);
                    let b11: StrBuilder = strbuf_push(b10, ", .f1 = ");
                    let b12: StrBuilder = strbuf_push(b11, payload1);
                    let b13: StrBuilder = strbuf_push(b12, ", .f2 = ");
                    let b14: StrBuilder = strbuf_push(b13, payload2);
                    let b15: StrBuilder = strbuf_push(b14, " } } })");
                    return Ok(strbuf_finish(b15));
                }

                if (sh_lexer.slice_eq(src, a1_coff, a1_cln, "Region") == 1) {
                    let vec: string = emit_parser_expr_c(mod_slug, src, nodes, a0)?;
                    let arg0_idx: i32 = expr_call_arg0_idx(nodes, a1);
                    let arg1_idx: i32 = expr_call_arg1_idx(nodes, a1);
                    let arg2_idx: i32 = expr_call_arg2_idx(nodes, a1);
                    let payload0: string = emit_parser_expr_c(mod_slug, src, nodes, arg0_idx)?;
                    let payload1: string = emit_parser_expr_c(mod_slug, src, nodes, arg1_idx)?;
                    let payload2: string = emit_parser_expr_c(mod_slug, src, nodes, arg2_idx)?;
                    let mod_up: string = sh_lexer.mangle_upper_slice(mod_slug, 0, string.len(mod_slug))?;
                    let b0: StrBuilder = strbuf_new();
                    let b1: StrBuilder = strbuf_push(b0, "fx_");
                    let b2: StrBuilder = strbuf_push(b1, mod_slug);
                    let b3: StrBuilder = strbuf_push(b2, "_vec_Stmt_push_val(core_default_allocator(), ");
                    let b4: StrBuilder = strbuf_push(b3, vec);
                    let b5: StrBuilder = strbuf_push(b4, ", (fx_");
                    let b6: StrBuilder = strbuf_push(b5, mod_slug);
                    let b7: StrBuilder = strbuf_push(b6, "_Stmt){ .tag = FX_");
                    let b8: StrBuilder = strbuf_push(b7, mod_up);
                    let b9: StrBuilder = strbuf_push(b8, "_STMT_TAG_REGION, .u = { .region = { .f0 = ");
                    let b10: StrBuilder = strbuf_push(b9, payload0);
                    let b11: StrBuilder = strbuf_push(b10, ", .f1 = ");
                    let b12: StrBuilder = strbuf_push(b11, payload1);
                    let b13: StrBuilder = strbuf_push(b12, ", .f2 = ");
                    let b14: StrBuilder = strbuf_push(b13, payload2);
                    let b15: StrBuilder = strbuf_push(b14, " } } })");
                    return Ok(strbuf_finish(b15));
                }
                if (sh_lexer.slice_eq(src, a1_coff, a1_cln, "Call") == 1) {
                    let vec: string = emit_parser_expr_c(mod_slug, src, nodes, a0)?;
                    let arg0_idx: i32 = expr_call_arg0_idx(nodes, a1);
                    let arg1_idx: i32 = expr_call_arg1_idx(nodes, a1);
                    let arg2_idx: i32 = expr_call_arg2_idx(nodes, a1);
                    let arg3_idx: i32 = expr_call_arg3_idx(nodes, a1);
                    let payload0: string = emit_parser_expr_c(mod_slug, src, nodes, arg0_idx)?;
                    let payload1: string = emit_parser_expr_c(mod_slug, src, nodes, arg1_idx)?;
                    let payload2: string = emit_parser_expr_c(mod_slug, src, nodes, arg2_idx)?;
                    let payload3: string = emit_parser_expr_c(mod_slug, src, nodes, arg3_idx)?;
                    let mod_up: string = sh_lexer.mangle_upper_slice(mod_slug, 0, string.len(mod_slug))?;
                    let b0: StrBuilder = strbuf_new();
                    let b1: StrBuilder = strbuf_push(b0, "fx_");
                    let b2: StrBuilder = strbuf_push(b1, mod_slug);
                    let b3: StrBuilder = strbuf_push(b2, "_vec_Stmt_push_val(core_default_allocator(), ");
                    let b4: StrBuilder = strbuf_push(b3, vec);
                    let b5: StrBuilder = strbuf_push(b4, ", (fx_");
                    let b6: StrBuilder = strbuf_push(b5, mod_slug);
                    let b7: StrBuilder = strbuf_push(b6, "_Stmt){ .tag = FX_");
                    let b8: StrBuilder = strbuf_push(b7, mod_up);
                    let b9: StrBuilder = strbuf_push(b8, "_STMT_TAG_CALL, .u = { .call = { .f0 = ");
                    let b10: StrBuilder = strbuf_push(b9, payload0);
                    let b11: StrBuilder = strbuf_push(b10, ", .f1 = ");
                    let b12: StrBuilder = strbuf_push(b11, payload1);
                    let b13: StrBuilder = strbuf_push(b12, ", .f2 = ");
                    let b14: StrBuilder = strbuf_push(b13, payload2);
                    let b15: StrBuilder = strbuf_push(b14, ", .f3 = ");
                    let b16: StrBuilder = strbuf_push(b15, payload3);
                    let b17: StrBuilder = strbuf_push(b16, " } } })");
                    return Ok(strbuf_finish(b17));
                }
                if (sh_lexer.slice_eq(src, a1_coff, a1_cln, "If") == 1) {
                    let vec: string = emit_parser_expr_c(mod_slug, src, nodes, a0)?;
                    let arg0_idx: i32 = expr_call_arg0_idx(nodes, a1);
                    let arg1_idx: i32 = expr_call_arg1_idx(nodes, a1);
                    let arg2_idx: i32 = expr_call_arg2_idx(nodes, a1);
                    let arg3_idx: i32 = expr_call_arg3_idx(nodes, a1);
                    let arg4_idx: i32 = expr_call_arg4_idx(nodes, a1);
                    let payload0: string = emit_parser_expr_c(mod_slug, src, nodes, arg0_idx)?;
                    let payload1: string = emit_parser_expr_c(mod_slug, src, nodes, arg1_idx)?;
                    let payload2: string = emit_parser_expr_c(mod_slug, src, nodes, arg2_idx)?;
                    let payload3: string = emit_parser_expr_c(mod_slug, src, nodes, arg3_idx)?;
                    let payload4: string = emit_parser_expr_c(mod_slug, src, nodes, arg4_idx)?;
                    let mod_up: string = sh_lexer.mangle_upper_slice(mod_slug, 0, string.len(mod_slug))?;
                    let b0: StrBuilder = strbuf_new();
                    let b1: StrBuilder = strbuf_push(b0, "fx_");
                    let b2: StrBuilder = strbuf_push(b1, mod_slug);
                    let b3: StrBuilder = strbuf_push(b2, "_vec_Stmt_push_val(core_default_allocator(), ");
                    let b4: StrBuilder = strbuf_push(b3, vec);
                    let b5: StrBuilder = strbuf_push(b4, ", (fx_");
                    let b6: StrBuilder = strbuf_push(b5, mod_slug);
                    let b7: StrBuilder = strbuf_push(b6, "_Stmt){ .tag = FX_");
                    let b8: StrBuilder = strbuf_push(b7, mod_up);
                    let b9: StrBuilder = strbuf_push(b8, "_STMT_TAG_IF, .u = { .if_ = { .f0 = ");
                    let b10: StrBuilder = strbuf_push(b9, payload0);
                    let b11: StrBuilder = strbuf_push(b10, ", .f1 = ");
                    let b12: StrBuilder = strbuf_push(b11, payload1);
                    let b13: StrBuilder = strbuf_push(b12, ", .f2 = ");
                    let b14: StrBuilder = strbuf_push(b13, payload2);
                    let b15: StrBuilder = strbuf_push(b14, ", .f3 = ");
                    let b16: StrBuilder = strbuf_push(b15, payload3);
                    let b17: StrBuilder = strbuf_push(b16, ", .f4 = ");
                    let b18: StrBuilder = strbuf_push(b17, payload4);
                    let b19: StrBuilder = strbuf_push(b18, " } } })");
                    return Ok(strbuf_finish(b19));
                }
            }
        }
    }
    let callee: string = emit_parser_callee_c(mod_slug, src, coff, cln)?;
    let a0: i32 = expr_call_arg0_idx(nodes, idx);
    let a1: i32 = expr_call_arg1_idx(nodes, idx);
    let a2: i32 = expr_call_arg2_idx(nodes, idx);
    let a3: i32 = expr_call_arg3_idx(nodes, idx);
    let a4: i32 = expr_call_arg4_idx(nodes, idx);
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, callee);
    let b2: StrBuilder = strbuf_push(b1, "(");
    if (a0 < 0) {
        let b3: StrBuilder = strbuf_push(b2, ")");
        return Ok(strbuf_finish(b3));
    }
    let span_end: i32 = a1;
    if (a2 >= 0) {
        span_end = a2;
    }
    if (a3 >= 0) {
        span_end = a3;
    }
    if (a4 >= 0) {
        span_end = a4;
    }
    let args: string = emit_call_args_span_c(mod_slug, src, nodes, a0, span_end)?;
    let b3: StrBuilder = strbuf_push(b2, args);
    let b4: StrBuilder = strbuf_push(b3, ")");
    return Ok(strbuf_finish(b4));
}

fn emit_parser_expr_c(mod_slug: string, src: string, nodes: Vec<Expr>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let tag: i32 = expr_ty_tag(nodes, idx);
    if (tag == 1) {
        let n: i32 = eval_expr(nodes, idx);
        return str_from_i32(n);
    }
    if (tag == 2) {
        let off: i32 = expr_strlit_off(nodes, idx);
        let ln: i32 = expr_strlit_ln(nodes, idx);
        let lit: string = sh_lexer.slice_str(src, off, ln)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "\"");
        let b2: StrBuilder = strbuf_push(b1, lit);
        let b3: StrBuilder = strbuf_push(b2, "\"");
        return Ok(strbuf_finish(b3));
    }
    if (tag == 3) {
        return emit_parser_ident_c(src, nodes, idx);
    }
    if (tag == 4) {
        return emit_parser_binop_expr_c(mod_slug, src, nodes, idx, " + ");
    }
    if (tag == 5) {
        return emit_parser_binop_expr_c(mod_slug, src, nodes, idx, " - ");
    }
    if (tag == 6) {
        return emit_parser_binop_expr_c(mod_slug, src, nodes, idx, " * ");
    }
    if (tag == 7) {
        return emit_parser_binop_expr_c(mod_slug, src, nodes, idx, " / ");
    }
    if (tag == 8) {
        return emit_parser_binop_expr_c(mod_slug, src, nodes, idx, " < ");
    }
    if (tag == 13) {
        return emit_parser_binop_expr_c(mod_slug, src, nodes, idx, " != ");
    }
    if (tag == 16) {
        return emit_parser_binop_expr_c(mod_slug, src, nodes, idx, " == ");
    }
    if (tag == 14) {
        return emit_parser_binop_expr_c(mod_slug, src, nodes, idx, " >= ");
    }
    if (tag == 10) {
        return emit_parser_call_expr_c(mod_slug, src, nodes, idx);
    }
    if (tag == 15) {
        let inner: i32 = expr_deref_inner_idx(nodes, idx);
        let e: string = emit_parser_expr_c(mod_slug, src, nodes, inner)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(*");
        let b2: StrBuilder = strbuf_push(b1, e);
        let b3: StrBuilder = strbuf_push(b2, ")");
        return Ok(strbuf_finish(b3));
    }
    // FX-SH-NAT-3 - Vec/array index sugar → `.data[i]` (same as vec_get).
    if (tag == 17) {
        let base_i: i32 = expr_index_base_idx(nodes, idx);
        let ix_i: i32 = expr_index_ix_idx(nodes, idx);
        let base: string = emit_parser_expr_c(mod_slug, src, nodes, base_i)?;
        let ix: string = emit_parser_expr_c(mod_slug, src, nodes, ix_i)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, base);
        let b2: StrBuilder = strbuf_push(b1, ".data[");
        let b3: StrBuilder = strbuf_push(b2, ix);
        let b4: StrBuilder = strbuf_push(b3, "]");
        return Ok(strbuf_finish(b4));
    }
    // FX-SH-NAT-4 - `a[lo..hi]` → fx_Slice_i32 view (foundry ok_subslice shape).
    if (tag == 18) {
        let base_i: i32 = expr_slice_base_idx(nodes, idx);
        let lo_i: i32 = expr_slice_lo_idx(nodes, idx);
        let hi_i: i32 = expr_slice_hi_idx(nodes, idx);
        let base: string = emit_parser_expr_c(mod_slug, src, nodes, base_i)?;
        let lo: string = emit_parser_expr_c(mod_slug, src, nodes, lo_i)?;
        let hi: string = emit_parser_expr_c(mod_slug, src, nodes, hi_i)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(fx_Slice_i32){ .data = (");
        let b2: StrBuilder = strbuf_push(b1, base);
        let b3: StrBuilder = strbuf_push(b2, ").data + (size_t)(");
        let b4: StrBuilder = strbuf_push(b3, lo);
        let b5: StrBuilder = strbuf_push(b4, "), .len = (size_t)((");
        let b6: StrBuilder = strbuf_push(b5, hi);
        let b7: StrBuilder = strbuf_push(b6, ") - (");
        let b8: StrBuilder = strbuf_push(b7, lo);
        let b9: StrBuilder = strbuf_push(b8, ")) }");
        return Ok(strbuf_finish(b9));
    }
    // FX-SH-NAT-7 - ArrayLit → compound literal `{ .data = { … } }`.
    if (tag == 19) {
        return emit_parser_array_lit_c(mod_slug, src, nodes, idx);
    }
    return Err(1);
}

fn array_lit_count(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        ArrayLit(c, _, _, _, _, _, _, _, _) => c,
        Num(_) => 0,
        StrLit(_, _) => 0,
        Ident(_, _) => 0,
        Add(_, _) => 0,
        Sub(_, _) => 0,
        Mul(_, _) => 0,
        Div(_, _) => 0,
        CmpLt(_, _) => 0,
        CmpNe(_, _) => 0,
        CmpEq(_, _) => 0,
        CmpGe(_, _) => 0,
        Deref(_) => 0,
        Match(_, _, _) => 0,
        CallExpr(_, _, _, _, _, _, _) => 0,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => 0,
        TryExpr(_) => 0,
        Index(_, _) => 0,
        SliceRange(_, _, _) => 0,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn array_lit_field_idx(nodes: Vec<Expr>, idx: i32, which: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        ArrayLit(_, f0, f1, f2, f3, f4, f5, f6, f7) => {
            if (which == 0) { return f0; }
            if (which == 1) { return f1; }
            if (which == 2) { return f2; }
            if (which == 3) { return f3; }
            if (which == 4) { return f4; }
            if (which == 5) { return f5; }
            if (which == 6) { return f6; }
            return f7;
        },
        Num(_) => -1,
        StrLit(_, _) => -1,
        Ident(_, _) => -1,
        Add(_, _) => -1,
        Sub(_, _) => -1,
        Mul(_, _) => -1,
        Div(_, _) => -1,
        CmpLt(_, _) => -1,
        CmpNe(_, _) => -1,
        CmpEq(_, _) => -1,
        CmpGe(_, _) => -1,
        Deref(_) => -1,
        Match(_, _, _) => -1,
        CallExpr(_, _, _, _, _, _, _) => -1,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => -1,
        TryExpr(_) => -1,
        Index(_, _) => -1,
        SliceRange(_, _, _) => -1,
        ArrayLit(_, _, _, _, _, _, _, _, _) => -1,
    };
}

fn emit_parser_array_lit_c(mod_slug: string, src: string, nodes: Vec<Expr>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let count: i32 = array_lit_count(nodes, idx);
    let nstr: string = str_from_i32(count)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "(fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_Array_i32_");
    let b4: StrBuilder = strbuf_push(b3, nstr);
    let cur: StrBuilder = strbuf_push(b4, "){ .data = { ");
    let i: i32 = 0;
    while (i < count) {
        if (i > 0) {
            cur = strbuf_push(cur, ", ");
        }
        let fi: i32 = array_lit_field_idx(nodes, idx, i);
        let val: string = emit_parser_expr_c(mod_slug, src, nodes, fi)?;
        cur = strbuf_push(cur, val);
        i = i + 1;
    }
    cur = strbuf_push(cur, " } }");
    return Ok(strbuf_finish(cur));
}

fn emit_parser_index_assign_line(mod_slug: string, src: string, nodes: Vec<Expr>, base_i: i32, ix_i: i32, val_i: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let base: string = emit_parser_expr_c(mod_slug, src, nodes, base_i)?;
    let ix: string = emit_parser_expr_c(mod_slug, src, nodes, ix_i)?;
    let val: string = emit_parser_expr_c(mod_slug, src, nodes, val_i)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, base);
    let b3: StrBuilder = strbuf_push(b2, ".data[");
    let b4: StrBuilder = strbuf_push(b3, ix);
    let b5: StrBuilder = strbuf_push(b4, "] = ");
    let b6: StrBuilder = strbuf_push(b5, val);
    let b7: StrBuilder = strbuf_push(b6, ";\n");
    return Ok(strbuf_finish(b7));
}

fn emit_parser_cond_c(mod_slug: string, src: string, nodes: Vec<Expr>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    return emit_parser_expr_c(mod_slug, src, nodes, idx);
}

fn emit_parser_let_typed_line(mod_slug: string, src: string, fn_out: FnOut, var_off: i32, var_ln: i32, ty_off: i32, ty_ln: i32, nodes: Vec<Expr>, expr_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let vname: string = sh_lexer.slice_str(src, var_off, var_ln)?;
    let ty_c: string = emit_let_bind_type_c_name(mod_slug, src, fn_out, ty_off, ty_ln)?;
    let expr: string = emit_parser_expr_c(mod_slug, src, nodes, expr_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, ty_c);
    let b3: StrBuilder = strbuf_push(b2, " ");
    let b4: StrBuilder = strbuf_push(b3, vname);
    let b5: StrBuilder = strbuf_push(b4, " = ");
    let b6: StrBuilder = strbuf_push(b5, expr);
    let b7: StrBuilder = strbuf_push(b6, ";\n");
    let f: string = strbuf_finish(b7);
    if (var_ln >= 1) {
        if (string.byte_at(src, var_off) == 95) {
            let v0: StrBuilder = strbuf_new();
            let v1: StrBuilder = strbuf_push(v0, "    (void)");
            let v2: StrBuilder = strbuf_push(v1, vname);
            let v3: StrBuilder = strbuf_push(v2, ";\n");
            let void_line: string = strbuf_finish(v3);
            let o0: StrBuilder = strbuf_new();
            let o1: StrBuilder = strbuf_push(o0, f);
            let o2: StrBuilder = strbuf_push(o1, void_line);
            return Ok(strbuf_finish(o2));
        }
    }
    return Ok(f);
}

fn emit_parser_let_i32_line(mod_slug: string, src: string, var_off: i32, var_ln: i32, nodes: Vec<Expr>, expr_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let vname: string = sh_lexer.slice_str(src, var_off, var_ln)?;
    let expr: string = emit_parser_expr_c(mod_slug, src, nodes, expr_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    int32_t ");
    let b2: StrBuilder = strbuf_push(b1, vname);
    let b3: StrBuilder = strbuf_push(b2, " = ");
    let b4: StrBuilder = strbuf_push(b3, expr);
    let b5: StrBuilder = strbuf_push(b4, ";\n");
    let d: string = strbuf_finish(b5);
    if (var_ln >= 1) {
        if (string.byte_at(src, var_off) == 95) {
            let v0: StrBuilder = strbuf_new();
            let v1: StrBuilder = strbuf_push(v0, "    (void)");
            let v2: StrBuilder = strbuf_push(v1, vname);
            let v3: StrBuilder = strbuf_push(v2, ";\n");
            let void_line: string = strbuf_finish(v3);
            let o0: StrBuilder = strbuf_new();
            let o1: StrBuilder = strbuf_push(o0, d);
            let o2: StrBuilder = strbuf_push(o1, void_line);
            return Ok(strbuf_finish(o2));
        }
    }
    return Ok(d);
}

fn emit_parser_assign_ptr_line(mod_slug: string, src: string, name_off: i32, name_ln: i32, nodes: Vec<Expr>, expr_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let pname: string = sh_lexer.slice_str(src, name_off, name_ln)?;
    let expr: string = emit_parser_expr_c(mod_slug, src, nodes, expr_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    (*");
    let b2: StrBuilder = strbuf_push(b1, pname);
    let b3: StrBuilder = strbuf_push(b2, ") = ");
    let b4: StrBuilder = strbuf_push(b3, expr);
    let b5: StrBuilder = strbuf_push(b4, ";\n");
    return Ok(strbuf_finish(b5));
}

fn emit_parser_assign_line(mod_slug: string, src: string, name_off: i32, name_ln: i32, nodes: Vec<Expr>, expr_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let vname: string = sh_lexer.slice_str(src, name_off, name_ln)?;
    let expr: string = emit_parser_expr_c(mod_slug, src, nodes, expr_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, vname);
    let b3: StrBuilder = strbuf_push(b2, " = ");
    let b4: StrBuilder = strbuf_push(b3, expr);
    let b5: StrBuilder = strbuf_push(b4, ";\n");
    return Ok(strbuf_finish(b5));
}

fn emit_parser_assign_try_bind_line(src: string, name_off: i32, name_ln: i32, try_n: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let vname: string = sh_lexer.slice_str(src, name_off, name_ln)?;
    let n: string = str_from_i32(try_n)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, vname);
    let b3: StrBuilder = strbuf_push(b2, " = __try_");
    let b4: StrBuilder = strbuf_push(b3, n);
    let b5: StrBuilder = strbuf_push(b4, ".ok_val;\n");
    return Ok(strbuf_finish(b5));
}

fn emit_parser_assign_try_line(mod_slug: string, src: string, fn_out: FnOut, name_off: i32, name_ln: i32, nodes: Vec<Expr>, expr_idx: i32, try_n: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let try_line: string = emit_parser_try_call_line(mod_slug, src, fn_out, nodes, expr_idx, try_n, 0, 0)?;
    let prop_line: string = emit_try_propagate_line(try_n)?;
    let bind_line: string = emit_parser_assign_try_bind_line(src, name_off, name_ln, try_n)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, try_line);
    let b2: StrBuilder = strbuf_push(b1, prop_line);
    let b3: StrBuilder = strbuf_push(b2, bind_line);
    return Ok(strbuf_finish(b3));
}

fn emit_parser_break_line() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    break;\n");
}

fn emit_parser_continue_line() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    continue;\n");
}

fn emit_result_err_ok_dummy(mod_slug: string, src: string, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "string") == 1) {
        return Ok("NULL");
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "i32") == 1) {
        return Ok("0");
    }
    let ok_name: string = sh_lexer.slice_str(src, fn_out.ret_ok_off, fn_out.ret_ok_len)?;
    let p0: StrBuilder = strbuf_new();
    let p1: StrBuilder = strbuf_push(p0, "fx_");
    let p2: StrBuilder = strbuf_push(p1, mod_slug);
    let p3: StrBuilder = strbuf_push(p2, "_");
    let st_ty: string = strbuf_finish(strbuf_push(p3, ok_name));
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "ImpOut") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(");
        let b2: StrBuilder = strbuf_push(b1, st_ty);
        let b3: StrBuilder = strbuf_push(b2, "){ .path_off = 0, .path_len = 0 }");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "ModOut") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(");
        let b2: StrBuilder = strbuf_push(b1, st_ty);
        let b3: StrBuilder = strbuf_push(b2, "){ .name_off = 0, .name_len = 0 }");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "RetTypeOut") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(");
        let b2: StrBuilder = strbuf_push(b1, st_ty);
        let b3: StrBuilder = strbuf_push(b2, "){ .ret_off = 0, .ret_len = 0, .ret_is_result = 0, .ret_ok_off = 0, .ret_ok_len = 0, .ret_err_off = 0, .ret_err_len = 0 }");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "EnumOut") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(");
        let b2: StrBuilder = strbuf_push(b1, st_ty);
        let b3: StrBuilder = strbuf_push(b2, "){ .name_off = 0, .name_len = 0, .variant_count = 0, .variants_env = 0, .payloads_env = 0 }");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "StructOut") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(");
        let b2: StrBuilder = strbuf_push(b1, st_ty);
        let b3: StrBuilder = strbuf_push(b2, "){ .name_off = 0, .name_len = 0, .field_count = 0, .fields_env = 0 }");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "FnSigOut") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(");
        let b2: StrBuilder = strbuf_push(b1, st_ty);
        let b3: StrBuilder = strbuf_push(b2, "){ .name_off = 0, .name_len = 0, .ret_is_result = 0, .ret_ok_off = 0, .ret_ok_len = 0, .effect_count = 0, .param_tok_pos = 0, .body_start = 0, .body_len = 0 }");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "FnOut") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(");
        let b2: StrBuilder = strbuf_push(b1, st_ty);
        let b3: StrBuilder = strbuf_push(b2, "){ .name_off = 0, .name_len = 0, .ret_off = 0, .ret_len = 0, .ret_is_result = 0, .ret_ok_off = 0, .ret_ok_len = 0, .ret_err_off = 0, .ret_err_len = 0, .effect_count = 0, .param_sig = 0, .param_env = 0, .param_tok_pos = 0, .body_start = 0, .body_len = 0, .nodes = (fx_Vec_Expr){0}, .stmts = (fx_Vec_Stmt){0} }");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "ParamParseOut") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(");
        let b2: StrBuilder = strbuf_push(b1, st_ty);
        let b3: StrBuilder = strbuf_push(b2, "){ .sig = 0, .env = 0 }");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "ParseOut") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(");
        let b2: StrBuilder = strbuf_push(b1, st_ty);
        let b3: StrBuilder = strbuf_push(b2, "){ .idx = 0, .nodes = (fx_Vec_Expr){0} }");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "StmtStep") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(");
        let b2: StrBuilder = strbuf_push(b1, st_ty);
        let b3: StrBuilder = strbuf_push(b2, "){ .nodes = (fx_Vec_Expr){0}, .stmts = (fx_Vec_Stmt){0} }");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "BlockParseOut") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(");
        let b2: StrBuilder = strbuf_push(b1, st_ty);
        let b3: StrBuilder = strbuf_push(b2, "){ .count = 0, .nodes = (fx_Vec_Expr){0}, .stmts = (fx_Vec_Stmt){0} }");
        return Ok(strbuf_finish(b3));
    }
    if (sh_lexer.slice_eq(src, fn_out.ret_ok_off, fn_out.ret_ok_len, "LetOut") == 1) {
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "(");
        let b2: StrBuilder = strbuf_push(b1, st_ty);
        let b3: StrBuilder = strbuf_push(b2, "){ .name_off = 0, .name_len = 0, .root = 0, .nodes = (fx_Vec_Expr){0} }");
        return Ok(strbuf_finish(b3));
    }
    return Err(1);
}

fn emit_return_err_num_line(mod_slug: string, src: string, fn_out: FnOut, ret_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let ret_ty: string = emit_result_type_c_name(mod_slug, src, fn_out.ret_ok_off, fn_out.ret_ok_len)?;
    let arg_idx: i32 = expr_call_arg0_idx(fn_out.nodes, ret_idx);
    let n: i32 = eval_expr(fn_out.nodes, arg_idx);
    let s: string = str_from_i32(n)?;
    let dummy: string = emit_result_err_ok_dummy(mod_slug, src, fn_out)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return (");
    let b2: StrBuilder = strbuf_push(b1, ret_ty);
    let b3: StrBuilder = strbuf_push(b2, "){ .tag = FX_RESULT_TAG_ERR, .ok_val = ");
    let b4: StrBuilder = strbuf_push(b3, dummy);
    let b5: StrBuilder = strbuf_push(b4, ", .err_val = (core_Err)");
    let b6: StrBuilder = strbuf_push(b5, s);
    let b7: StrBuilder = strbuf_push(b6, " };\n");
    return Ok(strbuf_finish(b7));
}

fn emit_return_ok_struct_lit_exprs_line(prof: FixtureProfile, mod_slug: string, src: string, fn_out: FnOut, st_out: StructOut, nodes: Vec<Expr>, ret_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let ret_ty: string = emit_result_type_c_name(mod_slug, src, fn_out.ret_ok_off, fn_out.ret_ok_len)?;
    let lit_idx: i32 = expr_call_arg0_idx(nodes, ret_idx);
    let count: i32 = struct_lit_count(nodes, lit_idx);
    let ty_name: string = emit_struct_type_c_name(prof, src, st_out.name_off, st_out.name_len)?;
    let fields: string = emit_struct_lit_fields_assign_exprs(st_out, mod_slug, src, nodes, lit_idx, 0, count)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return (");
    let b2: StrBuilder = strbuf_push(b1, ret_ty);
    let b3: StrBuilder = strbuf_push(b2, "){ .tag = FX_RESULT_TAG_OK, .ok_val = (");
    let b4: StrBuilder = strbuf_push(b3, ty_name);
    let b5: StrBuilder = strbuf_push(b4, ")");
    let b6: StrBuilder = strbuf_push(b5, fields);
    let b7: StrBuilder = strbuf_push(b6, " }, .err_val = CORE_OK };\n");
    return Ok(strbuf_finish(b7));
}

fn stmt_idx_is_nested(stmts: Vec<Stmt>, block_start: i32, block_end: i32, idx: i32) -> i32 {
    let i: i32 = block_start;
    while (i < block_end) {
        if (i != idx) {
            let tag: i32 = stmt_ty_tag(stmts, i);
            if (tag == 4) {
                let ts: i32 = stmt_if_then_start(stmts, i);
                let tl: i32 = stmt_if_then_len(stmts, i);
                if (idx >= ts && idx < ts + tl) {
                    return 1;
                }
                let el: i32 = stmt_if_else_len(stmts, i);
                if (el > 0) {
                    let es: i32 = stmt_if_else_start(stmts, i);
                    if (idx >= es && idx < es + el) {
                        return 1;
                    }
                }
            }
            if (tag == 5) {
                let bs: i32 = stmt_while_body_start(stmts, i);
                let bl: i32 = stmt_while_body_len(stmts, i);
                if (idx >= bs && idx < bs + bl) {
                    return 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn emit_parser_body_stmts_range(mod_slug: string, src: string, prof: FixtureProfile, st_out: StructOut, fn_out: FnOut, start: i32, count: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (count <= 0) {
        return Ok("");
    }
    let block_end: i32 = start + count;
    if (stmt_idx_is_nested(fn_out.stmts, start, block_end, start) == 1) {
        return emit_parser_body_stmts_range(mod_slug, src, prof, st_out, fn_out, start + 1, count - 1);
    }
    let line: string = emit_parser_body_stmt_line(mod_slug, src, prof, st_out, fn_out, start)?;
    let rest: string = emit_parser_body_stmts_range(mod_slug, src, prof, st_out, fn_out, start + 1, count - 1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, line);
    let b2: StrBuilder = strbuf_push(b1, rest);
    return Ok(strbuf_finish(b2));
}

fn emit_parser_if_stmt_line(mod_slug: string, src: string, prof: FixtureProfile, st_out: StructOut, fn_out: FnOut, cond_idx: i32, then_start: i32, then_len: i32, else_start: i32, else_len: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let cond: string = emit_parser_cond_c(mod_slug, src, fn_out.nodes, cond_idx)?;
    let then_body: string = emit_parser_body_stmts_range(mod_slug, src, prof, st_out, fn_out, then_start, then_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    if (");
    let b2: StrBuilder = strbuf_push(b1, cond);
    let b3: StrBuilder = strbuf_push(b2, ") {\n");
    let b4: StrBuilder = strbuf_push(b3, then_body);
    if (else_len > 0) {
        let else_body: string = emit_parser_body_stmts_range(mod_slug, src, prof, st_out, fn_out, else_start, else_len)?;
        let b5: StrBuilder = strbuf_push(b4, "    } else {\n");
        let b6: StrBuilder = strbuf_push(b5, else_body);
        let b7: StrBuilder = strbuf_push(b6, "    }\n");
        return Ok(strbuf_finish(b7));
    }
    let b5: StrBuilder = strbuf_push(b4, "    }\n");
    return Ok(strbuf_finish(b5));
}

fn emit_parser_while_stmt_line(mod_slug: string, src: string, prof: FixtureProfile, st_out: StructOut, fn_out: FnOut, cond_idx: i32, body_start: i32, body_len: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let cond: string = emit_parser_cond_c(mod_slug, src, fn_out.nodes, cond_idx)?;
    let body: string = emit_parser_body_stmts_range(mod_slug, src, prof, st_out, fn_out, body_start, body_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    while (");
    let b2: StrBuilder = strbuf_push(b1, cond);
    let b3: StrBuilder = strbuf_push(b2, ") {\n");
    let b4: StrBuilder = strbuf_push(b3, body);
    let b5: StrBuilder = strbuf_push(b4, "    }\n");
    return Ok(strbuf_finish(b5));
}

fn emit_parser_body_stmt_line(mod_slug: string, src: string, prof: FixtureProfile, st_out: StructOut, fn_out: FnOut, stmt_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let tag: i32 = stmt_ty_tag(fn_out.stmts, stmt_idx);
    if (tag == 1) {
        let off: i32 = stmt_let_var_off(fn_out.stmts, stmt_idx);
        let ln: i32 = stmt_let_var_ln(fn_out.stmts, stmt_idx);
        let e: i32 = stmt_let_expr_idx(fn_out.stmts, stmt_idx);
        if (expr_ty_tag(fn_out.nodes, e) == 12) {
            let try_n: i32 = emit_parser_try_n_before(fn_out, stmt_idx);
            let ty_off: i32 = stmt_let_ty_off(fn_out.stmts, stmt_idx);
            let ty_ln: i32 = stmt_let_ty_ln(fn_out.stmts, stmt_idx);
            return emit_parser_let_try_line(mod_slug, src, fn_out, off, ln, fn_out.nodes, e, try_n, ty_off, ty_ln);
        }
        if (stmt_let_ty_ln(fn_out.stmts, stmt_idx) > 0) {
            let ty_off: i32 = stmt_let_ty_off(fn_out.stmts, stmt_idx);
            let ty_ln: i32 = stmt_let_ty_ln(fn_out.stmts, stmt_idx);
            return emit_parser_let_typed_line(mod_slug, src, fn_out, off, ln, ty_off, ty_ln, fn_out.nodes, e);
        }
        return emit_parser_let_i32_line(mod_slug, src, off, ln, fn_out.nodes, e);
    }
    if (tag == 2) {
        let e: i32 = stmt_return_expr_idx(fn_out.stmts, stmt_idx);
        if (expr_call_callee_is(fn_out.nodes, e, src, "Err") == 1) {
            return emit_return_err_num_line(mod_slug, src, fn_out, e);
        }
        if (expr_call_callee_is(fn_out.nodes, e, src, "Ok") == 1) {
            let arg_idx: i32 = expr_call_arg0_idx(fn_out.nodes, e);
            if (expr_ty_tag(fn_out.nodes, arg_idx) == 3) {
                let ident: string = expr_ok_return_ident_name(fn_out.nodes, e, src)?;
                return emit_return_ok_ident_line(mod_slug, src, fn_out, ident);
            }
            if (expr_ty_tag(fn_out.nodes, arg_idx) == 1) {
                return emit_return_ok_num_line(mod_slug, src, fn_out, fn_out.nodes, e);
            }
            if (expr_ty_tag(fn_out.nodes, arg_idx) == 2) {
                let lit_off: i32 = expr_strlit_off(fn_out.nodes, arg_idx);
                let lit_ln: i32 = expr_strlit_ln(fn_out.nodes, arg_idx);
                let lit: string = sh_lexer.slice_str(src, lit_off, lit_ln)?;
                return emit_return_ok_strlit_line(mod_slug, src, fn_out, lit);
            }
            if (expr_ty_tag(fn_out.nodes, arg_idx) == 10) {
                return emit_return_ok_call_expr_line(mod_slug, src, fn_out, fn_out.nodes, e);
            }
            // CONV-3-r.26 - Result Ok payload may be an arithmetic expression.
            if (expr_ty_tag(fn_out.nodes, arg_idx) == 4) {
                return emit_return_ok_call_expr_line(mod_slug, src, fn_out, fn_out.nodes, e);
            }
            return emit_return_ok_struct_lit_exprs_line(prof, mod_slug, src, fn_out, st_out, fn_out.nodes, e);
        }
        if (expr_ty_tag(fn_out.nodes, e) == 10) {
            return emit_parser_return_mangled_call_line(mod_slug, src, fn_out.nodes, e);
        }
        if (expr_ty_tag(fn_out.nodes, e) == 1) {
            let n: i32 = eval_expr(fn_out.nodes, e);
            return emit_return_num_line(n);
        }
        // SH-C-71 - bare `return "<strlit>";` for `-> string` (const char*).
        if (expr_ty_tag(fn_out.nodes, e) == 2) {
            let lit_off: i32 = expr_strlit_off(fn_out.nodes, e);
            let lit_ln: i32 = expr_strlit_ln(fn_out.nodes, e);
            let lit: string = sh_lexer.slice_str(src, lit_off, lit_ln)?;
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, "    return \"");
            let b2: StrBuilder = strbuf_push(b1, lit);
            let b3: StrBuilder = strbuf_push(b2, "\";\n");
            return Ok(strbuf_finish(b3));
        }
        if (expr_ty_tag(fn_out.nodes, e) == 3) {
            return emit_return_ident_line(src, fn_out.nodes, e);
        }
        // CONV-3-r.23 - return add/binop chains (ok_char_lit).
        // SH-C-45 - also Sub (return 0 - 1) and other binops emit_parser_expr_c already maps.
        if (expr_ty_tag(fn_out.nodes, e) == 4) {
            let expr: string = emit_parser_expr_c(mod_slug, src, fn_out.nodes, e)?;
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, "    return ");
            let b2: StrBuilder = strbuf_push(b1, expr);
            let b3: StrBuilder = strbuf_push(b2, ";\n");
            return Ok(strbuf_finish(b3));
        }
        if (expr_ty_tag(fn_out.nodes, e) == 5) {
            let expr: string = emit_parser_expr_c(mod_slug, src, fn_out.nodes, e)?;
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, "    return ");
            let b2: StrBuilder = strbuf_push(b1, expr);
            let b3: StrBuilder = strbuf_push(b2, ";\n");
            return Ok(strbuf_finish(b3));
        }
        if (expr_ty_tag(fn_out.nodes, e) == 6) {
            let expr: string = emit_parser_expr_c(mod_slug, src, fn_out.nodes, e)?;
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, "    return ");
            let b2: StrBuilder = strbuf_push(b1, expr);
            let b3: StrBuilder = strbuf_push(b2, ";\n");
            return Ok(strbuf_finish(b3));
        }
        if (expr_ty_tag(fn_out.nodes, e) == 7) {
            let expr: string = emit_parser_expr_c(mod_slug, src, fn_out.nodes, e)?;
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, "    return ");
            let b2: StrBuilder = strbuf_push(b1, expr);
            let b3: StrBuilder = strbuf_push(b2, ";\n");
            return Ok(strbuf_finish(b3));
        }
        // SH-C-53 - direct struct-literal return (e.g. struct_lit_acc_init_first).
        if (expr_ty_tag(fn_out.nodes, e) == 11) {
            return emit_return_struct_lit_exprs_line(prof, src, st_out, fn_out.nodes, e);
        }
        return Err(1);
    }
    if (tag == 3) {
        let off: i32 = stmt_assign_var_off(fn_out.stmts, stmt_idx);
        let ln: i32 = stmt_assign_var_ln(fn_out.stmts, stmt_idx);
        let e: i32 = stmt_assign_expr_idx(fn_out.stmts, stmt_idx);
        if (expr_ty_tag(fn_out.nodes, e) == 12) {
            let try_n: i32 = emit_parser_try_n_before(fn_out, stmt_idx);
            return emit_parser_assign_try_line(mod_slug, src, fn_out, off, ln, fn_out.nodes, e, try_n);
        }
        return emit_parser_assign_line(mod_slug, src, off, ln, fn_out.nodes, e);
    }
    if (tag == 8) {
        let off: i32 = stmt_assign_var_off(fn_out.stmts, stmt_idx);
        let ln: i32 = stmt_assign_var_ln(fn_out.stmts, stmt_idx);
        let e: i32 = stmt_assign_expr_idx(fn_out.stmts, stmt_idx);
        return emit_parser_assign_ptr_line(mod_slug, src, off, ln, fn_out.nodes, e);
    }
    if (tag == 4) {
        let c: i32 = stmt_if_cond(fn_out.stmts, stmt_idx);
        let ts: i32 = stmt_if_then_start(fn_out.stmts, stmt_idx);
        let tl: i32 = stmt_if_then_len(fn_out.stmts, stmt_idx);
        let es: i32 = stmt_if_else_start(fn_out.stmts, stmt_idx);
        let el: i32 = stmt_if_else_len(fn_out.stmts, stmt_idx);
        return emit_parser_if_stmt_line(mod_slug, src, prof, st_out, fn_out, c, ts, tl, es, el);
    }
    if (tag == 5) {
        let c: i32 = stmt_while_cond(fn_out.stmts, stmt_idx);
        let bs: i32 = stmt_while_body_start(fn_out.stmts, stmt_idx);
        let bl: i32 = stmt_while_body_len(fn_out.stmts, stmt_idx);
        return emit_parser_while_stmt_line(mod_slug, src, prof, st_out, fn_out, c, bs, bl);
    }
    if (tag == 7) {
        return emit_parser_break_line();
    }
    if (tag == 10) {
        return emit_parser_continue_line();
    }
    // FX-SH-NAT-7 - IndexAssign → `.data[i] = val`.
    if (tag == 11) {
        let base_i: i32 = stmt_index_assign_base_idx(fn_out.stmts, stmt_idx);
        let ix_i: i32 = stmt_index_assign_ix_idx(fn_out.stmts, stmt_idx);
        let val_i: i32 = stmt_index_assign_val_idx(fn_out.stmts, stmt_idx);
        return emit_parser_index_assign_line(mod_slug, src, fn_out.nodes, base_i, ix_i, val_i);
    }
    return Err(1);
}

fn emit_parser_fn_body_block(mod_slug: string, src: string, prof: FixtureProfile, st_out: StructOut, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    return emit_parser_body_stmts_range(mod_slug, src, prof, st_out, fn_out, fn_out.body_start, fn_out.body_len);
}

fn emit_parser_param_void_casts() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    (void)kinds;\n    (void)vals;\n    (void)lens;\n");
}

fn emit_parser_param_pos_void_cast() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    (void)pos;\n");
}

fn param_sig_has_pos(sig: string) -> i32 {
    let needle: string = "int32_t* pos";
    let nlen: i32 = string.len(needle);
    let slen: i32 = string.len(sig);
    if (slen < nlen) {
        return 0;
    }
    let i: i32 = 0;
    while (i + nlen <= slen) {
        if (sh_lexer.slice_eq(sig, i, nlen, needle) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn emit_parser_param_src_void_cast() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    (void)src;\n");
}

fn emit_fn_parser_helper_block(prof: FixtureProfile, mod_slug: string, src: string, st_out: StructOut, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let sig_line: string = emit_fn_sig_open_line(mod_slug, src, fn_out)?;
    let vc_b0: StrBuilder = strbuf_new();
    if (param_sig_has_kinds(fn_out.param_sig) == 1) {
        let void_casts: string = emit_parser_param_void_casts()?;
        vc_b0 = strbuf_push(vc_b0, void_casts);
        if (param_sig_has_pos(fn_out.param_sig) == 1) {
            let pos_cast: string = emit_parser_param_pos_void_cast()?;
            vc_b0 = strbuf_push(vc_b0, pos_cast);
        }
    }
    if (param_sig_is_parser_toks_src(fn_out.param_sig) == 1) {
        let src_cast: string = emit_parser_param_src_void_cast()?;
        vc_b0 = strbuf_push(vc_b0, src_cast);
    } else {
        if (param_sig_has_src(fn_out.param_sig) == 1) {
            let src_cast: string = emit_parser_param_src_void_cast()?;
            vc_b0 = strbuf_push(vc_b0, src_cast);
        }
    }
    if (param_sig_has_parser_nodes_stmts(fn_out.param_sig) == 1) {
        let ns_cast: string = emit_parser_param_nodes_stmts_void_casts()?;
        vc_b0 = strbuf_push(vc_b0, ns_cast);
    }
    let void_casts: string = strbuf_finish(vc_b0);
    let body: string = emit_parser_fn_body_block(mod_slug, src, prof, st_out, fn_out)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, sig_line);
    let b2: StrBuilder = strbuf_push(b1, void_casts);
    let b3: StrBuilder = strbuf_push(b2, body);
    let b4: StrBuilder = strbuf_push(b3, "}\n\n");
    return Ok(strbuf_finish(b4));
}

fn emit_fn_return_ok_struct_lit_block(prof: FixtureProfile, mod_slug: string, src: string, st_out: StructOut, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let sig_line: string = emit_fn_sig_open_line(mod_slug, src, fn_out)?;
    let void_casts: string = "";
    if (param_sig_is_parser_toks(fn_out.param_sig) == 1) {
        let vc0: StrBuilder = strbuf_new();
        let vc1: StrBuilder = strbuf_push(vc0, emit_parser_param_void_casts()?);
        let vc2: StrBuilder = strbuf_push(vc1, emit_parser_param_pos_void_cast()?);
        void_casts = strbuf_finish(vc2);
    }
    let ret_line: string = emit_return_ok_struct_lit_line(prof, mod_slug, src, st_out, fn_out)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, sig_line);
    let b2: StrBuilder = strbuf_push(b1, void_casts);
    let b3: StrBuilder = strbuf_push(b2, ret_line);
    let b4: StrBuilder = strbuf_push(b3, "}\n\n");
    return Ok(strbuf_finish(b4));
}

fn emit_fn_ret_type_c(mod_slug: string, src: string, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    if (fn_out.ret_is_result == 1) {
        return emit_result_type_c_name(mod_slug, src, fn_out.ret_ok_off, fn_out.ret_ok_len);
    }
    return map_type_span_to_c_mod(mod_slug, src, fn_out.ret_off, fn_out.ret_len);
}

fn emit_return_ok_strlit_line(mod_slug: string, src: string, fn_out: FnOut, lit: string) -> Result<string, core_Err> effects { alloc, mut } {
    let ret_ty: string = emit_result_type_c_name(mod_slug, src, fn_out.ret_ok_off, fn_out.ret_ok_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return (");
    let b2: StrBuilder = strbuf_push(b1, ret_ty);
    let b3: StrBuilder = strbuf_push(b2, "){ .tag = FX_RESULT_TAG_OK, .ok_val = \"");
    let b4: StrBuilder = strbuf_push(b3, lit);
    let b5: StrBuilder = strbuf_push(b4, "\", .err_val = CORE_OK };\n");
    return Ok(strbuf_finish(b5));
}

fn emit_fn_return_ok_strlit_block(mod_slug: string, src: string, fn_out: FnOut, lit: string) -> Result<string, core_Err> effects { alloc, mut } {
    let sig_line: string = emit_fn_sig_open_line(mod_slug, src, fn_out)?;
    let ret_line: string = emit_return_ok_strlit_line(mod_slug, src, fn_out, lit)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, sig_line);
    let b2: StrBuilder = strbuf_push(b1, ret_line);
    let b3: StrBuilder = strbuf_push(b2, "}\n\n");
    return Ok(strbuf_finish(b3));
}

fn emit_try_call0_callee_line(mod_slug: string, src: string, nodes: Vec<Expr>, expr_idx: i32, try_n: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let inner: i32 = expr_try_inner_idx(nodes, expr_idx);
    let p0: StrBuilder = strbuf_new();
    let p1: StrBuilder = strbuf_push(p0, "fx_");
    let p2: StrBuilder = strbuf_push(p1, mod_slug);
    let pfx2: string = strbuf_finish(strbuf_push(p2, "_"));
    let callee: string = emit_mangled_callee(pfx2, src, nodes, inner)?;
    let r0: StrBuilder = strbuf_new();
    let r1: StrBuilder = strbuf_push(r0, "fx_");
    let r2: StrBuilder = strbuf_push(r1, mod_slug);
    let ret_ty2: string = strbuf_finish(strbuf_push(r2, "_Result_string"));
    let n: string = str_from_i32(try_n)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, ret_ty2);
    let b3: StrBuilder = strbuf_push(b2, " __try_");
    let b4: StrBuilder = strbuf_push(b3, n);
    let b5: StrBuilder = strbuf_push(b4, " = ");
    let b6: StrBuilder = strbuf_push(b5, callee);
    let b7: StrBuilder = strbuf_push(b6, "();\n");
    return Ok(strbuf_finish(b7));
}

fn expr_try_inner_idx(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        Num(_) => idx,
        StrLit(_, _) => idx,
        Ident(_, _) => idx,
        Add(_, _) => idx,
        Sub(_, _) => idx,
        Mul(_, _) => idx,
        Div(_, _) => idx,
        CmpLt(_, _) => idx,
        CmpNe(_, _) => idx,
        CmpEq(_, _) => idx,
        CmpGe(_, _) => idx,
        Deref(_) => idx,
        Match(_, _, _) => idx,
        CallExpr(_, _, _, _, _, _, _) => idx,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => idx,
        ArrayLit(_, _, _, _, _, _, _, _, _) => idx,
    };
}

fn expr_deref_inner_idx(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Deref(inner) => inner,
        Num(_) => idx,
        StrLit(_, _) => idx,
        Ident(_, _) => idx,
        Add(_, _) => idx,
        Sub(_, _) => idx,
        Mul(_, _) => idx,
        Div(_, _) => idx,
        CmpLt(_, _) => idx,
        CmpNe(_, _) => idx,
        CmpEq(_, _) => idx,
        CmpGe(_, _) => idx,
        Match(_, _, _) => idx,
        CallExpr(_, _, _, _, _, _, _) => idx,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => idx,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

fn emit_try_propagate_line(try_n: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let n: string = str_from_i32(try_n)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    if (__try_");
    let b2: StrBuilder = strbuf_push(b1, n);
    let b3: StrBuilder = strbuf_push(b2, ".tag != FX_RESULT_TAG_OK) {\n");
    let b4: StrBuilder = strbuf_push(b3, "        return __try_");
    let b5: StrBuilder = strbuf_push(b4, n);
    let b6: StrBuilder = strbuf_push(b5, ";\n    }\n");
    return Ok(strbuf_finish(b6));
}

fn emit_parser_try_propagate_line(mod_slug: string, src: string, fn_out: FnOut, try_n: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let ret_ty: string = emit_result_type_c_name(mod_slug, src, fn_out.ret_ok_off, fn_out.ret_ok_len)?;
    let dummy: string = emit_result_err_ok_dummy(mod_slug, src, fn_out)?;
    let n: string = str_from_i32(try_n)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    if (__try_");
    let b2: StrBuilder = strbuf_push(b1, n);
    let b3: StrBuilder = strbuf_push(b2, ".tag != FX_RESULT_TAG_OK) {\n        return (");
    let b4: StrBuilder = strbuf_push(b3, ret_ty);
    let b5: StrBuilder = strbuf_push(b4, "){ .tag = FX_RESULT_TAG_ERR, .ok_val = ");
    let b6: StrBuilder = strbuf_push(b5, dummy);
    let b7: StrBuilder = strbuf_push(b6, ", .err_val = __try_");
    let b8: StrBuilder = strbuf_push(b7, n);
    let b9: StrBuilder = strbuf_push(b8, ".err_val };\n    }\n");
    return Ok(strbuf_finish(b9));
}

fn emit_let_try_call0_bind_line(src: string, var_off: i32, var_len: i32, try_n: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let vname: string = sh_lexer.slice_str(src, var_off, var_len)?;
    let n: string = str_from_i32(try_n)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    const char* ");
    let b2: StrBuilder = strbuf_push(b1, vname);
    let b3: StrBuilder = strbuf_push(b2, " = __try_");
    let b4: StrBuilder = strbuf_push(b3, n);
    let b5: StrBuilder = strbuf_push(b4, ".ok_val;\n");
    return Ok(strbuf_finish(b5));
}

fn emit_return_ok_num_line(mod_slug: string, src: string, fn_out: FnOut, nodes: Vec<Expr>, ret_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let arg_idx: i32 = expr_call_arg0_idx(nodes, ret_idx);
    let n: i32 = eval_expr(nodes, arg_idx);
    let s: string = str_from_i32(n)?;
    let ret_ty: string = emit_result_type_c_name(mod_slug, src, fn_out.ret_ok_off, fn_out.ret_ok_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return (");
    let b2: StrBuilder = strbuf_push(b1, ret_ty);
    let b3: StrBuilder = strbuf_push(b2, "){ .tag = FX_RESULT_TAG_OK, .ok_val = ");
    let b4: StrBuilder = strbuf_push(b3, s);
    let b5: StrBuilder = strbuf_push(b4, ", .err_val = CORE_OK };\n");
    return Ok(strbuf_finish(b5));
}

fn emit_return_ok_ident_line(mod_slug: string, src: string, fn_out: FnOut, ident: string) -> Result<string, core_Err> effects { alloc, mut } {
    let ret_ty: string = emit_result_type_c_name(mod_slug, src, fn_out.ret_ok_off, fn_out.ret_ok_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return (");
    let b2: StrBuilder = strbuf_push(b1, ret_ty);
    let b3: StrBuilder = strbuf_push(b2, "){ .tag = FX_RESULT_TAG_OK, .ok_val = ");
    let b4: StrBuilder = strbuf_push(b3, ident);
    let b5: StrBuilder = strbuf_push(b4, ", .err_val = CORE_OK };\n");
    return Ok(strbuf_finish(b5));
}

fn emit_return_ok_call_expr_line(mod_slug: string, src: string, fn_out: FnOut, nodes: Vec<Expr>, ret_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let arg_idx: i32 = expr_call_arg0_idx(nodes, ret_idx);
    let expr: string = emit_parser_expr_c(mod_slug, src, nodes, arg_idx)?;
    let ret_ty: string = emit_result_type_c_name(mod_slug, src, fn_out.ret_ok_off, fn_out.ret_ok_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return (");
    let b2: StrBuilder = strbuf_push(b1, ret_ty);
    let b3: StrBuilder = strbuf_push(b2, "){ .tag = FX_RESULT_TAG_OK, .ok_val = ");
    let b4: StrBuilder = strbuf_push(b3, expr);
    let b5: StrBuilder = strbuf_push(b4, ", .err_val = CORE_OK };\n");
    return Ok(strbuf_finish(b5));
}

fn emit_fn_let_try_return_ok_ident_block(mod_slug: string, src: string, fn_out: FnOut, ident: string) -> Result<string, core_Err> effects { alloc, mut } {
    let sig_line: string = emit_fn_sig_open_line(mod_slug, src, fn_out)?;
    let let_idx: i32 = stmt_let_expr_idx(fn_out.stmts, fn_out.body_start);
    let var_off: i32 = stmt_let_name_off(fn_out.stmts, fn_out.body_start);
    let var_len: i32 = stmt_let_name_ln(fn_out.stmts, fn_out.body_start);
    let try_line: string = emit_try_call0_callee_line(mod_slug, src, fn_out.nodes, let_idx, 0)?;
    let prop_line: string = emit_try_propagate_line(0)?;
    let bind_line: string = emit_let_try_call0_bind_line(src, var_off, var_len, 0)?;
    let ret_line: string = emit_return_ok_ident_line(mod_slug, src, fn_out, ident)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, sig_line);
    let b2: StrBuilder = strbuf_push(b1, try_line);
    let b3: StrBuilder = strbuf_push(b2, prop_line);
    let b4: StrBuilder = strbuf_push(b3, bind_line);
    let b5: StrBuilder = strbuf_push(b4, ret_line);
    let b6: StrBuilder = strbuf_push(b5, "}\n\n");
    return Ok(strbuf_finish(b6));
}

fn emit_fs_read_text_helper_block(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let pfx: string = strbuf_finish(b2);
    let r0: StrBuilder = strbuf_new();
    let r1: StrBuilder = strbuf_push(r0, pfx);
    let ret_ty: string = strbuf_finish(strbuf_push(r1, "_Result_string"));
    let f0: StrBuilder = strbuf_new();
    let f1: StrBuilder = strbuf_push(f0, pfx);
    let fn_name: string = strbuf_finish(strbuf_push(f1, "_fs_read_text"));
    let o0: StrBuilder = strbuf_new();
    let o1: StrBuilder = strbuf_push(o0, "static ");
    let o2: StrBuilder = strbuf_push(o1, ret_ty);
    let o3: StrBuilder = strbuf_push(o2, " ");
    let o4: StrBuilder = strbuf_push(o3, fn_name);
    let o5: StrBuilder = strbuf_push(o4, "(const char* path) {\n    FILE* f = fopen(path, \"rb\");\n    if (f == NULL) {\n        return (");
    let o6: StrBuilder = strbuf_push(o5, ret_ty);
    let o7: StrBuilder = strbuf_push(o6, "){ .tag = FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = CORE_ERR_INVALID_ARG };\n    }\n    if (fseek(f, 0, SEEK_END) != 0) {\n        fclose(f);\n        return (");
    let o8: StrBuilder = strbuf_push(o7, ret_ty);
    let o9: StrBuilder = strbuf_push(o8, "){ .tag = FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = CORE_ERR_INVALID_ARG };\n    }\n    long sz = ftell(f);\n    if (sz < 0) {\n        fclose(f);\n        return (");
    let o10: StrBuilder = strbuf_push(o9, ret_ty);
    let o11: StrBuilder = strbuf_push(o10, "){ .tag = FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = CORE_ERR_INVALID_ARG };\n    }\n    if (fseek(f, 0, SEEK_SET) != 0) {\n        fclose(f);\n        return (");
    let o12: StrBuilder = strbuf_push(o11, ret_ty);
    let o13: StrBuilder = strbuf_push(o12, "){ .tag = FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = CORE_ERR_INVALID_ARG };\n    }\n    char* buf = (char*)malloc((size_t)sz + 1u);\n    if (buf == NULL) {\n        fclose(f);\n        return (");
    let o14: StrBuilder = strbuf_push(o13, ret_ty);
    let o15: StrBuilder = strbuf_push(o14, "){ .tag = FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = CORE_ERR_OUT_OF_MEMORY };\n    }\n    if (fread(buf, 1, (size_t)sz, f) != (size_t)sz) {\n        free(buf);\n        fclose(f);\n        return (");
    let o16: StrBuilder = strbuf_push(o15, ret_ty);
    let o17: StrBuilder = strbuf_push(o16, "){ .tag = FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = CORE_ERR_INVALID_ARG };\n    }\n    fclose(f);\n    buf[sz] = '\\0';\n    return (");
    let o18: StrBuilder = strbuf_push(o17, ret_ty);
    let o19: StrBuilder = strbuf_push(o18, "){ .tag = FX_RESULT_TAG_OK, .ok_val = buf, .err_val = CORE_OK };\n}\n\n");
    return Ok(strbuf_finish(o19));
}

fn emit_string_len_helper_block() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("static int32_t fx_std_string_len(const char* s) {\n    if (s == NULL) {\n        return 0;\n    }\n    int32_t n = 0;\n    while (s[n] != '\\0') {\n        n = n + 1;\n    }\n    return n;\n}\n\nstatic int32_t fx_std_string_byte_at(const char* s, int32_t i) {\n    if (s == NULL) {\n        return 0;\n    }\n    if (i < 0) {\n        return 0;\n    }\n    return (int32_t)(unsigned char)s[i];\n}\n\n");
}

fn emit_str_from_i32_helper_block(mod_slug: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let pfx: string = strbuf_finish(b2);
    let r0: StrBuilder = strbuf_new();
    let r1: StrBuilder = strbuf_push(r0, pfx);
    let ret_ty: string = strbuf_finish(strbuf_push(r1, "_Result_string"));
    let f0: StrBuilder = strbuf_new();
    let f1: StrBuilder = strbuf_push(f0, pfx);
    let fn_name: string = strbuf_finish(strbuf_push(f1, "_str_from_i32"));
    let o0: StrBuilder = strbuf_new();
    let o1: StrBuilder = strbuf_push(o0, "static ");
    let o2: StrBuilder = strbuf_push(o1, ret_ty);
    let o3: StrBuilder = strbuf_push(o2, " ");
    let o4: StrBuilder = strbuf_push(o3, fn_name);
    let o5: StrBuilder = strbuf_push(o4, "(int32_t n) {\n    char buf[16];\n    int written = snprintf(buf, sizeof(buf), \"%d\", (int)n);\n    if (written < 0 || (size_t)written >= sizeof(buf)) {\n        return (");
    let o6: StrBuilder = strbuf_push(o5, ret_ty);
    let o7: StrBuilder = strbuf_push(o6, "){ .tag = FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = CORE_ERR_OVERFLOW };\n    }\n    size_t total = (size_t)written + 1;\n    char* out = (char*)malloc(total);\n    if (out == NULL) {\n        return (");
    let o8: StrBuilder = strbuf_push(o7, ret_ty);
    let o9: StrBuilder = strbuf_push(o8, "){ .tag = FX_RESULT_TAG_ERR, .ok_val = NULL, .err_val = CORE_ERR_OUT_OF_MEMORY };\n    }\n    memcpy(out, buf, total);\n    return (");
    let o10: StrBuilder = strbuf_push(o9, ret_ty);
    let o11: StrBuilder = strbuf_push(o10, "){ .tag = FX_RESULT_TAG_OK, .ok_val = out, .err_val = CORE_OK };\n}\n\n");
    return Ok(strbuf_finish(o11));
}

fn emit_return_fs_read_text_ident_line(mod_slug: string, ident: string) -> Result<string, core_Err> effects { alloc, mut } {
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let pfx: string = strbuf_finish(b2);
    let c0: StrBuilder = strbuf_new();
    let c1: StrBuilder = strbuf_push(c0, pfx);
    let callee: string = strbuf_finish(strbuf_push(c1, "_fs_read_text"));
    let o0: StrBuilder = strbuf_new();
    let o1: StrBuilder = strbuf_push(o0, "    return ");
    let o2: StrBuilder = strbuf_push(o1, callee);
    let o3: StrBuilder = strbuf_push(o2, "(");
    let o4: StrBuilder = strbuf_push(o3, ident);
    let o5: StrBuilder = strbuf_push(o4, ");\n");
    return Ok(strbuf_finish(o5));
}

fn emit_fn_let_try_return_fs_read_text_block(mod_slug: string, src: string, fn_out: FnOut, ident: string) -> Result<string, core_Err> effects { alloc, mut } {
    let sig_line: string = emit_fn_sig_open_line(mod_slug, src, fn_out)?;
    let let_idx: i32 = stmt_let_expr_idx(fn_out.stmts, fn_out.body_start);
    let var_off: i32 = stmt_let_name_off(fn_out.stmts, fn_out.body_start);
    let var_len: i32 = stmt_let_name_ln(fn_out.stmts, fn_out.body_start);
    let try_line: string = emit_try_call0_callee_line(mod_slug, src, fn_out.nodes, let_idx, 0)?;
    let prop_line: string = emit_try_propagate_line(0)?;
    let bind_line: string = emit_let_try_call0_bind_line(src, var_off, var_len, 0)?;
    let ret_line: string = emit_return_fs_read_text_ident_line(mod_slug, ident)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, sig_line);
    let b2: StrBuilder = strbuf_push(b1, try_line);
    let b3: StrBuilder = strbuf_push(b2, prop_line);
    let b4: StrBuilder = strbuf_push(b3, bind_line);
    let b5: StrBuilder = strbuf_push(b4, ret_line);
    let b6: StrBuilder = strbuf_push(b5, "}\n\n");
    return Ok(strbuf_finish(b6));
}

fn emit_mangled_fn_name(mod_slug: string, src: string, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let fname: string = sh_lexer.slice_str(src, fn_out.name_off, fn_out.name_len)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_");
    let b4: StrBuilder = strbuf_push(b3, fname);
    return Ok(strbuf_finish(b4));
}

fn emit_fn_sig_open_line(mod_slug: string, src: string, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let ret_c: string = emit_fn_ret_type_c(mod_slug, src, fn_out)?;
    let mangled: string = emit_mangled_fn_name(mod_slug, src, fn_out)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, ret_c);
    let b2: StrBuilder = strbuf_push(b1, " ");
    let b3: StrBuilder = strbuf_push(b2, mangled);
    let b4: StrBuilder = strbuf_push(b3, fn_out.param_sig);
    let b5: StrBuilder = strbuf_push(b4, " {\n");
    return Ok(strbuf_finish(b5));
}

fn stmt_let_expr_idx(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Let(off, ln, e, _, _) => {
            if (off + ln < 0) {
                return -1;
            }
            return e;
        },
        Return(r) => r,
        Assign(a, b, c) => a + b + c,
        AssignPtr(a, b, c) => a + b + c,
        If(a, b, c, d, e) => a + b + c + d + e,
        While(a, b, c) => a + b + c,
        Call(a, b, c, d) => a + b + c + d,
        Break => 0,
        Continue => 0,
        Region(a, b, c) => a + b + c,
        IndexAssign(a, b, c) => a + b + c,
    };
}

fn call2_num_at(nodes: Vec<Expr>, call_idx: i32, which: i32) -> i32 {
    let node: Expr = vec_get(nodes, call_idx);
    return match node {
        CallExpr(coff, cln, a0, a1, _, _, _) => {
            if (coff + cln < 0) {
                return 0;
            }
            if (which == 0) {
                return eval_expr(nodes, a0);
            }
            return eval_expr(nodes, a1);
        },
        Num(n) => n,
        StrLit(off, ln) => off + ln,
        Ident(ioff, iln) => ioff + iln,
        Add(l, r) => l + r,
        Sub(l, r) => l - r,
        Mul(l, r) => l + r,
        Div(l, r) => l - r,
        CmpLt(l, r) => l + r,
        CmpNe(l, r) => l + r,
        CmpEq(l, r) => l + r,
        CmpGe(l, r) => l + r,
        Deref(inner) => inner,
        Match(scr, arms, _) => scr + arms,
        StructLit(_, _, c, f0, f1, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => c + f0 + f1,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

fn stmt_return_expr_idx(stmts: Vec<Stmt>, idx: i32) -> i32 {
    let s: Stmt = vec_get(stmts, idx);
    return match s {
        Return(e) => e,
        Let(a, b, c, _, _) => a + b + c,
        Assign(a, b, c) => a + b + c,
        AssignPtr(a, b, c) => a + b + c,
        If(a, b, c, d, e) => a + b + c + d + e,
        While(a, b, c) => a + b + c,
        Call(a, b, c, d) => a + b + c + d,
        Break => 0,
        Continue => 0,
        Region(a, b, c) => a + b + c,
        IndexAssign(a, b, c) => a + b + c,
    };
}

fn expr_ident_off(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Ident(off, ln) => {
            if (off + ln >= 0) {
                return off;
            }
            return 0;
        },
        Num(n) => n,
        StrLit(off, ln) => off + ln,
        Add(l, r) => l + r,
        Sub(l, r) => l - r,
        Mul(l, r) => l + r,
        Div(l, r) => l - r,
        CmpLt(l, r) => l + r,
        CmpNe(l, r) => l + r,
        CmpEq(l, r) => l + r,
        CmpGe(l, r) => l + r,
        Deref(inner) => inner,
        Match(scr, arms, _) => scr + arms,
        CallExpr(coff, cln, a0, a1, _, _, _) => coff + cln + a0 + a1,
        StructLit(o, l, c, f0, f1, f2, f3, f4, f5, f6, f7, f8, _, _, _, _, _, _, _, _) => o + l + c + f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

fn expr_ident_ln(nodes: Vec<Expr>, idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Ident(off, ln) => {
            if (off + ln >= 0) {
                return ln;
            }
            return 0;
        },
        Num(n) => n,
        StrLit(off, ln) => off + ln,
        Add(l, r) => l + r,
        Sub(l, r) => l - r,
        Mul(l, r) => l + r,
        Div(l, r) => l - r,
        CmpLt(l, r) => l + r,
        CmpNe(l, r) => l + r,
        CmpEq(l, r) => l + r,
        CmpGe(l, r) => l + r,
        Deref(inner) => inner,
        Match(scr, arms, _) => scr + arms,
        CallExpr(coff, cln, a0, a1, _, _, _) => coff + cln + a0 + a1,
        StructLit(o, l, c, f0, f1, f2, f3, f4, f5, f6, f7, f8, _, _, _, _, _, _, _, _) => o + l + c + f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

fn emit_return_ident_line(src: string, nodes: Vec<Expr>, ret_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let off: i32 = expr_ident_off(nodes, ret_idx);
    let ln: i32 = expr_ident_ln(nodes, ret_idx);
    let name: string = sh_lexer.slice_str(src, off, ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return ");
    let b2: StrBuilder = strbuf_push(b1, name);
    let b3: StrBuilder = strbuf_push(b2, ";\n");
    return Ok(strbuf_finish(b3));
}

fn emit_return_num_line(n: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let s: string = str_from_i32(n)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return ");
    let b2: StrBuilder = strbuf_push(b1, s);
    let b3: StrBuilder = strbuf_push(b2, ";\n");
    return Ok(strbuf_finish(b3));
}

// CONV-3-r.14 - `while (false) { return 42; }` lowers to `while (0)` like production.
fn emit_while_false_return42_block() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    while (0) {\n        return 42;\n    }\n");
}

// CONV-3-r.17 - `for (let i = 0; i < 5; i = i + 1) { sum = sum + i; }`
fn emit_for_sum_i0_to5_block() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    for (int32_t i = 0; (i < 5); i = (i + 1)) {\n        sum = (sum + i);\n    }\n");
}

// CONV-3-r.18 - `for (...) { if (i == 2) continue; sum = sum + i; }`
fn emit_for_continue_i0_to5_block() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    for (int32_t i = 0; (i < 5); i = (i + 1)) {\n        if ((i == 2)) {\n            continue;\n        }\n        sum = (sum + i);\n    }\n");
}

// CONV-3-r.15 - `if (b) { return 1; } else { return 0; }` (bool param as int32_t).
fn emit_if_b_return10_block() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    if (b) {\n        return 1;\n    } else {\n        return 0;\n    }\n");
}

// CONV-3-r.15 - `return pick(true);` lowers to `pick(1)` like production.
fn emit_return_pick_true_line() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    return fx_ok_if_else_pick(1);\n");
}

// CONV-3-r.19 - `return a < b;`
fn emit_return_cmp_lt_idents_line() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    return (a < b);\n");
}

// CONV-3-r.19 - `if (lt(1, 2)) { return 10; } return 0;`
fn emit_if_lt_12_return10_block() -> Result<string, core_Err> effects { alloc, mut } {
    return Ok("    if (fx_ok_cmp_lt_lt(1, 2)) {\n        return 10;\n    }\n    return 0;\n");
}

fn expr_add_operand_idx(nodes: Vec<Expr>, idx: i32, which: i32) -> i32 {
    let node: Expr = vec_get(nodes, idx);
    return match node {
        Add(li, ri) => {
            if (which == 0) {
                return li;
            }
            return ri;
        },
        Sub(li, ri) => {
            if (which == 0) {
                return li;
            }
            return ri;
        },
        Mul(li, ri) => {
            if (which == 0) {
                return li;
            }
            return ri;
        },
        Div(li, ri) => {
            if (which == 0) {
                return li;
            }
            return ri;
        },
        Num(n) => n,
        StrLit(off, ln) => off + ln,
        Ident(ioff, iln) => ioff + iln,
        CmpLt(l, r) => l + r,
        CmpNe(l, r) => l + r,
        CmpEq(l, r) => l + r,
        CmpGe(l, r) => l + r,
        Deref(inner) => inner,
        Match(scr, arms, _) => scr + arms,
        CallExpr(coff, cln, a0, a1, _, _, _) => coff + cln + a0 + a1,
        StructLit(o, l, c, f0, f1, f2, f3, f4, f5, f6, f7, f8, _, _, _, _, _, _, _, _) => o + l + c + f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

fn emit_return_add_idents_line(src: string, nodes: Vec<Expr>, expr_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let left_idx: i32 = expr_add_operand_idx(nodes, expr_idx, 0);
    let right_idx: i32 = expr_add_operand_idx(nodes, expr_idx, 1);
    let off0: i32 = expr_ident_off(nodes, left_idx);
    let ln0: i32 = expr_ident_ln(nodes, left_idx);
    let off1: i32 = expr_ident_off(nodes, right_idx);
    let ln1: i32 = expr_ident_ln(nodes, right_idx);
    let n0: string = sh_lexer.slice_str(src, off0, ln0)?;
    let n1: string = sh_lexer.slice_str(src, off1, ln1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    return (");
    let b2: StrBuilder = strbuf_push(b1, n0);
    let b3: StrBuilder = strbuf_push(b2, " + ");
    let b4: StrBuilder = strbuf_push(b3, n1);
    let b5: StrBuilder = strbuf_push(b4, ");\n");
    return Ok(strbuf_finish(b5));
}

fn expr_call2_callee_off(nodes: Vec<Expr>, call_idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, call_idx);
    return match node {
        CallExpr(coff, cln, a0, a1, _, _, _) => {
            if (coff + cln + a0 + a1 < 0) {
                return 0;
            }
            return coff;
        },
        Num(n) => n,
        StrLit(off, ln) => off + ln,
        Ident(ioff, iln) => ioff + iln,
        Add(l, r) => l + r,
        Sub(l, r) => l - r,
        Mul(l, r) => l + r,
        Div(l, r) => l - r,
        CmpLt(l, r) => l + r,
        CmpNe(l, r) => l + r,
        CmpEq(l, r) => l + r,
        CmpGe(l, r) => l + r,
        Deref(inner) => inner,
        Match(scr, arms, _) => scr + arms,
        StructLit(o, l, c, f0, f1, f2, f3, f4, f5, f6, f7, f8, _, _, _, _, _, _, _, _) => o + l + c + f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

fn expr_call2_callee_ln(nodes: Vec<Expr>, call_idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, call_idx);
    return match node {
        CallExpr(coff, cln, a0, a1, _, _, _) => {
            if (coff + cln + a0 + a1 < 0) {
                return 0;
            }
            return cln;
        },
        Num(n) => n,
        StrLit(off, ln) => off + ln,
        Ident(ioff, iln) => ioff + iln,
        Add(l, r) => l + r,
        Sub(l, r) => l - r,
        Mul(l, r) => l + r,
        Div(l, r) => l - r,
        CmpLt(l, r) => l + r,
        CmpNe(l, r) => l + r,
        CmpEq(l, r) => l + r,
        CmpGe(l, r) => l + r,
        Deref(inner) => inner,
        Match(scr, arms, _) => scr + arms,
        StructLit(o, l, c, f0, f1, f2, f3, f4, f5, f6, f7, f8, _, _, _, _, _, _, _, _) => o + l + c + f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
