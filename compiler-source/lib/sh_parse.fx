    let st: StructOut = emit_sh_parse_pick_st_expr_stmt(src, fn_out, mod_st, imp_st, param_st, ret_st, enum_st, struct_st, parse_out_st, stmt_step_st, block_parse_out_st, arg_count_out_st, struct_lit_acc_st);
    return emit_fn_parser_helper_block(prof, prof.mod_slug, src, st, fn_out);
}

