fn variants_env_nth(env: string, want: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let hlen: i32 = string.len(env);
    let i: i32 = 0;
    let idx: i32 = 0;
    let start: i32 = 0;
    while (i < hlen) {
        if (string.byte_at(env, i) == 124) {
            if (idx == want) {
                let ln: i32 = i - start;
                return sh_lexer.slice_str(env, start, ln);
            }
            idx = idx + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if (idx == want) {
        let ln: i32 = hlen - start;
        return sh_lexer.slice_str(env, start, ln);
    }
    return Err(1);
}

fn payloads_env_nth(env: string, want: i32) -> Result<string, core_Err> effects { alloc, mut } {
    return variants_env_nth(env, want);
}

fn enum_has_any_payload(en_out: EnumOut) -> i32 {
    let hlen: i32 = string.len(en_out.payloads_env);
    let i: i32 = 0;
    while (i < hlen) {
        if (string.byte_at(en_out.payloads_env, i) != 124) {
            if (string.byte_at(en_out.payloads_env, i) != 0) {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn payload_spec_is_multi(spec: string) -> i32 {
    if (string.len(spec) < 2) {
        return 0;
    }
    if (string.byte_at(spec, 0) == 77) {
        return 1;
    }
    return 0;
}

fn payload_spec_union_field(spec: string) -> Result<string, core_Err> effects { alloc, mut } {
    let hlen: i32 = string.len(spec);
    let i: i32 = hlen - 1;
    while (i >= 0) {
        if (string.byte_at(spec, i) == 58) {
            return sh_lexer.slice_str(spec, i + 1, hlen - i - 1);
        }
        i = i - 1;
    }
    return Err(1);
}

fn payload_spec_multi_count(spec: string) -> i32 {
    if (payload_spec_is_multi(spec) != 1) {
        return 1;
    }
    if (string.len(spec) < 2) {
        return 1;
    }
    // Spec prefix `M<digit>` - digit is ASCII '1'..'9' (was hard-coded to 2 only).
    let d: i32 = string.byte_at(spec, 1);
    if (d >= 49) {
        if (d <= 57) {
            return d - 48;
        }
    }
    return 1;
}

fn payload_spec_ty(spec: string) -> Result<string, core_Err> effects { alloc, mut } {
    if (payload_spec_is_multi(spec) == 1) {
        let hlen: i32 = string.len(spec);
        let i: i32 = 0;
        let start: i32 = 0;
        while (i < hlen) {
            if (string.byte_at(spec, i) == 58) {
                if (start > 0) {
                    return sh_lexer.slice_str(spec, start, i - start);
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return Err(1);
    }
    let hlen: i32 = string.len(spec);
    let i: i32 = 0;
    while (i < hlen) {
        if (string.byte_at(spec, i) == 58) {
            return sh_lexer.slice_str(spec, 0, i);
        }
        i = i + 1;
    }
    return Err(1);
}

fn payload_spec_field(spec: string) -> Result<string, core_Err> effects { alloc, mut } {
    return payload_spec_union_field(spec);
}

fn emit_enum_type_c_name(prof: FixtureProfile, src: string, en_off: i32, en_ln: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let ename: string = sh_lexer.slice_str(src, en_off, en_ln)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "fx_");
    let b2: StrBuilder = strbuf_push(b1, prof.mod_slug);
    let b3: StrBuilder = strbuf_push(b2, "_");
    let b4: StrBuilder = strbuf_push(b3, ename);
    return Ok(strbuf_finish(b4));
}

fn emit_enum_tag_typedef_cases(prof: FixtureProfile, src: string, en_out: EnumOut, i: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (i >= en_out.variant_count) {
        return Ok("");
    }
    let vname: string = variants_env_nth(en_out.variants_env, i)?;
    let const_name: string = emit_enum_variant_tag_const(prof, src, en_out, vname)?;
    let rest: string = emit_enum_tag_typedef_cases(prof, src, en_out, i + 1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, const_name);
    let b3: StrBuilder = strbuf_push(b2, ",\n");
    let b4: StrBuilder = strbuf_push(b3, rest);
    return Ok(strbuf_finish(b4));
}

fn emit_enum_variant_const(prof: FixtureProfile, src: string, en_out: EnumOut, variant_name: string) -> Result<string, core_Err> effects { alloc, mut } {
    let mod_up: string = sh_lexer.mangle_upper_slice(prof.mod_slug, 0, string.len(prof.mod_slug))?;
    let enum_up: string = sh_lexer.mangle_upper_slice(src, en_out.name_off, en_out.name_len)?;
    let var_up: string = sh_lexer.mangle_upper_slice(variant_name, 0, string.len(variant_name))?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "FX_");
    let b2: StrBuilder = strbuf_push(b1, mod_up);
    let b3: StrBuilder = strbuf_push(b2, "_");
    let b4: StrBuilder = strbuf_push(b3, enum_up);
    let b5: StrBuilder = strbuf_push(b4, "_");
    let b6: StrBuilder = strbuf_push(b5, var_up);
    return Ok(strbuf_finish(b6));
}

fn emit_enum_variant_tag_const(prof: FixtureProfile, src: string, en_out: EnumOut, variant_name: string) -> Result<string, core_Err> effects { alloc, mut } {
    let mod_up: string = sh_lexer.mangle_upper_slice(prof.mod_slug, 0, string.len(prof.mod_slug))?;
    let enum_up: string = sh_lexer.mangle_upper_slice(src, en_out.name_off, en_out.name_len)?;
    let var_up: string = sh_lexer.mangle_upper_slice(variant_name, 0, string.len(variant_name))?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "FX_");
    let b2: StrBuilder = strbuf_push(b1, mod_up);
    let b3: StrBuilder = strbuf_push(b2, "_");
    let b4: StrBuilder = strbuf_push(b3, enum_up);
    let b5: StrBuilder = strbuf_push(b4, "_TAG_");
    let b6: StrBuilder = strbuf_push(b5, var_up);
    return Ok(strbuf_finish(b6));
}

fn emit_payload_union_field_lines(spec: string) -> Result<string, core_Err> effects { alloc, mut } {
    if (payload_spec_is_multi(spec) != 1) {
        let ty_c: string = payload_spec_ty(spec)?;
        let field: string = payload_spec_field(spec)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "        ");
        let b2: StrBuilder = strbuf_push(b1, ty_c);
        let b3: StrBuilder = strbuf_push(b2, " ");
        let b4: StrBuilder = strbuf_push(b3, field);
        let b5: StrBuilder = strbuf_push(b4, ";\n");
        return Ok(strbuf_finish(b5));
    }
    let union_field: string = payload_spec_union_field(spec)?;
    let count: i32 = payload_spec_multi_count(spec);
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "        struct {\n");
    let i: i32 = 0;
    let cur: StrBuilder = b1;
    while (i < count) {
        let fi: string = str_from_i32(i)?;
        cur = strbuf_push(cur, "            int32_t f");
        cur = strbuf_push(cur, fi);
        cur = strbuf_push(cur, ";\n");
        i = i + 1;
    }
    let b2: StrBuilder = strbuf_push(cur, "        } ");
    let b3: StrBuilder = strbuf_push(b2, union_field);
    let b4: StrBuilder = strbuf_push(b3, ";\n");
    return Ok(strbuf_finish(b4));
}

fn emit_payload_union_fields(en_out: EnumOut, i: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (i >= en_out.variant_count) {
        return Ok("");
    }
    let spec: string = payloads_env_nth(en_out.payloads_env, i)?;
    if (string.len(spec) < 1) {
        return emit_payload_union_fields(en_out, i + 1);
    }
    let line4: string = emit_payload_union_field_lines(spec)?;
    let rest: string = emit_payload_union_fields(en_out, i + 1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, line4);
    let b2: StrBuilder = strbuf_push(b1, rest);
    return Ok(strbuf_finish(b2));
}

fn emit_enum_typedef_cases(prof: FixtureProfile, src: string, en_out: EnumOut, i: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (i >= en_out.variant_count) {
        return Ok("");
    }
    let vname: string = variants_env_nth(en_out.variants_env, i)?;
    let const_name: string = emit_enum_variant_const(prof, src, en_out, vname)?;
    let rest: string = emit_enum_typedef_cases(prof, src, en_out, i + 1)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b2: StrBuilder = strbuf_push(b1, const_name);
    let b3: StrBuilder = strbuf_push(b2, ",\n");
    let b4: StrBuilder = strbuf_push(b3, rest);
    return Ok(strbuf_finish(b4));
}

fn emit_enum_typedef_block(prof: FixtureProfile, src: string, en_out: EnumOut) -> Result<string, core_Err> effects { alloc, mut } {
    let ty_name: string = emit_enum_type_c_name(prof, src, en_out.name_off, en_out.name_len)?;
    if (enum_has_any_payload(en_out) != 1) {
        let cases: string = emit_enum_typedef_cases(prof, src, en_out, 0)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "typedef enum {\n");
        let b2: StrBuilder = strbuf_push(b1, cases);
        let b3: StrBuilder = strbuf_push(b2, "} ");
        let b4: StrBuilder = strbuf_push(b3, ty_name);
        let b5: StrBuilder = strbuf_push(b4, ";\n\n");
        return Ok(strbuf_finish(b5));
    }
    let t0: StrBuilder = strbuf_new();
    let t1: StrBuilder = strbuf_push(t0, ty_name);
    let t2: StrBuilder = strbuf_push(t1, "Tag");
    let tag_name: string = strbuf_finish(t2);
    let tag_cases: string = emit_enum_tag_typedef_cases(prof, src, en_out, 0)?;
    let union_fields: string = emit_payload_union_fields(en_out, 0)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "typedef enum {\n");
    let b2: StrBuilder = strbuf_push(b1, tag_cases);
    let b3: StrBuilder = strbuf_push(b2, "} ");
    let b4: StrBuilder = strbuf_push(b3, tag_name);
    let b5: StrBuilder = strbuf_push(b4, ";\n\ntypedef struct {\n    ");
    let b6: StrBuilder = strbuf_push(b5, tag_name);
    let b7: StrBuilder = strbuf_push(b6, " tag;\n    union {\n");
    let b8: StrBuilder = strbuf_push(b7, union_fields);
    let b9: StrBuilder = strbuf_push(b8, "    } u;\n} ");
    let b10: StrBuilder = strbuf_push(b9, ty_name);
    let b11: StrBuilder = strbuf_push(b10, ";\n\n");
    return Ok(strbuf_finish(b11));
}

fn match_arm_body_idx(nodes: Vec<Expr>, match_idx: i32, arm_i: i32) -> i32 {
    if (expr_ty_tag(nodes, match_idx) != 9) {
        return -1;
    }
    let node: Expr = vec_get(nodes, match_idx);
    return match node {
        Match(_, arm_count, bodies_start) => unpack_match_body(nodes, bodies_start, arm_i, arm_count),
        Num(_) => -1,
        StrLit(_, _) => -1,
        Ident(_, _) => -1,
        Add(_, _) => -1,
        Sub(_, _) => -1,
        Mul(_, _) => -1,
        Div(_, _) => -1,
        CmpLt(_, _) => -1,
        CmpNe(_, _) => -1,
        CmpEq(_, _) => -1,
        CmpGe(_, _) => -1,
        Deref(_) => -1,
        CallExpr(_, _, _, _, _, _, _) => -1,
        StructLit(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => -1,
        TryExpr(_) => -1,
        Index(_, _) => -1,
        SliceRange(_, _, _) => -1,
        ArrayLit(_, _, _, _, _, _, _, _, _) => 0,
    };
}

fn emit_match_call_expr_c(callee_pfx: string, src: string, nodes: Vec<Expr>, call_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (expr_ty_tag(nodes, call_idx) != 10) {
        return Err(1);
    }
    let coff: i32 = expr_call2_callee_off(nodes, call_idx);
    let cln: i32 = expr_call2_callee_ln(nodes, call_idx);
    let a0: i32 = expr_call_arg0_idx(nodes, call_idx);
    let a1: i32 = expr_call_arg1_idx(nodes, call_idx);
    let name: string = sh_lexer.slice_str(src, coff, cln)?;
    let c0: StrBuilder = strbuf_new();
    let c1: StrBuilder = strbuf_push(c0, callee_pfx);
    let callee: string = strbuf_finish(strbuf_push(c1, name));
    if (a0 < 0) {
        if (a1 >= 0) {
            return Err(1);
        }
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, callee);
        let b2: StrBuilder = strbuf_push(b1, "()");
        return Ok(strbuf_finish(b2));
    }
    let arg0: string = emit_match_expr_c(callee_pfx, src, nodes, a0)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, callee);
    let b2: StrBuilder = strbuf_push(b1, "(");
    let b3: StrBuilder = strbuf_push(b2, arg0);
    if (a1 < 0) {
        let b4: StrBuilder = strbuf_push(b3, ")");
        return Ok(strbuf_finish(b4));
    }
    let arg1: string = emit_match_expr_c(callee_pfx, src, nodes, a1)?;
    let b4: StrBuilder = strbuf_push(b3, ", ");
    let b5: StrBuilder = strbuf_push(b4, arg1);
    let b6: StrBuilder = strbuf_push(b5, ")");
    return Ok(strbuf_finish(b6));
}

fn emit_match_expr_c(callee_pfx: string, src: string, nodes: Vec<Expr>, idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let tag: i32 = expr_ty_tag(nodes, idx);
    if (tag == 1) {
        let n: i32 = eval_expr(nodes, idx);
        return str_from_i32(n);
    }
    if (tag == 3) {
        let off: i32 = expr_ident_off(nodes, idx);
        let ln: i32 = expr_ident_ln(nodes, idx);
        return sh_lexer.slice_str(src, off, ln);
    }
    if (tag == 10) {
        return emit_match_call_expr_c(callee_pfx, src, nodes, idx);
    }
    return Err(1);
}

fn emit_match_switch_cases(src: string, prof: FixtureProfile, en_out: EnumOut, nodes: Vec<Expr>, match_idx: i32, arm_count: i32, i: i32) -> Result<string, core_Err> effects { alloc, mut } {
    if (i >= arm_count) {
        return Ok("");
    }
    let vname: string = variants_env_nth(en_out.variants_env, i)?;
    let body_idx: i32 = match_arm_body_idx(nodes, match_idx, i);
    if (enum_has_any_payload(en_out) != 1) {
        let const_name: string = emit_enum_variant_const(prof, src, en_out, vname)?;
        let body_val: i32 = eval_expr(nodes, body_idx);
        let body_str: string = str_from_i32(body_val)?;
        let rest: string = emit_match_switch_cases(src, prof, en_out, nodes, match_idx, arm_count, i + 1)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, "        case ");
        let b2: StrBuilder = strbuf_push(b1, const_name);
        let b3: StrBuilder = strbuf_push(b2, ":\n            _match_result = ");
        let b4: StrBuilder = strbuf_push(b3, body_str);
        let b5: StrBuilder = strbuf_push(b4, ";\n            break;\n");
        let b6: StrBuilder = strbuf_push(b5, rest);
        return Ok(strbuf_finish(b6));
    }
    let const_name: string = emit_enum_variant_tag_const(prof, src, en_out, vname)?;
    let spec: string = payloads_env_nth(en_out.payloads_env, i)?;
    let rest: string = emit_match_switch_cases(src, prof, en_out, nodes, match_idx, arm_count, i + 1)?;
    let h0: StrBuilder = strbuf_new();
    let h1: StrBuilder = strbuf_push(h0, "        case ");
    let h2: StrBuilder = strbuf_push(h1, const_name);
    let head: string = strbuf_finish(strbuf_push(h2, ":\n            {\n"));
    if (string.len(spec) < 1) {
        if (expr_is_call0(nodes, body_idx) == 1) {
            let callee_pfx: string = profile_callee_prefix(prof)?;
            let callee: string = emit_mangled_callee(callee_pfx, src, nodes, body_idx)?;
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, head);
            let b2: StrBuilder = strbuf_push(b1, "                _match_result = ");
            let b3: StrBuilder = strbuf_push(b2, callee);
            let b4: StrBuilder = strbuf_push(b3, "();\n                break;\n            }\n");
            let b5: StrBuilder = strbuf_push(b4, rest);
            return Ok(strbuf_finish(b5));
        }
        let body_val: i32 = eval_expr(nodes, body_idx);
        let body_str: string = str_from_i32(body_val)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, head);
        let b2: StrBuilder = strbuf_push(b1, "                _match_result = ");
        let b3: StrBuilder = strbuf_push(b2, body_str);
        let b4: StrBuilder = strbuf_push(b3, ";\n                break;\n            }\n");
        let b5: StrBuilder = strbuf_push(b4, rest);
        return Ok(strbuf_finish(b5));
    }
    if (payload_spec_is_multi(spec) == 1) {
        let union_field: string = payload_spec_union_field(spec)?;
        // SH-C-16 - multi-payload arm with call0 body (e.g. CallExpr(_, _) => stop_code()).
        if (expr_is_call0(nodes, body_idx) == 1) {
            let callee_pfx: string = profile_callee_prefix(prof)?;
            let callee: string = emit_mangled_callee(callee_pfx, src, nodes, body_idx)?;
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, head);
            let b2: StrBuilder = strbuf_push(b1, "                _match_result = ");
            let b3: StrBuilder = strbuf_push(b2, callee);
            let b4: StrBuilder = strbuf_push(b3, "();\n                break;\n            }\n");
            let b5: StrBuilder = strbuf_push(b4, rest);
            return Ok(strbuf_finish(b5));
        }
        // CONV-3-r.24 - Two(x, _) => x binds only f0 (ignore _).
        if (expr_ty_tag(nodes, body_idx) == 3) {
            let x_off: i32 = expr_ident_off(nodes, body_idx);
            let x_ln: i32 = expr_ident_ln(nodes, body_idx);
            let x_name: string = sh_lexer.slice_str(src, x_off, x_ln)?;
            let b0: StrBuilder = strbuf_new();
            let b1: StrBuilder = strbuf_push(b0, head);
            let b2: StrBuilder = strbuf_push(b1, "                int32_t ");
            let b3: StrBuilder = strbuf_push(b2, x_name);
            let b4: StrBuilder = strbuf_push(b3, " = _scrutinee.u.");
            let b5: StrBuilder = strbuf_push(b4, union_field);
            let b6: StrBuilder = strbuf_push(b5, ".f0;\n                _match_result = ");
            let b7: StrBuilder = strbuf_push(b6, x_name);
            let b8: StrBuilder = strbuf_push(b7, ";\n                break;\n            }\n");
            let b9: StrBuilder = strbuf_push(b8, rest);
            return Ok(strbuf_finish(b9));
        }
        let left_idx: i32 = expr_add_operand_idx(nodes, body_idx, 0);
        let right_idx: i32 = expr_add_operand_idx(nodes, body_idx, 1);
        let x_off: i32 = expr_ident_off(nodes, left_idx);
        let x_ln: i32 = expr_ident_ln(nodes, left_idx);
        let y_off: i32 = expr_ident_off(nodes, right_idx);
        let y_ln: i32 = expr_ident_ln(nodes, right_idx);
        let x_name: string = sh_lexer.slice_str(src, x_off, x_ln)?;
        let y_name: string = sh_lexer.slice_str(src, y_off, y_ln)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, head);
        let b2: StrBuilder = strbuf_push(b1, "                int32_t ");
        let b3: StrBuilder = strbuf_push(b2, x_name);
        let b4: StrBuilder = strbuf_push(b3, " = _scrutinee.u.");
        let b5: StrBuilder = strbuf_push(b4, union_field);
        let b6: StrBuilder = strbuf_push(b5, ".f0;\n                int32_t ");
        let b7: StrBuilder = strbuf_push(b6, y_name);
        let b8: StrBuilder = strbuf_push(b7, " = _scrutinee.u.");
        let b9: StrBuilder = strbuf_push(b8, union_field);
        let b10: StrBuilder = strbuf_push(b9, ".f1;\n                _match_result = (");
        let b11: StrBuilder = strbuf_push(b10, x_name);
        let b12: StrBuilder = strbuf_push(b11, " + ");
        let b13: StrBuilder = strbuf_push(b12, y_name);
        let b14: StrBuilder = strbuf_push(b13, ");\n                break;\n            }\n");
        let b15: StrBuilder = strbuf_push(b14, rest);
        return Ok(strbuf_finish(b15));
    }
    let ty_c: string = payload_spec_ty(spec)?;
    let field: string = payload_spec_field(spec)?;
    let bind_off: i32 = 0;
    let bind_ln: i32 = 0;
    if (expr_ty_tag(nodes, body_idx) == 10) {
        let bind_arg: i32 = expr_call_arg0_idx(nodes, body_idx);
        if (expr_ty_tag(nodes, bind_arg) == 10) {
            let inner_arg: i32 = expr_call_arg0_idx(nodes, bind_arg);
            bind_off = expr_ident_off(nodes, inner_arg);
            bind_ln = expr_ident_ln(nodes, inner_arg);
        } else {
            bind_off = expr_ident_off(nodes, bind_arg);
            bind_ln = expr_ident_ln(nodes, bind_arg);
        }
    } else {
        bind_off = expr_ident_off(nodes, body_idx);
        bind_ln = expr_ident_ln(nodes, body_idx);
    }
    let bind_name: string = sh_lexer.slice_str(src, bind_off, bind_ln)?;
    let p0: StrBuilder = strbuf_new();
    let p1: StrBuilder = strbuf_push(p0, head);
    let p2: StrBuilder = strbuf_push(p1, "                ");
    let p3: StrBuilder = strbuf_push(p2, ty_c);
    let p4: StrBuilder = strbuf_push(p3, " ");
    let p5: StrBuilder = strbuf_push(p4, bind_name);
    let p6: StrBuilder = strbuf_push(p5, " = _scrutinee.u.");
    let bind_prefix: string = strbuf_finish(strbuf_push(p6, field));
    if (expr_ty_tag(nodes, body_idx) == 10) {
        let callee_pfx: string = profile_callee_prefix(prof)?;
        let callee: string = emit_mangled_callee(callee_pfx, src, nodes, body_idx)?;
        let a0: i32 = expr_call_arg0_idx(nodes, body_idx);
        let a1: i32 = expr_call_arg1_idx(nodes, body_idx);
        let arg0: string = emit_match_expr_c(callee_pfx, src, nodes, a0)?;
        let b0: StrBuilder = strbuf_new();
        let b1: StrBuilder = strbuf_push(b0, bind_prefix);
        let b2: StrBuilder = strbuf_push(b1, ";\n                _match_result = ");
        let b3: StrBuilder = strbuf_push(b2, callee);
        let b4: StrBuilder = strbuf_push(b3, "(");
        let b5: StrBuilder = strbuf_push(b4, arg0);
        if (a1 >= 0) {
            let arg1: string = emit_match_expr_c(callee_pfx, src, nodes, a1)?;
            let b6: StrBuilder = strbuf_push(b5, ", ");
            let b7: StrBuilder = strbuf_push(b6, arg1);
            let b8: StrBuilder = strbuf_push(b7, ");\n                break;\n            }\n");
            let b9: StrBuilder = strbuf_push(b8, rest);
            return Ok(strbuf_finish(b9));
        }
        let b6: StrBuilder = strbuf_push(b5, ");\n                break;\n            }\n");
        let b7: StrBuilder = strbuf_push(b6, rest);
        return Ok(strbuf_finish(b7));
    }
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, bind_prefix);
    let b2: StrBuilder = strbuf_push(b1, ";\n                _match_result = ");
    let b3: StrBuilder = strbuf_push(b2, bind_name);
    let b4: StrBuilder = strbuf_push(b3, ";\n                break;\n            }\n");
    let b5: StrBuilder = strbuf_push(b4, rest);
    return Ok(strbuf_finish(b5));
}

fn emit_match_i32_switch_body(src: string, prof: FixtureProfile, en_out: EnumOut, nodes: Vec<Expr>, match_idx: i32, arm_count: i32, scr_idx: i32) -> Result<string, core_Err> effects { alloc, mut } {
    let scr_off: i32 = expr_ident_off(nodes, scr_idx);
    let scr_ln: i32 = expr_ident_ln(nodes, scr_idx);
    let scr_name: string = sh_lexer.slice_str(src, scr_off, scr_ln)?;
    let enum_ty: string = emit_enum_type_c_name(prof, src, en_out.name_off, en_out.name_len)?;
    let cases: string = emit_match_switch_cases(src, prof, en_out, nodes, match_idx, arm_count, 0)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, "    ");
    let b1b: StrBuilder = strbuf_push(b1, enum_ty);
    let b2: StrBuilder = strbuf_push(b1b, " _scrutinee = ");
    let b3: StrBuilder = strbuf_push(b2, scr_name);
    let b4: StrBuilder = strbuf_push(b3, ";\n    int32_t _match_result = 0;\n    switch (_scrutinee");
    if (enum_has_any_payload(en_out) == 1) {
        let b5: StrBuilder = strbuf_push(b4, ".tag");
        let b6: StrBuilder = strbuf_push(b5, ") {\n");
        let b7: StrBuilder = strbuf_push(b6, cases);
        let b8: StrBuilder = strbuf_push(b7, "    }\n    return _match_result;\n");
        return Ok(strbuf_finish(b8));
    }
    let b5: StrBuilder = strbuf_push(b4, ") {\n");
    let b6: StrBuilder = strbuf_push(b5, cases);
    let b7: StrBuilder = strbuf_push(b6, "    }\n    return _match_result;\n");
    return Ok(strbuf_finish(b7));
}

fn emit_fn_match_return_block(mod_slug: string, src: string, prof: FixtureProfile, en_out: EnumOut, fn_out: FnOut) -> Result<string, core_Err> effects { alloc, mut } {
    let sig: string = emit_fn_sig_open_line(mod_slug, src, fn_out)?;
    let ret_idx: i32 = stmt_return_expr_idx(fn_out.stmts, fn_out.body_start);
    let scr_idx: i32 = expr_match_scrutinee_idx(fn_out.nodes, ret_idx);
    let arm_count: i32 = expr_match_arm_count(fn_out.nodes, ret_idx);
    if (scr_idx < 0) {
        return Err(1);
    }
    if (arm_count < 0) {
        return Err(1);
    }
    let body: string = emit_match_i32_switch_body(src, prof, en_out, fn_out.nodes, ret_idx, arm_count, scr_idx)?;
    let b0: StrBuilder = strbuf_new();
    let b1: StrBuilder = strbuf_push(b0, sig);
    let b2: StrBuilder = strbuf_push(b1, body);
    let b3: StrBuilder = strbuf_push(b2, "}\n\n");
    return Ok(strbuf_finish(b3));
}

fn expr_call_arg0_idx(nodes: Vec<Expr>, call_idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, call_idx);
    return match node {
        CallExpr(_, _, a0, _, _, _, _) => a0,
        Num(n) => n,
        StrLit(off, ln) => off + ln,
        Ident(off, ln) => off + ln,
        Add(l, r) => l + r,
        Sub(l, r) => l - r,
        Mul(l, r) => l + r,
        Div(l, r) => l - r,
        CmpLt(l, r) => l + r,
        CmpNe(l, r) => l + r,
        CmpEq(l, r) => l + r,
        CmpGe(l, r) => l + r,
        Deref(inner) => inner,
        Match(scr, arms, _) => scr + arms,
        StructLit(_, _, c, f0, f1, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => c + f0 + f1,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

fn expr_call_arg1_idx(nodes: Vec<Expr>, call_idx: i32) -> i32 {
    let node: Expr = vec_get(nodes, call_idx);
    return match node {
        CallExpr(_, _, _, a1, _, _, _) => a1,
        Num(n) => n,
        StrLit(off, ln) => off + ln,
        Ident(off, ln) => off + ln,
        Add(l, r) => l + r,
        Sub(l, r) => l - r,
        Mul(l, r) => l + r,
        Div(l, r) => l - r,
        CmpLt(l, r) => l + r,
        CmpNe(l, r) => l + r,
        CmpEq(l, r) => l + r,
        CmpGe(l, r) => l + r,
        Deref(inner) => inner,
        Match(scr, arms, _) => scr + arms,
        StructLit(_, _, c, f0, f1, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => c + f0 + f1,
        TryExpr(inner) => inner,
        Index(base, _) => base,
        SliceRange(base, _, _) => base,
        ArrayLit(c, f0, _, _, _, _, _, _, _) => c + f0,
    };
}

