    let b4: StrBuilder = strbuf_push(b3, "#include \"fx_vec.h\"\n");
    let b5: StrBuilder = strbuf_push(b4, "#include \"zspec/core.h\"\n\n");
    let b6: StrBuilder = strbuf_push(b5, "static fx_Vec_i32 fx_{{MODULE}}_vec_arena_new(core_Allocator* region, int32_t len) {\n");
    let b7: StrBuilder = strbuf_push(b6, "    size_t n = (size_t)len;\n");
    let b8: StrBuilder = strbuf_push(b7, "    int32_t* p = (int32_t*)core_mem_alloc(region, n * sizeof(int32_t));\n");
    let b9: StrBuilder = strbuf_push(b8, "    for (size_t i = 0; i < n; i++) {\n");
    let b10: StrBuilder = strbuf_push(b9, "        p[i] = (int32_t)(i + 1);\n");
    let b11: StrBuilder = strbuf_push(b10, "    }\n");
    let b12: StrBuilder = strbuf_push(b11, "    return (fx_Vec_i32){ .data = p, .len = n, .cap = n };\n");
    let b13: StrBuilder = strbuf_push(b12, "}\n\n");
    let b14: StrBuilder = strbuf_push(b13, "int32_t fx_{{MODULE}}_read_first(fx_Vec_i32 v) {\n");
    let b15: StrBuilder = strbuf_push(b14, "    return (v.data[0]);\n");
    let b16: StrBuilder = strbuf_push(b15, "}\n\n");
    let b17: StrBuilder = strbuf_push(b16, "int32_t fx_{{MODULE}}_main(void) {\n");
    let b18: StrBuilder = strbuf_push(b17, "    core_Allocator* r = core_arena_new(core_default_allocator(), (size_t)({{ARENA}}));\n");
    let b19: StrBuilder = strbuf_push(b18, "    fx_Vec_i32 v = fx_{{MODULE}}_vec_arena_new(r, {{LEN}});\n");
    let b20: StrBuilder = strbuf_push(b19, "    /* fx: defer */ fx_{{MODULE}}_read_first(v);\n");
    let b21: StrBuilder = strbuf_push(b20, "    core_mem_reset(r);\n");
    let b22: StrBuilder = strbuf_push(b21, "    return ((v.data[0]) + (v.data[1]));\n");
    let b23: StrBuilder = strbuf_push(b22, "}\n");
    return Ok(strbuf_finish(b23));
}

